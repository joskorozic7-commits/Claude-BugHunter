-- Gems fuer Robux (Developer Products). So richtest du sie ein:
--   create.roblox.com -> dein Spiel -> Monetization -> Developer Products ->
--   "Create a Developer Product", Preis einstellen, ID hier bei ProductId eintragen.
-- Solange ProductId = 0 ist, gibt es die Gems nur in Studio zum Testen.
--------------------------------------------------------------------------
Config.GemPacks = {
	{ Id = "Pack1", Gems = 150, Robux = 49, ProductId = 3736545082 },
	{ Id = "Pack2", Gems = 400, Robux = 99, ProductId = 3736545191 },
	{ Id = "Pack3", Gems = 1000, Robux = 199, ProductId = 3736545308 },
	{ Id = "Pack4", Gems = 2500, Robux = 449, ProductId = 3736545421, Tag = "POPULAR" },
	{ Id = "Pack5", Gems = 6500, Robux = 999, ProductId = 3736545488 },
	{ Id = "Pack6", Gems = 22000, Robux = 3000, ProductId = 3736545603, Tag = "BEST VALUE" },
}

--------------------------------------------------------------------------
-- Handel
--------------------------------------------------------------------------
Config.Trade = {
	MaxPets = 8, -- pro Seite
	RequestTimeout = 30,
	Countdown = 3, -- Sekunden nach "Bereit" bis man bestaetigen kann
}

-- Hub (Startbereich) liegt bei Z < 0
Config.HubLength = 120
Config.SpawnPosition = { 0, -55 }

return Config
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX00000019"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX00000018"><Properties><string name="Name">SlapServer</string><ProtectedString name="Source"><![CDATA[--[[
	SlapServer (Script in ServerScriptService)

	Startet alle Server-Module von "Slap the Blob" und verbindet sie.
	Die einzelnen Systeme liegen als ModuleScripts unter diesem Skript.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("SlapShared")
local Config = require(Shared:WaitForChild("Config"))

local Remotes = require(script:WaitForChild("Remotes"))
local Data = require(script:WaitForChild("Data"))
local World = require(script:WaitForChild("World"))
local Gyatts = require(script:WaitForChild("Gyatts"))
local Hands = require(script:WaitForChild("Hands"))
local Combat = require(script:WaitForChild("Combat"))
local Shop = require(script:WaitForChild("Shop"))
local Pets = require(script:WaitForChild("Pets"))
local Rewards = require(script:WaitForChild("Rewards"))
local Leaderboards = require(script:WaitForChild("Leaderboards"))
local Duel = require(script:WaitForChild("Duel"))
local Trade = require(script:WaitForChild("Trade"))
local Items = require(script:WaitForChild("Items"))

--------------------------------------------------------------------------
-- Gemeinsamer Kontext fuer alle Module
--------------------------------------------------------------------------
local actions = {}

local ctx = {
	Players = Players,
	Remotes = Remotes,
	Data = Data,
	World = World,
	Gyatts = Gyatts,
	Hands = Hands,
	Combat = Combat,
	Shop = Shop,
	Pets = Pets,
	Rewards = Rewards,
	Leaderboards = Leaderboards,
	Duel = Duel,
	Trade = Trade,
	Items = Items,
}

function ctx.RegisterAction(name, handler)
	actions[name] = handler
end

-- Karte zuerst bauen (andere Module brauchen die Positionen)
World.Build()

for _, module in ipairs({ Data, Gyatts, Hands, Combat, Shop, Pets, Rewards, Leaderboards, Duel, Trade, Items }) do
	module.Init(ctx)
end

Gyatts.Start()
Combat.Start()
Shop.Start()
Pets.Start()
Leaderboards.Start()
Duel.Run()
Data.StartAutosave()

--------------------------------------------------------------------------
-- Anfragen vom Client (mit Schutz gegen Spam)
--------------------------------------------------------------------------
local requestBudget = {} -- [Player] = { count, windowStart }

ctx.RegisterAction("RequestState", function(player)
	Data.Push(player, true)
	Gyatts.SendEventState(player)
end)

Remotes.Events.Request.OnServerEvent:Connect(function(player, action, a, b)
	if type(action) ~= "string" then
		return
	end
	local now = os.clock()
	local budget = requestBudget[player]
	if not budget or now - budget.Start > 1 then
		budget = { Count = 0, Start = now }
		requestBudget[player] = budget
	end
	budget.Count = budget.Count + 1
	if budget.Count > 25 then
		return -- zu viele Anfragen pro Sekunde
	end
	local handler = actions[action]
	if not handler then
		return
	end
	local ok, err = pcall(handler, player, a, b)
	if not ok then
		warn("[SlapTheBlob] Error in action '" .. action .. "': " .. tostring(err))
	end
end)

--------------------------------------------------------------------------
-- Spieler
--------------------------------------------------------------------------
local function onCharacterAdded(player, character)
	local profile = Data.Get(player)
	if not profile then
		return
	end
	character:WaitForChild("Humanoid", 10)
	player:WaitForChild("Backpack", 10)
	if player.Character ~= character or not player.Parent then
		return
	end
	Hands.Give(player, true)
	Items.ApplyCharacter(player)
end

local function onPlayerAdded(player)
	local profile = Data.CreateProfile(player)
	Data.CreateLeaderstats(profile)

	local ok, data = Data.Load(player)
	if not player.Parent then
		Data.RemoveProfile(player)
		return
	end
	profile.Data = data
	profile.Loaded = true
	profile.CanSave = ok
	Data.RefreshQuests(profile)
	Shop.CheckRobuxHands(player, profile)

	if not ok then
		if RunService:IsStudio() then
			Remotes.Notify(player, "⚠️ Saving off: in Studio turn on 'Game Settings > Security > Enable Studio Access to API Services'.", { 255, 200, 120 })
		else
			Remotes.Notify(player, "⚠️ Your data could not be loaded. Progress will not be saved this session.", { 255, 120, 120 })
		end
	end

	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	if player.Character then
		task.spawn(onCharacterAdded, player, player.Character)
	end

	Pets.UpdateAttribute(player)
	Data.Push(player, true)
	Gyatts.SendEventState(player)
	Remotes.Notify(player, "👋 Welcome to " .. Config.GameName .. "! Slap the Blobs and become the strongest!", { 255, 170, 220 })
	if data.TotalSlaps == 0 then
		Remotes.Popup(player, "WELCOME!", "Walk to the Baby Blob and click to slap it!", { 255, 170, 220 })
	end
end

local function onPlayerRemoving(player)
	requestBudget[player] = nil
	Duel.OnLeave(player)
	Trade.OnLeave(player)
	local profile = Data.RemoveProfile(player)
	if profile and profile.Loaded then
		profile.Data.PlayTime = profile.Data.PlayTime + math.floor(os.clock() - profile.JoinTime)
		Data.Save(profile)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

game:BindToClose(function()
	Data.SaveAllBlocking()
end)

print("[SlapTheBlob] Server v" .. Config.Version .. " started - have fun slapping!")
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">Combat</string><ProtectedString name="Source"><![CDATA[--[[
	Combat: jeder Slap wird hier auf dem Server geprueft und berechnet.
	  * Cooldown, Reichweite, freigeschaltete Zone
	  * Krit / Mega-Krit, Combo
	  * PvP in der Arena (Rueckstoss)
	  * Auto-Slap
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("SlapShared")
local Config = require(Shared:WaitForChild("Config"))
local Calc = require(Shared:WaitForChild("Calc"))

local Combat = {}
local ctx

local PVP_MAX_REACH = 12

local function getAliveRoot(player)
	local character = player.Character
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or humanoid.Health <= 0 then
		return nil
	end
	return root, humanoid
end

local function pvpSlap(player, profile, root)
	local reach = math.min(Calc.GetTotalReach(profile.Data), PVP_MAX_REACH)
	local best, bestDistance = nil, math.huge
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			local otherRoot = getAliveRoot(other)
			if otherRoot and ctx.World.IsInArena(otherRoot.Position) and not ctx.Duel.IsInDuel(other) then
				local distance = (otherRoot.Position - root.Position).Magnitude - 1.5
				if distance <= reach and distance < bestDistance then
					best, bestDistance = other, distance
				end
			end
		end
	end
	if best then
		ctx.Duel.Start(player, best)
	end
end

-- Gibt true zurueck, wenn geslappt wurde (fuer die Schwung-Animation)
function Combat.TrySlap(player, isAuto)
	local profile = ctx.Data.Get(player)
	if not profile then
		return false
	end
	local root = getAliveRoot(player)
	if not root then
		return false
	end

	local data = profile.Data
	local now = os.clock()
	local cooldown = Calc.GetTotalCooldown(data)
	if isAuto then
		cooldown = cooldown * Config.AutoSlapSlowdown
	end
	if now - profile.LastSlap < cooldown - 0.04 then
		return false
	end
	profile.LastSlap = now

	-- Duell laeuft: eigene Kampf-Regeln
	if profile.Duel then
		return ctx.Duel.Slap(player, profile, root)
	end
	-- In der Duell-Zone: einen anderen Spieler slappen startet ein Duell
	if ctx.World.IsInArena(root.Position) then
		pvpSlap(player, profile, root)
		return true
	end

	local target = ctx.Gyatts.FindTarget(root.Position, Calc.GetTotalReach(data), data.Zones)
	if not target then
		return true -- Luft-Slap
	end

	-- Combo
	if now - profile.LastHit <= Config.ComboWindow then
		profile.Combo = math.min(profile.Combo + 1, Calc.GetMaxCombo(data.Upgrades.Combo))
	else
		profile.Combo = 1
	end
	profile.LastHit = now

	local unixNow = os.time()
	local damage = Calc.GetDamage(data, unixNow)
	local critLevel = 0
	if math.random() < Calc.GetTotalCritChance(data) then
		critLevel = 1
		damage = damage * Config.CritMultiplier
		if math.random() < Config.MegaCritChance then
			critLevel = 2
			damage = damage * Config.MegaCritMultiplier
		end
	end

	-- Legendaere Hand-Kraefte
	local hand = Calc.GetHand(data.Hand)
	local special = nil
	if hand.Smite then
		profile.SmiteCount = (profile.SmiteCount or 0) + 1
		if profile.SmiteCount >= hand.Smite.Every then
			profile.SmiteCount = 0
			special = "Smite"
			damage = damage * hand.Smite.Multiplier
		end
	end
	-- Slaps werden aus dem normalen Schaden berechnet (SNAP toetet nur sofort,
	-- sonst wuerde ein SNAP auf ein Ziel mit riesigen Leben die Wirtschaft sprengen)
	local rewardDamage = damage
	if hand.Snap and not target.IsGolden and math.random() < hand.Snap then
		special = "Snap"
		damage = math.max(damage, math.ceil(target.Health))
	end

	local slapMultiplier = Calc.GetSlapMultiplier(data, unixNow) * Calc.GetComboMultiplier(profile.Combo)
	local reward = rewardDamage * target.RewardMultiplier * slapMultiplier
	reward = ctx.Data.AddSlaps(profile, math.max(1, reward))

	data.TotalSlaps = data.TotalSlaps + 1
	if profile.Combo > data.BestCombo then
		data.BestCombo = profile.Combo
	end
	ctx.Data.AddStat(profile, "Slaps", 1)
	ctx.Data.AddStat(profile, "BestCombo", profile.Combo)
	if critLevel > 0 then
		ctx.Data.AddStat(profile, "Crits", 1)
	end

	ctx.Remotes.FireAll("SlapFx", {
		Kind = "Gyatt",
		Key = target.Key,
		Position = target.Position,
		Radius = target.Radius,
		Damage = damage,
		Crit = critLevel,
		Reward = reward,
		Combo = profile.Combo,
		UserId = player.UserId,
		From = root.Position,
		Special = special,
	})

	-- Blitz trifft auch alle Gyatts in der Naehe
	local splashTargets = {}
	if special == "Smite" then
		for _, other in ipairs(ctx.Gyatts.List) do
			if other ~= target and other.Alive and other.ZoneIndex <= data.Zones
				and (other.Position - target.Position).Magnitude <= hand.Smite.Radius then
				table.insert(splashTargets, other)
			end
		end
	end

	ctx.Gyatts.Damage(target, player, damage)

	for _, other in ipairs(splashTargets) do
		if other.Alive then
			local splashReward = ctx.Data.AddSlaps(profile, math.max(1, damage * other.RewardMultiplier * slapMultiplier))
			ctx.Remotes.FireAll("SlapFx", {
				Kind = "Gyatt",
				Key = other.Key,
				Position = other.Position,
				Radius = other.Radius,
				Damage = damage,
				Crit = critLevel,
				Reward = splashReward,
				Combo = profile.Combo,
				UserId = player.UserId,
				From = target.Position,
				Special = "Smite",
			})
			ctx.Gyatts.Damage(other, player, damage)
		end
	end

	if not data.TutorialDone and data.TotalSlaps >= 10 then
		data.TutorialDone = true
		ctx.Remotes.Popup(player, "SUPER SLAP!", "Now buy upgrades in the 🛒 Shop!", { 255, 170, 220 })
		ctx.Data.Push(player, true)
	else
		ctx.Data.Push(player, false)
	end
	return true
end

local function startAutoSlap()
	task.spawn(function()
		while true do
			task.wait(0.1)
			for player, profile in pairs(ctx.Data.Profiles) do
				if profile.Loaded and profile.Data.AutoSlapOn and profile.Data.GemShop.AutoSlap >= 1 and ctx.Hands.IsEquipped(player) then
					local data = profile.Data
					local cooldown = Calc.GetTotalCooldown(data) * Config.AutoSlapSlowdown
					if os.clock() - profile.LastSlap >= cooldown then
						local root = getAliveRoot(player)
						if root and not ctx.World.IsInArena(root.Position)
							and ctx.Gyatts.FindTarget(root.Position, Calc.GetTotalReach(data), data.Zones) then
							if Combat.TrySlap(player, true) then
								ctx.Hands.Swing(player)
							end
						end
					end
				end
			end
		end
	end)
end

function Combat.Init(context)
	ctx = context
end

function Combat.Start()
	startAutoSlap()
end

return Combat
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">Data</string><ProtectedString name="Source"><![CDATA[--[[
	Data: Spielstaende laden, pruefen, speichern und an den Client senden.
]]

local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("SlapShared")
local Config = require(Shared:WaitForChild("Config"))
local Calc = require(Shared:WaitForChild("Calc"))

local Data = {}
Data.Profiles = {} -- [Player] = profile

local Remotes -- wird in Init gesetzt

local store = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[SlapTheBlob] DataStore not available: " .. tostring(result))
	end
end

--------------------------------------------------------------------------
-- Standardwerte & Pruefung
--------------------------------------------------------------------------
local SETTINGS = { "Sounds", "DamageNumbers", "Shake", "OtherPets" }
Data.SettingNames = SETTINGS

function Data.Default()
	local upgrades = {}
	for _, id in ipairs(Config.UpgradeOrder) do
		upgrades[id] = 0
	end
	local boosts = {}
	for _, id in ipairs(Config.BoostOrder) do
		boosts[id] = 0
	end
	local settings = {}
	for _, name in ipairs(SETTINGS) do
		settings[name] = true
	end
	return {
		Slaps = 0,
		Gems = 0,
		Rebirths = 0,
		TotalSlaps = 0,
		TotalEarned = 0,
		TotalDefeats = 0,
		BestCombo = 0,
		Upgrades = upgrades,
		Hand = Config.Hands[1].Id,
		OwnedHands = { [Config.Hands[1].Id] = true },
		Zones = 1,
		Pets = {},
		NextPetUid = 1,
		GemShop = { AutoSlap = 0, PetSlot = 0, Inventory = 0 },
		AutoSlapOn = false,
		Boosts = boosts,
		Daily = { Last = 0, Streak = 0 },
		Quests = { Day = -1, Progress = {}, Claimed = {} },
		Codes = {},
		Settings = settings,
		PlayTime = 0,
		TutorialDone = false,
		DuelWins = 0,
		TotalTrades = 0,
		Receipts = {}, -- bereits gutgeschriebene Robux-Kaeufe (PurchaseId -> Zeit)
		Items = {}, -- Accessoires: { Uid, Id, Level, Equipped }
		NextItemUid = 1,
	}
end

local function num(value, maxValue)
	value = tonumber(value)
	if not value or value ~= value or value == math.huge or value == -math.huge or value < 0 then
		return 0
	end
	value = math.floor(value)
	if maxValue and value > maxValue then
		value = maxValue
	end
	return value
end

function Data.Sanitize(raw)
	local data = Data.Default()
	if type(raw) ~= "table" then
		return data
	end

	data.Slaps = num(raw.Slaps)
	data.Gems = num(raw.Gems)
	data.Rebirths = num(raw.Rebirths, 100000)
	data.TotalSlaps = num(raw.TotalSlaps)
	data.TotalEarned = num(raw.TotalEarned)
	data.TotalDefeats = num(raw.TotalDefeats)
	data.BestCombo = num(raw.BestCombo)
	data.PlayTime = num(raw.PlayTime)
	data.DuelWins = num(raw.DuelWins)
	-- Items
	local seenItemUids, highestItemUid, equippedCategory = {}, 0, {}
	if type(raw.Items) == "table" then
		for _, item in ipairs(raw.Items) do
			if #data.Items >= Config.ItemInventory + 50 then
				break
			end
			if type(item) == "table" and type(item.Id) == "string" and Config.Items[item.Id] then
				local uid = num(item.Uid)
				if uid > 0 and not seenItemUids[uid] then
					seenItemUids[uid] = true
					highestItemUid = math.max(highestItemUid, uid)
					local category = Config.Items[item.Id].Category
					local equipped = item.Equipped == true and not equippedCategory[category]
					if equipped then
						equippedCategory[category] = true
					end
					table.insert(data.Items, { Uid = uid, Id = item.Id, Level = math.max(1, math.min(Config.ItemMaxLevel, num(item.Level))), Equipped = equipped })
				end
			end
		end
	end
	data.NextItemUid = math.max(num(raw.NextItemUid), highestItemUid + 1, 1)
	data.TotalTrades = num(raw.TotalTrades)
	if type(raw.Receipts) == "table" then
		local list = {}
		for purchaseId, time in pairs(raw.Receipts) do
			if type(purchaseId) == "string" then
				table.insert(list, { purchaseId, num(time) })
			end
		end
		table.sort(list, function(x, y)
			return x[2] > y[2]
		end)
		for i = 1, math.min(#list, 100) do
			data.Receipts[list[i][1]] = list[i][2]
		end
	end
	data.TutorialDone = raw.TutorialDone == true
	data.AutoSlapOn = raw.AutoSlapOn == true

	if type(raw.Upgrades) == "table" then
		for _, id in ipairs(Config.UpgradeOrder) do
			data.Upgrades[id] = Calc.ClampLevel(id, raw.Upgrades[id])
		end
	end

	if type(raw.OwnedHands) == "table" then
		for handId, owned in pairs(raw.OwnedHands) do
			if owned == true and Calc.IsHand(handId) and not Calc.IsRobuxHand(handId) then
				data.OwnedHands[handId] = true
			end
		end
	end
	-- Robux-Haende werden nach dem Laden ueber den Game Pass geprueft
	if type(raw.Hand) == "string" and (data.OwnedHands[raw.Hand] or Calc.IsRobuxHand(raw.Hand)) then
		data.Hand = raw.Hand
	end

	data.Zones = math.max(1, math.min(#Config.Zones, num(raw.Zones)))

	if type(raw.GemShop) == "table" then
		for _, item in ipairs(Config.GemShop) do
			if not item.Repeatable then
				data.GemShop[item.Id] = num(raw.GemShop[item.Id], #item.Prices)
			end
		end
	end

	-- Pets
	local maxPets = Calc.GetInventorySize(data)
	local slots = Calc.GetPetSlots(data)
	local equippedCount = 0
	local seenUids = {}
	local highestUid = 0
	if type(raw.Pets) == "table" then
		for _, pet in ipairs(raw.Pets) do
			if #data.Pets >= maxPets then
				break
			end
			if type(pet) == "table" and type(pet.Id) == "string" and Config.Pets[pet.Id] then
				local uid = num(pet.Uid)
				if uid > 0 and not seenUids[uid] then
					seenUids[uid] = true
					if uid > highestUid then
						highestUid = uid
					end
					local equipped = pet.Equipped == true and equippedCount < slots
					if equipped then
						equippedCount = equippedCount + 1
					end
					table.insert(data.Pets, { Uid = uid, Id = pet.Id, Equipped = equipped })
				end
			end
		end
	end
	data.NextPetUid = math.max(num(raw.NextPetUid), highestUid + 1, 1)

	if type(raw.Boosts) == "table" then
		for _, id in ipairs(Config.BoostOrder) do
			data.Boosts[id] = num(raw.Boosts[id])
		end
	end

	if type(raw.Daily) == "table" then
		data.Daily.Last = num(raw.Daily.Last)
		data.Daily.Streak = num(raw.Daily.Streak, #Config.DailyRewards)
	end

	if type(raw.Quests) == "table" then
		data.Quests.Day = tonumber(raw.Quests.Day) or -1
		for i = 1, Config.QuestsPerDay do
			data.Quests.Progress[i] = type(raw.Quests.Progress) == "table" and num(raw.Quests.Progress[i]) or 0
			data.Quests.Claimed[i] = type(raw.Quests.Claimed) == "table" and raw.Quests.Claimed[i] == true
		end
	end

	if type(raw.Codes) == "table" then
		for code, used in pairs(raw.Codes) do
			if type(code) == "string" and used == true then
				data.Codes[code] = true
			end
		end
	end

	if type(raw.Settings) == "table" then
		for _, name in ipairs(SETTINGS) do
			if type(raw.Settings[name]) == "boolean" then
				data.Settings[name] = raw.Settings[name]
			end
		end
	end

	return data
end

local function deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in pairs(value) do
		copy[k] = deepCopy(v)
	end
	return copy
end
Data.DeepCopy = deepCopy

--------------------------------------------------------------------------
-- Laden & Speichern
--------------------------------------------------------------------------
local function key(userId)
	return "Player_" .. tostring(userId)
end

function Data.Load(player)
	if not store then
		return true, Data.Default()
	end
	local attempts = RunService:IsStudio() and 1 or 3
	for attempt = 1, attempts do
		local ok, result = pcall(function()
			return store:GetAsync(key(player.UserId))
		end)
		if ok then
			return true, Data.Sanitize(result)
		end
		warn("[SlapTheBlob] Load failed (" .. attempt .. "/" .. attempts .. "): " .. tostring(result))
		if attempt < attempts then
			task.wait(2)
		end
	end
	return false, Data.Default()
end

function Data.Save(profile)
	if not store or not profile or not profile.CanSave then
		return false
	end
	local snapshot = deepCopy(profile.Data)
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			store:SetAsync(key(profile.UserId), snapshot)
		end)
		if ok then
			return true
		end
		warn("[SlapTheBlob] Save failed (" .. attempt .. "/3): " .. tostring(err))
		if attempt < 3 then
			task.wait(1)
		end
	end
	return false
end

function Data.HasStore()
	return store ~= nil
end

--------------------------------------------------------------------------
-- Profile
--------------------------------------------------------------------------
function Data.Get(player)
	local profile = Data.Profiles[player]
	if profile and profile.Loaded then
		return profile
	end
	return nil
end

function Data.CreateProfile(player)
	local profile = {
		Player = player,
		UserId = player.UserId,
		Data = Data.Default(),
		Loaded = false,
		CanSave = false,
		-- nur zur Laufzeit:
		LastSlap = 0,
		LastWarning = 0,
		Combo = 0,
		LastHit = 0,
		JoinTime = os.clock(),
		RobuxHands = {}, -- [HandId] = true (aus Game Pass, wird nie gespeichert)
		Leaderstats = nil,
	}
	Data.Profiles[player] = profile
	return profile
end

function Data.RemoveProfile(player)
	local profile = Data.Profiles[player]
	Data.Profiles[player] = nil
	return profile
end

--------------------------------------------------------------------------
-- Geld & Statistiken
--------------------------------------------------------------------------
function Data.AddSlaps(profile, amount)
	amount = math.floor(tonumber(amount) or 0)
	if amount <= 0 or amount ~= amount or amount == math.huge then
		return 0
	end
	profile.Data.Slaps = profile.Data.Slaps + amount
	profile.Data.TotalEarned = profile.Data.TotalEarned + amount
	return amount
end

function Data.AddGems(profile, amount)
	amount = math.floor(tonumber(amount) or 0)
	if amount <= 0 then
		return 0
	end
	profile.Data.Gems = profile.Data.Gems + amount
	return amount
end

function Data.AddBoost(profile, boostId, seconds)
	if not Config.Boosts[boostId] then
		return
	end
	local now = os.time()
	local current = tonumber(profile.Data.Boosts[boostId]) or 0
	if current < now then
		current = now
	end
	profile.Data.Boosts[boostId] = current + math.floor(seconds)
end

-- Stellt sicher, dass die Quests zum heutigen Tag gehoeren
function Data.RefreshQuests(profile)
	local today = Calc.GetDayNumber(os.time())
	local quests = profile.Data.Quests
	if quests.Day ~= today then
		quests.Day = today
		quests.Progress = {}
		quests.Claimed = {}
		for i = 1, Config.QuestsPerDay do
			quests.Progress[i] = 0
			quests.Claimed[i] = false
		end
		return true
	end
	return false
end

-- Quest-Fortschritt erhoehen. "BestCombo" zaehlt den Hoechstwert.
function Data.AddStat(profile, stat, amount)
	Data.RefreshQuests(profile)
	local quests = Calc.GetQuests(profile.Data.Quests.Day, profile.UserId)
	local changed = false
	for i, quest in ipairs(quests) do
		if quest.Stat == stat and not profile.Data.Quests.Claimed[i] then
			local before = profile.Data.Quests.Progress[i] or 0
			local after
			if stat == "BestCombo" then
				after = math.max(before, amount)
			else
				after = before + amount
			end
			if after > quest.Amount then
				after = quest.Amount
			end
			if after ~= before then
				profile.Data.Quests.Progress[i] = after
				changed = true
				if after >= quest.Amount and before < quest.Amount then
					Remotes.Notify(profile.Player, "📜 Quest complete: " .. quest.Text .. " - claim your reward!", { 255, 230, 120 })
				end
			end
		end
	end
	return changed
end

--------------------------------------------------------------------------
-- An den Client senden
--------------------------------------------------------------------------
local function updateLeaderstats(profile)
	if profile.Leaderstats then
		profile.Leaderstats.Slaps.Value = Calc.FormatNumber(profile.Data.Slaps)
		profile.Leaderstats.Rebirths.Value = profile.Data.Rebirths
		profile.Leaderstats.Gems.Value = profile.Data.Gems
	end
end

-- full = true: alles senden (nach Kaeufen). false: nur Zahlen (nach Slaps).
function Data.Push(player, full)
	local profile = Data.Get(player)
	if not profile then
		return
	end
	updateLeaderstats(profile)
	local payload
	if full then
		Data.RefreshQuests(profile)
		payload = deepCopy(profile.Data)
		payload.Full = true
		payload.RobuxHands = deepCopy(profile.RobuxHands)
	else
		local d = profile.Data
		payload = {
			Full = false,
			Slaps = d.Slaps,
			Gems = d.Gems,
			TotalSlaps = d.TotalSlaps,
			TotalEarned = d.TotalEarned,
			TotalDefeats = d.TotalDefeats,
			BestCombo = d.BestCombo,
			Quests = deepCopy(d.Quests),
		}
	end
	payload.ServerTime = os.time()
	Remotes.Fire("State", player, payload)
end

function Data.CreateLeaderstats(profile)
	local player = profile.Player
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"

	local slaps = Instance.new("StringValue")
	slaps.Name = "Slaps"
	slaps.Value = "0"
	slaps.Parent = folder

	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = folder

	local gems = Instance.new("IntValue")
	gems.Name = "Gems"
	gems.Parent = folder

	folder.Parent = player
	profile.Leaderstats = { Slaps = slaps, Rebirths = rebirths, Gems = gems }
end

function Data.Init(ctx)
	Remotes = ctx.Remotes
end

-- Alle 2 Minuten speichern
function Data.StartAutosave()
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveInterval)
			for _, profile in pairs(Data.Profiles) do
				if profile.Loaded then
					task.spawn(Data.Save, profile)
				end
			end
		end
	end)
end

function Data.SaveAllBlocking()
	local pending = 0
	for _, profile in pairs(Data.Profiles) do
		if profile.Loaded then
			pending = pending + 1
			task.spawn(function()
				Data.Save(profile)
				pending = pending - 1
			end)
		end
	end
	local started = os.clock()
	while pending > 0 and os.clock() - started < 25 do
		task.wait(0.1)
	end
end


return Data
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">Duel</string><ProtectedString name="Source"><![CDATA[--[[
	Duel: 1-gegen-1-Kaempfe.

	Wer in der Duell-Zone im Hub einen anderen Spieler slappt, startet ein
	Duell. Beide werden in eine freie schwebende Arena teleportiert.
	  * Leben (eigene Duell-Leben, nicht die Roblox-Gesundheit)
	  * 3-2-1-Countdown, danach 60 Sekunden Kampf
	  * Schaden haengt (gedeckelt) von der Hand-Staerke ab, Krits, Combo-Bonus
	  * Dash mit kurzer Unverwundbarkeit
	  * Rueckstoss wird staerker, je weniger Leben man hat -> Ring-Out moeglich
	  * Sieg: Gems + Duell-Sieg; nach Ablauf gewinnt, wer mehr Leben hat
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("SlapShared")
local Config = require(Shared:WaitForChild("Config"))
local Calc = require(Shared:WaitForChild("Calc"))

local Duel = {}
local ctx

local D = Config.Duel
local duels = {} -- aktive Duelle
local arenaInUse = {} -- [ArenaIndex] = Duel

local function getRoot(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or humanoid.Health <= 0 then
		return nil
	end
	return root
end

function Duel.IsInDuel(player)
	local profile = ctx.Data.Get(player)
	return profile ~= nil and profile.Duel ~= nil
end

local function other(duel, player)
	if duel.A == player then
		return duel.B
	end
	return duel.A
end

local function sendUpdate(duel)
	local now = os.clock()
	local timeLeft = 0
	if duel.FightStart then
		timeLeft = math.max(0, D.Duration - (now - duel.FightStart))
	end
	for _, player in ipairs({ duel.A, duel.B }) do
		local opponent = other(duel, player)
		local profile = ctx.Data.Get(player)
		ctx.Remotes.Fire("Duel", player, {
			Kind = "Update",
			MyHealth = duel.Health[player],
			TheirHealth = duel.Health[opponent],
			MaxHealth = D.Health,
			TimeLeft = timeLeft,
			Opponent = opponent.DisplayName,
			MyCombo = profile and profile.DuelCombo or 0,
		})
	end
end

-- Schaden eines Treffers aus der Hand-Staerke (log-skaliert und gedeckelt)
function Duel.GetHitDamage(data)
	local raw = Calc.GetDamage(data, os.time())
	local damage = D.BaseDamage + math.log10(math.max(1, raw)) * D.DamagePerPower
	return math.min(D.MaxDamage, damage)
end

local function teleportBack(player)
	local root = getRoot(player)
	if root and player.Character then
		local center = ctx.World.Arena.Center
		player.Character:PivotTo(CFrame.new(center + Vector3.new(ctx.World.Arena.Radius + 6, 4, 0)))
	end
end

local function finish(duel, winner, reason)
	if duel.Over then
		return
	end
	duel.Over = true
	for i, d in ipairs(duels) do
		if d == duel then
			table.remove(duels, i)
			break
		end
	end
	arenaInUse[duel.ArenaIndex] = nil

	for _, player in ipairs({ duel.A, duel.B }) do
		player:SetAttribute("InDuel", nil)
		local profile = ctx.Data.Get(player)
		if profile then
			profile.Duel = nil
			local result
			local gems
			if winner == nil then
				result = "Draw"
				gems = D.LoseGems
			elseif winner == player then
				result = "Win"
				gems = D.WinGems
				profile.Data.DuelWins = (profile.Data.DuelWins or 0) + 1
			else
				result = "Lose"
				gems = D.LoseGems
			end
			ctx.Data.AddGems(profile, gems)
			ctx.Remotes.Fire("Duel", player, { Kind = "End", Result = result, Gems = gems, Reason = reason })
			ctx.Data.Push(player, true)
			task.delay(2.5, function()
				if player.Parent and not (ctx.Data.Get(player) and ctx.Data.Get(player).Duel) then
					teleportBack(player)
				end
			end)
		end
	end
	if winner then
		ctx.Remotes.NotifyAll("⚔️ " .. winner.DisplayName .. " won a duel against " .. other(duel, winner).DisplayName .. "! (" .. reason .. ")", { 255, 200, 120 })
	end
end

function Duel.Start(a, b)
	local profileA, profileB = ctx.Data.Get(a), ctx.Data.Get(b)
	if not profileA or not profileB or profileA.Duel or profileB.Duel then
		return false
	end
	if ctx.Trade and (ctx.Trade.IsTrading(a) or ctx.Trade.IsTrading(b)) then
		return false
	end
	local arenaIndex = nil
	for i = 1, #ctx.World.DuelArenas do
		if not arenaInUse[i] then
			arenaIndex = i
			break
		end
	end
	if not arenaIndex then
		ctx.Remotes.Notify(a, "⚔️ All duel arenas are busy, try again in a moment!", { 255, 200, 120 })
		return false
	end
	local arena = ctx.World.DuelArenas[arenaIndex]
	local duel = {
		A = a,
		B = b,
		ArenaIndex = arenaIndex,
		Arena = arena,
		Health = { [a] = D.Health, [b] = D.Health },
		Started = os.clock(),
		FightStart = nil,
		Over = false,
	}
	arenaInUse[arenaIndex] = duel
	table.insert(duels, duel)
	profileA.Duel = duel
	profileB.Duel = duel
	profileA.DuelCombo, profileB.DuelCombo = 0, 0
	profileA.LastDuelHit, profileB.LastDuelHit = 0, 0
	profileA.DashUntil, profileB.DashUntil = 0, 0

	profileA.LastDash, profileB.LastDash = 0, 0
	for i, player in ipairs({ a, b }) do
		player:SetAttribute("InDuel", true)
		if player.Character then
			player.Character:PivotTo(arena.Spawns[i])
		end
		ctx.Remotes.Fire("Duel", player, {
			Kind = "Start",
			Opponent = other(duel, player).DisplayName,
			Countdown = D.Countdown,
			Duration = D.Duration,
			MaxHealth = D.Health,
		})
	end
	task.delay(D.Countdown, function()
		if not duel.Over then
			duel.FightStart = os.clock()
			sendUpdate(duel)
		end
	end)
	return true
end

-- Slap waehrend eines Duells. Gibt true zurueck, wenn ein Schlag ausgefuehrt wurde.
function Duel.Slap(player, profile, root)
	local duel = profile.Duel
	if not duel or duel.Over or not duel.FightStart then
		return false
	end
	local now = os.clock()
	if now - (profile.LastDuelSlap or 0) < D.AttackCooldown - 0.04 then
		return false
	end
	profile.LastDuelSlap = now

	local opponent = other(duel, player)
	local opponentProfile = ctx.Data.Get(opponent)
	local opponentRoot = getRoot(opponent)
	if not opponentProfile or not opponentRoot then
		return true
	end
	local distance = (opponentRoot.Position - root.Position).Magnitude
	if distance > D.Reach + 1.5 then
		return true -- daneben
	end
	if now < (opponentProfile.DashUntil or 0) then
		ctx.Remotes.FireAll("SlapFx", { Kind = "DuelDodge", Position = opponentRoot.Position, Radius = 2, UserId = player.UserId })
		return true -- ausgewichen
	end

	-- Combo
	if now - (profile.LastDuelHit or 0) <= D.ComboWindow then
		profile.DuelCombo = (profile.DuelCombo or 0) + 1
	else
		profile.DuelCombo = 0
	end
	profile.LastDuelHit = now

	local damage = Duel.GetHitDamage(profile.Data) * (1 + math.min(D.MaxComboBonus, profile.DuelCombo * D.ComboBonus))
	local crit = math.random() < D.CritChance
	if crit then
		damage = damage * D.CritMultiplier
	end
	-- Dash-Schlag: kurz nach einem Dash trifft man haerter
	local dashStrike = now - (profile.LastDash or 0) <= D.DashStrikeWindow
	if dashStrike then
		damage = damage * D.DashStrikeMultiplier
		profile.LastDash = profile.LastDash - D.DashStrikeWindow -- nur einmal pro Dash
	end
	damage = math.floor(damage * 10 + 0.5) / 10
	duel.Health[opponent] = math.max(0, duel.Health[opponent] - damage)

	-- Rueckstoss: staerker bei wenig Leben
	local missing = 1 - duel.Health[opponent] / D.Health
	local flat = opponentRoot.Position - root.Position
	flat = Vector3.new(flat.X, 0, flat.Z)
	if flat.Magnitude < 0.01 then
		flat = Vector3.new(0, 0, 1)
	end
	local strength = D.Knockback * (1 + missing * D.KnockbackGrowth) * (crit and 1.3 or 1) * (dashStrike and 1.4 or 1)
	ctx.Remotes.Fire("Knockback", opponent, flat.Unit * strength + Vector3.new(0, D.UpForce, 0), player.DisplayName)
	ctx.Remotes.FireAll("SlapFx", {
		Kind = "Duel",
		Position = opponentRoot.Position,
		Radius = 2,
		Damage = damage,
		Crit = crit and 1 or 0,
		UserId = player.UserId,
		TargetId = opponent.UserId,
		Combo = profile.DuelCombo,
		Special = dashStrike and "DashStrike" or nil,
	})
	ctx.Data.AddStat(profile, "PvpSlaps", 1)

	if duel.Health[opponent] <= 0 then
		finish(duel, player, "K.O.")
	else
		sendUpdate(duel)
	end
	return true
end

function Duel.Dash(player)
	local profile = ctx.Data.Get(player)
	if not profile or not profile.Duel or not profile.Duel.FightStart then
		return
	end
	local now = os.clock()
	if now - (profile.LastDash or 0) < D.DashCooldown - 0.1 then
		return
	end
	profile.LastDash = now
	profile.DashUntil = now + D.DashInvulnerable
	ctx.Remotes.Fire("Duel", player, { Kind = "DashOk", Cooldown = D.DashCooldown })
end

function Duel.OnLeave(player)
	local profile = ctx.Data.Profiles[player]
	local duel = profile and profile.Duel
	if duel and not duel.Over then
		finish(duel, other(duel, player), "opponent left")
	end
end

local function tick()
	local now = os.clock()
	for i = #duels, 1, -1 do
		local duel = duels[i]
		if duel and not duel.Over then
			local arenaY = duel.Arena.Center.Y
			local loser = nil
			local reason = nil
			for _, player in ipairs({ duel.A, duel.B }) do
				if not player.Parent then
					loser, reason = player, "opponent left"
				else
					local root = getRoot(player)
					if not root then
						loser, reason = player, "K.O."
					elseif root.Position.Y < arenaY - D.RingOutDepth then
						loser, reason = player, "RING OUT"
					end
				end
			end
			if loser then
				finish(duel, other(duel, loser), reason)
			elseif duel.FightStart and now - duel.FightStart >= D.Duration then
				local ha, hb = duel.Health[duel.A], duel.Health[duel.B]
				if ha > hb then
					finish(duel, duel.A, "time")
				elseif hb > ha then
					finish(duel, duel.B, "time")
				else
					finish(duel, nil, "time")
				end
			end
		end
	end
end

function Duel.Init(context)
	ctx = context
	ctx.RegisterAction("DuelDash", Duel.Dash)
end

function Duel.Run()
	task.spawn(function()
		local lastUpdate = 0
		while true do
			task.wait(0.1)
			local ok, err = pcall(tick)
			if not ok then
				warn("[SlapTheBlob] Duel tick: " .. tostring(err))
			end
			if os.clock() - lastUpdate > 1 then
				lastUpdate = os.clock()
				for _, duel in ipairs(duels) do
					if duel.FightStart and not duel.Over then
						sendUpdate(duel)
					end
				end
			end
		end
	end)
end

return Duel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">Gyatts</string><ProtectedString name="Source"><![CDATA[--[[
	Gyatts: baut die Gyatt-Modelle, verwaltet Leben, Besiegen, Respawn,
	Belohnungen und das "Goldener Blob"-Event.

	Animationen (Wackeln, Hinschauen, Gesicht) macht der Client.
]]

local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("SlapShared")
local Config = require(Shared:WaitForChild("Config"))
local Calc = require(Shared:WaitForChild("Calc"))

local Gyatts = {}
Gyatts.List = {} -- alle aktiven Gyatt-Objekte (auch tote, die gleich respawnen)
Gyatts.Golden = nil

local ctx -- Init
local storage -- Ablage fuer besiegte Gyatts

local function rgb(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

--------------------------------------------------------------------------
-- Modell bauen
--------------------------------------------------------------------------
local function detail(model, name, size, cframe, color, mat, shape)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = mat or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		p.Shape = shape
	end
	p.Parent = model
	return p
end


local function unit(x, y, z)
	return Vector3.new(x, y, z).Unit
end

-- Flaches Gesicht (Augen, Brauen, Mund) - fuer Wuerfel, Roboter, Golems usw.
-- cf zeigt mit -Z nach vorne, w = Breite des Gesichts
local function addFace(model, cf, w, eyeColor, pupilColor)
	local white = eyeColor or Color3.fromRGB(255, 255, 255)
	local black = pupilColor or Color3.fromRGB(25, 15, 25)
	for _, side in ipairs({ -1, 1 }) do
		detail(model, "EyeWhite", Vector3.new(w * 0.26, w * 0.26, w * 0.26), cf * CFrame.new(side * w * 0.22, w * 0.1, 0), white, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
		detail(model, "Pupil", Vector3.new(w * 0.13, w * 0.13, w * 0.13), cf * CFrame.new(side * w * 0.22, w * 0.1, -w * 0.1), black, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
		detail(model, "Brow", Vector3.new(w * 0.22, w * 0.045, w * 0.05), cf * CFrame.new(side * w * 0.22, w * 0.3, -w * 0.04) * CFrame.Angles(0, 0, math.rad(side * -12)), Color3.fromRGB(25, 15, 25))
	end
	for i = -1, 1 do
		detail(model, "MouthSmile", Vector3.new(w * 0.11, w * 0.045, w * 0.05), cf * CFrame.new(i * w * 0.1, -w * 0.18 + math.abs(i) * w * 0.04, -w * 0.02) * CFrame.Angles(0, 0, math.rad(i * 25)), Color3.fromRGB(25, 15, 25))
	end
	local mouthO = detail(model, "MouthO", Vector3.new(w * 0.15, w * 0.15, w * 0.08), cf * CFrame.new(0, -w * 0.18, -w * 0.02), Color3.fromRGB(120, 20, 50), Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	mouthO.Transparency = 1
end

local function makeBody(model, size, cframe, color, mat, shape)
	local body = Instance.new("Part")
	body.Name = "Body"
	body.Size = size
	body.CFrame = cframe
	body.Anchored = true
	body.CanCollide = true
	body.Color = color
	body.Material = mat or Enum.Material.SmoothPlastic
	body.TopSurface = Enum.SurfaceType.Smooth
	body.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		body.Shape = shape
	end
	body.Parent = model
	return body
end

local function oval(model, name, size, cframe, color, mat)
	local p = detail(model, name, size, cframe, color, mat)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

local function darker(c, amount)
	return Color3.new(math.clamp(c.R - amount, 0, 1), math.clamp(c.G - amount, 0, 1), math.clamp(c.B - amount, 0, 1))
end

local KIND_BUILDERS = {}

-- Blob: runder Koerper mit Gesicht, Fuessen und Accessoires
function KIND_BUILDERS.blob(model, spec, S, r, base)
	local body = Instance.new("Part")
	body.Name = "Body"
	body.Shape = Enum.PartType.Ball
	body.Size = Vector3.new(S, S, S)
	body.CFrame = base
	body.Anchored = true
	body.CanCollide = true
	body.Color = rgb(spec.Color)
	body.Material = spec.Material or Enum.Material.SmoothPlastic
	body.TopSurface = Enum.SurfaceType.Smooth
	body.BottomSurface = Enum.SurfaceType.Smooth
	body.Parent = model

	local function onSurface(direction, extra)
		return base * CFrame.new(direction * (r + (extra or 0)))
	end
	local function facing(position, outward)
		-- Teil, das von der Kugel nach aussen schaut
		local worldPos = (base * CFrame.new(position)).Position
		local worldOut = base:VectorToWorldSpace(outward)
		return CFrame.lookAt(worldPos, worldPos + worldOut)
	end

	local black = Color3.fromRGB(25, 15, 25)
	local white = Color3.fromRGB(255, 255, 255)

	-- kleine Fuesse
	for _, side in ipairs({ -1, 1 }) do
		local foot = detail(model, "Foot", Vector3.new(S * 0.3, S * 0.15, S * 0.38),
			base * CFrame.new(side * S * 0.22, -r * 0.97, -S * 0.05),
			Color3.new(math.clamp(body.Color.R - 0.18, 0, 1), math.clamp(body.Color.G - 0.18, 0, 1), math.clamp(body.Color.B - 0.18, 0, 1)), body.Material)
		local footMesh = Instance.new("SpecialMesh")
		footMesh.MeshType = Enum.MeshType.Sphere
		footMesh.Parent = foot
	end

	-- Augen
	for _, side in ipairs({ -1, 1 }) do
		local dir = unit(side * 0.34, 0.24, -0.91)
		detail(model, "EyeWhite", Vector3.new(S * 0.3, S * 0.3, S * 0.3), onSurface(dir, -S * 0.08), white, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
		detail(model, "Pupil", Vector3.new(S * 0.15, S * 0.15, S * 0.15), onSurface(dir, S * 0.02), black, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
		detail(model, "Shine", Vector3.new(S * 0.05, S * 0.05, S * 0.05), onSurface(unit(side * 0.34 + 0.05, 0.3, -0.9), S * 0.07), white, Enum.Material.Neon, Enum.PartType.Ball)
		-- Augenbraue
		local browDir = unit(side * 0.33, 0.5, -0.8)
		detail(model, "Brow", Vector3.new(S * 0.22, S * 0.045, S * 0.05),
			facing(browDir * (r + S * 0.01), browDir) * CFrame.Angles(0, 0, math.rad(side * -12)), black)
		-- Baeckchen
		local blush = detail(model, "Blush", Vector3.new(S * 0.13, S * 0.13, S * 0.13), onSurface(unit(side * 0.55, -0.05, -0.83), -S * 0.045),
			Color3.fromRGB(255, 110, 150), Enum.Material.SmoothPlastic, Enum.PartType.Ball)
		blush.Transparency = 0.25
	end

	-- Mund: Laecheln (3 Teile) und "O" (versteckt, Client zeigt es beim Treffer)
	for i = -1, 1 do
		local dir = unit(i * 0.13, -0.27 + math.abs(i) * 0.05, -0.95)
		detail(model, "MouthSmile", Vector3.new(S * 0.11, S * 0.045, S * 0.05),
			facing(dir * (r + S * 0.005), dir) * CFrame.Angles(0, 0, math.rad(i * 25)), black)
	end
	local mouthO = detail(model, "MouthO", Vector3.new(S * 0.16, S * 0.16, S * 0.16), onSurface(unit(0, -0.28, -0.96), -S * 0.06),
		Color3.fromRGB(120, 20, 50), Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	mouthO.Transparency = 1

	-- Accessoires
	local accessories = {}
	for _, a in ipairs(spec.Accessories or {}) do
		accessories[a] = true
	end

	if accessories.bow then
		local pink = Color3.fromRGB(255, 80, 150)
		local c = onSurface(unit(0.45, 0.85, 0), -S * 0.02)
		detail(model, "BowCenter", Vector3.new(S * 0.1, S * 0.1, S * 0.1), c, pink, nil, Enum.PartType.Ball)
		detail(model, "BowLeft", Vector3.new(S * 0.16, S * 0.16, S * 0.16), c * CFrame.new(-S * 0.1, S * 0.03, 0), pink, nil, Enum.PartType.Ball)
		detail(model, "BowRight", Vector3.new(S * 0.16, S * 0.16, S * 0.16), c * CFrame.new(S * 0.1, -S * 0.03, 0), pink, nil, Enum.PartType.Ball)
	end

	if accessories.glasses then
		for _, side in ipairs({ -1, 1 }) do
			local dir = unit(side * 0.34, 0.24, -0.91)
			local lens = detail(model, "Lens", Vector3.new(S * 0.3, S * 0.2, S * 0.04), facing(dir * (r + S * 0.09), dir), Color3.fromRGB(20, 20, 30), Enum.Material.Glass)
			lens.Transparency = 0.1
		end
		local bridgeDir = unit(0, 0.26, -0.96)
		detail(model, "Bridge", Vector3.new(S * 0.14, S * 0.03, S * 0.03), facing(bridgeDir * (r + S * 0.06), bridgeDir), Color3.fromRGB(20, 20, 30))
	end

	if accessories.cowboy then
		local brown = Color3.fromRGB(140, 90, 50)
		local top = base * CFrame.new(0, r * 0.92, 0)
		detail(model, "HatBrim", Vector3.new(S * 0.04, S * 0.95, S * 0.95), top * CFrame.Angles(0, 0, math.rad(90)), brown, Enum.Material.Fabric, Enum.PartType.Cylinder)
		detail(model, "HatTop", Vector3.new(S * 0.3, S * 0.5, S * 0.5), top * CFrame.new(0, S * 0.15, 0) * CFrame.Angles(0, 0, math.rad(90)), brown, Enum.Material.Fabric, Enum.PartType.Cylinder)
		detail(model, "HatBand", Vector3.new(S * 0.06, S * 0.52, S * 0.52), top * CFrame.new(0, S * 0.04, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(200, 40, 40), Enum.Material.Fabric, Enum.PartType.Cylinder)
	end

	if accessories.scarf then
		local red = Color3.fromRGB(220, 40, 60)
		for i = 0, 15 do
			local angle = (i / 16) * math.pi * 2
			local dir = Vector3.new(math.cos(angle) * 0.86, -0.5, math.sin(angle) * 0.86)
			detail(model, "Scarf", Vector3.new(S * 0.17, S * 0.17, S * 0.17), base * CFrame.new(dir * r), (i % 2 == 0) and red or Color3.fromRGB(255, 255, 255), Enum.Material.Fabric, Enum.PartType.Ball)
		end
	end

	if accessories.horns then
		for _, side in ipairs({ -1, 1 }) do
			local hornBase = onSurface(unit(side * 0.5, 0.82, 0), -S * 0.05)
			detail(model, "Horn", Vector3.new(S * 0.12, S * 0.32, S * 0.12), hornBase * CFrame.Angles(0, 0, math.rad(side * -25)) * CFrame.new(0, S * 0.12, 0), Color3.fromRGB(60, 20, 20), Enum.Material.Basalt)
			detail(model, "HornTip", Vector3.new(S * 0.08, S * 0.12, S * 0.08), hornBase * CFrame.Angles(0, 0, math.rad(side * -25)) * CFrame.new(0, S * 0.32, 0), Color3.fromRGB(255, 120, 20), Enum.Material.Neon)
		end
	end

	if accessories.halo then
		local gold = Color3.fromRGB(255, 230, 100)
		for i = 0, 17 do
			local angle = (i / 18) * math.pi * 2
			detail(model, "Halo", Vector3.new(S * 0.08, S * 0.08, S * 0.08), base * CFrame.new(math.cos(angle) * r * 0.55, r * 1.3, math.sin(angle) * r * 0.55), gold, Enum.Material.Neon, Enum.PartType.Ball)
		end
	end

	if accessories.antenna then
		for _, side in ipairs({ -1, 1 }) do
			local start = base * CFrame.new(side * r * 0.35, r * 0.88, 0)
			detail(model, "AntennaStick", Vector3.new(S * 0.04, S * 0.4, S * 0.04), start * CFrame.Angles(0, 0, math.rad(side * -20)) * CFrame.new(0, S * 0.18, 0), Color3.fromRGB(60, 60, 70), Enum.Material.Metal)
			detail(model, "AntennaBall", Vector3.new(S * 0.12, S * 0.12, S * 0.12), start * CFrame.Angles(0, 0, math.rad(side * -20)) * CFrame.new(0, S * 0.4, 0), Color3.fromRGB(120, 255, 120), Enum.Material.Neon, Enum.PartType.Ball)
		end
	end

	if accessories.crown then
		local gold = Color3.fromRGB(255, 200, 40)
		local top = base * CFrame.new(0, r * (accessories.cowboy and 1.25 or 0.9), 0)
		detail(model, "CrownBase", Vector3.new(S * 0.14, S * 0.45, S * 0.45), top * CFrame.Angles(0, 0, math.rad(90)), gold, Enum.Material.Foil, Enum.PartType.Cylinder)
		for i = 0, 4 do
			local angle = (i / 5) * math.pi * 2
			local spikePos = top * CFrame.new(math.cos(angle) * S * 0.19, S * 0.13, math.sin(angle) * S * 0.19)
			detail(model, "CrownSpike", Vector3.new(S * 0.07, S * 0.16, S * 0.07), spikePos, gold, Enum.Material.Foil)
			detail(model, "CrownGem", Vector3.new(S * 0.06, S * 0.06, S * 0.06), spikePos * CFrame.new(0, S * 0.1, 0),
				(i % 2 == 0) and Color3.fromRGB(255, 40, 80) or Color3.fromRGB(60, 160, 255), Enum.Material.Neon, Enum.PartType.Ball)
		end
	end

	return body
end

-- Schleim-Wuerfel: durchsichtiger Wuerfel mit leuchtendem Kern
function KIND_BUILDERS.cube(model, spec, S, r, base)
	local color = rgb(spec.Color)
	local body = makeBody(model, Vector3.new(S, S, S), base, color, Enum.Material.Glass)
	body.Transparency = 0.25
	detail(model, "Core", Vector3.new(S * 0.45, S * 0.45, S * 0.45), base, darker(color, 0.25), Enum.Material.Neon, Enum.PartType.Ball)
	for _, offset in ipairs({ { -0.3, 0.3 }, { 0.25, -0.25 }, { 0.35, 0.35 } }) do
		oval(model, "Drip", Vector3.new(S * 0.18, S * 0.12, S * 0.18), base * CFrame.new(offset[1] * S, S * 0.52, offset[2] * S), color, Enum.Material.Glass)
	end
	addFace(model, base * CFrame.new(0, S * 0.05, -S * 0.5 - 0.02), S * 0.8)
	return body
end

-- Trainings-Dummy: Strohsack mit Zielscheibe auf einem Pfosten
function KIND_BUILDERS.dummy(model, spec, S, r, base)
	local sack = rgb(spec.Color)
	local body = makeBody(model, Vector3.new(S, S * 0.72, S * 0.72), base * CFrame.Angles(0, 0, math.rad(90)), sack, Enum.Material.Fabric, Enum.PartType.Cylinder)
	local front = -S * 0.36 - 0.04
	local ringColors = { { 0.62, Color3.fromRGB(220, 40, 50) }, { 0.44, Color3.fromRGB(255, 255, 255) }, { 0.26, Color3.fromRGB(220, 40, 50) } }
	for i, ring in ipairs(ringColors) do
		detail(model, "TargetRing", Vector3.new(0.06, S * ring[1], S * ring[1]), base * CFrame.new(0, -S * 0.05, front - i * 0.03) * CFrame.Angles(0, math.rad(90), 0),
			ring[2], Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
	end
	local headCf = base * CFrame.new(0, S * 0.68, 0)
	detail(model, "Head", Vector3.new(S * 0.48, S * 0.48, S * 0.48), headCf, sack, Enum.Material.Fabric, Enum.PartType.Ball)
	addFace(model, headCf * CFrame.new(0, 0, -S * 0.24), S * 0.36)
	detail(model, "Arms", Vector3.new(S * 1.4, S * 0.14, S * 0.14), base * CFrame.new(0, S * 0.22, 0) * CFrame.Angles(0, 0, 0), darker(sack, 0.08), Enum.Material.Fabric)
	detail(model, "Post", Vector3.new(S * 0.14, S * 0.5, S * 0.14), base * CFrame.new(0, -S * 0.6, 0), Color3.fromRGB(110, 70, 40), Enum.Material.Wood)
	detail(model, "Stand", Vector3.new(S * 0.08, S * 0.7, S * 0.7), base * CFrame.new(0, -S * 0.83, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(110, 70, 40), Enum.Material.Wood, Enum.PartType.Cylinder)
	return body
end

-- Roboter: Kasten-Koerper, Kopf mit Visier, Antenne, Arme, Beine
function KIND_BUILDERS.robot(model, spec, S, r, base)
	local metal = rgb(spec.Color)
	local body = makeBody(model, Vector3.new(S * 0.8, S * 0.62, S * 0.6), base * CFrame.new(0, -S * 0.05, 0), metal, Enum.Material.DiamondPlate)
	local headCf = base * CFrame.new(0, S * 0.45, 0)
	detail(model, "Head", Vector3.new(S * 0.6, S * 0.42, S * 0.52), headCf, metal, Enum.Material.Metal)
	detail(model, "Visor", Vector3.new(S * 0.5, S * 0.2, S * 0.04), headCf * CFrame.new(0, S * 0.03, -S * 0.27), Color3.fromRGB(20, 20, 30), Enum.Material.Glass)
	addFace(model, headCf * CFrame.new(0, S * 0.02, -S * 0.3), S * 0.5, Color3.fromRGB(0, 255, 230), Color3.fromRGB(0, 120, 255))
	detail(model, "Antenna", Vector3.new(S * 0.04, S * 0.25, S * 0.04), headCf * CFrame.new(0, S * 0.32, 0), Color3.fromRGB(60, 60, 70), Enum.Material.Metal)
	detail(model, "AntennaLight", Vector3.new(S * 0.1, S * 0.1, S * 0.1), headCf * CFrame.new(0, S * 0.46, 0), Color3.fromRGB(255, 60, 60), Enum.Material.Neon, Enum.PartType.Ball)
	detail(model, "ChestLight", Vector3.new(S * 0.2, S * 0.2, S * 0.04), base * CFrame.new(0, 0, -S * 0.31), Color3.fromRGB(0, 255, 230), Enum.Material.Neon, Enum.PartType.Ball)
	for _, side in ipairs({ -1, 1 }) do
		detail(model, "Arm", Vector3.new(S * 0.16, S * 0.5, S * 0.16), base * CFrame.new(side * S * 0.52, -S * 0.08, 0) * CFrame.Angles(0, 0, math.rad(side * 12)), darker(metal, 0.1), Enum.Material.Metal)
		detail(model, "Claw", Vector3.new(S * 0.2, S * 0.12, S * 0.2), base * CFrame.new(side * S * 0.58, -S * 0.36, 0), Color3.fromRGB(255, 200, 40), Enum.Material.Metal)
		detail(model, "Leg", Vector3.new(S * 0.18, S * 0.3, S * 0.2), base * CFrame.new(side * S * 0.2, -S * 0.5, 0), darker(metal, 0.15), Enum.Material.Metal)
		detail(model, "Foot", Vector3.new(S * 0.26, S * 0.08, S * 0.32), base * CFrame.new(side * S * 0.2, -S * 0.66, -S * 0.04), darker(metal, 0.25), Enum.Material.Metal)
	end
	return body
end

-- Geist: leuchtend, halb durchsichtig, wehender Schweif
function KIND_BUILDERS.ghost(model, spec, S, r, base)
	local color = rgb(spec.Color)
	local body = makeBody(model, Vector3.new(S, S, S), base, color, Enum.Material.Neon, Enum.PartType.Ball)
	body.Transparency = 0.25
	for i = -1, 1 do
		local tail = detail(model, "Tail", Vector3.new(S * 0.36, S * 0.36, S * 0.36), base * CFrame.new(i * S * 0.28, -S * 0.5, 0), color, Enum.Material.Neon, Enum.PartType.Ball)
		tail.Transparency = 0.35
	end
	for _, side in ipairs({ -1, 1 }) do
		oval(model, "EyeWhite", Vector3.new(S * 0.16, S * 0.26, S * 0.08), base * CFrame.new(side * S * 0.17, S * 0.1, -S * 0.46), Color3.fromRGB(20, 10, 30), Enum.Material.SmoothPlastic)
	end
	local mouthO = oval(model, "MouthO", Vector3.new(S * 0.16, S * 0.2, S * 0.08), base * CFrame.new(0, -S * 0.12, -S * 0.46), Color3.fromRGB(20, 10, 30), Enum.Material.SmoothPlastic)
	mouthO.Transparency = 0
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = S * 2
	light.Brightness = 1.5
	light.Parent = body
	return body
end

-- Golem: Fels-Koerper mit leuchtenden Kristallen
function KIND_BUILDERS.golem(model, spec, S, r, base)
	local crystal = rgb(spec.Color)
	local rock = Color3.fromRGB(90, 85, 95)
	local body = makeBody(model, Vector3.new(S * 0.9, S * 0.9, S * 0.9), base, rock, Enum.Material.Slate, Enum.PartType.Ball)
	addFace(model, base * CFrame.new(0, S * 0.08, -S * 0.43), S * 0.6, crystal, Color3.fromRGB(255, 255, 255))
	local rng = Random.new(#spec.Key * 31)
	for i = 1, 6 do
		local angle = rng:NextNumber(-1.2, 1.2)
		local tilt = rng:NextNumber(-0.6, 0.6)
		local h = S * rng:NextNumber(0.3, 0.5)
		detail(model, "Crystal", Vector3.new(h * 0.35, h, h * 0.35),
			base * CFrame.Angles(tilt, angle, 0) * CFrame.new(0, S * 0.42, S * 0.12) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), 0, rng:NextNumber(-0.3, 0.3)),
			crystal, Enum.Material.Neon)
	end
	for _, side in ipairs({ -1, 1 }) do
		detail(model, "Fist", Vector3.new(S * 0.36, S * 0.36, S * 0.36), base * CFrame.new(side * S * 0.55, -S * 0.15, -S * 0.05), rock, Enum.Material.Slate, Enum.PartType.Ball)
		detail(model, "FootRock", Vector3.new(S * 0.3, S * 0.2, S * 0.36), base * CFrame.new(side * S * 0.22, -S * 0.46, 0), darker(rock, 0.1), Enum.Material.Slate)
	end
	return body
end

-- Schatzkiste: gibt viele Gems
function KIND_BUILDERS.chest(model, spec, S, r, base)
	local wood = rgb(spec.Color)
	local gold = Color3.fromRGB(255, 200, 40)
	local body = makeBody(model, Vector3.new(S, S * 0.6, S * 0.7), base * CFrame.new(0, -S * 0.15, 0), wood, Enum.Material.WoodPlanks)
	detail(model, "Lid", Vector3.new(S * 1.04, S * 0.32, S * 0.74), base * CFrame.new(0, S * 0.32, 0), darker(wood, 0.05), Enum.Material.WoodPlanks)
	for _, x in ipairs({ -0.38, 0.38 }) do
		detail(model, "Band", Vector3.new(S * 0.08, S * 0.95, S * 0.76), base * CFrame.new(x * S, 0, 0), gold, Enum.Material.Foil)
	end
	detail(model, "Lock", Vector3.new(S * 0.16, S * 0.2, S * 0.08), base * CFrame.new(0, S * 0.1, -S * 0.38), gold, Enum.Material.Foil)
	local shine = Instance.new("Sparkles")
	shine.SparkleColor = gold
	shine.Parent = body
	return body
end

-- Pinata: bunter Esel aus Papierstreifen, laesst Items fallen
function KIND_BUILDERS.pinata(model, spec, S, r, base)
	local main = rgb(spec.Color)
	local stripes = { main, Color3.fromRGB(255, 220, 70), Color3.fromRGB(80, 200, 255), Color3.fromRGB(255, 110, 180), Color3.fromRGB(120, 230, 120) }
	local body = makeBody(model, Vector3.new(S * 0.95, S * 0.5, S * 0.5), base * CFrame.Angles(0, math.rad(90), 0), main, Enum.Material.Fabric)
	for i = 0, 4 do
		detail(model, "Stripe", Vector3.new(S * 0.52, S * 0.52, S * 0.1), base * CFrame.new(0, 0, (i - 2) * S * 0.18), stripes[i + 1], Enum.Material.Fabric)
	end
	local headCf = base * CFrame.new(0, S * 0.35, -S * 0.5)
	detail(model, "Head", Vector3.new(S * 0.36, S * 0.4, S * 0.36), headCf, stripes[2], Enum.Material.Fabric)
	detail(model, "Snout", Vector3.new(S * 0.28, S * 0.2, S * 0.24), headCf * CFrame.new(0, -S * 0.08, -S * 0.22), stripes[4], Enum.Material.Fabric)
	addFace(model, headCf * CFrame.new(0, S * 0.04, -S * 0.19), S * 0.34)
	for _, side in ipairs({ -1, 1 }) do
		detail(model, "Ear", Vector3.new(S * 0.08, S * 0.3, S * 0.1), headCf * CFrame.new(side * S * 0.12, S * 0.3, 0) * CFrame.Angles(0, 0, math.rad(side * -15)), stripes[3], Enum.Material.Fabric)
		for _, front in ipairs({ -1, 1 }) do
			detail(model, "Leg", Vector3.new(S * 0.14, S * 0.4, S * 0.14), base * CFrame.new(side * S * 0.16, -S * 0.42, front * S * 0.3), stripes[(side + front + 4) % 5 + 1], Enum.Material.Fabric)
		end
	end
	detail(model, "Tail", Vector3.new(S * 0.08, S * 0.08, S * 0.35), base * CFrame.new(0, S * 0.1, S * 0.6) * CFrame.Angles(math.rad(-30), 0, 0), stripes[5], Enum.Material.Fabric)
	detail(model, "Rope", Vector3.new(S * 0.04, S * 0.8, S * 0.04), base * CFrame.new(0, S * 0.65, 0), Color3.fromRGB(150, 110, 60), Enum.Material.Fabric)
	local confetti = Instance.new("Sparkles")
	confetti.SparkleColor = Color3.fromRGB(255, 220, 90)
	confetti.Parent = body
	return body
end

local function buildModel(spec)
	local S = spec.Size
	local r = S / 2
	local base = spec.BaseCFrame -- Mitte des Koerpers, Vorderseite = -Z
	local model = Instance.new("Model")
	model.Name = "Gyatt_" .. spec.Key

	local kind = spec.Kind or "blob"
	local builder = KIND_BUILDERS[kind] or KIND_BUILDERS.blob
	local body = builder(model, spec, S, r, base)

	-- Umriss
	local highlight = Instance.new("Highlight")
	highlight.Name = "Outline"
	highlight.FillTransparency = 1
	highlight.FillColor = Color3.fromRGB(255, 255, 255)
	highlight.OutlineColor = Color3.fromRGB(40, 15, 40)
	highlight.OutlineTransparency = 0.1
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Enabled = false -- der Client schaltet nur nahe Ziele ein (max. 31 Highlights moeglich)
	highlight.Adornee = model
	highlight.Parent = model

	-- Sound
	local sound = Instance.new("Sound")
	sound.Name = "SlapSound"
	sound.SoundId = "rbxasset://sounds/swordslash.wav"
	sound.Volume = 0.7
	sound.RollOffMaxDistance = 120
	sound.Parent = body

	-- Name + Lebensbalken
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "InfoGui"
	billboard.Adornee = body
	billboard.Size = UDim2.new(math.max(12, S * 1.3), 0, 4, 0)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, r + 3.5, 0)
	billboard.MaxDistance = 220
	billboard.LightInfluence = 0
	billboard.Parent = body

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "NameLabel"
	nameLabel.Size = UDim2.fromScale(1, 0.5)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Font = Enum.Font.FredokaOne
	nameLabel.TextScaled = true
	nameLabel.TextColor3 = spec.NameColor or Color3.fromRGB(255, 255, 255)
	nameLabel.TextStrokeTransparency = 0
	nameLabel.Text = spec.DisplayName
	nameLabel.Parent = billboard

	local barBack = Instance.new("Frame")
	barBack.Name = "HealthBack"
	barBack.Position = UDim2.fromScale(0, 0.55)
	barBack.Size = UDim2.fromScale(1, 0.42)
	barBack.BackgroundColor3 = Color3.fromRGB(40, 0, 20)
	barBack.BorderSizePixel = 0
	barBack.Parent = billboard
	local backCorner = Instance.new("UICorner")
	backCorner.CornerRadius = UDim.new(0.5, 0)
	backCorner.Parent = barBack
	local backStroke = Instance.new("UIStroke")
	backStroke.Thickness = 2
	backStroke.Color = Color3.fromRGB(20, 0, 10)
	backStroke.Parent = barBack

	local barFill = Instance.new("Frame")
	barFill.Name = "HealthFill"
	barFill.Size = UDim2.fromScale(1, 1)
	barFill.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	barFill.BorderSizePixel = 0
	barFill.Parent = barBack
	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(0.5, 0)
	fillCorner.Parent = barFill
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new(Color3.fromRGB(255, 60, 140), Color3.fromRGB(255, 160, 80))
	gradient.Parent = barFill

	local hpText = Instance.new("TextLabel")
	hpText.Name = "HealthText"
	hpText.Size = UDim2.fromScale(1, 1)
	hpText.BackgroundTransparency = 1
	hpText.Font = Enum.Font.GothamBold
	hpText.TextScaled = true
	hpText.TextColor3 = Color3.fromRGB(255, 255, 255)
	hpText.TextStrokeTransparency = 0.2
	hpText.ZIndex = 2
	hpText.Parent = barBack

	model.PrimaryPart = body
	-- beim Streaming (Standard in neuen Spielen) immer das ganze Modell auf einmal laden
	pcall(function()
		model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	end)
	model:SetAttribute("Key", spec.Key)
	model:SetAttribute("BaseCFrame", base)
	model:SetAttribute("Size", S)
	model:SetAttribute("ZoneIndex", spec.ZoneIndex)
	model:SetAttribute("Kind", kind)
	if kind == "chest" then
		model:SetAttribute("NoTurn", true)
	elseif kind == "ghost" then
		model:SetAttribute("Float", true)
	end
	CollectionService:AddTag(model, "SlapGyatt")

	return model, body, barFill, hpText, sound
end

--------------------------------------------------------------------------
-- Gyatt-Objekte
--------------------------------------------------------------------------
local function updateGui(g)
	local ratio = math.clamp(g.Health / g.MaxHealth, 0, 1)
	g.HealthFill.Size = UDim2.fromScale(ratio, 1)
	g.HealthText.Text = Calc.FormatNumber(math.ceil(g.Health)) .. " / " .. Calc.FormatNumber(g.MaxHealth)
end

local function createGyatt(spec)
	local model, body, fill, text, sound = buildModel(spec)
	local g = {
		Key = spec.Key,
		DisplayName = spec.DisplayName,
		ZoneIndex = spec.ZoneIndex,
		MaxHealth = spec.MaxHealth,
		Health = spec.MaxHealth,
		RewardMultiplier = spec.RewardMultiplier,
		DefeatBonus = spec.DefeatBonus,
		Gems = spec.Gems,
		Radius = spec.Size / 2,
		Position = spec.BaseCFrame.Position,
		Model = model,
		Body = body,
		HealthFill = fill,
		HealthText = text,
		Sound = sound,
		Alive = true,
		Contributors = {},
		IsGolden = spec.IsGolden == true,
		IsBoss = spec.IsBoss == true,
		Kind = spec.Kind or "blob",
		Respawn = spec.Respawn or Config.GyattRespawnTime,
	}
	updateGui(g)
	model.Parent = ctx.World.GyattFolder
	table.insert(Gyatts.List, g)
	return g
end

local function removeFromList(g)
	for i, other in ipairs(Gyatts.List) do
		if other == g then
			table.remove(Gyatts.List, i)
			return
		end
	end
end

function Gyatts.BuildAll()
	storage = Instance.new("Folder")
	storage.Name = "SlapDefeatedGyatts"
	storage.Parent = ServerStorage

	for zoneIndex, zone in ipairs(Config.Zones) do
		local zoneInfo = ctx.World.Zones[zoneIndex]
		for gyattIndex, cfg in ipairs(zone.Gyatts) do
			local spot = zoneInfo.GyattSpots[gyattIndex]
			local heightFactor = 0.56
			if cfg.Kind == "ghost" then
				heightFactor = 1.0
			elseif cfg.Kind == "chest" then
				heightFactor = 0.45
			elseif cfg.Kind == "dummy" then
				heightFactor = 0.9
			elseif cfg.Kind == "pinata" then
				heightFactor = 0.62
			end
			createGyatt({
				Key = Calc.GetGyattKey(zoneIndex, gyattIndex),
				DisplayName = cfg.DisplayName,
				ZoneIndex = zoneIndex,
				MaxHealth = cfg.MaxHealth,
				Size = cfg.Size,
				Color = cfg.Color,
				Accessories = cfg.Accessories,
				RewardMultiplier = cfg.RewardMultiplier,
				DefeatBonus = math.floor(cfg.MaxHealth * cfg.RewardMultiplier * 0.25),
				Gems = cfg.Gems,
				Kind = cfg.Kind,
				Respawn = cfg.Respawn,
				IsBoss = gyattIndex == 2,
				BaseCFrame = CFrame.new(spot.Position + Vector3.new(0, 0.4 + cfg.Size * heightFactor, 0)),
			})
		end
	end
end

-- Naechster lebender Gyatt in Reichweite, den der Spieler schlagen darf
function Gyatts.FindTarget(position, reach, unlockedZones)
	local best, bestDistance = nil, math.huge
	for _, g in ipairs(Gyatts.List) do
		if g.Alive and g.ZoneIndex <= unlockedZones then
			local distance = (g.Position - position).Magnitude - g.Radius
			if distance <= reach and distance < bestDistance then
				best = g
				bestDistance = distance
			end
		end
	end
	return best
end

local function rewardContributors(g, killer)
	for userId in pairs(g.Contributors) do
		local player = Players:GetPlayerByUserId(userId)
		local profile = player and ctx.Data.Get(player)
		if profile then
			local multiplier = Calc.GetSlapMultiplier(profile.Data, os.time())
			local bonus = ctx.Data.AddSlaps(profile, g.DefeatBonus * multiplier)
			local gemAmount = g.Gems or 0
			if gemAmount > 0 then
				gemAmount = gemAmount * (1 + Calc.GetItemBonuses(profile.Data).Gems)
			end
			local gems = ctx.Data.AddGems(profile, gemAmount)
			profile.Data.TotalDefeats = profile.Data.TotalDefeats + 1
			ctx.Data.AddStat(profile, "Defeats", 1)
			if g.Kind == "chest" then
				ctx.Data.AddStat(profile, "Chests", 1)
			end
			if ctx.Items then
				local ok, err = pcall(ctx.Items.RollDrop, player, profile, g)
				if not ok then
					warn("[SlapTheBlob] Item drop failed: " .. tostring(err))
				end
			end
			local text = "🎉 " .. g.DisplayName .. " defeated!  +" .. Calc.FormatNumber(bonus) .. " Slaps"
			if gems > 0 then
				text = text .. "  +" .. gems .. " 💎"
			end
			ctx.Remotes.Notify(player, text, { 120, 255, 140 })
			ctx.Data.Push(player, false)
		end
	end
	g.Contributors = {}
	if g.IsGolden and killer then
		ctx.Remotes.NotifyAll("⭐ " .. killer.DisplayName .. " defeated the GOLDEN BLOB! ⭐", { 255, 215, 0 })
	end
end

local function defeat(g, killer)
	g.Alive = false
	g.Health = 0
	updateGui(g)

	local explosion = Instance.new("Explosion")
	explosion.BlastPressure = 0
	explosion.BlastRadius = 0
	explosion.DestroyJointRadiusPercent = 0
	explosion.Position = g.Position
	explosion.Parent = workspace

	ctx.Remotes.FireAll("Defeat", g.Key, g.Position, g.Radius, g.IsGolden)
	rewardContributors(g, killer)

	if g.IsGolden then
		Gyatts.EndGolden(true)
		return
	end

	g.Model.Parent = storage
	task.delay(g.Respawn, function()
		g.Health = g.MaxHealth
		g.Alive = true
		g.Contributors = {}
		updateGui(g)
		g.Model.Parent = ctx.World.GyattFolder
	end)
end

-- Schaden zufuegen. Gibt true zurueck, wenn der Gyatt dadurch besiegt wurde.
function Gyatts.Damage(g, player, damage)
	if not g.Alive then
		return false
	end
	g.Contributors[player.UserId] = true
	g.Health = g.Health - damage
	g.Sound.PlaybackSpeed = 0.9 + math.random() * 0.3
	g.Sound:Play()
	if g.Health <= 0 then
		defeat(g, player)
		return true
	end
	updateGui(g)
	return false
end

--------------------------------------------------------------------------
-- Goldener Gyatt
--------------------------------------------------------------------------
Gyatts.GoldenState = { Active = false, ZoneIndex = 0, EndsAt = 0 }

function Gyatts.SendEventState(player)
	local state = Gyatts.GoldenState
	if state.Active then
		ctx.Remotes.Fire("Event", player, "GoldenStart", state.ZoneIndex, state.EndsAt)
	end
end

function Gyatts.EndGolden(defeated)
	local g = Gyatts.Golden
	if not g then
		return
	end
	Gyatts.Golden = nil
	Gyatts.GoldenState.Active = false
	g.Alive = false
	removeFromList(g)
	g.Model:Destroy()
	ctx.Remotes.FireAll("Event", "GoldenEnd", defeated == true)
	if not defeated then
		ctx.Remotes.NotifyAll("⭐ The Golden Blob escaped... next time!", { 255, 200, 120 })
	end
end

function Gyatts.SpawnGolden(zoneIndex)
	if Gyatts.Golden then
		return
	end
	local zone = Config.Zones[zoneIndex]
	local zoneInfo = ctx.World.Zones[zoneIndex]
	if not zone or not zoneInfo then
		return
	end
	local golden = Config.GoldenGyatt
	-- staerkstes Ziel der Zone (nicht die Schatzkiste)
	local bigGyatt = zone.Gyatts[1]
	for _, target in ipairs(zone.Gyatts) do
		if target.Kind ~= "chest" and target.MaxHealth > bigGyatt.MaxHealth then
			bigGyatt = target
		end
	end
	local maxHealth = math.floor(bigGyatt.MaxHealth * golden.HealthFactor)
	local g = createGyatt({
		Key = "Golden",
		DisplayName = golden.DisplayName,
		ZoneIndex = zoneIndex,
		MaxHealth = maxHealth,
		Size = golden.Size,
		Color = golden.Color,
		Material = Enum.Material.Foil,
		NameColor = Color3.fromRGB(255, 220, 60),
		Accessories = { "crown", "glasses" },
		RewardMultiplier = bigGyatt.RewardMultiplier * golden.RewardFactor,
		DefeatBonus = math.floor(maxHealth * bigGyatt.RewardMultiplier * golden.RewardFactor * 0.25),
		Gems = golden.Gems,
		IsGolden = true,
		BaseCFrame = CFrame.new(zoneInfo.GoldenSpot.Position + Vector3.new(0, 0.4 + golden.Size * 0.56, 0)),
	})
	local sparkles = Instance.new("Sparkles")
	sparkles.SparkleColor = Color3.fromRGB(255, 230, 120)
	sparkles.Parent = g.Body
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 220, 100)
	light.Range = 30
	light.Brightness = 3
	light.Parent = g.Body

	Gyatts.Golden = g
	local endsAt = os.time() + golden.Duration
	Gyatts.GoldenState = { Active = true, ZoneIndex = zoneIndex, EndsAt = endsAt }
	ctx.Remotes.FireAll("Event", "GoldenStart", zoneIndex, endsAt)
	ctx.Remotes.NotifyAll("⭐ A GOLDEN BLOB appeared in Zone " .. zoneIndex .. " (" .. zone.Name .. ")! ⭐", { 255, 215, 0 })

	task.delay(golden.Duration, function()
		if Gyatts.Golden == g then
			Gyatts.EndGolden(false)
		end
	end)
end

local function startGoldenLoop()
	task.spawn(function()
		local rng = Random.new()
		while true do
			task.wait(rng:NextInteger(Config.GoldenGyatt.MinInterval, Config.GoldenGyatt.MaxInterval))
			-- Zone: zufaellig bis zur hoechsten Zone, die ein Spieler hier hat
			local highest = 0
			for _, player in ipairs(Players:GetPlayers()) do
				local profile = ctx.Data.Get(player)
				if profile and profile.Data.Zones > highest then
					highest = profile.Data.Zones
				end
			end
			if highest > 0 and not Gyatts.Golden then
				Gyatts.SpawnGolden(rng:NextInteger(1, highest))
			end
		end
	end)
end

function Gyatts.Init(context)
	ctx = context
end

function Gyatts.Start()
	Gyatts.BuildAll()
	startGoldenLoop()
end

return Gyatts
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">Hands</string><ProtectedString name="Source"><![CDATA[--[[
	Hands: baut das Slap-Hand-Tool (Aussehen je nach Hand + Staerke-Level)
	und gibt es dem Spieler.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("SlapShared")
local Calc = require(Shared:WaitForChild("Calc"))

local Hands = {}
Hands.ToolName = "Slap Hand"

local ctx

local function rgb(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

local function material(name)
	local ok, result = pcall(function()
		return Enum.Material[name]
	end)
	if ok and result then
		return result
	end
	return Enum.Material.SmoothPlastic
end

local function handPart(name, size, color, mat, shape)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = mat
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true
	p.Anchored = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		p.Shape = shape
	end
	return p
end

function Hands.Build(data)
	local powerLevel = data.Upgrades.Power
	local hand = Calc.GetHand(data.Hand)
	local scale = Calc.GetHandScale(powerLevel)
	if hand.Effect == "thanos" then
		scale = scale * 1.25
	elseif hand.Effect == "ultragod" then
		scale = scale * 1.5
	end
	local color = rgb(hand.Color)
	local mat = material(hand.Material)

	local tool = Instance.new("Tool")
	tool.Name = Hands.ToolName
	tool.ToolTip = hand.DisplayName .. " (x" .. hand.Damage .. " Damage) - click to slap!"
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool:SetAttribute("HandId", hand.Id)
	tool:SetAttribute("PowerLevel", powerLevel)

	local palm = handPart("Handle", Vector3.new(1.4, 1.5, 0.55) * scale, color, mat)
	palm.CFrame = CFrame.new()
	palm.Parent = tool

	local parts = { palm }
	local function attach(p, offset)
		p.CFrame = palm.CFrame * offset
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = palm
		weld.Part1 = p
		weld.Parent = p
		p.Parent = tool
		table.insert(parts, p)
		return p
	end

	-- Finger mit Fingerkuppen
	local fingerXs = { -0.51, -0.17, 0.17, 0.51 }
	local fingerLengths = { 0.8, 1.0, 0.95, 0.75 }
	for i, x in ipairs(fingerXs) do
		local length = fingerLengths[i] * scale
		attach(handPart("Finger" .. i, Vector3.new(0.3 * scale, length, 0.45 * scale), color, mat),
			CFrame.new(x * scale, 0.75 * scale + length / 2, 0))
		attach(handPart("Tip" .. i, Vector3.new(0.3 * scale, 0.3 * scale, 0.3 * scale), color, mat, Enum.PartType.Ball),
			CFrame.new(x * scale, 0.75 * scale + length, 0))
	end
	-- Daumen
	attach(handPart("Thumb", Vector3.new(0.35 * scale, 0.75 * scale, 0.45 * scale), color, mat),
		CFrame.new(0.85 * scale, 0.05 * scale, 0) * CFrame.Angles(0, 0, math.rad(-35)))
	-- Armband in Kontrastfarbe
	attach(handPart("Cuff", Vector3.new(1.55 * scale, 0.35 * scale, 0.7 * scale), Color3.fromRGB(255, 110, 180), Enum.Material.Neon),
		CFrame.new(0, -0.8 * scale, 0))

	-- Effekte
	if hand.Effect == "sparkles" then
		local s = Instance.new("Sparkles")
		s.SparkleColor = color
		s.Parent = palm
	elseif hand.Effect == "fire" then
		local f = Instance.new("Fire")
		f.Size = 3 * scale
		f.Heat = 4
		f.Color = color
		f.SecondaryColor = Color3.fromRGB(255, 240, 120)
		f.Parent = palm
	elseif hand.Effect == "smoke" then
		local s = Instance.new("Smoke")
		s.Size = 1.5 * scale
		s.Opacity = 0.12
		s.RiseVelocity = 1
		s.Color = Color3.fromRGB(220, 240, 255)
		s.Parent = palm
	elseif hand.Effect == "rainbow" then
		for _, p in ipairs(parts) do
			if p.Name ~= "Cuff" then
				CollectionService:AddTag(p, "RainbowHand")
			end
		end
		local s = Instance.new("Sparkles")
		s.Parent = palm
	end
	if hand.Effect == "dragon" then
		-- schwarze Krallen an den Fingerspitzen
		for i, x in ipairs(fingerXs) do
			local length = fingerLengths[i] * scale
			attach(handPart("Claw" .. i, Vector3.new(0.18 * scale, 0.45 * scale, 0.18 * scale), Color3.fromRGB(20, 15, 15), Enum.Material.SmoothPlastic),
				CFrame.new(x * scale, 0.75 * scale + length + 0.3 * scale, -0.08 * scale) * CFrame.Angles(math.rad(-25), 0, 0))
		end
		local f = Instance.new("Fire")
		f.Size = 4 * scale
		f.Heat = 6
		f.Color = Color3.fromRGB(255, 60, 20)
		f.SecondaryColor = Color3.fromRGB(120, 0, 0)
		f.Parent = palm
	elseif hand.Effect == "thanos" then
		-- Die sechs Infinity-Steine
		local stones = {
			{ 160, 60, 255 }, -- Power
			{ 60, 140, 255 }, -- Space
			{ 255, 40, 40 }, -- Reality
			{ 255, 150, 30 }, -- Soul
			{ 40, 230, 90 }, -- Time
			{ 255, 230, 40 }, -- Mind
		}
		for i = 1, 4 do
			local x = fingerXs[i]
			local c = stones[i]
			local stone = attach(handPart("Stone" .. i, Vector3.new(0.24 * scale, 0.24 * scale, 0.24 * scale), Color3.fromRGB(c[1], c[2], c[3]), Enum.Material.Neon, Enum.PartType.Ball),
				CFrame.new(x * scale, 0.6 * scale, -0.3 * scale))
			stone.Name = "InfinityStone" .. i
		end
		local thumbStone = stones[5]
		attach(handPart("InfinityStone5", Vector3.new(0.24 * scale, 0.24 * scale, 0.24 * scale), Color3.fromRGB(thumbStone[1], thumbStone[2], thumbStone[3]), Enum.Material.Neon, Enum.PartType.Ball),
			CFrame.new(0.95 * scale, 0.2 * scale, -0.25 * scale))
		local mindStone = stones[6]
		attach(handPart("InfinityStone6", Vector3.new(0.42 * scale, 0.42 * scale, 0.42 * scale), Color3.fromRGB(mindStone[1], mindStone[2], mindStone[3]), Enum.Material.Neon, Enum.PartType.Ball),
			CFrame.new(0, -0.05 * scale, -0.3 * scale))
		local f = Instance.new("Fire")
		f.Size = 4 * scale
		f.Heat = 5
		f.Color = Color3.fromRGB(150, 60, 255)
		f.SecondaryColor = Color3.fromRGB(255, 200, 60)
		f.Parent = palm
		local s = Instance.new("Sparkles")
		s.SparkleColor = Color3.fromRGB(200, 120, 255)
		s.Parent = palm
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(170, 90, 255)
		light.Range = 14
		light.Brightness = 2
		light.Parent = palm
	elseif hand.Effect == "ultragod" then
		-- Regenbogen-Heiligenschein ums Handgelenk
		for i = 0, 9 do
			local angle = (i / 10) * math.pi * 2
			local orb = attach(handPart("HaloOrb" .. i, Vector3.new(0.28 * scale, 0.28 * scale, 0.28 * scale), Color3.fromRGB(255, 255, 255), Enum.Material.Neon, Enum.PartType.Ball),
				CFrame.new(math.cos(angle) * 1.15 * scale, -0.8 * scale, math.sin(angle) * 1.15 * scale))
			CollectionService:AddTag(orb, "RainbowHand")
		end
		-- goldene Kristalle auf den Knoecheln
		for i, x in ipairs(fingerXs) do
			attach(handPart("GodGem" .. i, Vector3.new(0.2 * scale, 0.32 * scale, 0.2 * scale), Color3.fromRGB(255, 215, 60), Enum.Material.Neon),
				CFrame.new(x * scale, 0.6 * scale, -0.32 * scale) * CFrame.Angles(0, math.rad(45), 0))
		end
		local f = Instance.new("Fire")
		f.Size = 6 * scale
		f.Heat = 9
		f.Color = Color3.fromRGB(255, 240, 160)
		f.SecondaryColor = Color3.fromRGB(255, 160, 255)
		f.Parent = palm
		local s = Instance.new("Sparkles")
		s.SparkleColor = Color3.fromRGB(255, 255, 200)
		s.Parent = palm
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 245, 200)
		light.Range = 22
		light.Brightness = 4
		light.Parent = palm
	end
	if hand.Effect == "aura" or hand.Effect == "omni" then
		local f = Instance.new("Fire")
		f.Size = 3 * scale
		f.Heat = 5
		f.Color = color
		f.SecondaryColor = Color3.fromRGB(255, 255, 255)
		f.Parent = palm
		local glowLight = Instance.new("PointLight")
		glowLight.Color = color
		glowLight.Range = 12
		glowLight.Brightness = 2
		glowLight.Parent = palm
	end
	if hand.Effect == "electric" then
		local s = Instance.new("Sparkles")
		s.SparkleColor = Color3.fromRGB(255, 255, 150)
		s.Parent = palm
		for i, x in ipairs(fingerXs) do
			attach(handPart("Bolt" .. i, Vector3.new(0.08 * scale, 0.5 * scale, 0.08 * scale), Color3.fromRGB(255, 255, 200), Enum.Material.Neon),
				CFrame.new(x * scale, 0.75 * scale + fingerLengths[i] * scale + 0.35 * scale, 0) * CFrame.Angles(0, 0, math.rad((i % 2 == 0) and 25 or -25)))
		end
	elseif hand.Effect == "shadow" then
		local smoke = Instance.new("Smoke")
		smoke.Size = 2 * scale
		smoke.Opacity = 0.25
		smoke.RiseVelocity = 2
		smoke.Color = Color3.fromRGB(80, 30, 120)
		smoke.Parent = palm
	elseif hand.Effect == "orbit" or hand.Effect == "omni" then
		for i = 0, 7 do
			local angle = (i / 8) * math.pi * 2
			local orb = attach(handPart("Orb" .. i, Vector3.new(0.26 * scale, 0.26 * scale, 0.26 * scale), color, Enum.Material.Neon, Enum.PartType.Ball),
				CFrame.new(math.cos(angle) * 1.1 * scale, 0.2 * scale, math.sin(angle) * 1.1 * scale))
			if hand.Effect == "omni" then
				CollectionService:AddTag(orb, "RainbowHand")
			end
		end
		if hand.Effect == "omni" then
			for _, p in ipairs(parts) do
				if p.Name ~= "Cuff" then
					CollectionService:AddTag(p, "RainbowHand")
				end
			end
		end
	end
	-- Schweif beim Schlagen (in der Farbe der Hand)
	local trailTop = Instance.new("Attachment")
	trailTop.Name = "TrailTop"
	trailTop.Position = Vector3.new(0, 0.9 * scale, 0)
	trailTop.Parent = palm
	local trailBottom = Instance.new("Attachment")
	trailBottom.Name = "TrailBottom"
	trailBottom.Position = Vector3.new(0, -0.6 * scale, 0)
	trailBottom.Parent = palm
	local trail = Instance.new("Trail")
	trail.Name = "SlapTrail"
	trail.Attachment0 = trailTop
	trail.Attachment1 = trailBottom
	trail.Lifetime = 0.18
	trail.MinLength = 0.1
	trail.FaceCamera = true
	trail.LightEmission = 0.6
	trail.Color = ColorSequence.new(color, Color3.fromRGB(255, 255, 255))
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 1) })
	trail.Parent = palm

	if hand.Material == "Neon" then
		local light = Instance.new("PointLight")
		light.Color = color
		light.Range = 8
		light.Brightness = 1
		light.Parent = palm
	end

	-- Griff: Handflaeche nach vorne, Finger nach oben
	local baseGrip = CFrame.new(0, 0, -0.45 * scale) * CFrame.Angles(math.rad(-90), 0, 0)
	tool.Grip = baseGrip
	tool:SetAttribute("BaseGrip", baseGrip)

	tool.Activated:Connect(function()
		local player = ctx.Players:GetPlayerFromCharacter(tool.Parent)
		if not player then
			return
		end
		if ctx.Combat.TrySlap(player) then
			Hands.SwingTool(tool)
		end
	end)

	return tool
end

local function removeHands(player)
	local containers = { player:FindFirstChildOfClass("Backpack"), player.Character }
	for _, container in ipairs(containers) do
		if container then
			for _, child in ipairs(container:GetChildren()) do
				if child:IsA("Tool") and child.Name == Hands.ToolName then
					child:Destroy()
				end
			end
		end
	end
end

-- Gibt dem Spieler eine neue Hand. Ausgeruestet, wenn sie es vorher war
-- (oder forceEquip gesetzt ist).
function Hands.Give(player, forceEquip)
	local profile = ctx.Data.Get(player)
	if not profile then
		return
	end
	local character = player.Character
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not character or not backpack then
		return
	end
	local current = character:FindFirstChildOfClass("Tool")
	local wasEquipped = current ~= nil and current.Name == Hands.ToolName

	removeHands(player)
	local tool = Hands.Build(profile.Data)
	tool.Parent = backpack

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 and (wasEquipped or forceEquip) then
		humanoid:EquipTool(tool)
	end
end

-- Hat der Spieler die Hand gerade in der Hand?
function Hands.IsEquipped(player)
	local character = player.Character
	if not character then
		return false
	end
	local tool = character:FindFirstChildOfClass("Tool")
	return tool ~= nil and tool.Name == Hands.ToolName
end

-- Kurze Schwung-Animation ueber den Griff
function Hands.SwingTool(tool)
	local base = tool:GetAttribute("BaseGrip")
	if typeof(base) ~= "CFrame" then
		return
	end
	local swingId = (tool:GetAttribute("SwingId") or 0) + 1
	tool:SetAttribute("SwingId", swingId)
	tool.Grip = base * CFrame.Angles(math.rad(75), 0, 0)
	task.delay(0.1, function()
		if tool.Parent and tool:GetAttribute("SwingId") == swingId then
			tool.Grip = base
		end
	end)
end

-- Schwung fuer Auto-Slap
function Hands.Swing(player)
	local character = player.Character
	local tool = character and character:FindFirstChildOfClass("Tool")
	if tool and tool.Name == Hands.ToolName then
		Hands.SwingTool(tool)
	end
end

function Hands.Init(context)
	ctx = context
end

return Hands
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">Items</string><ProtectedString name="Source"><![CDATA[--[[
	Items: Accessoires (Huete, Fluegel/Ruecken, Auren).
	  * Inventar, Ausruesten (eins pro Kategorie), Loeschen
	  * Verschmelzen: 3 gleiche Items mit gleicher Stufe -> 1 Item mit +1 Stern
	  * Drops beim Besiegen von Zielen (jede Art hat ihre eigene Chance)
	  * Kisten fuer Slaps, Gems oder Robux
	  * Aussehen am Charakter + Werte (Laufgeschwindigkeit, Sprungkraft)
]]

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("SlapShared")
local Config = require(Shared:WaitForChild("Config"))
local Calc = require(Shared:WaitForChild("Calc"))

local Items = {}
local ctx
local rng = Random.new()

local RED = { 255, 120, 120 }
local GREEN = { 120, 255, 140 }

local function random01()
	return rng:NextNumber()
end

local function findItem(data, uid)
	for i, item in ipairs(data.Items) do
		if item.Uid == uid then
			return item, i
		end
	end
	return nil
end

-- Item geben (auch ueber dem Limit, damit gekaufte Items nie verloren gehen)
function Items.Give(profile, itemId, level)
	if not Config.Items[itemId] then
		return nil
	end
	local item = { Uid = profile.Data.NextItemUid, Id = itemId, Level = level or 1, Equipped = false }
	profile.Data.NextItemUid = profile.Data.NextItemUid + 1
	table.insert(profile.Data.Items, item)
	return item
end

--------------------------------------------------------------------------
-- Aussehen am Charakter
--------------------------------------------------------------------------
local function newPart(model, name, size, color, mat, shape)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = mat
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.Anchored = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape == "Oval" then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	elseif shape then
		p.Shape = shape
	end
	p.Parent = model
	return p
end

local function rgb(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

local function material(name)
	local ok, result = pcall(function()
		return Enum.Material[name]
	end)
	return (ok and result) or Enum.Material.SmoothPlastic
end

local BALL, CYL = Enum.PartType.Ball, Enum.PartType.Cylinder
local UPRIGHT = CFrame.Angles(0, 0, math.rad(90)) -- Zylinder aufrecht stellen

-- Baut ein Accessoire. anchor = CFrame am Charakter, add(name, size, offset, shape, colorOverride)
local function buildForm(item, add)
	local form = item.Form
	if form == "cone" or form == "wizard" then
		for i = 0, 3 do
			add("Cone" .. i, Vector3.new(0.5, 1.5 - i * 0.35, 1.5 - i * 0.35), CFrame.new(0, 0.25 + i * 0.45, 0) * UPRIGHT, CYL)
		end
		add("Tip", Vector3.new(0.4, 0.4, 0.4), CFrame.new(0, 2.1, 0), BALL, form == "cone" and Color3.fromRGB(255, 255, 255) or nil)
		if form == "wizard" then
			add("Brim", Vector3.new(0.12, 2.6, 2.6), CFrame.new(0, 0.05, 0) * UPRIGHT, CYL)
		end
	elseif form == "cap" then
		add("Dome", Vector3.new(1.35, 0.7, 1.35), CFrame.new(0, 0.15, 0), "Oval")
		add("Visor", Vector3.new(1.2, 0.1, 0.8), CFrame.new(0, 0.05, -0.75), nil)
	elseif form == "beanie" then
		add("Dome", Vector3.new(1.4, 0.9, 1.4), CFrame.new(0, 0.2, 0), "Oval")
		add("Pom", Vector3.new(0.45, 0.45, 0.45), CFrame.new(0, 0.7, 0), BALL, Color3.fromRGB(255, 255, 255))
	elseif form == "tophat" then
		add("Brim", Vector3.new(0.12, 2, 2), CFrame.new(0, 0.05, 0) * UPRIGHT, CYL)
		add("Tube", Vector3.new(1.4, 1.2, 1.2), CFrame.new(0, 0.75, 0) * UPRIGHT, CYL)
		add("Band", Vector3.new(0.25, 1.24, 1.24), CFrame.new(0, 0.3, 0) * UPRIGHT, CYL, Color3.fromRGB(200, 30, 50))
	elseif form == "brim" then
		add("Brim", Vector3.new(0.12, 2.6, 2.6), CFrame.new(0, 0.05, 0) * UPRIGHT, CYL)
		add("Crown", Vector3.new(0.8, 1.3, 1.3), CFrame.new(0, 0.45, 0) * UPRIGHT, CYL)
	elseif form == "chef" then
		add("Base", Vector3.new(0.8, 1.3, 1.3), CFrame.new(0, 0.4, 0) * UPRIGHT, CYL)
		add("Puff", Vector3.new(1.7, 1.1, 1.7), CFrame.new(0, 1.05, 0), "Oval")
	elseif form == "ears_long" then
		for _, side in ipairs({ -1, 1 }) do
			add("Ear", Vector3.new(0.35, 1.5, 0.2), CFrame.new(side * 0.35, 0.8, 0) * CFrame.Angles(0, 0, side * -0.15), "Oval")
		end
	elseif form == "ears_cat" then
		for _, side in ipairs({ -1, 1 }) do
			add("Ear", Vector3.new(0.45, 0.55, 0.2), CFrame.new(side * 0.42, 0.3, 0) * CFrame.Angles(0, 0, side * -0.4), nil)
		end
	elseif form == "horns" then
		for _, side in ipairs({ -1, 1 }) do
			add("Horn", Vector3.new(0.9, 0.3, 0.3), CFrame.new(side * 0.7, 0.2, 0) * CFrame.Angles(0, 0, side * 0.9) * UPRIGHT, CYL)
		end
		add("Helmet", Vector3.new(1.3, 0.6, 1.3), CFrame.new(0, 0, 0), "Oval")
	elseif form == "antlers" then
		for _, side in ipairs({ -1, 1 }) do
			add("Antler", Vector3.new(1, 0.15, 0.15), CFrame.new(side * 0.45, 0.45, 0) * CFrame.Angles(0, 0, side * -1) * UPRIGHT, CYL)
			add("Branch", Vector3.new(0.5, 0.12, 0.12), CFrame.new(side * 0.75, 0.75, 0) * CFrame.Angles(0, 0, side * 0.3) * UPRIGHT, CYL)
		end
	elseif form == "band" then
		add("Band", Vector3.new(0.25, 1.32, 1.32), CFrame.new(0, -0.35, 0) * UPRIGHT, CYL)
		add("Knot", Vector3.new(0.3, 0.3, 0.6), CFrame.new(0, -0.35, 0.75), nil)
	elseif form == "ring" then
		for i = 0, 9 do
			local a = (i / 10) * math.pi * 2
			add("Flower", Vector3.new(0.35, 0.35, 0.35), CFrame.new(math.cos(a) * 0.62, -0.05, math.sin(a) * 0.62), BALL,
				(i % 2 == 0) and nil or Color3.fromRGB(255, 255, 140))
		end
	elseif form == "helm" then
		add("Helm", Vector3.new(1.45, 1.35, 1.45), CFrame.new(0, -0.35, 0), "Oval")
		add("Visor", Vector3.new(1, 0.15, 0.1), CFrame.new(0, -0.4, -0.72), nil, Color3.fromRGB(30, 30, 35))
	elseif form == "dome" then
		local dome = add("Dome", Vector3.new(1.9, 1.9, 1.9), CFrame.new(0, -0.55, 0), BALL)
		dome.Transparency = 0.55
	elseif form == "crown" then
		add("Ring", Vector3.new(0.35, 1.25, 1.25), CFrame.new(0, 0.1, 0) * UPRIGHT, CYL)
		for i = 0, 4 do
			local a = (i / 5) * math.pi * 2
			add("Spike", Vector3.new(0.18, 0.45, 0.18), CFrame.new(math.cos(a) * 0.5, 0.45, math.sin(a) * 0.5), nil)
			add("Gem", Vector3.new(0.16, 0.16, 0.16), CFrame.new(math.cos(a) * 0.5, 0.72, math.sin(a) * 0.5), BALL, Color3.fromRGB(255, 60, 120))
		end
	elseif form == "halo" then
		for i = 0, 13 do
			local a = (i / 14) * math.pi * 2
			add("Halo", Vector3.new(0.22, 0.22, 0.22), CFrame.new(math.cos(a) * 0.7, 0.7, math.sin(a) * 0.7), BALL)
		end
	-- Ruecken
	elseif form == "backpack" then
		add("Pack", Vector3.new(1.3, 1.4, 0.7), CFrame.new(0, 0, 0.35), nil)
		add("Flap", Vector3.new(1.32, 0.45, 0.72), CFrame.new(0, 0.55, 0.36), nil, Color3.fromRGB(255, 220, 80))
	elseif form == "cape" then
		add("Cape", Vector3.new(1.8, 2.6, 0.12), CFrame.new(0, -0.6, 0.25) * CFrame.Angles(math.rad(10), 0, 0), nil)
	elseif form == "jetpack" then
		for _, side in ipairs({ -1, 1 }) do
			add("Tank", Vector3.new(1.4, 0.55, 0.55), CFrame.new(side * 0.35, 0, 0.45) * UPRIGHT, CYL)
			add("Nozzle", Vector3.new(0.3, 0.4, 0.4), CFrame.new(side * 0.35, -0.8, 0.45) * UPRIGHT, CYL, Color3.fromRGB(60, 60, 70))
		end
	elseif form == "wings_round" or form == "wings_feather" or form == "wings_bat" then
		for _, side in ipairs({ -1, 1 }) do
			if form == "wings_round" then
				add("WingTop", Vector3.new(1.8, 1.4, 0.1), CFrame.new(side * 1.1, 0.5, 0.35) * CFrame.Angles(0, side * -0.3, side * -0.3), "Oval")
				add("WingLow", Vector3.new(1.2, 1, 0.1), CFrame.new(side * 0.9, -0.5, 0.35) * CFrame.Angles(0, side * -0.3, side * 0.3), "Oval")
			elseif form == "wings_feather" then
				for f = 0, 2 do
					add("Feather" .. f, Vector3.new(2.2 - f * 0.4, 0.45, 0.12), CFrame.new(side * (1.1 + f * 0.05), 0.6 - f * 0.45, 0.35) * CFrame.Angles(0, side * -0.25, side * (0.35 - f * 0.25)), "Oval")
				end
			else
				add("Wing", Vector3.new(2.2, 1.3, 0.1), CFrame.new(side * 1.2, 0.3, 0.35) * CFrame.Angles(0, side * -0.3, side * -0.35), nil)
				add("Tip", Vector3.new(0.6, 0.6, 0.12), CFrame.new(side * 2.2, 0.75, 0.35) * CFrame.Angles(0, 0, side * 0.8), nil)
			end
		end
	end
end

local AURA_TAG = "SlapItemVisual"

local function clearVisuals(character)
	for _, child in ipairs(character:GetDescendants()) do
		if CollectionService:HasTag(child, AURA_TAG) then
			child:Destroy()
		end
	end
end

local function addEffect(target, item, color)
	if item.Effect == "fire" then
		local f = Instance.new("Fire")
		f.Size = 2
		f.Heat = 3
		f.Color = color
		f.Parent = target
		CollectionService:AddTag(f, AURA_TAG)
	elseif item.Effect == "smoke" then
		local s = Instance.new("Smoke")
		s.Size = 1
		s.Opacity = 0.15
		s.Color = color
		s.Parent = target
		CollectionService:AddTag(s, AURA_TAG)
	elseif item.Effect == "sparkles" or item.Effect == "rainbow" then
		local s = Instance.new("Sparkles")
		s.SparkleColor = color
		s.Parent = target
		CollectionService:AddTag(s, AURA_TAG)
	end
end

local function attachItem(character, item)
	local color = rgb(item.Color)
	local mat = material(item.Material)
	if item.Category == "Aura" then
		local root = character:FindFirstChild("HumanoidRootPart")
		if not root then
			return
		end
		local attachment = Instance.new("Attachment")
		attachment.Name = "AuraAttachment"
		attachment.Parent = root
		CollectionService:AddTag(attachment, AURA_TAG)
		local emitter = Instance.new("ParticleEmitter")
		emitter.Rate = 12
		emitter.Lifetime = NumberRange.new(1, 1.8)
		emitter.Speed = NumberRange.new(1, 3)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.LightEmission = 0.7
		emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
		if item.Effect == "rainbow" then
			emitter.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
				ColorSequenceKeypoint.new(0.5, Color3.fromRGB(80, 255, 120)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(120, 120, 255)),
			})
		else
			emitter.Color = ColorSequence.new(color)
		end
		emitter.Parent = attachment
		local light = Instance.new("PointLight")
		light.Color = color
		light.Range = 8
		light.Brightness = 1
		light.Parent = attachment
		addEffect(root, item, color)
		return
	end

	local anchorPart, anchorOffset
	if item.Category == "Hat" then
		anchorPart = character:FindFirstChild("Head")
		if anchorPart then
			anchorOffset = CFrame.new(0, anchorPart.Size.Y / 2, 0)
		end
	else
		anchorPart = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
		if anchorPart then
			anchorOffset = CFrame.new(0, 0.2, anchorPart.Size.Z / 2)
		end
	end
	if not anchorPart then
		return
	end
	local model = Instance.new("Model")
	model.Name = "SlapAccessory_" .. item.Category
	CollectionService:AddTag(model, AURA_TAG)
	local base = anchorPart.CFrame * anchorOffset
	local first = nil
	local function add(name, size, offset, shape, colorOverride)
		local p = newPart(model, name, size, colorOverride or color, mat, shape)
		p.CFrame = base * offset
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = anchorPart
		weld.Part1 = p
		weld.Parent = p
		if item.Effect == "rainbow" and not colorOverride then
			CollectionService:AddTag(p, "RainbowHand")
		end
		first = first or p
		return p
	end
	buildForm(item, add)
	model.Parent = character
	if first then
		addEffect(first, item, color)
	end
end

-- Aussehen + Werte am Charakter anwenden
function Items.ApplyCharacter(player)
	local profile = ctx.Data.Get(player)
	local character = player.Character
	if not profile or not character then
		return
	end
	clearVisuals(character)
	for _, owned in ipairs(profile.Data.Items) do
		if owned.Equipped and Config.Items[owned.Id] then
			attachItem(character, Config.Items[owned.Id])
		end
	end
	Items.ApplyStats(player)
end

function Items.ApplyStats(player)
	local profile = ctx.Data.Get(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not profile or not humanoid then
		return
	end
	humanoid.WalkSpeed = Calc.GetWalkSpeed(profile.Data)
	humanoid.UseJumpPower = true
	humanoid.JumpPower = Calc.GetJumpPower(profile.Data.Upgrades.Jump)
end

--------------------------------------------------------------------------
-- Aktionen
--------------------------------------------------------------------------
local function changed(player)
	Items.ApplyCharacter(player)
	ctx.Data.Push(player, true)
end

function Items.Equip(player, uid)
	local profile = ctx.Data.Get(player)
	if not profile or type(uid) ~= "number" then
		return
	end
	local item = findItem(profile.Data, uid)
	if not item then
		return
	end
	local category = Config.Items[item.Id].Category
	for _, other in ipairs(profile.Data.Items) do
		if other.Equipped and Config.Items[other.Id].Category == category then
			other.Equipped = false
		end
	end
	item.Equipped = true
	changed(player)
end

function Items.Unequip(player, uid)
	local profile = ctx.Data.Get(player)
	if not profile or type(uid) ~= "number" then
		return
	end
	local item = findItem(profile.Data, uid)
	if item then
		item.Equipped = false
		changed(player)
	end
end

function Items.Delete(player, uid)
	local profile = ctx.Data.Get(player)
	if not profile or type(uid) ~= "number" then
		return
	end
	local item, index = findItem(profile.Data, uid)
	if item then
		table.remove(profile.Data.Items, index)
		changed(player)
	end
end

-- 3 gleiche Items (gleiche Stufe) -> 1 Item mit +1 Stern
function Items.Merge(player, uid)
	local profile = ctx.Data.Get(player)
	if not profile or type(uid) ~= "number" then
		return
	end
	local data = profile.Data
	local base = findItem(data, uid)
	if not base then
		return
	end
	if base.Level >= Config.ItemMaxLevel then
		ctx.Remotes.Notify(player, "⭐ This item is already at max stars!", { 255, 220, 120 })
		return
	end
	local group = { base }
	for _, other in ipairs(data.Items) do
		if #group >= 3 then
			break
		end
		if other ~= base and other.Id == base.Id and other.Level == base.Level then
			table.insert(group, other)
		end
	end
	if #group < 3 then
		ctx.Remotes.Notify(player, "🔨 You need 3 of the same item with the same stars to merge.", RED)
		return
	end
	local wasEquipped = false
	for _, item in ipairs(group) do
		wasEquipped = wasEquipped or item.Equipped
		local _, index = findItem(data, item.Uid)
		table.remove(data.Items, index)
	end
	local result = Items.Give(profile, base.Id, base.Level + 1)
	result.Equipped = wasEquipped
	local cfg = Config.Items[base.Id]
	ctx.Remotes.Popup(player, "MERGED!", cfg.DisplayName .. " " .. string.rep("★", result.Level) .. "  " .. Calc.DescribeItem(base.Id, result.Level),
		Config.Rarities[cfg.Rarity].Color)
	ctx.Remotes.Fire("Event", player, "Purchased")
	changed(player)
end

local function crateById(crateId)
	for _, crate in ipairs(Config.ItemCrates) do
		if crate.Id == crateId then
			return crate
		end
	end
	return nil
end
Items.CrateById = crateById

-- Kiste oeffnen und Items geben (fuer Robux-Kaeufe ohne Preispruefung)
function Items.GrantCrate(player, profile, crate)
	local results = {}
	for _ = 1, crate.Count or 1 do
		local rarity = Calc.RollRarity(crate.Weights, random01)
		local itemId = Calc.PickItem(rarity, random01)
		if itemId then
			Items.Give(profile, itemId, 1)
			table.insert(results, { Id = itemId, Level = 1 })
			local cfg = Config.Items[itemId]
			if Config.Rarities[cfg.Rarity].Order >= 5 then
				ctx.Remotes.NotifyAll("🌟 " .. player.DisplayName .. " got " .. cfg.DisplayName .. " (" .. Config.Rarities[cfg.Rarity].DisplayName .. ")!", Config.Rarities[cfg.Rarity].Color)
			end
		end
	end
	ctx.Remotes.Fire("Hatch", player, { Crate = crate.Id, Items = results })
	changed(player)
	return results
end

function Items.OpenCrate(player, crateId)
	local profile = ctx.Data.Get(player)
	local crate = type(crateId) == "string" and crateById(crateId)
	if not profile or not crate or crate.Currency == "Robux" then
		return
	end
	local now = os.clock()
	if profile.LastCrate and now - profile.LastCrate < 1 then
		return
	end
	if #profile.Data.Items >= Config.ItemInventory then
		ctx.Remotes.Notify(player, "🎒 Your item storage is full! Merge or delete items.", RED)
		return
	end
	local key = crate.Currency == "Gems" and "Gems" or "Slaps"
	if profile.Data[key] < crate.Price then
		ctx.Remotes.Notify(player, "Not enough " .. key .. "! You need " .. Calc.FormatNumber(crate.Price), RED)
		ctx.Remotes.Fire("Event", player, "Denied")
		return
	end
	profile.LastCrate = now
	profile.Data[key] = profile.Data[key] - crate.Price
	Items.GrantCrate(player, profile, crate)
end

-- Drop beim Besiegen eines Ziels
function Items.RollDrop(player, profile, target)
	local chance = Config.KindDrops[target.Kind or "blob"] or 0.01
	if target.IsBoss then
		chance = chance * Config.BossDropBonus
	end
	chance = chance * (1 + Calc.GetItemBonuses(profile.Data).Luck * 0.2)
	if rng:NextNumber() >= chance or #profile.Data.Items >= Config.ItemInventory then
		return nil
	end
	-- hoehere Zonen: bessere Seltenheiten
	local weights = {}
	local zoneFactor = (target.ZoneIndex or 1) / #Config.Zones
	for rarity, weight in pairs(Config.DropRarityWeights) do
		local order = Config.Rarities[rarity].Order
		weights[rarity] = weight * (1 + zoneFactor * (order - 1) * 1.5)
	end
	local rarity = Calc.RollRarity(weights, random01)
	local itemId = Calc.PickItem(rarity, random01)
	if not itemId then
		return nil
	end
	Items.Give(profile, itemId, 1)
	local cfg = Config.Items[itemId]
	local rarityInfo = Config.Rarities[cfg.Rarity]
	if rarityInfo.Order >= 3 then
		ctx.Remotes.Popup(player, "ITEM DROP!", cfg.DisplayName .. " (" .. rarityInfo.DisplayName .. ")  " .. Calc.DescribeItem(itemId, 1), rarityInfo.Color)
	else
		ctx.Remotes.Notify(player, "🎁 You found " .. cfg.DisplayName .. " (" .. rarityInfo.DisplayName .. ")!", rarityInfo.Color)
	end
	ctx.Data.Push(player, true)
	return itemId
end

function Items.Init(context)
	ctx = context
	ctx.RegisterAction("EquipItem", Items.Equip)
	ctx.RegisterAction("UnequipItem", Items.Unequip)
	ctx.RegisterAction("DeleteItem", Items.Delete)
	ctx.RegisterAction("MergeItem", Items.Merge)
	ctx.RegisterAction("OpenCrate", Items.OpenCrate)
end

Items.Players = Players
return Items
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">Leaderboards</string><ProtectedString name="Source"><![CDATA[--[[
	Leaderboards: globale Bestenlisten auf den Tafeln im Hub.
	Wenn keine DataStores verfuegbar sind (z.B. in Studio ohne API-Zugriff),
	zeigen die Tafeln die Spieler auf diesem Server.
]]

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("SlapShared")
local Config = require(Shared:WaitForChild("Config"))
local Calc = require(Shared:WaitForChild("Calc"))

local Leaderboards = {}
local ctx

local stores = {}
local nameCache = {}

-- Slaps koennen riesig werden -> logarithmisch speichern (passt immer in 64 Bit)
local SCALE = 1e9
local function encode(value)
	return math.floor(math.log10(math.max(0, value) + 1) * SCALE)
end
local function decode(value)
	return math.floor(10 ^ (value / SCALE) - 1 + 0.5)
end

local function getName(userId)
	if nameCache[userId] then
		return nameCache[userId]
	end
	local player = Players:GetPlayerByUserId(userId)
	if player then
		nameCache[userId] = player.DisplayName
		return player.DisplayName
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	if ok and type(name) == "string" then
		nameCache[userId] = name
		return name
	end
	return "Player " .. tostring(userId)
end

local function fill(boardId, entries, formatValue, title)
	local rows = ctx.World.Leaderboards and ctx.World.Leaderboards[boardId]
	if not rows then
		return
	end
	for i, row in ipairs(rows) do
		local entry = entries[i]
		if entry then
			local medal = (i == 1 and "🥇") or (i == 2 and "🥈") or (i == 3 and "🥉") or (i .. ".")
			row.Text = "  " .. medal .. "  " .. entry.Name .. "  -  " .. formatValue(entry.Value)
		elseif i == 1 and title then
			row.Text = "  " .. title
		else
			row.Text = "  " .. i .. ".  ..."
		end
	end
end

local function fromServer(field)
	local entries = {}
	for _, profile in pairs(ctx.Data.Profiles) do
		if profile.Loaded then
			table.insert(entries, { Name = profile.Player.DisplayName, Value = profile.Data[field], UserId = profile.UserId })
		end
	end
	table.sort(entries, function(a, b)
		return a.Value > b.Value
	end)
	return entries
end

local function readGlobal(store, isEncoded)
	local ok, pages = pcall(function()
		return store:GetSortedAsync(false, 10)
	end)
	if not ok or not pages then
		return nil
	end
	local ok2, page = pcall(function()
		return pages:GetCurrentPage()
	end)
	if not ok2 or type(page) ~= "table" then
		return nil
	end
	local entries = {}
	for _, item in ipairs(page) do
		local userId = tonumber(string.match(tostring(item.key), "%d+"))
		local value = tonumber(item.value) or 0
		if userId then
			table.insert(entries, { Name = getName(userId), Value = isEncoded and decode(value) or value, UserId = userId })
		end
	end
	return entries
end

-- Top 3 als Avatar-Statuen auf das Siegertreppchen stellen
local podiumUsers = {}
local function updatePodium(entries)
	local podium = ctx.World.Podium
	if not podium then
		return
	end
	for rank = 1, 3 do
		local spot = podium[rank]
		local entry = entries[rank]
		local userId = entry and entry.UserId or nil
		if spot then
			spot.Label.Text = (rank == 1 and "👑 " or "") .. "#" .. rank .. "  " .. (entry and (entry.Name .. "\n" .. Calc.FormatNumber(entry.Value) .. " Slaps") or "...")
			if podiumUsers[rank] ~= userId then
				podiumUsers[rank] = userId
				if spot.Model then
					spot.Model:Destroy()
					spot.Model = nil
				end
				if userId and userId > 0 then
					local ok, model = pcall(function()
						return Players:CreateHumanoidModelFromUserId(userId)
					end)
					if ok and model then
						model.Name = "PodiumAvatar" .. rank
						for _, d in ipairs(model:GetDescendants()) do
							if d:IsA("BasePart") then
								d.Anchored = true
								d.CanCollide = false
							elseif d:IsA("Script") or d:IsA("LocalScript") then
								d:Destroy()
							end
						end
						local humanoid = model:FindFirstChildOfClass("Humanoid")
						if humanoid then
							humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
						end
						local hipHeight = (humanoid and humanoid.HipHeight or 2) + 1
						pcall(function()
							model:PivotTo(spot.Top * CFrame.new(0, hipHeight + 0.6, 0))
						end)
						model.Parent = ctx.World.Root
						spot.Model = model
					end
				end
			end
		end
	end
end

function Leaderboards.Refresh()
	-- eigene Werte hochladen
	for _, profile in pairs(ctx.Data.Profiles) do
		if profile.Loaded and profile.CanSave then
			local key = "Player_" .. profile.UserId
			if stores.Earned then
				pcall(function()
					stores.Earned:SetAsync(key, encode(profile.Data.TotalEarned))
				end)
			end
			if stores.Rebirths then
				pcall(function()
					stores.Rebirths:SetAsync(key, profile.Data.Rebirths)
				end)
			end
		end
	end

	local earned = stores.Earned and readGlobal(stores.Earned, true)
	if not earned then
		earned = fromServer("TotalEarned")
		fill("Earned", earned, Calc.FormatNumber, "(this server only)")
	else
		fill("Earned", earned, Calc.FormatNumber, nil)
	end
	local okPodium, errPodium = pcall(updatePodium, earned)
	if not okPodium then
		warn("[SlapTheBlob] Podium: " .. tostring(errPodium))
	end
	local rebirths = stores.Rebirths and readGlobal(stores.Rebirths, false)
	if rebirths then
		fill("Rebirths", rebirths, tostring, nil)
	else
		fill("Rebirths", fromServer("Rebirths"), tostring, "(this server only)")
	end
end

function Leaderboards.Init(context)
	ctx = context
	if ctx.Data.HasStore() then
		local ok1, s1 = pcall(function()
			return DataStoreService:GetOrderedDataStore(Config.LeaderboardSlapsStore)
		end)
		local ok2, s2 = pcall(function()
			return DataStoreService:GetOrderedDataStore(Config.LeaderboardRebirthStore)
		end)
		stores.Earned = ok1 and s1 or nil
		stores.Rebirths = ok2 and s2 or nil
	end
end

function Leaderboards.Start()
	task.spawn(function()
		task.wait(5)
		while true do
			local ok, err = pcall(Leaderboards.Refresh)
			if not ok then
				warn("[SlapTheBlob] Leaderboard: " .. tostring(err))
			end
			task.wait(Config.LeaderboardRefresh)
		end
	end)
end

return Leaderboards
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">Pets</string><ProtectedString name="Source"><![CDATA[--[[
	Pets: Eier oeffnen, Pets ausruesten / ablegen / loeschen.
	Ausgeruestete Pets stehen als Attribut "EquippedPets" am Spieler,
	damit alle Clients sie anzeigen koennen.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("SlapShared")
local Config = require(Shared:WaitForChild("Config"))
local Calc = require(Shared:WaitForChild("Calc"))

local Pets = {}
local ctx
local rng = Random.new()

local RED = { 255, 120, 120 }

local function countEquipped(data)
	local n = 0
	for _, pet in ipairs(data.Pets) do
		if pet.Equipped then
			n = n + 1
		end
	end
	return n
end

local function findPet(data, uid)
	for i, pet in ipairs(data.Pets) do
		if pet.Uid == uid then
			return pet, i
		end
	end
	return nil
end

function Pets.UpdateAttribute(player)
	local profile = ctx.Data.Get(player)
	if not profile then
		return
	end
	player:SetAttribute("EquippedPets", table.concat(Calc.GetEquippedPetIds(profile.Data), ","))
end

local function changed(player)
	Pets.UpdateAttribute(player)
	ctx.Data.Push(player, true)
end

function Pets.Hatch(player, eggId, amount)
	local profile = ctx.Data.Get(player)
	if not profile or type(eggId) ~= "string" then
		return
	end
	local egg = Config.Eggs[eggId]
	if not egg or egg.Robux then
		return -- Robux-Eier gehen nur ueber den Shop-Kauf
	end
	if egg.Event then
		local current = Calc.GetCurrentEvent(os.time())
		if not current or current.Id ~= egg.Event then
			ctx.Remotes.Notify(player, "⭐ This event egg is not available this week!", RED)
			return
		end
	end
	amount = (amount == 3) and 3 or 1
	local data = profile.Data

	local now = os.clock()
	if profile.LastHatch and now - profile.LastHatch < 1.2 then
		return
	end
	if egg.Zone > data.Zones then
		ctx.Remotes.Notify(player, "Unlock Zone " .. egg.Zone .. " first!", RED)
		return
	end
	local space = Calc.GetInventorySize(data) - #data.Pets
	if space < amount then
		ctx.Remotes.Notify(player, "🎒 Your pet inventory is full! Delete pets or buy more space.", RED)
		ctx.Remotes.Fire("Event", player, "Denied")
		return
	end
	local balanceKey = egg.Currency == "Gems" and "Gems" or "Slaps"
	local price = egg.Price * amount
	if data[balanceKey] < price then
		local icon = balanceKey == "Gems" and "💎" or "👋"
		ctx.Remotes.Notify(player, "Not enough " .. balanceKey .. "! You need " .. icon .. " " .. Calc.FormatNumber(price), RED)
		ctx.Remotes.Fire("Event", player, "Denied")
		return
	end
	profile.LastHatch = now
	data[balanceKey] = data[balanceKey] - price
	Pets.GrantEgg(player, profile, eggId, amount)
end

-- Pets aus einem Ei geben (ohne Preis; Robux-Kaeufe duerfen das Inventar ueberfuellen)
function Pets.GrantEgg(player, profile, eggId, amount)
	local data = profile.Data
	local lucky = Calc.IsBoostActive(data, "LuckyEggs", os.time())
	local slots = Calc.GetPetSlots(data)
	local results = {}
	for _ = 1, amount do
		local petId = Calc.RollEgg(eggId, lucky, function()
			return rng:NextNumber()
		end)
		local pet = { Uid = data.NextPetUid, Id = petId, Equipped = false }
		data.NextPetUid = data.NextPetUid + 1
		if countEquipped(data) < slots then
			pet.Equipped = true
		end
		table.insert(data.Pets, pet)
		table.insert(results, { Id = petId, Uid = pet.Uid })

		local petCfg = Config.Pets[petId]
		if Config.Rarities[petCfg.Rarity].Order >= 4 then
			local rarity = Config.Rarities[petCfg.Rarity]
			ctx.Remotes.NotifyAll("🌟 " .. player.DisplayName .. " hatched " .. petCfg.DisplayName .. " (" .. rarity.DisplayName .. ")!", rarity.Color)
		end
	end
	ctx.Data.AddStat(profile, "Eggs", amount)
	ctx.Remotes.Fire("Hatch", player, { EggId = eggId, Pets = results })
	changed(player)
	return results
end

function Pets.Equip(player, uid)
	local profile = ctx.Data.Get(player)
	if not profile or type(uid) ~= "number" then
		return
	end
	local pet = findPet(profile.Data, uid)
	if not pet or pet.Equipped then
		return
	end
	if countEquipped(profile.Data) >= Calc.GetPetSlots(profile.Data) then
		ctx.Remotes.Notify(player, "All pet slots are full! Unequip a pet first.", RED)
		return
	end
	pet.Equipped = true
	changed(player)
end

function Pets.Unequip(player, uid)
	local profile = ctx.Data.Get(player)
	if not profile or type(uid) ~= "number" then
		return
	end
	local pet = findPet(profile.Data, uid)
	if not pet or not pet.Equipped then
		return
	end
	pet.Equipped = false
	changed(player)
end

function Pets.Delete(player, uid)
	local profile = ctx.Data.Get(player)
	if not profile or type(uid) ~= "number" then
		return
	end
	if ctx.Trade.IsTrading(player) then
		ctx.Remotes.Notify(player, "🤝 You can't delete pets while trading.", RED)
		return
	end
	local pet, index = findPet(profile.Data, uid)
	if not pet then
		return
	end
	table.remove(profile.Data.Pets, index)
	changed(player)
end

-- Beste Pets automatisch ausruesten
function Pets.EquipBest(player)
	local profile = ctx.Data.Get(player)
	if not profile then
		return
	end
	local data = profile.Data
	local sorted = {}
	for _, pet in ipairs(data.Pets) do
		pet.Equipped = false
		table.insert(sorted, pet)
	end
	table.sort(sorted, function(a, b)
		local boostA, boostB = Config.Pets[a.Id].Boost, Config.Pets[b.Id].Boost
		if boostA == boostB then
			return a.Uid < b.Uid
		end
		return boostA > boostB
	end)
	for i = 1, math.min(Calc.GetPetSlots(data), #sorted) do
		sorted[i].Equipped = true
	end
	ctx.Remotes.Notify(player, "🐾 Best pets equipped!", { 120, 255, 140 })
	changed(player)
end

-- Alle nicht ausgeruesteten Pets einer Seltenheit loeschen
function Pets.DeleteRarity(player, rarity)
	local profile = ctx.Data.Get(player)
	if not profile or type(rarity) ~= "string" or not Config.Rarities[rarity] then
		return
	end
	if ctx.Trade.IsTrading(player) then
		ctx.Remotes.Notify(player, "🤝 You can't delete pets while trading.", RED)
		return
	end
	local kept = {}
	local removed = 0
	for _, pet in ipairs(profile.Data.Pets) do
		if not pet.Equipped and Config.Pets[pet.Id].Rarity == rarity then
			removed = removed + 1
		else
			table.insert(kept, pet)
		end
	end
	profile.Data.Pets = kept
	ctx.Remotes.Notify(player, "🗑️ " .. removed .. " pets deleted.", { 255, 220, 120 })
	changed(player)
end

function Pets.Init(context)
	ctx = context
	ctx.RegisterAction("Hatch", Pets.Hatch)
	ctx.RegisterAction("EquipPet", Pets.Equip)
	ctx.RegisterAction("UnequipPet", Pets.Unequip)
	ctx.RegisterAction("DeletePet", Pets.Delete)
	ctx.RegisterAction("EquipBestPets", Pets.EquipBest)
	ctx.RegisterAction("DeleteRarity", Pets.DeleteRarity)
end

-- Anzeige am Event-Stand im Hub aktualisieren
local function updateEventStand()
	local stand = ctx.World.EventStand
	if not stand then
		return
	end
	local event, endsAt = Calc.GetCurrentEvent(os.time())
	if not event then
		return
	end
	local left = math.max(0, endsAt - os.time())
	local days = math.floor(left / 86400)
	local hours = math.floor((left % 86400) / 3600)
	local minutes = math.floor((left % 3600) / 60)
	stand.Title.Text = "⭐ " .. string.upper(event.Name) .. " ⭐"
	stand.Title.TextColor3 = Color3.fromRGB(event.Color[1], event.Color[2], event.Color[3])
	stand.Timer.Text = "Exclusive pets!  Ends in " .. days .. "d " .. hours .. "h " .. minutes .. "m"
	stand.Egg.Color = Color3.fromRGB(event.Color[1], event.Color[2], event.Color[3])
	stand.Prompt.ObjectText = event.Name .. " Egg (💎 " .. Calc.FormatNumber(Config.EventEggPrice) .. ")"
end

function Pets.Start()
	task.spawn(function()
		while true do
			pcall(updateEventStand)
			task.wait(30)
		end
	end)
	for _, zoneInfo in ipairs(ctx.World.Zones) do
		for _, stand in ipairs(zoneInfo.EggStands) do
			for _, prompt in ipairs(stand.Prompts) do
				local eggId = prompt:GetAttribute("EggId")
				local amount = prompt:GetAttribute("Amount")
				prompt.Triggered:Connect(function(player)
					Pets.Hatch(player, eggId, amount)
				end)
			end
		end
	end
end

return Pets
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[--[[
	Remotes: legt alle RemoteEvents an und bietet kleine Helfer.

	Client -> Server:  Request(action, ...)
	Server -> Client:  State, Notify, SlapFx, Hatch, Popup, Knockback, Event, Defeat
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = {}
Remotes.Events = {}

local folder = ReplicatedStorage:FindFirstChild("SlapRemotes")
if not folder then
	folder = Instance.new("Folder")
	folder.Name = "SlapRemotes"
	folder.Parent = ReplicatedStorage
end

local NAMES = { "Request", "State", "Notify", "SlapFx", "Hatch", "Popup", "Knockback", "Event", "Defeat", "Duel", "Trade" }

for _, name in ipairs(NAMES) do
	local remote = folder:FindFirstChild(name)
	if not remote then
		remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
	end
	Remotes.Events[name] = remote
end

local WHITE = { 255, 255, 255 }

function Remotes.Notify(player, text, color)
	if player and player.Parent then
		Remotes.Events.Notify:FireClient(player, text, color or WHITE)
	end
end

function Remotes.NotifyAll(text, color)
	Remotes.Events.Notify:FireAllClients(text, color or WHITE)
end

-- Grosses Popup in der Bildschirmmitte (z.B. "NEW HAND!")
function Remotes.Popup(player, title, subtitle, color)
	if player and player.Parent then
		Remotes.Events.Popup:FireClient(player, title, subtitle or "", color or WHITE)
	end
end

function Remotes.Fire(name, player, ...)
	if player and player.Parent then
		Remotes.Events[name]:FireClient(player, ...)
	end
end

function Remotes.FireAll(name, ...)
	Remotes.Events[name]:FireAllClients(...)
end

return Remotes
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000014"><Properties><string name="Name">Rewards</string><ProtectedString name="Source"><![CDATA[--[[
	Rewards: taegliche Belohnung, taegliche Quests und Codes.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("SlapShared")
local Config = require(Shared:WaitForChild("Config"))
local Calc = require(Shared:WaitForChild("Calc"))

local Rewards = {}
local ctx

local RED = { 255, 120, 120 }
local GOLD = { 255, 220, 100 }

-- Belohnungstabelle anwenden: { Gems=, Boost=, Duration= }
local function grant(profile, reward)
	local parts = {}
	if reward.Gems and reward.Gems > 0 then
		ctx.Data.AddGems(profile, reward.Gems)
		table.insert(parts, "+" .. reward.Gems .. " 💎")
	end
	if reward.Boost and Config.Boosts[reward.Boost] then
		ctx.Data.AddBoost(profile, reward.Boost, reward.Duration or 300)
		local boost = Config.Boosts[reward.Boost]
		table.insert(parts, boost.Icon .. " " .. boost.DisplayName .. " " .. Calc.FormatTime(reward.Duration or 300))
	end
	return table.concat(parts, "   ")
end

function Rewards.ClaimDaily(player)
	local profile = ctx.Data.Get(player)
	if not profile then
		return
	end
	local now = os.time()
	local canClaim, day, waitSeconds = Calc.GetDailyStatus(profile.Data, now)
	if not canClaim then
		ctx.Remotes.Notify(player, "🎁 Next reward in " .. Calc.FormatTime(waitSeconds), RED)
		return
	end
	profile.Data.Daily.Last = now
	profile.Data.Daily.Streak = day
	local text = grant(profile, Config.DailyRewards[day])
	ctx.Remotes.Popup(player, "DAY " .. day .. " REWARD!", text, GOLD)
	ctx.Remotes.Fire("Event", player, "Purchased")
	ctx.Data.Push(player, true)
end

function Rewards.ClaimQuest(player, index)
	local profile = ctx.Data.Get(player)
	if not profile or type(index) ~= "number" then
		return
	end
	index = math.floor(index)
	ctx.Data.RefreshQuests(profile)
	local quests = Calc.GetQuests(profile.Data.Quests.Day, profile.UserId)
	local quest = quests[index]
	if not quest then
		return
	end
	if profile.Data.Quests.Claimed[index] then
		ctx.Remotes.Notify(player, "You already claimed this quest!", { 255, 220, 120 })
		return
	end
	if (profile.Data.Quests.Progress[index] or 0) < quest.Amount then
		ctx.Remotes.Notify(player, "📜 This quest is not finished yet!", RED)
		return
	end
	profile.Data.Quests.Claimed[index] = true
	local text = grant(profile, { Gems = quest.Gems })
	ctx.Remotes.Popup(player, "QUEST COMPLETE!", text, GOLD)
	ctx.Remotes.Fire("Event", player, "Purchased")
	ctx.Data.Push(player, true)
end

function Rewards.RedeemCode(player, text)
	local profile = ctx.Data.Get(player)
	if not profile or type(text) ~= "string" then
		return
	end
	local code = string.upper((text:gsub("%s", "")))
	if #code == 0 or #code > 30 then
		return
	end
	local now = os.clock()
	if profile.LastCode and now - profile.LastCode < 1.5 then
		return
	end
	profile.LastCode = now
	local reward = Config.Codes[code]
	if not reward then
		ctx.Remotes.Notify(player, "❌ That code does not exist.", RED)
		ctx.Remotes.Fire("Event", player, "Denied")
		return
	end
	if profile.Data.Codes[code] then
		ctx.Remotes.Notify(player, "You already used this code!", { 255, 220, 120 })
		return
	end
	profile.Data.Codes[code] = true
	local rewardText = grant(profile, reward)
	ctx.Remotes.Popup(player, "CODE REDEEMED!", rewardText, GOLD)
	ctx.Remotes.Fire("Event", player, "Purchased")
	ctx.Data.Push(player, true)
end

function Rewards.Init(context)
	ctx = context
	ctx.RegisterAction("ClaimDaily", Rewards.ClaimDaily)
	ctx.RegisterAction("ClaimQuest", Rewards.ClaimQuest)
	ctx.RegisterAction("RedeemCode", Rewards.RedeemCode)
end

return Rewards
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000015"><Properties><string name="Name">Shop</string><ProtectedString name="Source"><![CDATA[--[[
	Shop: alle Kaeufe mit Slaps und Gems.
	  Upgrades, Haende, Zonen, Teleport, Rebirth, Gem-Shop, Auto-Slap, Einstellungen
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("SlapShared")
local Config = require(Shared:WaitForChild("Config"))
local Calc = require(Shared:WaitForChild("Calc"))

local Shop = {}
local ctx
local rebirthRng = Random.new()

local RED = { 255, 120, 120 }
local GREEN = { 120, 255, 140 }

local function notEnough(player, amount, currency)
	local icon = currency == "Gems" and "💎" or "👋"
	ctx.Remotes.Notify(player, "Not enough " .. currency .. "! You need " .. icon .. " " .. Calc.FormatNumber(amount), RED)
	ctx.Remotes.Fire("Event", player, "Denied")
end

--------------------------------------------------------------------------
-- Upgrades
--------------------------------------------------------------------------
-- Kauft ein Level. Gibt zurueck: ok, fehlendeWaehrung ("Slaps"/"Gems"/nil), Betrag, warTierUp
local function buyOneUpgrade(profile, id, allowTierUp)
	local data = profile.Data
	local level = data.Upgrades[id]
	local cost, gems = Calc.GetUpgradeCost(id, level)
	if not cost then
		return false, nil, nil, false
	end
	local tierUp = gems > 0
	if tierUp and not allowTierUp then
		return false, "TierUp", cost, true
	end
	if data.Slaps < cost then
		return false, "Slaps", cost, tierUp
	end
	if data.Gems < gems then
		return false, "Gems", gems, tierUp
	end
	data.Slaps = data.Slaps - cost
	data.Gems = data.Gems - gems
	data.Upgrades[id] = level + 1
	ctx.Data.AddStat(profile, "Upgrades", 1)
	return true, nil, cost, tierUp
end

local function afterUpgrade(player, profile, id, bought, tierUp)
	local upgrade = Config.Upgrades[id]
	local level = profile.Data.Upgrades[id]
	if tierUp then
		local tierInfo = Calc.GetTierInfo(Calc.GetTier(level))
		ctx.Remotes.Popup(player, "TIER UP!", upgrade.Icon .. " " .. upgrade.DisplayName .. " is now " .. string.upper(tierInfo.Name) .. "  (" .. Calc.DescribeUpgrade(id, level) .. ")", tierInfo.Color)
	else
		ctx.Remotes.Notify(player, upgrade.Icon .. " " .. upgrade.DisplayName .. " is now level " .. level
			.. (bought > 1 and ("  (+" .. bought .. ")") or "") .. "!", GREEN)
	end
	ctx.Remotes.Fire("Event", player, "Purchased")
	if id == "Power" then
		ctx.Hands.Give(player, false) -- Hand waechst
	end
	if id == "Legs" or id == "Jump" then
		ctx.Items.ApplyStats(player) -- schneller laufen / hoeher springen
	end
	ctx.Data.Push(player, true)
end

function Shop.BuyUpgrade(player, id)
	local profile = ctx.Data.Get(player)
	if not profile or type(id) ~= "string" or not Config.Upgrades[id] then
		return
	end
	local ok, missing, amount, tierUp = buyOneUpgrade(profile, id, true)
	if ok then
		afterUpgrade(player, profile, id, 1, tierUp)
	elseif missing == nil then
		ctx.Remotes.Notify(player, "Already at max level!", { 255, 220, 120 })
	else
		notEnough(player, amount, missing)
	end
end

-- Kauft so viele Level wie moeglich, aber nie automatisch einen Tier-Up (der kostet Gems)
function Shop.BuyUpgradeMax(player, id)
	local profile = ctx.Data.Get(player)
	if not profile or type(id) ~= "string" or not Config.Upgrades[id] then
		return
	end
	local bought = 0
	local lastMissing, lastAmount = nil, nil
	for _ = 1, Config.Upgrades[id].MaxLevel do
		local ok, missing, amount = buyOneUpgrade(profile, id, false)
		lastMissing, lastAmount = missing, amount
		if not ok then
			break
		end
		bought = bought + 1
	end
	if bought > 0 then
		afterUpgrade(player, profile, id, bought, false)
	elseif lastMissing == "TierUp" then
		ctx.Remotes.Notify(player, "⚡ Time for a TIER UP! Press the Tier Up button.", { 255, 220, 120 })
	elseif lastMissing == nil then
		ctx.Remotes.Notify(player, "Already at max level!", { 255, 220, 120 })
	else
		notEnough(player, lastAmount, lastMissing)
	end
end

--------------------------------------------------------------------------
-- Haende
--------------------------------------------------------------------------
local function ownsHand(profile, handId)
	return profile.Data.OwnedHands[handId] == true or profile.RobuxHands[handId] == true
end
Shop.OwnsHand = ownsHand

-- Robux-Hand freischalten (nach Kauf oder zum Testen in Studio)
local function grantRobuxHand(player, profile, hand, isTest)
	profile.RobuxHands[hand.Id] = true
	profile.Data.Hand = hand.Id
	ctx.Hands.Give(player, true)
	local subtitle = hand.DisplayName .. "  (x" .. Calc.FormatNumber(hand.Damage) .. " Damage)"
	if isTest then
		subtitle = subtitle .. "  - Studio test, free"
	else
		ctx.Remotes.NotifyAll("👑 " .. player.DisplayName .. " got the " .. hand.DisplayName .. "!", hand.Color)
	end
	ctx.Remotes.Popup(player, "ULTRA HAND UNLOCKED!", subtitle, hand.Color)
	ctx.Remotes.Fire("Event", player, "Purchased")
	ctx.Data.Push(player, true)
end

-- Beim Betreten pruefen, welche Robux-Haende der Spieler besitzt
function Shop.CheckRobuxHands(player, profile)
	for _, hand in ipairs(Config.Hands) do
		local passId = tonumber(hand.GamePassId) or 0
		if hand.Currency == "Robux" and passId > 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, passId)
			end)
			if ok and owns then
				profile.RobuxHands[hand.Id] = true
			end
		end
	end
	if Calc.IsRobuxHand(profile.Data.Hand) and not profile.RobuxHands[profile.Data.Hand] then
		profile.Data.Hand = Config.Hands[1].Id
	end
end

function Shop.BuyHand(player, handId)
	local profile = ctx.Data.Get(player)
	if not profile or type(handId) ~= "string" or not Calc.IsHand(handId) then
		return
	end
	local data = profile.Data
	local hand = Calc.GetHand(handId)
	if ownsHand(profile, handId) then
		Shop.EquipHand(player, handId)
		return
	end
	if hand.Currency == "Robux" then
		local passId = tonumber(hand.GamePassId) or 0
		if passId <= 0 then
			if RunService:IsStudio() then
				grantRobuxHand(player, profile, hand, true)
			else
				ctx.Remotes.Notify(player, "👑 " .. hand.DisplayName .. " is coming soon!", { 255, 220, 120 })
			end
			return
		end
		local ok, err = pcall(function()
			MarketplaceService:PromptGamePassPurchase(player, passId)
		end)
		if not ok then
			warn("[SlapTheBlob] Game pass prompt failed: " .. tostring(err))
		end
		return
	end
	local balanceKey = hand.Currency == "Gems" and "Gems" or "Slaps"
	if data[balanceKey] < hand.Price then
		notEnough(player, hand.Price, balanceKey)
		return
	end
	data[balanceKey] = data[balanceKey] - hand.Price
	data.OwnedHands[handId] = true
	data.Hand = handId
	ctx.Hands.Give(player, true)
	ctx.Remotes.Popup(player, "NEW HAND!", hand.DisplayName .. "  (x" .. hand.Damage .. " Damage)", hand.Color)
	ctx.Remotes.Fire("Event", player, "Purchased")
	ctx.Data.Push(player, true)
end

function Shop.EquipHand(player, handId)
	local profile = ctx.Data.Get(player)
	if not profile or type(handId) ~= "string" or not ownsHand(profile, handId) then
		return
	end
	profile.Data.Hand = handId
	ctx.Hands.Give(player, true)
	ctx.Remotes.Notify(player, "✋ " .. Calc.GetHand(handId).DisplayName .. " equipped!", GREEN)
	ctx.Data.Push(player, true)
end

--------------------------------------------------------------------------
-- Zonen & Teleport
--------------------------------------------------------------------------
function Shop.UnlockZone(player, zoneIndex)
	local profile = ctx.Data.Get(player)
	if not profile or type(zoneIndex) ~= "number" then
		return
	end
	local data = profile.Data
	zoneIndex = math.floor(zoneIndex)
	local zone = Config.Zones[zoneIndex]
	if not zone then
		return
	end
	if zoneIndex <= data.Zones then
		ctx.Remotes.Notify(player, "You already own this zone!", { 255, 220, 120 })
		return
	end
	if zoneIndex > data.Zones + 1 then
		ctx.Remotes.Notify(player, "Unlock Zone " .. (data.Zones + 1) .. " first!", RED)
		return
	end
	if data.Slaps < zone.Price then
		notEnough(player, zone.Price, "Slaps")
		return
	end
	data.Slaps = data.Slaps - zone.Price
	data.Zones = zoneIndex
	ctx.Remotes.Popup(player, "NEW ZONE!", "Zone " .. zoneIndex .. ": " .. zone.Name, zone.Accent)
	ctx.Remotes.NotifyAll("🗺️ " .. player.DisplayName .. " unlocked Zone " .. zoneIndex .. " (" .. zone.Name .. ")!", zone.Accent)
	ctx.Remotes.Fire("Event", player, "Purchased")
	ctx.Data.Push(player, true)
end

function Shop.Teleport(player, zoneIndex)
	local profile = ctx.Data.Get(player)
	if not profile or type(zoneIndex) ~= "number" then
		return
	end
	zoneIndex = math.floor(zoneIndex)
	local character = player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then
		return
	end
	if profile.Duel then
		ctx.Remotes.Notify(player, "⚔️ You can't teleport during a duel!", RED)
		return
	end
	local now = os.clock()
	if profile.LastTeleport and now - profile.LastTeleport < 2 then
		return
	end
	if zoneIndex == 0 then
		profile.LastTeleport = now
		local spawn = ctx.World.Spawn
		character:PivotTo(spawn.CFrame * CFrame.new(0, 4, 0))
		return
	end
	if zoneIndex < 1 or zoneIndex > profile.Data.Zones then
		ctx.Remotes.Notify(player, "This zone is still locked!", RED)
		return
	end
	profile.LastTeleport = now
	character:PivotTo(ctx.World.Zones[zoneIndex].TeleportCFrame)
end

--------------------------------------------------------------------------
-- Rebirth
--------------------------------------------------------------------------
function Shop.Rebirth(player)
	local profile = ctx.Data.Get(player)
	if not profile then
		return
	end
	local data = profile.Data
	local cost = Calc.GetRebirthCost(data.Rebirths)
	if data.Zones < Config.RebirthMinZone then
		ctx.Remotes.Notify(player, "♻️ Unlock Zone " .. Config.RebirthMinZone .. " before you can rebirth!", RED)
		ctx.Remotes.Fire("Event", player, "Denied")
		return
	end
	if data.Slaps < cost then
		notEnough(player, cost, "Slaps")
		return
	end
	data.Rebirths = data.Rebirths + 1
	data.Slaps = 0
	for _, id in ipairs(Config.UpgradeOrder) do
		data.Upgrades[id] = 0
	end
	data.Zones = 1
	local gems = ctx.Data.AddGems(profile, Calc.GetRebirthGems(data.Rebirths))
	profile.Combo = 0
	-- Bonus-Item: je mehr Rebirths, desto seltener
	local r = data.Rebirths
	local weights = { Rare = 60, Epic = 25 + r * 2, Legendary = 6 + r, Mythic = 0.5 + r * 0.4, Ultra = r >= 10 and (r * 0.1) or 0 }
	local bonusId = Calc.PickItem(Calc.RollRarity(weights, function()
		return rebirthRng:NextNumber()
	end), function()
		return rebirthRng:NextNumber()
	end)
	if bonusId then
		ctx.Items.Give(profile, bonusId, 1)
		local bonusCfg = Config.Items[bonusId]
		ctx.Remotes.Notify(player, "🎁 Rebirth bonus: " .. bonusCfg.DisplayName .. " (" .. Config.Rarities[bonusCfg.Rarity].DisplayName .. ")!", Config.Rarities[bonusCfg.Rarity].Color)
	end

	ctx.Remotes.Popup(player, "REBIRTH " .. data.Rebirths .. "!", "Forever " .. Calc.FormatMultiplier(Calc.GetRebirthSlapMultiplier(data.Rebirths))
		.. " Slaps & " .. Calc.FormatMultiplier(Calc.GetRebirthDamageMultiplier(data.Rebirths)) .. " Damage  (+" .. gems .. " 💎)", { 200, 150, 255 })
	ctx.Remotes.NotifyAll("♻️ " .. player.DisplayName .. " did Rebirth " .. data.Rebirths .. "!", { 200, 150, 255 })

	-- zurueck zum Start, weil die Zonen wieder gesperrt sind
	local character = player.Character
	if character and character:FindFirstChild("HumanoidRootPart") then
		character:PivotTo(ctx.World.Spawn.CFrame * CFrame.new(0, 4, 0))
	end
	ctx.Hands.Give(player, false)
	ctx.Items.ApplyCharacter(player)
	ctx.Data.Push(player, true)
	task.spawn(ctx.Data.Save, profile)
end

--------------------------------------------------------------------------
-- Gem-Shop
--------------------------------------------------------------------------
function Shop.BuyGemItem(player, itemId)
	local profile = ctx.Data.Get(player)
	if not profile or type(itemId) ~= "string" then
		return
	end
	local item = Calc.GetGemItem(itemId)
	if not item then
		return
	end
	local data = profile.Data
	local owned = data.GemShop[itemId] or 0
	local price = Calc.GetGemItemPrice(itemId, owned)
	if not price then
		ctx.Remotes.Notify(player, "You already bought all of this!", { 255, 220, 120 })
		return
	end
	if data.Gems < price then
		notEnough(player, price, "Gems")
		return
	end
	data.Gems = data.Gems - price
	if item.Boost then
		ctx.Data.AddBoost(profile, item.Boost, item.Duration)
		ctx.Remotes.Notify(player, item.Icon .. " " .. item.DisplayName .. " activated!", GREEN)
	else
		data.GemShop[itemId] = owned + 1
		if itemId == "AutoSlap" then
			data.AutoSlapOn = true
			ctx.Remotes.Popup(player, "AUTO-SLAP!", "Hold your hand and stand next to a Blob.", { 120, 220, 255 })
		else
			ctx.Remotes.Notify(player, item.Icon .. " " .. item.DisplayName .. " bought!", GREEN)
		end
	end
	ctx.Remotes.Fire("Event", player, "Purchased")
	ctx.Data.Push(player, true)
end

function Shop.ToggleAutoSlap(player)
	local profile = ctx.Data.Get(player)
	if not profile then
		return
	end
	if profile.Data.GemShop.AutoSlap < 1 then
		ctx.Remotes.Notify(player, "Buy Auto-Slap in the 💎 Gem Shop!", RED)
		return
	end
	profile.Data.AutoSlapOn = not profile.Data.AutoSlapOn
	ctx.Remotes.Notify(player, "🤖 Auto-Slap " .. (profile.Data.AutoSlapOn and "AN" or "AUS"), GREEN)
	ctx.Data.Push(player, true)
end

function Shop.SetSetting(player, name, value)
	local profile = ctx.Data.Get(player)
	if not profile or type(name) ~= "string" or type(value) ~= "boolean" then
		return
	end
	if profile.Data.Settings[name] == nil then
		return
	end
	profile.Data.Settings[name] = value
	ctx.Data.Push(player, true)
end

--------------------------------------------------------------------------
-- Dimensionen
--------------------------------------------------------------------------
function Shop.EnterDimension(player, dimIndex)
	local profile = ctx.Data.Get(player)
	local dim = Config.Dimensions[dimIndex]
	if not profile or not dim or not ctx.World.Dimensions[dimIndex] then
		return
	end
	if profile.Duel then
		return
	end
	-- man muss die letzte Zone der vorherigen Dimension haben
	if profile.Data.Zones < dim.FirstZone - 1 then
		ctx.Remotes.Notify(player, "🌀 Unlock Zone " .. (dim.FirstZone - 1) .. " first!", RED)
		return
	end
	local character = player.Character
	if character and character:FindFirstChild("HumanoidRootPart") then
		character:PivotTo(ctx.World.Dimensions[dimIndex].LandingCFrame)
		ctx.Remotes.Popup(player, string.upper(dim.Name), "A new dimension! Unlock its zones at the gates.", { 200, 140, 255 })
	end
end

function Shop.ReturnToOverworld(player)
	local character = player.Character
	if character and character:FindFirstChild("HumanoidRootPart") then
		character:PivotTo(ctx.World.Dimensions[1].LandingCFrame)
	end
end

--------------------------------------------------------------------------
-- Gems fuer Robux (Developer Products)
--------------------------------------------------------------------------
local function findPack(packId)
	for _, pack in ipairs(Config.GemPacks) do
		if pack.Id == packId then
			return pack
		end
	end
	return nil
end

local function grantGemPack(player, profile, pack, isTest)
	ctx.Data.AddGems(profile, pack.Gems)
	local subtitle = "+" .. Calc.FormatNumber(pack.Gems) .. " Gems"
	if isTest then
		subtitle = subtitle .. "  (Studio test)"
	end
	ctx.Remotes.Popup(player, "💎 GEMS ADDED!", subtitle, { 120, 220, 255 })
	ctx.Remotes.Fire("Event", player, "Purchased")
	ctx.Data.Push(player, true)
end

function Shop.BuyGemPack(player, packId)
	local profile = ctx.Data.Get(player)
	local pack = type(packId) == "string" and findPack(packId)
	if not profile or not pack then
		return
	end
	if (tonumber(pack.ProductId) or 0) <= 0 then
		if RunService:IsStudio() then
			grantGemPack(player, profile, pack, true)
		else
			ctx.Remotes.Notify(player, "💎 Gem packs are coming soon!", { 255, 220, 120 })
		end
		return
	end
	local ok, err = pcall(function()
		MarketplaceService:PromptProductPurchase(player, pack.ProductId)
	end)
	if not ok then
		warn("[SlapTheBlob] Product prompt failed: " .. tostring(err))
	end
end

-- Alle Developer Products: Gem-Pakete, Robux-Eier und Robux-Kisten
local function findProduct(productId)
	if not productId or productId == 0 then
		return nil
	end
	for _, pack in ipairs(Config.GemPacks) do
		if tonumber(pack.ProductId) == productId then
			return "Gems", pack
		end
	end
	for _, egg in ipairs(Config.RobuxEggs) do
		if tonumber(egg.ProductId) == productId then
			return "Egg", egg
		end
	end
	for _, crate in ipairs(Config.ItemCrates) do
		if crate.Currency == "Robux" and tonumber(crate.ProductId) == productId then
			return "Crate", crate
		end
	end
	return nil
end

local function grantProduct(player, profile, kind, def, isTest)
	if kind == "Gems" then
		grantGemPack(player, profile, def, isTest)
	elseif kind == "Egg" then
		ctx.Pets.GrantEgg(player, profile, def.Id, 1)
		if isTest then
			ctx.Remotes.Notify(player, "🥚 " .. def.Name .. " (Studio test)", { 255, 220, 120 })
		end
	elseif kind == "Crate" then
		ctx.Items.GrantCrate(player, profile, def)
		if isTest then
			ctx.Remotes.Notify(player, "🎁 " .. def.Name .. " (Studio test)", { 255, 220, 120 })
		end
	end
end

-- Kauf starten (ID 0 = in Studio gratis testen)
local function promptProduct(player, kind, def)
	local profile = ctx.Data.Get(player)
	if not profile then
		return
	end
	if (tonumber(def.ProductId) or 0) <= 0 then
		if RunService:IsStudio() then
			grantProduct(player, profile, kind, def, true)
		else
			ctx.Remotes.Notify(player, "🛒 This item is coming soon!", { 255, 220, 120 })
		end
		return
	end
	local ok, err = pcall(function()
		MarketplaceService:PromptProductPurchase(player, def.ProductId)
	end)
	if not ok then
		warn("[SlapTheBlob] Product prompt failed: " .. tostring(err))
	end
end

function Shop.BuyRobuxEgg(player, eggId)
	for _, egg in ipairs(Config.RobuxEggs) do
		if egg.Id == eggId then
			promptProduct(player, "Egg", egg)
			return
		end
	end
end

function Shop.BuyCrate(player, crateId)
	local crate = type(crateId) == "string" and ctx.Items.CrateById(crateId)
	if not crate then
		return
	end
	if crate.Currency == "Robux" then
		promptProduct(player, "Crate", crate)
	else
		ctx.Items.OpenCrate(player, crateId)
	end
end

-- Roblox ruft das fuer jeden Robux-Kauf auf (auch nach einem Absturz erneut,
-- bis wir PurchaseGranted zurueckgeben). Jeder Kauf wird genau einmal gutgeschrieben.
local function processReceipt(info)
	local kind, def = findProduct(info.ProductId)
	if not kind then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local player = Players:GetPlayerByUserId(info.PlayerId)
	local profile = player and ctx.Data.Get(player)
	if not profile or not profile.Loaded then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if ctx.Data.HasStore() and not profile.CanSave then
		-- Spielstand nicht sicher geladen: spaeter nochmal versuchen
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = profile.Data
	local purchaseId = tostring(info.PurchaseId)
	if data.Receipts[purchaseId] then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	-- Zustand merken, um bei einem Speicherfehler alles zurueckzunehmen
	local before = { Gems = data.Gems, Pets = #data.Pets, Items = #data.Items, NextPetUid = data.NextPetUid, NextItemUid = data.NextItemUid }
	data.Receipts[purchaseId] = os.time()
	local ok, err = pcall(grantProduct, player, profile, kind, def, false)
	if ok and ctx.Data.HasStore() then
		ok = ctx.Data.Save(profile)
		err = "save failed"
	end
	if not ok then
		warn("[SlapTheBlob] Purchase " .. purchaseId .. " not granted: " .. tostring(err))
		data.Receipts[purchaseId] = nil
		data.Gems = before.Gems
		for i = #data.Pets, before.Pets + 1, -1 do
			table.remove(data.Pets, i)
		end
		for i = #data.Items, before.Items + 1, -1 do
			table.remove(data.Items, i)
		end
		data.NextPetUid = before.NextPetUid
		data.NextItemUid = before.NextItemUid
		ctx.Pets.UpdateAttribute(player)
		ctx.Items.ApplyCharacter(player)
		ctx.Data.Push(player, true)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end
Shop.ProcessReceipt = processReceipt

function Shop.Init(context)
	ctx = context
	ctx.RegisterAction("BuyUpgrade", Shop.BuyUpgrade)
	ctx.RegisterAction("BuyUpgradeMax", Shop.BuyUpgradeMax)
	ctx.RegisterAction("BuyHand", Shop.BuyHand)
	ctx.RegisterAction("EquipHand", Shop.EquipHand)
	ctx.RegisterAction("UnlockZone", Shop.UnlockZone)
	ctx.RegisterAction("Teleport", Shop.Teleport)
	ctx.RegisterAction("Rebirth", Shop.Rebirth)
	ctx.RegisterAction("BuyGemItem", Shop.BuyGemItem)
	ctx.RegisterAction("ToggleAutoSlap", Shop.ToggleAutoSlap)
	ctx.RegisterAction("SetSetting", Shop.SetSetting)
	ctx.RegisterAction("BuyGemPack", Shop.BuyGemPack)
	ctx.RegisterAction("BuyRobuxEgg", Shop.BuyRobuxEgg)
	ctx.RegisterAction("BuyCrate", Shop.BuyCrate)
end

function Shop.Start()
	MarketplaceService.ProcessReceipt = processReceipt
	for dimIndex, dimInfo in pairs(ctx.World.Dimensions) do
		if dimInfo.ReturnPrompt then
			dimInfo.ReturnPrompt.Triggered:Connect(function(player)
				Shop.ReturnToOverworld(player)
			end)
		end
	end
	for _, zoneInfo in ipairs(ctx.World.Zones) do
		if zoneInfo.PortalPrompt then
			local dimIndex = zoneInfo.PortalPrompt:GetAttribute("Dimension")
			zoneInfo.PortalPrompt.Triggered:Connect(function(player)
				Shop.EnterDimension(player, dimIndex)
			end)
		end
	end
	-- Robux-Kauf abgeschlossen
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		local profile = ctx.Data.Get(player)
		if not profile then
			return
		end
		for _, hand in ipairs(Config.Hands) do
			if hand.Currency == "Robux" and tonumber(hand.GamePassId) == passId then
				grantRobuxHand(player, profile, hand, false)
			end
		end
	end)

	-- Tor-Prompts
	for _, zoneInfo in ipairs(ctx.World.Zones) do
		if zoneInfo.GatePrompt then
			local index = zoneInfo.Index
			zoneInfo.GatePrompt.Triggered:Connect(function(player)
				Shop.UnlockZone(player, index)
			end)
		end
	end
end

return Shop
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">Trade</string><ProtectedString name="Source"><![CDATA[--[[
	Trade: Pets zwischen Spielern tauschen.

	Ablauf:
	  1. Spieler A schickt eine Anfrage an B
	  2. B nimmt an -> beide sehen das Handelsfenster
	  3. Jeder waehlt bis zu 8 Pets
	  4. Beide druecken "Bereit" -> 3 Sekunden Countdown
	  5. Beide bestaetigen -> der Server prueft alles nochmal und tauscht

	Jede Aenderung am Angebot setzt "Bereit" bei beiden zurueck (Schutz vor Betrug).
	Alles wird auf dem Server geprueft, der Client zeigt nur an.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("SlapShared")
local Config = require(Shared:WaitForChild("Config"))
local Calc = require(Shared:WaitForChild("Calc"))

local Trade = {}
local ctx

local T = Config.Trade
local RED = { 255, 120, 120 }
local GREEN = { 120, 255, 140 }

local requests = {} -- [Ziel-Spieler] = { [Absender-Spieler] = Zeit }
local trades = {} -- [Spieler] = Handel

function Trade.IsTrading(player)
	return trades[player] ~= nil
end

local function partner(trade, player)
	if trade.A == player then
		return trade.B
	end
	return trade.A
end

local function findPet(data, uid)
	for i, pet in ipairs(data.Pets) do
		if pet.Uid == uid then
			return pet, i
		end
	end
	return nil
end

local function offerPayload(data, uids)
	local list = {}
	for _, uid in ipairs(uids) do
		local pet = findPet(data, uid)
		if pet then
			table.insert(list, { Uid = pet.Uid, Id = pet.Id })
		end
	end
	return list
end

local function push(trade)
	local now = os.clock()
	for _, player in ipairs({ trade.A, trade.B }) do
		local other = partner(trade, player)
		local myProfile = ctx.Data.Get(player)
		local otherProfile = ctx.Data.Get(other)
		if myProfile and otherProfile then
			ctx.Remotes.Fire("Trade", player, {
				Kind = "Update",
				Partner = other.DisplayName,
				MyOffer = offerPayload(myProfile.Data, trade.Offers[player]),
				TheirOffer = offerPayload(otherProfile.Data, trade.Offers[other]),
				MyReady = trade.Ready[player] == true,
				TheirReady = trade.Ready[other] == true,
				MyConfirmed = trade.Confirmed[player] == true,
				TheirConfirmed = trade.Confirmed[other] == true,
				CountdownLeft = trade.CountdownEnd and math.max(0, trade.CountdownEnd - now) or nil,
			})
		end
	end
end

local function close(trade, reason)
	if trade.Closed then
		return
	end
	trade.Closed = true
	for _, player in ipairs({ trade.A, trade.B }) do
		if trades[player] == trade then
			trades[player] = nil
		end
		ctx.Remotes.Fire("Trade", player, { Kind = "Closed", Reason = reason })
	end
end

local function resetReady(trade)
	trade.Ready = {}
	trade.Confirmed = {}
	trade.CountdownEnd = nil
end

function Trade.Request(player, targetUserId)
	local profile = ctx.Data.Get(player)
	if not profile or type(targetUserId) ~= "number" then
		return
	end
	local target = Players:GetPlayerByUserId(targetUserId)
	if not target or target == player or not ctx.Data.Get(target) then
		return
	end
	if trades[player] or trades[target] then
		ctx.Remotes.Notify(player, "🤝 One of you is already trading.", RED)
		return
	end
	if ctx.Duel.IsInDuel(player) or ctx.Duel.IsInDuel(target) then
		ctx.Remotes.Notify(player, "🤝 You can't trade during a duel.", RED)
		return
	end
	local now = os.clock()
	if profile.LastTradeRequest and now - profile.LastTradeRequest < 3 then
		return
	end
	profile.LastTradeRequest = now
	requests[target] = requests[target] or {}
	requests[target][player] = now
	ctx.Remotes.Fire("Trade", target, { Kind = "Request", FromUserId = player.UserId, FromName = player.DisplayName, Timeout = T.RequestTimeout })
	ctx.Remotes.Notify(player, "🤝 Trade request sent to " .. target.DisplayName .. ".", GREEN)
end

function Trade.Respond(player, fromUserId, accept)
	if type(fromUserId) ~= "number" then
		return
	end
	local from = Players:GetPlayerByUserId(fromUserId)
	local pending = requests[player]
	local sentAt = pending and from and pending[from]
	if pending and from then
		pending[from] = nil
	end
	if not from or not sentAt or os.clock() - sentAt > T.RequestTimeout then
		ctx.Remotes.Notify(player, "🤝 That trade request expired.", RED)
		return
	end
	if accept ~= true then
		ctx.Remotes.Notify(from, "🤝 " .. player.DisplayName .. " declined your trade.", RED)
		return
	end
	if trades[player] or trades[from] or not ctx.Data.Get(from) or not ctx.Data.Get(player) then
		ctx.Remotes.Notify(player, "🤝 The trade could not start.", RED)
		return
	end
	if ctx.Duel.IsInDuel(player) or ctx.Duel.IsInDuel(from) then
		return
	end
	local trade = { A = from, B = player, Offers = { [from] = {}, [player] = {} }, Ready = {}, Confirmed = {}, CountdownEnd = nil, Closed = false }
	trades[from] = trade
	trades[player] = trade
	push(trade)
end

function Trade.SetOffer(player, uids)
	local trade = trades[player]
	local profile = ctx.Data.Get(player)
	if not trade or not profile or type(uids) ~= "table" then
		return
	end
	local clean = {}
	local seen = {}
	for _, uid in ipairs(uids) do
		if #clean >= T.MaxPets then
			break
		end
		if type(uid) == "number" and not seen[uid] and findPet(profile.Data, uid) then
			seen[uid] = true
			table.insert(clean, uid)
		end
	end
	trade.Offers[player] = clean
	resetReady(trade)
	push(trade)
end

function Trade.SetReady(player, ready)
	local trade = trades[player]
	if not trade then
		return
	end
	trade.Ready[player] = ready == true
	trade.Confirmed = {}
	if trade.Ready[trade.A] and trade.Ready[trade.B] then
		trade.CountdownEnd = os.clock() + T.Countdown
		local myTrade = trade
		task.delay(T.Countdown + 0.05, function()
			if not myTrade.Closed and trades[myTrade.A] == myTrade then
				push(myTrade)
			end
		end)
	else
		trade.CountdownEnd = nil
	end
	push(trade)
end

local function execute(trade)
	local a, b = trade.A, trade.B
	local pa, pb = ctx.Data.Get(a), ctx.Data.Get(b)
	if not pa or not pb then
		close(trade, "A player left.")
		return
	end
	-- nochmal alles pruefen
	for _, side in ipairs({ { pa, trade.Offers[a] }, { pb, trade.Offers[b] } }) do
		for _, uid in ipairs(side[2]) do
			if not findPet(side[1].Data, uid) then
				close(trade, "A pet in the trade is gone.")
				return
			end
		end
	end
	local sizeA = #pa.Data.Pets - #trade.Offers[a] + #trade.Offers[b]
	local sizeB = #pb.Data.Pets - #trade.Offers[b] + #trade.Offers[a]
	if sizeA > Calc.GetInventorySize(pa.Data) or sizeB > Calc.GetInventorySize(pb.Data) then
		close(trade, "Not enough pet storage.")
		return
	end
	if #trade.Offers[a] == 0 and #trade.Offers[b] == 0 then
		close(trade, "Nothing to trade.")
		return
	end

	local function take(profile, uids)
		local taken = {}
		for _, uid in ipairs(uids) do
			local pet, index = findPet(profile.Data, uid)
			if pet then
				table.remove(profile.Data.Pets, index)
				table.insert(taken, pet.Id)
			end
		end
		return taken
	end
	local function give(profile, petIds)
		for _, petId in ipairs(petIds) do
			table.insert(profile.Data.Pets, { Uid = profile.Data.NextPetUid, Id = petId, Equipped = false })
			profile.Data.NextPetUid = profile.Data.NextPetUid + 1
		end
	end
	local fromA = take(pa, trade.Offers[a])
	local fromB = take(pb, trade.Offers[b])
	give(pa, fromB)
	give(pb, fromA)
	pa.Data.TotalTrades = (pa.Data.TotalTrades or 0) + 1
	pb.Data.TotalTrades = (pb.Data.TotalTrades or 0) + 1

	close(trade, "Done")
	for _, info in ipairs({ { a, pa, #fromB }, { b, pb, #fromA } }) do
		local player, profile, count = info[1], info[2], info[3]
		ctx.Pets.UpdateAttribute(player)
		ctx.Remotes.Popup(player, "TRADE COMPLETE!", "You got " .. count .. " pet" .. (count == 1 and "" or "s") .. ".", { 120, 255, 160 })
		ctx.Remotes.Fire("Event", player, "Purchased")
		ctx.Data.Push(player, true)
		task.spawn(ctx.Data.Save, profile)
	end
end

function Trade.Confirm(player)
	local trade = trades[player]
	if not trade or not trade.CountdownEnd then
		return
	end
	if not (trade.Ready[trade.A] and trade.Ready[trade.B]) or os.clock() < trade.CountdownEnd then
		return
	end
	trade.Confirmed[player] = true
	if trade.Confirmed[trade.A] and trade.Confirmed[trade.B] then
		execute(trade)
	else
		push(trade)
	end
end

function Trade.Cancel(player)
	local trade = trades[player]
	if trade then
		close(trade, player.DisplayName .. " cancelled the trade.")
	end
end

function Trade.OnLeave(player)
	requests[player] = nil
	for _, pending in pairs(requests) do
		pending[player] = nil
	end
	local trade = trades[player]
	if trade then
		close(trade, player.DisplayName .. " left the game.")
	end
end

function Trade.Init(context)
	ctx = context
	ctx.RegisterAction("TradeRequest", Trade.Request)
	ctx.RegisterAction("TradeRespond", Trade.Respond)
	ctx.RegisterAction("TradeSetOffer", Trade.SetOffer)
	ctx.RegisterAction("TradeReady", Trade.SetReady)
	ctx.RegisterAction("TradeConfirm", Trade.Confirm)
	ctx.RegisterAction("TradeCancel", Trade.Cancel)
end

return Trade
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">World</string><ProtectedString name="Source"><![CDATA[--[[
	World: baut die komplette Karte per Skript.
	  * Hub mit Spawn, Brunnen, Schildern, Bestenlisten und PvP-Arena
	  * 6 Themen-Zonen mit Deko, Eingangsbogen, Tor, Ei-Stand und Gyatt-Plaetzen
	  * Licht & Atmosphaere
]]

local Lighting = game:GetService("Lighting")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("SlapShared")
local Config = require(Shared:WaitForChild("Config"))
local Calc = require(Shared:WaitForChild("Calc"))

local World = {}
World.FloorTop = 1
World.Zones = {}

local FLOOR = World.FloorTop
local HALF_WIDTH = Config.ZoneWidth / 2

--------------------------------------------------------------------------
-- Bau-Helfer
--------------------------------------------------------------------------
local function rgb(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

local function material(name)
	local ok, result = pcall(function()
		return Enum.Material[name]
	end)
	if ok and result then
		return result
	end
	return Enum.Material.SmoothPlastic
end

local function part(props)
	local p = Instance.new(props.ClassName or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for key, value in pairs(props) do
		if key ~= "ClassName" and key ~= "Parent" then
			p[key] = value
		end
	end
	p.Parent = props.Parent
	return p
end

-- Ball
local function ball(parent, position, diameter, color, mat)
	return part({
		Name = "Ball",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(diameter, diameter, diameter),
		CFrame = CFrame.new(position),
		Color = color,
		Material = mat or Enum.Material.SmoothPlastic,
		Parent = parent,
	})
end

-- Aufrechter Zylinder (Roblox-Zylinder liegen standardmaessig auf der X-Achse)
local function pillar(parent, bottomPosition, height, diameter, color, mat)
	return part({
		Name = "Pillar",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, diameter, diameter),
		CFrame = CFrame.new(bottomPosition + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Material = mat or Enum.Material.SmoothPlastic,
		Parent = parent,
	})
end

-- Flache Scheibe (liegender Zylinder)
local function disc(parent, centerPosition, thickness, diameter, color, mat)
	return part({
		Name = "Disc",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(thickness, diameter, diameter),
		CFrame = CFrame.new(centerPosition) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Material = mat or Enum.Material.SmoothPlastic,
		Parent = parent,
	})
end

local function addLight(target, color, range, brightness)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range or 12
	light.Brightness = brightness or 1.5
	light.Parent = target
	return light
end

-- Schild mit Text. face = Seite, auf der der Text steht.
local function sign(parent, cframe, size, text, textColor, backColor, face)
	local board = part({
		Name = "Sign",
		Size = size,
		CFrame = cframe,
		Color = backColor or Color3.fromRGB(45, 25, 55),
		Parent = parent,
	})
	local gui = Instance.new("SurfaceGui")
	gui.Face = face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0
	gui.Parent = board
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextWrapped = true
	label.TextColor3 = textColor or Color3.fromRGB(255, 255, 255)
	label.TextStrokeTransparency = 0.4
	label.Text = text
	label.Parent = gui
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0.04, 0)
	padding.PaddingRight = UDim.new(0.04, 0)
	padding.PaddingTop = UDim.new(0.06, 0)
	padding.PaddingBottom = UDim.new(0.06, 0)
	padding.Parent = label
	return board, label
end

local function folder(name, parent)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

--------------------------------------------------------------------------
-- Deko pro Thema
--------------------------------------------------------------------------
local decor = {}

function decor.tree(parent, pos, rng)
	local height = rng:NextNumber(7, 12)
	pillar(parent, pos, height, rng:NextNumber(1.4, 2.2), Color3.fromRGB(110, 70, 40), Enum.Material.Wood)
	local leafColor = Color3.fromRGB(rng:NextInteger(50, 90), rng:NextInteger(150, 200), rng:NextInteger(60, 90))
	local top = pos + Vector3.new(0, height, 0)
	ball(parent, top, rng:NextNumber(6, 8), leafColor, Enum.Material.Grass)
	ball(parent, top + Vector3.new(1.8, -1.2, 0.5), rng:NextNumber(4, 5), leafColor, Enum.Material.Grass)
	ball(parent, top + Vector3.new(-1.6, -1, -0.8), rng:NextNumber(4, 5), leafColor, Enum.Material.Grass)
end

function decor.flower(parent, pos, rng)
	local colors = { { 255, 90, 140 }, { 255, 220, 60 }, { 160, 120, 255 }, { 255, 255, 255 }, { 255, 140, 60 } }
	local c = colors[rng:NextInteger(1, #colors)]
	pillar(parent, pos, 1.6, 0.25, Color3.fromRGB(60, 160, 60))
	ball(parent, pos + Vector3.new(0, 1.8, 0), 0.9, rgb(c))
	ball(parent, pos + Vector3.new(0, 1.8, 0), 0.45, Color3.fromRGB(255, 230, 90))
end

function decor.bush(parent, pos, rng)
	local color = Color3.fromRGB(60, rng:NextInteger(140, 180), 70)
	ball(parent, pos + Vector3.new(0, 1.2, 0), 3, color, Enum.Material.Grass)
	ball(parent, pos + Vector3.new(1.3, 0.9, 0.4), 2.2, color, Enum.Material.Grass)
	ball(parent, pos + Vector3.new(-1.2, 0.9, -0.3), 2.2, color, Enum.Material.Grass)
end

function decor.rock(parent, pos, rng, color, mat)
	local s = rng:NextNumber(1.5, 4)
	part({
		Name = "Rock",
		Size = Vector3.new(s * rng:NextNumber(1, 1.6), s * rng:NextNumber(0.6, 1), s),
		CFrame = CFrame.new(pos + Vector3.new(0, s * 0.3, 0)) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 6.28), rng:NextNumber(-0.3, 0.3)),
		Color = color or Color3.fromRGB(130, 130, 135),
		Material = mat or Enum.Material.Slate,
		Parent = parent,
	})
end

function decor.cactus(parent, pos, rng)
	local green = Color3.fromRGB(70, 160, 70)
	local h = rng:NextNumber(5, 9)
	pillar(parent, pos, h, 1.6, green, Enum.Material.Grass)
	ball(parent, pos + Vector3.new(0, h, 0), 1.6, green, Enum.Material.Grass)
	local armH = h * 0.5
	part({ Name = "Arm", Size = Vector3.new(1.6, 1.1, 1.1), CFrame = CFrame.new(pos + Vector3.new(1.3, armH, 0)), Color = green, Material = Enum.Material.Grass, Parent = parent })
	pillar(parent, pos + Vector3.new(2, armH - 0.5, 0), 2.6, 1.1, green, Enum.Material.Grass)
	part({ Name = "Arm", Size = Vector3.new(1.6, 1.1, 1.1), CFrame = CFrame.new(pos + Vector3.new(-1.3, armH + 1, 0)), Color = green, Material = Enum.Material.Grass, Parent = parent })
	pillar(parent, pos + Vector3.new(-2, armH + 0.5, 0), 2, 1.1, green, Enum.Material.Grass)
	ball(parent, pos + Vector3.new(0.3, h + 0.6, 0.3), 0.7, Color3.fromRGB(255, 100, 160))
end

function decor.pyramid(parent, pos, rng)
	local base = rng:NextNumber(14, 22)
	local steps = 6
	for i = 0, steps - 1 do
		local s = base * (1 - i / steps)
		part({
			Name = "PyramidStep",
			Size = Vector3.new(s, base / steps * 0.8, s),
			CFrame = CFrame.new(pos + Vector3.new(0, (i + 0.5) * base / steps * 0.8, 0)),
			Color = Color3.fromRGB(225, 190, 120),
			Material = Enum.Material.Sandstone,
			Parent = parent,
		})
	end
end

function decor.palm(parent, pos, rng)
	local h = rng:NextNumber(9, 13)
	pillar(parent, pos, h, 1.3, Color3.fromRGB(150, 110, 60), Enum.Material.Wood)
	for i = 1, 5 do
		local angle = (i / 5) * math.pi * 2
		part({
			Name = "Leaf",
			Size = Vector3.new(7, 0.3, 1.8),
			CFrame = CFrame.new(pos + Vector3.new(0, h, 0)) * CFrame.Angles(0, angle, math.rad(-20)) * CFrame.new(3.2, 0, 0),
			Color = Color3.fromRGB(70, 170, 70),
			Material = Enum.Material.Grass,
			Parent = parent,
		})
	end
	ball(parent, pos + Vector3.new(0.6, h - 0.5, 0), 1, Color3.fromRGB(120, 80, 40))
end

function decor.iceSpike(parent, pos, rng)
	local h = rng:NextNumber(5, 12)
	part({
		Name = "IceSpike",
		Size = Vector3.new(h * 0.25, h, h * 0.25),
		CFrame = CFrame.new(pos + Vector3.new(0, h / 2 - 0.5, 0)) * CFrame.Angles(rng:NextNumber(-0.25, 0.25), rng:NextNumber(0, 6.28), rng:NextNumber(-0.25, 0.25)),
		Color = Color3.fromRGB(170, 220, 255),
		Material = Enum.Material.Ice,
		Transparency = 0.15,
		Parent = parent,
	})
end

function decor.snowman(parent, pos, rng)
	local white = Color3.fromRGB(250, 250, 255)
	ball(parent, pos + Vector3.new(0, 1.8, 0), 4, white, Enum.Material.Snow)
	ball(parent, pos + Vector3.new(0, 4.6, 0), 3, white, Enum.Material.Snow)
	ball(parent, pos + Vector3.new(0, 6.7, 0), 2.1, white, Enum.Material.Snow)
	ball(parent, pos + Vector3.new(-0.4, 7, -0.95), 0.35, Color3.fromRGB(20, 20, 20))
	ball(parent, pos + Vector3.new(0.4, 7, -0.95), 0.35, Color3.fromRGB(20, 20, 20))
	part({ Name = "Carrot", Size = Vector3.new(0.3, 0.3, 1.2), CFrame = CFrame.new(pos + Vector3.new(0, 6.7, -1.4)), Color = Color3.fromRGB(255, 140, 30), Parent = parent })
	part({ Name = "Hat", Size = Vector3.new(1.6, 1.4, 1.6), CFrame = CFrame.new(pos + Vector3.new(0, 8.3, 0)), Color = Color3.fromRGB(30, 30, 35), Parent = parent })
	part({ Name = "HatRim", Size = Vector3.new(2.4, 0.2, 2.4), CFrame = CFrame.new(pos + Vector3.new(0, 7.6, 0)), Color = Color3.fromRGB(30, 30, 35), Parent = parent })
end

function decor.pine(parent, pos, rng)
	pillar(parent, pos, 3, 1.2, Color3.fromRGB(100, 70, 40), Enum.Material.Wood)
	local green = Color3.fromRGB(40, 110, 70)
	for i = 0, 3 do
		local s = 7 - i * 1.6
		part({
			Name = "PineLayer",
			Size = Vector3.new(s, 2, s),
			CFrame = CFrame.new(pos + Vector3.new(0, 3.5 + i * 2, 0)) * CFrame.Angles(0, math.rad(45 * i), 0),
			Color = green,
			Material = Enum.Material.Grass,
			Parent = parent,
		})
		part({
			Name = "Snow",
			Size = Vector3.new(s * 0.8, 0.3, s * 0.8),
			CFrame = CFrame.new(pos + Vector3.new(0, 4.6 + i * 2, 0)) * CFrame.Angles(0, math.rad(45 * i), 0),
			Color = Color3.fromRGB(250, 250, 255),
			Material = Enum.Material.Snow,
			Parent = parent,
		})
	end
end

function decor.lavaPool(parent, pos, rng)
	local d = rng:NextNumber(6, 12)
	local pool = disc(parent, pos + Vector3.new(0, 0.12, 0), 0.25, d, Color3.fromRGB(255, 100, 20), Enum.Material.Neon)
	pool.CanCollide = false
	disc(parent, pos + Vector3.new(0, 0.05, 0), 0.2, d + 1.5, Color3.fromRGB(40, 30, 30), Enum.Material.Basalt)
	addLight(pool, Color3.fromRGB(255, 120, 40), d + 6, 2)
end

function decor.volcano(parent, pos, rng)
	local rock = Color3.fromRGB(60, 40, 38)
	for i = 0, 4 do
		local d = 34 - i * 6
		pillar(parent, pos + Vector3.new(0, i * 5, 0), 5, d, rock, Enum.Material.Basalt)
	end
	local top = disc(parent, pos + Vector3.new(0, 25.2, 0), 0.4, 8, Color3.fromRGB(255, 90, 10), Enum.Material.Neon)
	local fire = Instance.new("Fire")
	fire.Size = 25
	fire.Heat = 20
	fire.Parent = top
	local smoke = Instance.new("Smoke")
	smoke.Size = 20
	smoke.RiseVelocity = 8
	smoke.Opacity = 0.15
	smoke.Color = Color3.fromRGB(70, 60, 60)
	smoke.Parent = top
	addLight(top, Color3.fromRGB(255, 100, 30), 40, 3)
end

function decor.cloud(parent, pos, rng)
	local white = Color3.fromRGB(255, 255, 255)
	local lift = rng:NextNumber(0, 6)
	for i = 1, rng:NextInteger(3, 5) do
		local p = ball(parent, pos + Vector3.new(rng:NextNumber(-4, 4), 2 + lift + rng:NextNumber(0, 2), rng:NextNumber(-3, 3)), rng:NextNumber(3.5, 6), white, Enum.Material.SmoothPlastic)
		p.CanCollide = false
	end
end

function decor.goldPillar(parent, pos, rng)
	local h = rng:NextNumber(8, 14)
	pillar(parent, pos, 1, 4, Color3.fromRGB(255, 215, 120), Enum.Material.Foil)
	pillar(parent, pos + Vector3.new(0, 1, 0), h, 2.4, Color3.fromRGB(250, 245, 235), Enum.Material.Marble)
	pillar(parent, pos + Vector3.new(0, h + 1, 0), 1, 4, Color3.fromRGB(255, 215, 120), Enum.Material.Foil)
end

function decor.rainbow(parent, pos)
	local colors = { { 255, 60, 60 }, { 255, 150, 40 }, { 255, 230, 60 }, { 80, 220, 90 }, { 70, 160, 255 }, { 160, 90, 255 } }
	for band, c in ipairs(colors) do
		local radius = 26 - band * 1.6
		for step = 0, 12 do
			local angle = math.pi * step / 12
			local p = part({
				Name = "Rainbow",
				Size = Vector3.new(1.6, 1.6, 7.5),
				CFrame = CFrame.new(pos + Vector3.new(math.cos(angle) * radius, math.sin(angle) * radius, 0)) * CFrame.Angles(0, 0, angle) * CFrame.Angles(0, math.rad(90), 0),
				Color = rgb(c),
				Material = Enum.Material.Neon,
				CanCollide = false,
				Parent = parent,
			})
			p.CastShadow = false
		end
	end
end

function decor.star(parent, pos, rng)
	local colors = { { 255, 255, 200 }, { 200, 220, 255 }, { 255, 200, 255 } }
	local p = ball(parent, pos + Vector3.new(0, rng:NextNumber(8, 30), 0), rng:NextNumber(0.6, 1.6), rgb(colors[rng:NextInteger(1, #colors)]), Enum.Material.Neon)
	p.CanCollide = false
	p.CastShadow = false
end

function decor.planet(parent, pos, rng)
	local colors = { { 255, 140, 90 }, { 120, 200, 255 }, { 200, 120, 255 }, { 120, 255, 180 } }
	local d = rng:NextNumber(10, 18)
	local center = pos + Vector3.new(0, rng:NextNumber(25, 40), 0)
	local p = ball(parent, center, d, rgb(colors[rng:NextInteger(1, #colors)]), Enum.Material.SmoothPlastic)
	p.CanCollide = false
	local ring = part({
		Name = "PlanetRing",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, d * 1.7, d * 1.7),
		CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90)) * CFrame.Angles(math.rad(20), 0, 0),
		Color = Color3.fromRGB(240, 220, 255),
		Material = Enum.Material.Neon,
		Transparency = 0.5,
		CanCollide = false,
		Parent = parent,
	})
	ring.CastShadow = false
end

function decor.crystal(parent, pos, rng)
	local colors = { { 180, 90, 255 }, { 90, 220, 255 }, { 255, 90, 200 } }
	local c = rgb(colors[rng:NextInteger(1, #colors)])
	for i = 1, 3 do
		local h = rng:NextNumber(3, 8)
		local p = part({
			Name = "Crystal",
			Size = Vector3.new(h * 0.3, h, h * 0.3),
			CFrame = CFrame.new(pos + Vector3.new(rng:NextNumber(-1.5, 1.5), h / 2 - 0.3, rng:NextNumber(-1.5, 1.5))) * CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, 6.28), rng:NextNumber(-0.4, 0.4)),
			Color = c,
			Material = Enum.Material.Neon,
			Transparency = 0.2,
			Parent = parent,
		})
		if i == 1 then
			addLight(p, c, 10, 1)
		end
	end
end

-- ===== Candy =====
local CANDY_COLORS = { { 255, 90, 160 }, { 120, 220, 255 }, { 255, 230, 90 }, { 160, 255, 140 }, { 200, 130, 255 } }

function decor.lollipop(parent, pos, rng)
	local h = rng:NextNumber(6, 11)
	pillar(parent, pos, h, 0.6, Color3.fromRGB(255, 255, 255))
	local c = CANDY_COLORS[rng:NextInteger(1, #CANDY_COLORS)]
	local candy = part({
		Name = "Lollipop",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.8, 5, 5),
		CFrame = CFrame.new(pos + Vector3.new(0, h + 2, 0)) * CFrame.Angles(0, rng:NextNumber(0, 3), 0),
		Color = rgb(c),
		Material = Enum.Material.Glass,
		Parent = parent,
	})
	part({
		Name = "Swirl",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.9, 2.4, 2.4),
		CFrame = candy.CFrame,
		Color = Color3.fromRGB(255, 255, 255),
		Parent = parent,
	})
end

function decor.candyCane(parent, pos, rng)
	local h = rng:NextNumber(7, 12)
	local segments = math.floor(h / 1.2)
	for i = 0, segments - 1 do
		pillar(parent, pos + Vector3.new(0, i * 1.2, 0), 1.2, 1.2, (i % 2 == 0) and Color3.fromRGB(230, 30, 50) or Color3.fromRGB(255, 255, 255))
	end
	local top = pos + Vector3.new(0, segments * 1.2, 0)
	for i = 1, 4 do
		local angle = (i / 4) * math.pi
		ball(parent, top + Vector3.new(math.sin(angle) * 1.5 - 0, math.cos(angle) * 1.2, 0) + Vector3.new(1.5 - math.cos(angle) * 1.5 - 1.5, 0, 0), 1.3,
			(i % 2 == 0) and Color3.fromRGB(230, 30, 50) or Color3.fromRGB(255, 255, 255))
	end
end

function decor.gumdrop(parent, pos, rng)
	local c = CANDY_COLORS[rng:NextInteger(1, #CANDY_COLORS)]
	local d = rng:NextNumber(2.5, 4.5)
	local drop = ball(parent, pos + Vector3.new(0, d * 0.2, 0), d, rgb(c), Enum.Material.Glass)
	drop.Transparency = 0.15
end

function decor.cupcake(parent, pos, rng)
	local c = CANDY_COLORS[rng:NextInteger(1, #CANDY_COLORS)]
	pillar(parent, pos, 2.5, 4, Color3.fromRGB(200, 140, 90))
	ball(parent, pos + Vector3.new(0, 3.3, 0), 4.4, rgb(c))
	ball(parent, pos + Vector3.new(0, 5.4, 0), 1.2, Color3.fromRGB(220, 20, 40))
end

-- ===== Cyber =====
function decor.neonPillar(parent, pos, rng)
	local h = rng:NextNumber(8, 18)
	part({ Name = "CyberPillar", Size = Vector3.new(2.5, h, 2.5), CFrame = CFrame.new(pos + Vector3.new(0, h / 2, 0)), Color = Color3.fromRGB(25, 30, 50), Parent = parent })
	local stripe = part({ Name = "CyberStripe", Size = Vector3.new(2.7, h * 0.9, 0.4), CFrame = CFrame.new(pos + Vector3.new(0, h / 2, -1.2)),
		Color = Color3.fromRGB(0, 255, 230), Material = Enum.Material.Neon, Parent = parent })
	addLight(stripe, Color3.fromRGB(0, 255, 230), 10, 1)
end

function decor.holoCube(parent, pos, rng)
	local s = rng:NextNumber(1.5, 3.5)
	local cube = part({
		Name = "HoloCube",
		Size = Vector3.new(s, s, s),
		CFrame = CFrame.new(pos + Vector3.new(0, rng:NextNumber(3, 9), 0)) * CFrame.Angles(rng:NextNumber(0, 3), rng:NextNumber(0, 3), rng:NextNumber(0, 3)),
		Color = (rng:NextNumber() < 0.5) and Color3.fromRGB(255, 0, 200) or Color3.fromRGB(0, 200, 255),
		Material = Enum.Material.Neon,
		Transparency = 0.35,
		CanCollide = false,
		Parent = parent,
	})
	cube.CastShadow = false
end

function decor.serverTower(parent, pos, rng)
	local h = rng:NextNumber(6, 10)
	part({ Name = "Server", Size = Vector3.new(4, h, 3), CFrame = CFrame.new(pos + Vector3.new(0, h / 2, 0)), Color = Color3.fromRGB(35, 40, 55), Material = Enum.Material.Metal, Parent = parent })
	for y = 1, math.floor(h) - 1 do
		local light = part({ Name = "ServerLight", Size = Vector3.new(0.4, 0.3, 0.2), CFrame = CFrame.new(pos + Vector3.new(rng:NextNumber(-1.4, 1.4), y, -1.55)),
			Color = (rng:NextNumber() < 0.7) and Color3.fromRGB(60, 255, 120) or Color3.fromRGB(255, 60, 60), Material = Enum.Material.Neon, Parent = parent })
		light.CastShadow = false
	end
end

function decor.gridLine(parent, pos, rng)
	local line = part({ Name = "GridLine", Size = Vector3.new(0.3, 0.1, rng:NextNumber(15, 40)), CFrame = CFrame.new(pos + Vector3.new(0, 0.05, 0)),
		Color = Color3.fromRGB(0, 255, 230), Material = Enum.Material.Neon, CanCollide = false, Parent = parent })
	line.CastShadow = false
end

-- ===== Shadow =====
function decor.deadTree(parent, pos, rng)
	local h = rng:NextNumber(7, 12)
	local dark = Color3.fromRGB(35, 25, 40)
	pillar(parent, pos, h, 1.2, dark, Enum.Material.Wood)
	for i = 1, 4 do
		local y = h * (0.45 + i * 0.12)
		local angle = rng:NextNumber(0, 6.28)
		part({ Name = "Branch", Size = Vector3.new(0.5, 0.5, rng:NextNumber(3, 5)),
			CFrame = CFrame.new(pos + Vector3.new(0, y, 0)) * CFrame.Angles(0, angle, 0) * CFrame.Angles(math.rad(-30), 0, 0) * CFrame.new(0, 0, -2),
			Color = dark, Material = Enum.Material.Wood, Parent = parent })
	end
end

function decor.purpleLamp(parent, pos, rng)
	pillar(parent, pos, 7, 0.6, Color3.fromRGB(30, 20, 40), Enum.Material.Metal)
	local orb = ball(parent, pos + Vector3.new(0, 7.6, 0), 1.6, Color3.fromRGB(170, 60, 255), Enum.Material.Neon)
	addLight(orb, Color3.fromRGB(170, 60, 255), 18, 2)
end

-- ===== Void =====
function decor.floatingShard(parent, pos, rng)
	local h = rng:NextNumber(2, 7)
	local shard = part({
		Name = "VoidShard",
		Size = Vector3.new(h * 0.35, h, h * 0.35),
		CFrame = CFrame.new(pos + Vector3.new(0, rng:NextNumber(3, 16), 0)) * CFrame.Angles(rng:NextNumber(-0.6, 0.6), rng:NextNumber(0, 6), rng:NextNumber(-0.6, 0.6)),
		Color = Color3.fromRGB(15, 10, 25),
		Material = Enum.Material.Glass,
		CanCollide = false,
		Parent = parent,
	})
	shard.CastShadow = false
	local edge = part({ Name = "ShardGlow", Size = Vector3.new(h * 0.12, h * 1.02, h * 0.12), CFrame = shard.CFrame,
		Color = Color3.fromRGB(200, 150, 255), Material = Enum.Material.Neon, CanCollide = false, Parent = parent })
	edge.CastShadow = false
end

function decor.voidRing(parent, pos, rng)
	local r = rng:NextNumber(4, 7)
	local center = pos + Vector3.new(0, r + 2, 0)
	local yaw = rng:NextNumber(0, 3)
	for i = 0, 15 do
		local angle = (i / 16) * math.pi * 2
		local p = ball(parent, center + CFrame.Angles(0, yaw, 0):VectorToWorldSpace(Vector3.new(math.cos(angle) * r, math.sin(angle) * r, 0)), 0.9,
			Color3.fromRGB(255, 255, 255), Enum.Material.Neon)
		p.CanCollide = false
		p.CastShadow = false
	end
end

function decor.blackHole(parent, pos, rng)
	local center = pos + Vector3.new(0, 30, 0)
	local hole = ball(parent, center, 14, Color3.fromRGB(0, 0, 0), Enum.Material.SmoothPlastic)
	hole.CanCollide = false
	hole.CastShadow = false
	local ring = part({ Name = "AccretionDisk", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 30, 30),
		CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90)) * CFrame.Angles(math.rad(15), 0, 0),
		Color = Color3.fromRGB(190, 110, 255), Material = Enum.Material.Neon, Transparency = 0.4, CanCollide = false, Parent = parent })
	ring.CastShadow = false
	addLight(ring, Color3.fromRGB(190, 110, 255), 60, 2)
end

-- Welche Deko-Objekte pro Thema, mit Anzahl
local THEMES = {
	meadow = { { "tree", 22 }, { "flower", 60 }, { "bush", 18 }, { "rock", 10 } },
	desert = { { "cactus", 22 }, { "palm", 8 }, { "rock", 16, { 200, 160, 110 }, "Sandstone" }, { "pyramid", 2, nil, nil, true } },
	ice = { { "iceSpike", 35 }, { "pine", 16 }, { "snowman", 5 }, { "rock", 8, { 200, 220, 240 }, "Glacier" } },
	lava = { { "lavaPool", 14 }, { "rock", 30, { 50, 35, 35 }, "Basalt" }, { "volcano", 2, nil, nil, true } },
	cloud = { { "cloud", 26 }, { "goldPillar", 14 }, { "rainbow", 1, nil, nil, true } },
	space = { { "star", 70 }, { "crystal", 22 }, { "planet", 4, nil, nil, true }, { "rock", 10, { 70, 60, 90 }, "Slate" } },
	candy = { { "lollipop", 18 }, { "candyCane", 16 }, { "gumdrop", 30 }, { "cupcake", 10 } },
	cyber = { { "neonPillar", 16 }, { "holoCube", 20 }, { "serverTower", 10 }, { "gridLine", 12 } },
	shadow = { { "deadTree", 18 }, { "crystal", 14 }, { "purpleLamp", 10 }, { "rock", 16, { 40, 30, 55 }, "Slate" } },
