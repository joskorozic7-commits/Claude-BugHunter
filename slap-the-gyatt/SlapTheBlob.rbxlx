}

--------------------------------------------------------------------------
-- Haupt-Bau
--------------------------------------------------------------------------
local root

local function buildLighting()
	Lighting.ClockTime = 14.5
	Lighting.Brightness = 2.2
	Lighting.GlobalShadows = true
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 140, 160)
	Lighting.Ambient = Color3.fromRGB(80, 70, 90)
	Lighting.EnvironmentDiffuseScale = 0.5
	Lighting.EnvironmentSpecularScale = 0.5

	local function ensure(className, name)
		local existing = Lighting:FindFirstChild(name)
		if existing then
			existing:Destroy()
		end
		local effect = Instance.new(className)
		effect.Name = name
		effect.Parent = Lighting
		return effect
	end

	local atmosphere = ensure("Atmosphere", "SlapAtmosphere")
	atmosphere.Density = 0.28
	atmosphere.Offset = 0.1
	atmosphere.Color = Color3.fromRGB(255, 220, 235)
	atmosphere.Decay = Color3.fromRGB(150, 110, 160)
	atmosphere.Glare = 0.3
	atmosphere.Haze = 1.2

	local bloom = ensure("BloomEffect", "SlapBloom")
	bloom.Intensity = 0.7
	bloom.Size = 26
	bloom.Threshold = 1.4

	local color = ensure("ColorCorrectionEffect", "SlapColor")
	color.Saturation = 0.18
	color.Contrast = 0.06
	color.Brightness = 0.02

	local rays = ensure("SunRaysEffect", "SlapSunRays")
	rays.Intensity = 0.06
	rays.Spread = 0.8
end

-- Verkaufsstand (Kiosk). Oeffnet beim Benutzen ein Menue (Attribut OpenMenu).
World.Kiosks = {}
local function kiosk(parent, position, facing, title, icon, menu, color, sub)
	local k = folder("Kiosk_" .. menu, parent)
	local look = CFrame.lookAt(position, position + facing)
	local function at(x, y, z)
		return look * CFrame.new(x, y, z)
	end
	local wood = Color3.fromRGB(120, 80, 50)
	-- Theke
	part({ Name = "Counter", Size = Vector3.new(14, 3.4, 4), CFrame = at(0, FLOOR + 1.7, 0), Color = wood, Material = Enum.Material.Wood, Parent = k })
	part({ Name = "CounterTop", Size = Vector3.new(14.6, 0.4, 4.6), CFrame = at(0, FLOOR + 3.6, 0), Color = color, Material = Enum.Material.SmoothPlastic, Parent = k })
	-- Rueckwand + Pfosten
	part({ Name = "Back", Size = Vector3.new(14, 10, 0.6), CFrame = at(0, FLOOR + 5, 5), Color = Color3.fromRGB(70, 45, 90), Parent = k })
	for _, x in ipairs({ -6.8, 6.8 }) do
		part({ Name = "Post", Size = Vector3.new(0.8, 11, 0.8), CFrame = at(x, FLOOR + 5.5, -1.6), Color = wood, Material = Enum.Material.Wood, Parent = k })
	end
	-- gestreiftes Dach
	for i = 0, 6 do
		part({ Name = "Awning", Size = Vector3.new(2, 0.3, 8), CFrame = at(-6 + i * 2, FLOOR + 11.3, 1.6) * CFrame.Angles(math.rad(-14), 0, 0),
			Color = (i % 2 == 0) and color or Color3.fromRGB(255, 255, 255), Parent = k })
	end
	-- Schild
	local board = sign(k, at(0, FLOOR + 13.6, 1), Vector3.new(14, 3.2, 0.5), icon .. " " .. title, Color3.fromRGB(255, 255, 255), color, Enum.NormalId.Front)
	board.Name = "KioskSign"
	-- Ware auf der Theke
	local display = ball(k, at(0, FLOOR + 5.2, 0.5).Position, 2.6, color, Enum.Material.Neon)
	display.Name = "Display"
	display.CanCollide = false
	addLight(display, color, 16, 1.4)
	-- Verkaeufer-Blob
	local seller = ball(k, at(0, FLOOR + 5, 3).Position, 3.4, Color3.fromRGB(255, 190, 215), Enum.Material.SmoothPlastic)
	seller.Name = "Seller"
	for _, side in ipairs({ -1, 1 }) do
		ball(k, (at(side * 0.6, FLOOR + 5.6, 1.5)).Position, 0.8, Color3.fromRGB(255, 255, 255)).Name = "Eye"
		ball(k, (at(side * 0.6, FLOOR + 5.6, 1.2)).Position, 0.4, Color3.fromRGB(25, 20, 30)).Name = "Pupil"
	end
	local promptPart = part({ Name = "KioskPrompt", Size = Vector3.new(1, 1, 1), CFrame = at(0, FLOOR + 3, -3), Transparency = 1, CanCollide = false, Parent = k })
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "OpenPrompt"
	prompt.ActionText = "Open"
	prompt.ObjectText = title .. (sub and (" (" .. sub .. ")") or "")
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt:SetAttribute("OpenMenu", menu)
	prompt.Parent = promptPart
	table.insert(World.Kiosks, { Menu = menu, Prompt = prompt, Position = position })
	return k
end
World.BuildKiosk = kiosk

local KIOSKS = {
	{ -1, -15, "UPGRADES", "🛒", "Shop", { 255, 110, 180 }, "Slaps" },
	{ -1, -38, "GLOVES", "✋", "Hands", { 255, 170, 60 }, "Slaps / Gems / Robux" },
	{ -1, -61, "EGG SHOP", "🥚", "EggShop", { 120, 200, 255 }, "Gems / Robux" },
	{ 1, -15, "ITEM CRATES", "🎁", "ItemShop", { 170, 110, 255 }, "Slaps / Gems / Robux" },
	{ 1, -38, "GEM SHOP", "💎", "Gems", { 80, 230, 255 }, "Gems / Robux" },
	{ 1, -61, "FORGE", "🔨", "Items", { 255, 90, 90 }, "Merge items" },
}

local function buildHub()
	local hub = folder("Hub", root)
	local length = Config.HubLength

	part({
		Name = "HubFloor",
		Size = Vector3.new(Config.ZoneWidth, 2, length),
		CFrame = CFrame.new(0, FLOOR - 1, -length / 2),
		Color = Color3.fromRGB(240, 200, 220),
		Material = Enum.Material.Pebble,
		Parent = hub,
	})
	-- Weg zur ersten Zone + Marktplatz-Fliesen
	part({ Name = "HubPath", Size = Vector3.new(14, 0.1, length), CFrame = CFrame.new(0, FLOOR + 0.05, -length / 2),
		Color = Color3.fromRGB(255, 225, 240), Material = Enum.Material.Marble, CanCollide = false, Parent = hub })
	for _, side in ipairs({ -1, 1 }) do
		part({ Name = "MarketStrip", Size = Vector3.new(22, 0.1, 72), CFrame = CFrame.new(side * 66, FLOOR + 0.06, -38),
			Color = Color3.fromRGB(255, 170, 205), Material = Enum.Material.Marble, CanCollide = false, Parent = hub })
	end

	local spawnPos = Config.SpawnPosition
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "SlapSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(14, 1, 14)
	spawn.CFrame = CFrame.new(spawnPos[1], FLOOR + 0.5, spawnPos[2]) * CFrame.Angles(0, math.pi, 0)
	spawn.Color = Color3.fromRGB(255, 110, 180)
	spawn.Material = Enum.Material.Neon
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = hub
	World.Spawn = spawn

	-- Brunnen hinter dem Spawn
	local fx, fz = 0, -80
	pillar(hub, Vector3.new(fx, FLOOR, fz), 1.5, 16, Color3.fromRGB(230, 230, 240), Enum.Material.Marble)
	local water = disc(hub, Vector3.new(fx, FLOOR + 1.45, fz), 0.2, 14, Color3.fromRGB(110, 200, 255), Enum.Material.Glass)
	water.Transparency = 0.25
	water.CanCollide = false
	pillar(hub, Vector3.new(fx, FLOOR, fz), 5, 2, Color3.fromRGB(230, 230, 240), Enum.Material.Marble)
	local statue = ball(hub, Vector3.new(fx, FLOOR + 7.5, fz), 5, Color3.fromRGB(255, 170, 205), Enum.Material.Marble)
	local face = Instance.new("Decal")
	face.Texture = "rbxasset://textures/face.png"
	face.Face = Enum.NormalId.Front
	face.Parent = statue
	local sparkle = Instance.new("Sparkles")
	sparkle.SparkleColor = Color3.fromRGB(255, 200, 230)
	sparkle.Parent = statue

	-- Laternen am Weg
	for _, z in ipairs({ -10, -35, -60 }) do
		for _, side in ipairs({ -1, 1 }) do
			local base = Vector3.new(side * 12, FLOOR, z)
			pillar(hub, base, 9, 0.6, Color3.fromRGB(50, 40, 60), Enum.Material.Metal)
			local lamp = ball(hub, base + Vector3.new(0, 9.5, 0), 1.6, Color3.fromRGB(255, 230, 180), Enum.Material.Neon)
			addLight(lamp, Color3.fromRGB(255, 220, 170), 22, 1.6)
		end
	end

	-- Willkommens-Bogen ueber dem Weg (vom Spawn aus lesbar)
	for _, side in ipairs({ -1, 1 }) do
		pillar(hub, Vector3.new(side * 10, FLOOR, -4), 15, 1.6, Color3.fromRGB(255, 110, 180), Enum.Material.Neon)
	end
	sign(hub, CFrame.new(0, FLOOR + 16, -4), Vector3.new(24, 4, 0.8), "👋 SLAP THE BLOB → ZONE 1", Color3.fromRGB(255, 255, 255),
		Color3.fromRGB(120, 40, 100), Enum.NormalId.Front)

	-- Verkaufsstaende links und rechts
	for _, k in ipairs(KIOSKS) do
		local side = k[1]
		kiosk(hub, Vector3.new(side * 72, 0, k[2]), Vector3.new(-side, 0, 0), k[3], k[4], k[5], rgb(k[6]), k[7])
	end

	-- Bestenlisten
	World.Leaderboards = {}
	local function leaderboard(id, title, cframe, color)
		local board = part({
			Name = "Leaderboard_" .. id,
			Size = Vector3.new(14, 18, 1),
			CFrame = cframe,
			Color = Color3.fromRGB(35, 20, 45),
			Parent = hub,
		})
		part({ Name = "Frame", Size = Vector3.new(15, 19, 0.8), CFrame = cframe * CFrame.new(0, 0, 0.3), Color = color, Material = Enum.Material.Neon, Parent = hub })
		for _, offsetX in ipairs({ -5, 5 }) do
			local bottom = (cframe * CFrame.new(offsetX, -9, 0)).Position
			pillar(hub, Vector3.new(bottom.X, FLOOR, bottom.Z), bottom.Y - FLOOR, 1, Color3.fromRGB(60, 50, 70), Enum.Material.Metal)
		end

		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 35
		gui.LightInfluence = 0
		gui.Parent = board

		local titleLabel = Instance.new("TextLabel")
		titleLabel.Name = "Title"
		titleLabel.Size = UDim2.fromScale(1, 0.12)
		titleLabel.BackgroundColor3 = color
		titleLabel.Font = Enum.Font.FredokaOne
		titleLabel.TextScaled = true
		titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		titleLabel.TextStrokeTransparency = 0.3
		titleLabel.Text = title
		titleLabel.Parent = gui

		local rows = {}
		for i = 1, 10 do
			local row = Instance.new("TextLabel")
			row.Name = "Row" .. i
			row.Position = UDim2.fromScale(0.03, 0.13 + (i - 1) * 0.087)
			row.Size = UDim2.fromScale(0.94, 0.08)
			row.BackgroundColor3 = Color3.fromRGB(60, 35, 75)
			row.BackgroundTransparency = (i % 2 == 0) and 0.4 or 0.75
			row.Font = Enum.Font.GothamBold
			row.TextScaled = true
			row.TextXAlignment = Enum.TextXAlignment.Left
			row.TextColor3 = i == 1 and Color3.fromRGB(255, 215, 0) or (i == 2 and Color3.fromRGB(220, 220, 230) or (i == 3 and Color3.fromRGB(230, 150, 80) or Color3.fromRGB(240, 230, 250)))
			row.Text = "  " .. i .. ".  ..."
			row.Parent = gui
			rows[i] = row
		end
		World.Leaderboards[id] = rows
	end
	-- stehen rechts und schauen zur Mitte (-X)
	leaderboard("Earned", "🏆 MOST SLAPS", CFrame.new(72, FLOOR + 14, -85) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(255, 110, 180))
	leaderboard("Rebirths", "♻️ MOST REBIRTHS", CFrame.new(72, FLOOR + 14, -108) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(150, 90, 255))

	-- Siegertreppchen fuer die Top 3 (Spieler-Avatare werden vom Server draufgestellt)
	World.Podium = {}
	local podiumCenter = Vector3.new(38, FLOOR, -96)
	local steps = {
		{ Rank = 1, X = 0, H = 6, Color = Color3.fromRGB(255, 205, 40) },
		{ Rank = 2, X = -8, H = 4, Color = Color3.fromRGB(205, 210, 225) },
		{ Rank = 3, X = 8, H = 2.5, Color = Color3.fromRGB(215, 135, 70) },
	}
	part({ Name = "PodiumBase", Size = Vector3.new(28, 0.6, 12), CFrame = CFrame.new(podiumCenter + Vector3.new(0, 0.3, 0)), Color = Color3.fromRGB(70, 40, 90), Material = Enum.Material.Marble, Parent = hub })
	for _, st in ipairs(steps) do
		local pos = podiumCenter + Vector3.new(st.X, 0, 0)
		local block = part({ Name = "PodiumStep" .. st.Rank, Size = Vector3.new(7.6, st.H, 7.6), CFrame = CFrame.new(pos + Vector3.new(0, st.H / 2 + 0.6, 0)), Color = st.Color, Material = Enum.Material.Foil, Parent = hub })
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Front
		gui.LightInfluence = 0
		gui.Parent = block
		local num = Instance.new("TextLabel")
		num.Size = UDim2.fromScale(1, 1)
		num.BackgroundTransparency = 1
		num.Font = Enum.Font.FredokaOne
		num.TextScaled = true
		num.TextColor3 = Color3.fromRGB(255, 255, 255)
		num.TextStrokeTransparency = 0
		num.Text = tostring(st.Rank)
		num.Parent = gui
		-- Namensschild
		local billboard = Instance.new("BillboardGui")
		billboard.Name = "PodiumName"
		billboard.Size = UDim2.new(10, 0, 2.4, 0)
		billboard.StudsOffsetWorldSpace = Vector3.new(0, st.H / 2 + 8.5, 0)
		billboard.MaxDistance = 90
		billboard.LightInfluence = 0
		billboard.Parent = block
		local label = Instance.new("TextLabel")
		label.Name = "Text"
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = st.Color
		label.TextStrokeTransparency = 0
		label.Text = (st.Rank == 1 and "👑 " or "") .. "#" .. st.Rank .. "  ..."
		label.Parent = billboard
		World.Podium[st.Rank] = { Top = CFrame.new(pos + Vector3.new(0, st.H + 0.6, 0)) * CFrame.Angles(0, math.rad(180), 0), Label = label, Block = block }
	end
	sign(hub, CFrame.new(podiumCenter + Vector3.new(0, 17, 4)), Vector3.new(22, 3.5, 0.6), "🏆 TOP 3 SLAPPERS 🏆", Color3.fromRGB(255, 230, 120),
		Color3.fromRGB(70, 30, 90), Enum.NormalId.Back)

	-- Wochen-Event-Stand (Ei wechselt jede Woche)
	local eventPos = Vector3.new(0, FLOOR, -104)
	local standFolder = folder("EventStand", hub)
	local base = pillar(standFolder, eventPos, 2.5, 11, Color3.fromRGB(60, 40, 75), Enum.Material.Marble)
	base.Name = "EventBase"
	disc(standFolder, eventPos + Vector3.new(0, 2.55, 0), 0.3, 11.6, Color3.fromRGB(255, 220, 90), Enum.Material.Neon)
	local eventEgg = part({ Name = "Egg", Size = Vector3.new(6, 7.8, 6), CFrame = CFrame.new(eventPos + Vector3.new(0, 7, 0)), Color = Color3.fromRGB(255, 200, 90), Material = Enum.Material.Foil, Parent = standFolder })
	local eggMesh = Instance.new("SpecialMesh")
	eggMesh.MeshType = Enum.MeshType.Sphere
	eggMesh.Parent = eventEgg
	eventEgg:SetAttribute("BaseY", eventPos.Y + 7)
	CollectionService:AddTag(eventEgg, "SlapEgg")
	addLight(eventEgg, Color3.fromRGB(255, 220, 120), 18, 2)
	local eventSparkle = Instance.new("Sparkles")
	eventSparkle.SparkleColor = Color3.fromRGB(255, 230, 120)
	eventSparkle.Parent = eventEgg
	local eventBoard = Instance.new("BillboardGui")
	eventBoard.Name = "EventInfo"
	eventBoard.Size = UDim2.new(14, 0, 5, 0)
	eventBoard.StudsOffsetWorldSpace = Vector3.new(0, 13, 0)
	eventBoard.MaxDistance = 90
	eventBoard.LightInfluence = 0
	eventBoard.Adornee = base
	eventBoard.Parent = base
	local eventTitle = Instance.new("TextLabel")
	eventTitle.Name = "Title"
	eventTitle.Size = UDim2.fromScale(1, 0.55)
	eventTitle.BackgroundTransparency = 1
	eventTitle.Font = Enum.Font.FredokaOne
	eventTitle.TextScaled = true
	eventTitle.TextColor3 = Color3.fromRGB(255, 220, 90)
	eventTitle.TextStrokeTransparency = 0
	eventTitle.Text = "⭐ WEEKLY EVENT"
	eventTitle.Parent = eventBoard
	local eventTimer = Instance.new("TextLabel")
	eventTimer.Name = "Timer"
	eventTimer.Position = UDim2.fromScale(0, 0.55)
	eventTimer.Size = UDim2.fromScale(1, 0.4)
	eventTimer.BackgroundTransparency = 1
	eventTimer.Font = Enum.Font.GothamBold
	eventTimer.TextScaled = true
	eventTimer.TextColor3 = Color3.fromRGB(255, 255, 255)
	eventTimer.TextStrokeTransparency = 0.2
	eventTimer.Text = "Exclusive pets!"
	eventTimer.Parent = eventBoard
	local eventPrompt = Instance.new("ProximityPrompt")
	eventPrompt.Name = "OpenPrompt"
	eventPrompt.ActionText = "Open Event Shop"
	eventPrompt.ObjectText = "Weekly Event Egg"
	eventPrompt.HoldDuration = 0
	eventPrompt.MaxActivationDistance = 13
	eventPrompt.RequiresLineOfSight = false
	eventPrompt:SetAttribute("OpenMenu", "EggShop")
	eventPrompt.Parent = base
	World.EventStand = { Egg = eventEgg, Title = eventTitle, Timer = eventTimer, Prompt = eventPrompt }

	-- PvP-Duell-Zone (flach, ohne Pfosten = freie Sicht)
	local arena = Config.Arena
	local center = Vector3.new(arena.CenterX, FLOOR, arena.CenterZ)
	disc(hub, center + Vector3.new(0, 0.4, 0), 0.8, arena.Radius * 2 + 2, Color3.fromRGB(255, 60, 140), Enum.Material.Neon)
	local platform = disc(hub, center + Vector3.new(0, 0.6, 0), 1, arena.Radius * 2, Color3.fromRGB(60, 40, 80), Enum.Material.DiamondPlate)
	platform.Name = "ArenaFloor"
	local markGui = Instance.new("SurfaceGui")
	markGui.Face = Enum.NormalId.Right
	markGui.LightInfluence = 0
	markGui.Parent = platform
	local markText = Instance.new("TextLabel")
	markText.Size = UDim2.fromScale(1, 1)
	markText.BackgroundTransparency = 1
	markText.Font = Enum.Font.FredokaOne
	markText.TextScaled = true
	markText.TextTransparency = 0.5
	markText.TextColor3 = Color3.fromRGB(255, 120, 180)
	markText.Text = "⚔️"
	markText.Parent = markGui
	sign(hub, CFrame.new(center + Vector3.new(0, 7, -arena.Radius - 3)), Vector3.new(22, 5, 0.8),
		"⚔️ DUEL ZONE ⚔️\nSlap a player here to start a duel!", Color3.fromRGB(255, 220, 240), Color3.fromRGB(120, 20, 60), Enum.NormalId.Back)
	World.Arena = { Center = center, Radius = arena.Radius }
end

local function buildZone(index, zone)
	local zFolder = folder("Zone" .. index, root)
	local decorFolder = folder("Decor", zFolder)
	local startZ = Calc.GetZoneStartZ(index)
	local length = Config.ZoneLength
	local centerZ = startZ + length / 2
	local accent = rgb(zone.Accent)
	local info = { Index = index, StartZ = startZ, Folder = zFolder }
	-- Positionen wurden fuer 120x130 entworfen und auf die grosse Zone skaliert
	local SX, SZ = Config.ZoneWidth / 120, length / 130
	local function at(x, z)
		return x * SX, startZ + z * SZ
	end
	local mechanic = zone.Mechanic or "none"
	info.Mechanic = mechanic

	local floorPart = part({
		Name = "Floor",
		Size = Vector3.new(Config.ZoneWidth, 2, length),
		CFrame = CFrame.new(0, FLOOR - 1, centerZ),
		Color = rgb(zone.Floor),
		Material = material(zone.FloorMaterial),
		Parent = zFolder,
	})
	if mechanic == "ice" then
		-- rutschiger Boden
		floorPart.Material = Enum.Material.Ice
		floorPart.CustomPhysicalProperties = PhysicalProperties.new(0.9, 0.02, 0.1, 100, 1)
	end
	part({
		Name = "Path",
		Size = Vector3.new(12, 0.2, length),
		CFrame = CFrame.new(0, FLOOR + 0.1, centerZ),
		Color = rgb(zone.Path),
		Material = Enum.Material.Pebble,
		CanCollide = false,
		Parent = zFolder,
	})

	-- Gyatt-Plaetze (Podeste)
	local SPOTS = { { -22, 48 }, { 20, 92 }, { 24, 42 }, { -40, 82 }, { 34, 112 } }
	info.GyattSpots = {}
	for i, s in ipairs(SPOTS) do
		local x, z = at(s[1], s[2])
		info.GyattSpots[i] = CFrame.new(x, FLOOR + 0.6, z)
	end
	for i, spot in ipairs(info.GyattSpots) do
		local size = (zone.Gyatts[i] or zone.Gyatts[1]).Size
		disc(zFolder, spot.Position, 0.6, size + 6, accent, Enum.Material.Neon).Name = "GyattPad"
		disc(zFolder, spot.Position + Vector3.new(0, 0.1, 0), 0.6, size + 4, Color3.fromRGB(255, 255, 255), Enum.Material.Marble).Name = "GyattPadTop"
	end
	do
		local gx, gz = at(-28, 108)
		info.GoldenSpot = CFrame.new(gx, FLOOR + 0.6, gz)
	end

	-- Eingangsbogen
	local archZ = startZ + 6
	pillar(zFolder, Vector3.new(-14, FLOOR, archZ), 16, 2.5, accent, Enum.Material.Neon)
	pillar(zFolder, Vector3.new(14, FLOOR, archZ), 16, 2.5, accent, Enum.Material.Neon)
	local mechInfo = Config.MechanicInfo and Config.MechanicInfo[mechanic]
	local archText = "Zone " .. index .. ": " .. zone.Name
	if mechInfo and mechanic ~= "none" then
		archText = archText .. "  " .. mechInfo.Icon
	end
	sign(zFolder, CFrame.new(0, FLOOR + 17.5, archZ), Vector3.new(32, 4, 1), archText,
		Color3.fromRGB(255, 255, 255), Color3.fromRGB(40, 25, 55), Enum.NormalId.Front)

	-- Tor (ab Zone 2)
	if index > 1 then
		local gate = part({
			Name = "Gate",
			Size = Vector3.new(Config.ZoneWidth, 30, 1.5),
			CFrame = CFrame.new(0, FLOOR + 15, startZ),
			Color = accent,
			Material = Enum.Material.ForceField,
			Transparency = 0.3,
			Parent = zFolder,
		})
		gate:SetAttribute("ZoneIndex", index)
		CollectionService:AddTag(gate, "SlapGate")
		local priceText = "🔒 Zone " .. index .. ": " .. zone.Name .. "\n👋 " .. Calc.FormatNumber(zone.Price) .. " Slaps"
		for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
			local gui = Instance.new("SurfaceGui")
			gui.Name = "GateGui"
			gui.Face = face
			gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
			gui.PixelsPerStud = 12
			gui.LightInfluence = 0
			gui.Parent = gate
			local label = Instance.new("TextLabel")
			label.Name = "Text"
			label.AnchorPoint = Vector2.new(0.5, 0.5)
			label.Position = UDim2.fromScale(0.5, 0.45)
			label.Size = UDim2.fromScale(0.4, 0.35)
			label.BackgroundTransparency = 1
			label.Font = Enum.Font.FredokaOne
			label.TextScaled = true
			label.TextColor3 = Color3.fromRGB(255, 255, 255)
			label.TextStrokeTransparency = 0
			label.Text = priceText
			label.Parent = gui
		end

		local promptPart = part({
			Name = "GatePrompt",
			Size = Vector3.new(1, 1, 1),
			CFrame = CFrame.new(0, FLOOR + 3, startZ - 3),
			Transparency = 1,
			CanCollide = false,
			Parent = zFolder,
		})
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "UnlockPrompt"
		prompt.ActionText = "Unlock (" .. Calc.FormatNumber(zone.Price) .. " Slaps)"
		prompt.ObjectText = "Zone " .. index .. ": " .. zone.Name
		prompt.HoldDuration = 0.4
		prompt.MaxActivationDistance = 14
		prompt.RequiresLineOfSight = false
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		prompt:SetAttribute("ZoneIndex", index)
		prompt.Parent = promptPart
		info.Gate = gate
		info.GatePrompt = prompt
	end

	-- Ei-Stand
	local egg = Config.Eggs[zone.Egg]
	info.EggStands = {}
	local function eggStand(eggId, position)
		local eggCfg = Config.Eggs[eggId]
		local standFolder = folder("EggStand_" .. eggId, zFolder)
		local base = pillar(standFolder, position, 2.5, 9, Color3.fromRGB(60, 40, 75), Enum.Material.Marble)
		base.Name = "EggBase"
		disc(standFolder, position + Vector3.new(0, 2.55, 0), 0.3, 9.6, accent, Enum.Material.Neon)
		local eggPart = part({
			Name = "Egg",
			Size = Vector3.new(5, 6.5, 5),
			CFrame = CFrame.new(position + Vector3.new(0, 6, 0)),
			Color = rgb(eggCfg.Color),
			Material = eggCfg.Currency == "Gems" and Enum.Material.Foil or Enum.Material.SmoothPlastic,
			Parent = standFolder,
		})
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = eggPart
		eggPart:SetAttribute("BaseY", position.Y + 6)
		CollectionService:AddTag(eggPart, "SlapEgg")
		local glow = Instance.new("PointLight")
		glow.Color = rgb(eggCfg.Color)
		glow.Range = 12
		glow.Brightness = 1.2
		glow.Parent = eggPart
		if eggCfg.Currency == "Gems" then
			local s = Instance.new("Sparkles")
			s.SparkleColor = Color3.fromRGB(255, 230, 120)
			s.Parent = eggPart
		end

		-- Info-Anzeige ueber dem Ei
		local billboard = Instance.new("BillboardGui")
		billboard.Name = "EggInfo"
		billboard.Size = UDim2.new(12, 0, 9, 0)
		billboard.StudsOffsetWorldSpace = Vector3.new(0, 10.5, 0)
		billboard.MaxDistance = 70
		billboard.LightInfluence = 0
		billboard.Adornee = base
		billboard.Parent = base
		local title = Instance.new("TextLabel")
		title.Size = UDim2.fromScale(1, 0.2)
		title.BackgroundTransparency = 1
		title.Font = Enum.Font.FredokaOne
		title.TextScaled = true
		title.TextColor3 = rgb(eggCfg.Color)
		title.TextStrokeTransparency = 0
		local currencyIcon = eggCfg.Currency == "Gems" and "💎" or "👋"
		title.Text = "🥚 " .. eggCfg.DisplayName .. "  " .. currencyIcon .. " " .. Calc.FormatNumber(eggCfg.Price)
		title.Parent = billboard
		local chances = Calc.GetEggChances(eggId, false)
		for i, entry in ipairs(chances) do
			local pet = Config.Pets[entry.PetId]
			local rarity = Config.Rarities[pet.Rarity]
			local row = Instance.new("TextLabel")
			row.Position = UDim2.fromScale(0, 0.2 + (i - 1) * 0.19)
			row.Size = UDim2.fromScale(1, 0.18)
			row.BackgroundTransparency = 1
			row.Font = Enum.Font.GothamBold
			row.TextScaled = true
			row.TextColor3 = rgb(rarity.Color)
			row.TextStrokeTransparency = 0.2
			row.Text = pet.DisplayName .. "  +" .. Calc.FormatNumber(math.floor(pet.Boost * 100)) .. "%  (" .. Calc.FormatChance(entry.Chance) .. ")"
			row.Parent = billboard
		end

		local prompts = {}
		for _, amount in ipairs({ 1, 3 }) do
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "Hatch" .. amount
			prompt.ActionText = amount == 1 and "Hatch" or "Hatch x3"
			prompt.ObjectText = eggCfg.DisplayName .. " (" .. currencyIcon .. " " .. Calc.FormatNumber(eggCfg.Price * amount) .. ")"
			prompt.KeyboardKeyCode = amount == 1 and Enum.KeyCode.E or Enum.KeyCode.R
			prompt.HoldDuration = 0.25
			prompt.MaxActivationDistance = 12
			prompt.RequiresLineOfSight = false
			prompt.UIOffset = Vector2.new(0, amount == 1 and 0 or 80)
			prompt:SetAttribute("EggId", eggId)
			prompt:SetAttribute("Amount", amount)
			prompt.Parent = base
			table.insert(prompts, prompt)
		end
		table.insert(info.EggStands, { EggId = eggId, Prompts = prompts })
	end
	local function eggAt(x, z)
		local ex, ez = at(x, z)
		return Vector3.new(ex, FLOOR, ez)
	end
	eggStand(zone.Egg, eggAt(42, 24))
	if zone.ExtraEgg then
		eggStand(zone.ExtraEgg, eggAt(42, 62))
	end
	if zone.ExtraEgg2 then
		eggStand(zone.ExtraEgg2, eggAt(-44, 20))
	end
	if egg == nil then
		warn("[SlapTheBlob] Zone " .. index .. " has no valid egg")
	end

	-- Deko
	local rng = Random.new(1000 + index * 77)
	local blocked = {
		{ X = 42, Z = 24, R = 9 },
		{ X = 42, Z = 62, R = 9 },
		{ X = -44, Z = 20, R = 9 },
		{ X = -28, Z = 108, R = 14 },
	}
	for i, s in ipairs(SPOTS) do
		local cfg = zone.Gyatts[i] or zone.Gyatts[1]
		table.insert(blocked, { X = s[1], Z = s[2], R = cfg.Size + 8 })
	end
	for _, b in ipairs(blocked) do
		b.X, b.Z = at(b.X, b.Z)
	end
	table.insert(blocked, { X = 0, Z = startZ + 6, R = 16 })
	table.insert(blocked, { X = 0, Z = startZ + length - 14, R = 22 })
	info.Pads = {}
	if mechanic == "bounce" or mechanic == "boost" then
		-- Sprung- bzw. Turbo-Felder in der Zone verteilen
		local padRng = Random.new(5000 + index)
		for n = 1, 10 do
			local px, pz
			local tries = 0
			repeat
				px = padRng:NextNumber(-HALF_WIDTH + 12, HALF_WIDTH - 12)
				pz = padRng:NextNumber(startZ + 24, startZ + length - 30)
				tries = tries + 1
				local ok = true
				for _, b in ipairs(blocked) do
					local dx, dz = px - b.X, pz - b.Z
					if math.sqrt(dx * dx + dz * dz) < b.R + 6 then
						ok = false
					end
				end
			until ok or tries > 30
			if mechanic == "bounce" then
				local pad = disc(zFolder, Vector3.new(px, FLOOR + 0.3, pz), 0.6, 9, Color3.fromRGB(255, 120, 220), Enum.Material.Neon)
				pad.Name = "BouncePad"
				CollectionService:AddTag(pad, "SlapBouncePad")
				table.insert(info.Pads, pad)
			else
				local pad = part({ Name = "BoostPad", Size = Vector3.new(8, 0.4, 12), CFrame = CFrame.new(px, FLOOR + 0.2, pz) * CFrame.Angles(0, (n % 2 == 0) and 0 or math.pi, 0),
					Color = Color3.fromRGB(80, 230, 255), Material = Enum.Material.Neon, CanCollide = false, Parent = zFolder })
				CollectionService:AddTag(pad, "SlapBoostPad")
				table.insert(info.Pads, pad)
			end
			table.insert(blocked, { X = px, Z = pz, R = 6 })
		end
	end
	local function isFree(x, z, radius)
		if math.abs(x) < 9 + radius then
			return false -- Weg frei lassen
		end
		for _, b in ipairs(blocked) do
			local dx, dz = x - b.X, z - b.Z
			if math.sqrt(dx * dx + dz * dz) < b.R + radius then
				return false
			end
		end
		return true
	end
	for _, entry in ipairs(THEMES[zone.Decor] or {}) do
		local kind, count, color, mat, big = entry[1], entry[2], entry[3], entry[4], entry[5]
		-- in den hinteren Welten weniger Deko (Leistung, vor allem am Handy)
		if index > 10 and not big then
			count = math.max(1, math.floor(count * 0.5))
		end
		local builder = decor[kind]
		if builder then
			for n = 1, count do
				local x, z
				if big then
					-- grosse Objekte an den Rand
					local side = (n % 2 == 0) and 1 or -1
					x = side * (HALF_WIDTH - 14)
					z = startZ + length * (0.3 + 0.4 * ((n - 1) / math.max(1, count - 1)))
					if kind == "rainbow" then
						x = 0
						z = startZ + length - 12
					end
				else
					local tries = 0
					repeat
						x = rng:NextNumber(-HALF_WIDTH + 3, HALF_WIDTH - 3)
						z = rng:NextNumber(startZ + 10, startZ + length - 4)
						tries = tries + 1
					until isFree(x, z, 2) or tries > 25
				end
				local pos = Vector3.new(x, FLOOR, z)
				if kind == "rock" then
					builder(decorFolder, pos, rng, color and rgb(color) or nil, mat and material(mat) or nil)
				else
					builder(decorFolder, pos, rng)
				end
			end
		end
	end

	-- Zaun an den Seiten
	for _, side in ipairs({ -1, 1 }) do
		part({
			Name = "Fence",
			Size = Vector3.new(1, 3, length),
			CFrame = CFrame.new(side * (HALF_WIDTH - 0.5), FLOOR + 1.5, centerZ),
			Color = accent,
			Material = Enum.Material.Neon,
			Transparency = 0.2,
			Parent = zFolder,
		})
	end

	-- Portal in die naechste Dimension am Ende der letzten Zone einer Dimension
	local dim, dimIndex = Calc.GetDimension(index)
	local nextDim = Config.Dimensions[dimIndex + 1]
	if index == dim.LastZone and nextDim then
		local portalZ = startZ + length - 14
		local portal = folder("RiftPortal", zFolder)
		local purple = Color3.fromRGB(170, 70, 255)
		for i = 0, 23 do
			local angle = (i / 24) * math.pi * 2
			local orb = ball(portal, Vector3.new(math.cos(angle) * 11, FLOOR + 13 + math.sin(angle) * 11, portalZ), 3, purple, Enum.Material.Neon)
			orb.CanCollide = false
		end
		local swirl = disc(portal, Vector3.new(0, FLOOR + 13, portalZ), 0.4, 20, Color3.fromRGB(60, 0, 120), Enum.Material.Neon)
		swirl.CFrame = CFrame.new(0, FLOOR + 13, portalZ) * CFrame.Angles(0, math.rad(90), 0)
		swirl.Transparency = 0.25
		swirl.CanCollide = false
		swirl.Name = "PortalSwirl"
		CollectionService:AddTag(swirl, "SlapPortal")
		addLight(swirl, purple, 40, 3)
		local sparkle = Instance.new("Sparkles")
		sparkle.SparkleColor = purple
		sparkle.Parent = swirl
		sign(portal, CFrame.new(0, FLOOR + 28, portalZ), Vector3.new(30, 4, 1), "🌀 PORTAL TO " .. string.upper(nextDim.Name) .. " 🌀",
			Color3.fromRGB(230, 200, 255), Color3.fromRGB(40, 10, 70), Enum.NormalId.Front)
		local promptPart = part({ Name = "PortalPrompt", Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(0, FLOOR + 3, portalZ - 4), Transparency = 1, CanCollide = false, Parent = portal })
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "EnterPrompt"
		prompt.ActionText = "Enter " .. nextDim.Name
		prompt.ObjectText = "Dimension Portal"
		prompt.HoldDuration = 0.5
		prompt.MaxActivationDistance = 16
		prompt.RequiresLineOfSight = false
		prompt:SetAttribute("Dimension", dimIndex + 1)
		prompt.Parent = promptPart
		info.PortalPrompt = prompt
	end

	-- Blick in die Zone hinein (+Z)
	info.TeleportCFrame = CFrame.new(0, FLOOR + 4, startZ + 16) * CFrame.Angles(0, math.pi, 0)
	World.Zones[index] = info
	return info
end

local function buildBounds()
	local bounds = folder("Bounds", root)
	local function wall(size, position)
		part({ Name = "InvisibleWall", Size = size, CFrame = CFrame.new(position), Transparency = 1, Parent = bounds })
	end
	for dimIndex, dim in ipairs(Config.Dimensions) do
		local frontZ = (dimIndex == 1) and -Config.HubLength or (dim.StartZ - Config.DimensionLandingLength)
		local endZ = Calc.GetZoneStartZ(dim.LastZone) + Config.ZoneLength
		local length = endZ - frontZ
		local centerZ = (endZ + frontZ) / 2
		wall(Vector3.new(2, 120, length), Vector3.new(-HALF_WIDTH - 1, 60, centerZ))
		wall(Vector3.new(2, 120, length), Vector3.new(HALF_WIDTH + 1, 60, centerZ))
		wall(Vector3.new(Config.ZoneWidth, 120, 2), Vector3.new(0, 60, frontZ - 1))
		wall(Vector3.new(Config.ZoneWidth, 120, 2), Vector3.new(0, 60, endZ + 1))
	end
	-- Hub-Zaun
	for _, side in ipairs({ -1, 1 }) do
		part({
			Name = "HubFence",
			Size = Vector3.new(1, 3, Config.HubLength),
			CFrame = CFrame.new(side * (HALF_WIDTH - 0.5), FLOOR + 1.5, -Config.HubLength / 2),
			Color = Color3.fromRGB(255, 110, 180),
			Material = Enum.Material.Neon,
			Transparency = 0.2,
			Parent = bounds,
		})
	end
end

-- Landeplattform am Anfang jeder weiteren Dimension (mit Rueck-Portal)
World.Dimensions = {}
local function buildLandings()
	for dimIndex, dim in ipairs(Config.Dimensions) do
		if dimIndex > 1 then
			local landing = folder("Landing_" .. dim.Name, root)
			local length = Config.DimensionLandingLength
			local frontZ = dim.StartZ - length
			local firstZone = Config.Zones[dim.FirstZone]
			part({
				Name = "LandingFloor",
				Size = Vector3.new(Config.ZoneWidth, 2, length),
				CFrame = CFrame.new(0, FLOOR - 1, frontZ + length / 2),
				Color = Color3.fromRGB(45, 25, 70),
				Material = Enum.Material.Marble,
				Parent = landing,
			})
			for x = -2, 2 do
				part({ Name = "Rune", Size = Vector3.new(6, 0.1, 6), CFrame = CFrame.new(x * 14, FLOOR + 0.05, frontZ + length / 2) * CFrame.Angles(0, math.rad(45), 0),
					Color = rgb(firstZone.Accent), Material = Enum.Material.Neon, CanCollide = false, Parent = landing })
			end
			sign(landing, CFrame.new(0, FLOOR + 36, frontZ + length - 4), Vector3.new(36, 7, 1),
				"🌀 WELCOME TO " .. string.upper(dim.Name) .. " 🌀\nStronger targets, rarer pets!", Color3.fromRGB(240, 220, 255), Color3.fromRGB(40, 10, 70), Enum.NormalId.Front)
			-- Rueck-Portal
			local returnPart = part({ Name = "ReturnPortal", Size = Vector3.new(10, 14, 1), CFrame = CFrame.new(-40, FLOOR + 7, frontZ + 6),
				Color = Color3.fromRGB(120, 255, 180), Material = Enum.Material.Neon, Transparency = 0.3, CanCollide = false, Parent = landing })
			addLight(returnPart, Color3.fromRGB(120, 255, 180), 20, 2)
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "ReturnPrompt"
			prompt.ActionText = "Return to Overworld"
			prompt.ObjectText = "Portal"
			prompt.HoldDuration = 0.3
			prompt.MaxActivationDistance = 14
			prompt.RequiresLineOfSight = false
			prompt.Parent = returnPart
			-- kleine Verkaufsstaende auch hier, damit man nicht zurueck muss
			local kz = frontZ + length / 2
			kiosk(landing, Vector3.new(-60, 0, kz - 10), Vector3.new(1, 0, 0), "UPGRADES", "🛒", "Shop", Color3.fromRGB(255, 110, 180), "Slaps")
			kiosk(landing, Vector3.new(-60, 0, kz + 12), Vector3.new(1, 0, 0), "GLOVES", "✋", "Hands", Color3.fromRGB(255, 170, 60), "Slaps / Gems")
			kiosk(landing, Vector3.new(60, 0, kz - 10), Vector3.new(-1, 0, 0), "ITEM CRATES", "🎁", "ItemShop", Color3.fromRGB(170, 110, 255), "Slaps / Gems")
			kiosk(landing, Vector3.new(60, 0, kz + 12), Vector3.new(-1, 0, 0), "FORGE", "🔨", "Items", Color3.fromRGB(255, 90, 90), "Merge items")
			World.Dimensions[dimIndex] = {
				LandingCFrame = CFrame.new(0, FLOOR + 4, frontZ + 20) * CFrame.Angles(0, math.pi, 0),
				ReturnPrompt = prompt,
			}
		else
			World.Dimensions[dimIndex] = { LandingCFrame = CFrame.new(0, FLOOR + 4, Calc.GetZoneStartZ(dim.LastZone) + Config.ZoneLength - 30) }
		end
	end
end

-- Schwebende Duell-Arenen hoch ueber der Karte
World.DuelArenas = {}
local function buildDuelArenas()
	local duel = Config.Duel
	local arenaFolder = folder("DuelArenas", root)
	for i = 1, duel.ArenaCount do
		local center = Vector3.new(-450 + (i - 1) * 150, FLOOR + duel.ArenaHeight, -350)
		local r = duel.ArenaRadius
		disc(arenaFolder, center + Vector3.new(0, -1.5, 0), 3, r * 2 + 3, Color3.fromRGB(255, 50, 120), Enum.Material.Neon)
		local floorPart = disc(arenaFolder, center + Vector3.new(0, -0.5, 0), 1.2, r * 2, Color3.fromRGB(45, 30, 70), Enum.Material.DiamondPlate)
		floorPart.Name = "DuelFloor"
		-- nur ein flacher Leuchtring am Rand: freie Sicht im Kampf
		local edge = disc(arenaFolder, center + Vector3.new(0, 0.12, 0), 0.1, r * 2 - 1, Color3.fromRGB(255, 120, 180), Enum.Material.Neon)
		edge.CanCollide = false
		edge.Transparency = 0.6
		local inner = disc(arenaFolder, center + Vector3.new(0, 0.15, 0), 0.1, r * 2 - 4, Color3.fromRGB(45, 30, 70), Enum.Material.DiamondPlate)
		inner.CanCollide = false
		World.DuelArenas[i] = {
			Center = center,
			Spawns = {
				CFrame.lookAt(center + Vector3.new(-r * 0.55, 3, 0), center + Vector3.new(0, 3, 0)),
				CFrame.lookAt(center + Vector3.new(r * 0.55, 3, 0), center + Vector3.new(0, 3, 0)),
			},
		}
	end
end

--------------------------------------------------------------------------
-- Hintergrund: Himmel, Wolken, Boden und Berge rund um die Karte
--------------------------------------------------------------------------
local BACKDROPS = {
	meadow = { Ground = { 90, 170, 90 }, Mountain = { 80, 140, 90 }, Cap = { 250, 250, 255 }, Kind = "mountain" },
	desert = { Ground = { 220, 185, 120 }, Mountain = { 210, 130, 70 }, Cap = { 235, 170, 100 }, Kind = "mesa" },
	ice = { Ground = { 230, 240, 255 }, Mountain = { 160, 190, 220 }, Cap = { 255, 255, 255 }, Kind = "mountain" },
	lava = { Ground = { 50, 35, 32 }, Mountain = { 60, 40, 38 }, Cap = { 255, 90, 20 }, Kind = "volcano" },
	cloud = { Ground = { 240, 245, 255 }, Mountain = { 255, 255, 255 }, Cap = { 255, 220, 120 }, Kind = "cloud" },
	space = { Ground = { 25, 15, 50 }, Mountain = { 70, 55, 100 }, Cap = { 170, 120, 255 }, Kind = "asteroid" },
	candy = { Ground = { 255, 190, 225 }, Mountain = { 255, 150, 200 }, Cap = { 255, 255, 255 }, Kind = "mountain" },
	cyber = { Ground = { 15, 20, 35 }, Mountain = { 30, 40, 60 }, Cap = { 0, 255, 230 }, Kind = "tower" },
	shadow = { Ground = { 30, 20, 40 }, Mountain = { 45, 30, 60 }, Cap = { 170, 60, 255 }, Kind = "mountain" },
	void = { Ground = { 10, 5, 20 }, Mountain = { 40, 20, 70 }, Cap = { 255, 255, 255 }, Kind = "asteroid" },
}

local function backdropMountain(parent, kind, position, rng, theme)
	local color = rgb(theme.Mountain)
	local cap = rgb(theme.Cap)
	if kind == "mountain" or kind == "volcano" then
		local baseD = rng:NextNumber(70, 120)
		local layers = 6
		local layerH = baseD * 0.16
		for i = 0, layers - 1 do
			local d = baseD * (1 - i / layers)
			local isTop = i >= layers - 2
			local layer = pillar(parent, position + Vector3.new(0, i * layerH, 0), layerH, d,
				(isTop and kind == "mountain") and cap or color, kind == "volcano" and Enum.Material.Basalt or Enum.Material.Rock)
			layer.CastShadow = false
		end
		if kind == "volcano" then
			local top = disc(parent, position + Vector3.new(0, layers * layerH + 0.2, 0), 0.5, baseD / layers, cap, Enum.Material.Neon)
			top.CastShadow = false
			local fire = Instance.new("Fire")
			fire.Size = 30
			fire.Heat = 25
			fire.Parent = top
			addLight(top, Color3.fromRGB(255, 100, 30), 60, 3)
		end
	elseif kind == "mesa" then
		local w = rng:NextNumber(40, 80)
		local h = rng:NextNumber(25, 45)
		for i = 0, 2 do
			local layer = part({
				Name = "Mesa",
				Size = Vector3.new(w * (1 - i * 0.12), h / 3, w * 0.7 * (1 - i * 0.12)),
				CFrame = CFrame.new(position + Vector3.new(0, h / 6 + i * h / 3, 0)) * CFrame.Angles(0, rng:NextNumber(0, 3), 0),
				Color = (i % 2 == 0) and color or cap,
				Material = Enum.Material.Sandstone,
				Parent = parent,
			})
			layer.CastShadow = false
		end
		local dune = ball(parent, position + Vector3.new(rng:NextNumber(-40, 40), -10, rng:NextNumber(-30, 30)), rng:NextNumber(40, 60), rgb(theme.Ground), Enum.Material.Sand)
		dune.CastShadow = false
	elseif kind == "cloud" then
		local lift = rng:NextNumber(10, 40)
		for i = 1, 6 do
			local puff = ball(parent, position + Vector3.new(rng:NextNumber(-25, 25), lift + rng:NextNumber(-5, 8), rng:NextNumber(-20, 20)), rng:NextNumber(18, 32), color, Enum.Material.SmoothPlastic)
			puff.CastShadow = false
			puff.CanCollide = false
		end
		-- kleiner goldener Tempel auf der Wolke
		for _, ox in ipairs({ -6, 6 }) do
			local col = pillar(parent, position + Vector3.new(ox, lift + 10, 0), 12, 2.5, cap, Enum.Material.Foil)
			col.CastShadow = false
		end
		local roof = part({ Name = "TempleRoof", Size = Vector3.new(18, 2, 8), CFrame = CFrame.new(position + Vector3.new(0, lift + 23, 0)), Color = cap, Material = Enum.Material.Foil, Parent = parent })
		roof.CastShadow = false
	elseif kind == "tower" then
		for i = 1, 3 do
			local w = rng:NextNumber(14, 26)
			local h = rng:NextNumber(60, 160)
			local offset = Vector3.new(rng:NextNumber(-30, 30), 0, rng:NextNumber(-30, 30))
			local tower = part({ Name = "Tower", Size = Vector3.new(w, h, w), CFrame = CFrame.new(position + offset + Vector3.new(0, h / 2, 0)),
				Color = color, Material = Enum.Material.SmoothPlastic, Parent = parent })
			tower.CastShadow = false
			for y = 10, h - 6, 14 do
				local stripe = part({ Name = "TowerStripe", Size = Vector3.new(w + 0.4, 0.8, w + 0.4), CFrame = CFrame.new(position + offset + Vector3.new(0, y, 0)),
					Color = cap, Material = Enum.Material.Neon, CanCollide = false, Parent = parent })
				stripe.CastShadow = false
			end
			if i == 1 then
				addLight(tower, cap, 40, 2)
			end
		end
	elseif kind == "asteroid" then
		for i = 1, 4 do
			local s = rng:NextNumber(8, 22)
			local rock = part({
				Name = "Asteroid",
				Size = Vector3.new(s, s * 0.8, s * 1.1),
				CFrame = CFrame.new(position + Vector3.new(rng:NextNumber(-30, 30), rng:NextNumber(15, 70), rng:NextNumber(-30, 30))) * CFrame.Angles(rng:NextNumber(0, 3), rng:NextNumber(0, 3), rng:NextNumber(0, 3)),
				Color = color,
				Material = Enum.Material.Slate,
				CanCollide = false,
				Parent = parent,
			})
			rock.CastShadow = false
			if i == 1 then
				local glow = ball(parent, rock.Position + Vector3.new(0, s * 0.5, 0), s * 0.3, cap, Enum.Material.Neon)
				glow.CanCollide = false
				glow.CastShadow = false
			end
		end
	end
end

local function buildBackground()
	local bg = folder("Background", root)
	local rng = Random.new(4242)

	-- Himmel (nur eingebaute Roblox-Werte, keine Bilder noetig)
	local oldSky = Lighting:FindFirstChildOfClass("Sky")
	if oldSky then
		oldSky:Destroy()
	end
	local sky = Instance.new("Sky")
	sky.Name = "SlapSky"
	sky.StarCount = 3000
	sky.CelestialBodiesShown = true
	sky.SunAngularSize = 16
	sky.MoonAngularSize = 9
	sky.Parent = Lighting

	-- Echte Wolken am Himmel
	local terrain = workspace.Terrain
	local clouds = terrain:FindFirstChildOfClass("Clouds")
	if not clouds then
		clouds = Instance.new("Clouds")
		clouds.Parent = terrain
	end
	clouds.Cover = 0.55
	clouds.Density = 0.55
	clouds.Color = Color3.fromRGB(255, 245, 250)

	local outer = 360 -- wie weit der Boden ausserhalb der Karte reicht
	local function ground(name, size, position, color, mat)
		local g = part({ Name = name, Size = size, CFrame = CFrame.new(position), Color = color, Material = mat, Parent = bg })
		g.CastShadow = false
		return g
	end

	-- Boden neben dem Hub und dahinter
	local hubColor = Color3.fromRGB(110, 190, 110)
	for _, side in ipairs({ -1, 1 }) do
		ground("HubGround", Vector3.new(outer, 2, Config.HubLength), Vector3.new(side * (HALF_WIDTH + outer / 2), FLOOR - 1.2, -Config.HubLength / 2), hubColor, Enum.Material.Grass)
	end
	ground("BackGround", Vector3.new(Config.ZoneWidth + outer * 2, 2, outer), Vector3.new(0, FLOOR - 1.2, -Config.HubLength - outer / 2), hubColor, Enum.Material.Grass)

	-- Riesige Blob-Statue hinter dem Hub ("Mount Blob"), schaut zum Spawn (+Z)
	local mx, mz = 0, -Config.HubLength - 120
	local pink = Color3.fromRGB(255, 160, 200)
	local my = FLOOR + 42
	local giant = ball(bg, Vector3.new(mx, my, mz), 84, pink, Enum.Material.Marble)
	giant.CastShadow = false
	local white = Color3.fromRGB(255, 255, 255)
	local black = Color3.fromRGB(30, 20, 35)
	for _, side in ipairs({ -1, 1 }) do
		local eye = ball(bg, Vector3.new(mx + side * 14, my + 10, mz + 36), 22, white, Enum.Material.SmoothPlastic)
		eye.CastShadow = false
		local pupil = ball(bg, Vector3.new(mx + side * 14, my + 10, mz + 45), 11, black, Enum.Material.SmoothPlastic)
		pupil.CastShadow = false
		local blush = ball(bg, Vector3.new(mx + side * 25, my - 4, mz + 33), 12, Color3.fromRGB(255, 110, 150), Enum.Material.SmoothPlastic)
		blush.CastShadow = false
		local foot = ball(bg, Vector3.new(mx + side * 20, FLOOR + 3, mz + 8), 26, Color3.fromRGB(220, 120, 160), Enum.Material.Marble)
		foot.CastShadow = false
	end
	local mouth = part({ Name = "MountBlobMouth", Size = Vector3.new(18, 3, 2), CFrame = CFrame.new(mx, my - 8, mz + 41), Color = black, Parent = bg })
	mouth.CastShadow = false
	local crownBase = pillar(bg, Vector3.new(mx, my + 38, mz), 6, 30, Color3.fromRGB(255, 200, 40), Enum.Material.Foil)
	crownBase.CastShadow = false
	local monumentSign = sign(bg, CFrame.new(mx, FLOOR + 92, mz + 2), Vector3.new(60, 10, 1), "MOUNT BLOB", Color3.fromRGB(255, 80, 160), Color3.fromRGB(255, 255, 255), Enum.NormalId.Back)
	monumentSign.CastShadow = false
	for _ = 1, 8 do
		backdropMountain(bg, "mountain", Vector3.new(rng:NextNumber(-260, 260), FLOOR - 1, -Config.HubLength - rng:NextNumber(170, 320)), rng, BACKDROPS.meadow)
	end

	-- Pro Zone: Boden und Berge links und rechts
	for index, zone in ipairs(Config.Zones) do
		local theme = BACKDROPS[zone.Decor] or BACKDROPS.meadow
		local startZ = Calc.GetZoneStartZ(index)
		local centerZ = startZ + Config.ZoneLength / 2
		for _, side in ipairs({ -1, 1 }) do
			ground("ZoneGround", Vector3.new(outer, 2, Config.ZoneLength), Vector3.new(side * (HALF_WIDTH + outer / 2), FLOOR - 1.2, centerZ), rgb(theme.Ground),
				zone.Decor == "desert" and Enum.Material.Sand or (zone.Decor == "ice" and Enum.Material.Snow or (zone.Decor == "lava" and Enum.Material.Basalt or (zone.Decor == "meadow" and Enum.Material.Grass or Enum.Material.SmoothPlastic))))
			for n = 1, (index > 10 and 2 or 3) do
				local x = side * rng:NextNumber(HALF_WIDTH + 60, HALF_WIDTH + 280)
				local z = startZ + (n - 0.5) * Config.ZoneLength / 3 + rng:NextNumber(-15, 15)
				backdropMountain(bg, theme.Kind, Vector3.new(x, FLOOR - 1, z), rng, theme)
			end
		end
	end

	-- Ende der Welt: Boden und Berge hinter der letzten Zone
	for dimIndex, dim in ipairs(Config.Dimensions) do
		local endZ = Calc.GetZoneStartZ(dim.LastZone) + Config.ZoneLength
		local lastTheme = BACKDROPS[Config.Zones[dim.LastZone].Decor] or BACKDROPS.space
		ground("EndGround", Vector3.new(Config.ZoneWidth + outer * 2, 2, outer * 0.5), Vector3.new(0, FLOOR - 1.2, endZ + outer * 0.25), rgb(lastTheme.Ground), Enum.Material.SmoothPlastic)
		for _ = 1, 6 do
			backdropMountain(bg, lastTheme.Kind, Vector3.new(rng:NextNumber(-260, 260), FLOOR - 1, endZ + rng:NextNumber(50, 170)), rng, lastTheme)
		end
		if dimIndex > 1 then
			local frontZ = dim.StartZ - Config.DimensionLandingLength
			local firstTheme = BACKDROPS[Config.Zones[dim.FirstZone].Decor] or BACKDROPS.space
			for _, side in ipairs({ -1, 1 }) do
				ground("LandingGround", Vector3.new(outer, 2, Config.DimensionLandingLength), Vector3.new(side * (HALF_WIDTH + outer / 2), FLOOR - 1.2, frontZ + Config.DimensionLandingLength / 2), rgb(firstTheme.Ground), Enum.Material.SmoothPlastic)
			end
			ground("RiftBackGround", Vector3.new(Config.ZoneWidth + outer * 2, 2, outer * 0.5), Vector3.new(0, FLOOR - 1.3, frontZ - outer * 0.25), rgb(firstTheme.Ground), Enum.Material.SmoothPlastic)
			for _ = 1, 6 do
				backdropMountain(bg, firstTheme.Kind, Vector3.new(rng:NextNumber(-260, 260), FLOOR - 1, frontZ - rng:NextNumber(50, 170)), rng, firstTheme)
			end
		end
	end
end

function World.Build()
	local old = workspace:FindFirstChild("SlapWorld")
	if old then
		old:Destroy()
	end
	root = folder("SlapWorld", workspace)
	World.Root = root

	-- Andere Spawns (z.B. aus der Baseplate-Vorlage) ausschalten
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("SpawnLocation") then
			d.Enabled = false
		end
	end

	buildLighting()
	buildHub()
	for index, zone in ipairs(Config.Zones) do
		buildZone(index, zone)
	end
	buildBounds()
	buildLandings()
	buildDuelArenas()
	buildBackground()

	World.GyattFolder = folder("Gyatts", root)
	return World
end

-- Liegt eine Position in der PvP-Arena?
function World.IsInArena(position)
	if not World.Arena then
		return false
	end
	local offset = position - World.Arena.Center
	local flat = math.sqrt(offset.X * offset.X + offset.Z * offset.Z)
	return flat <= World.Arena.Radius and offset.Y > -2 and offset.Y < 25
end

return World
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX00000031"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX00000030"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX00000029"><Properties><string name="Name">SlapClient</string><ProtectedString name="Source"><![CDATA[--[[
	SlapClient (LocalScript in StarterPlayer > StarterPlayerScripts)

	Startet die komplette Client-Seite von "Slap the Blob":
	Menues, HUD, Effekte, Pets, Welt-Animationen.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local Shared = ReplicatedStorage:WaitForChild("SlapShared")
local Config = require(Shared:WaitForChild("Config"))
local Calc = require(Shared:WaitForChild("Calc"))
local remotes = ReplicatedStorage:WaitForChild("SlapRemotes")

local UI = require(script:WaitForChild("UI"))
local Hud = require(script:WaitForChild("Hud"))
local Menus = require(script:WaitForChild("Menus"))
local Effects = require(script:WaitForChild("Effects"))
local WorldFx = require(script:WaitForChild("WorldFx"))
local PetsFx = require(script:WaitForChild("PetsFx"))
local Hatch = require(script:WaitForChild("Hatch"))
local DuelUI = require(script:WaitForChild("DuelUI"))
local TradeUI = require(script:WaitForChild("TradeUI"))

local old = playerGui:FindFirstChild("SlapUI")
if old then
	old:Destroy()
end
local screen = UI.Create("ScreenGui", {
	Name = "SlapUI",
	ResetOnSpawn = false,
	IgnoreGuiInset = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = playerGui,
})

--------------------------------------------------------------------------
-- Kontext
--------------------------------------------------------------------------
local ctx = {
	Player = player,
	Config = Config,
	Calc = Calc,
	UI = UI,
	Screen = screen,
	Remotes = remotes,
	State = nil,
	TimeOffset = 0,
}

local listeners = {}
function ctx.OnState(fn)
	table.insert(listeners, fn)
end

function ctx.Request(action, a, b)
	remotes.Request:FireServer(action, a, b)
end

function ctx.Now()
	return os.time() + ctx.TimeOffset
end

function ctx.Setting(name)
	local state = ctx.State
	if state and state.Settings and state.Settings[name] ~= nil then
		return state.Settings[name]
	end
	return true
end

-- Sounds (nur eingebaute Roblox-Sounds, damit garantiert nichts fehlt)
local SOUNDS = {
	Click = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.35, Speed = 1.6 },
	Buy = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.6, Speed = 1.2 },
	Denied = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.5, Speed = 0.6 },
	Crit = { Id = "rbxasset://sounds/swordlunge.wav", Volume = 0.7, Speed = 1 },
	Popup = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.7, Speed = 0.9 },
	Hatch = { Id = "rbxasset://sounds/unsheath.wav", Volume = 0.7, Speed = 1 },
	Whoosh = { Id = "rbxasset://sounds/swordslash.wav", Volume = 0.5, Speed = 0.7 },
}
local soundTemplates = {}
for name, info in pairs(SOUNDS) do
	local sound = Instance.new("Sound")
	sound.Name = "Slap_" .. name
	sound.SoundId = info.Id
	sound.Volume = info.Volume
	sound.PlaybackSpeed = info.Speed
	sound.Parent = SoundService
	soundTemplates[name] = sound
end

function ctx.PlaySound(name, speedFactor)
	if not ctx.Setting("Sounds") then
		return
	end
	local template = soundTemplates[name]
	if not template then
		return
	end
	local sound = template:Clone()
	sound.PlaybackSpeed = template.PlaybackSpeed * (speedFactor or 1)
	sound.Parent = SoundService
	sound:Play()
	Debris:AddItem(sound, 3)
end

--------------------------------------------------------------------------
-- Module starten
--------------------------------------------------------------------------
ctx.Hud = Hud
ctx.Menus = Menus
ctx.Effects = Effects
ctx.WorldFx = WorldFx
ctx.PetsFx = PetsFx
ctx.Hatch = Hatch
ctx.DuelUI = DuelUI
ctx.TradeUI = TradeUI

Hud.Init(ctx)
Menus.Init(ctx)
Effects.Init(ctx)
WorldFx.Init(ctx)
PetsFx.Init(ctx)
Hatch.Init(ctx)
DuelUI.Init(ctx)
TradeUI.Init(ctx)

UI.OnWindowOpened = function()
	ctx.PlaySound("Click")
end

-- Verkaufsstaende im Hub oeffnen ihr Menue
game:GetService("ProximityPromptService").PromptTriggered:Connect(function(prompt, who)
	if who ~= player then
		return
	end
	local menu = prompt:GetAttribute("OpenMenu")
	if type(menu) == "string" and UI.Windows[menu] then
		UI.Open(menu)
	end
end)

--------------------------------------------------------------------------
-- Spielstand vom Server
--------------------------------------------------------------------------
remotes.State.OnClientEvent:Connect(function(payload)
	if type(payload) ~= "table" then
		return
	end
	if type(payload.ServerTime) == "number" then
		ctx.TimeOffset = payload.ServerTime - os.time()
	end
	if payload.Full or not ctx.State then
		ctx.State = payload
	else
		for key, value in pairs(payload) do
			ctx.State[key] = value
		end
	end
	for _, fn in ipairs(listeners) do
		local ok, err = pcall(fn, ctx.State, payload.Full == true)
		if not ok then
			warn("[SlapTheBlob] UI error: " .. tostring(err))
		end
	end
end)

remotes.Notify.OnClientEvent:Connect(function(text, color)
	Hud.Notify(text, color)
end)

remotes.Popup.OnClientEvent:Connect(function(title, subtitle, color)
	Hud.Popup(title, subtitle, color)
	ctx.PlaySound("Popup")
end)

remotes.Event.OnClientEvent:Connect(function(kind, a, b)
	if kind == "Purchased" then
		ctx.PlaySound("Buy")
	elseif kind == "Denied" then
		ctx.PlaySound("Denied")
	elseif kind == "GoldenStart" then
		Hud.SetGoldenEvent(a, b)
		ctx.PlaySound("Popup", 1.3)
	elseif kind == "GoldenEnd" then
		Hud.SetGoldenEvent(nil, nil)
	end
end)

remotes.SlapFx.OnClientEvent:Connect(function(info)
	if type(info) == "table" then
		Effects.OnSlap(info)
		WorldFx.OnSlap(info)
		if info.UserId == player.UserId and info.Kind == "Gyatt" then
			Hud.SetCombo(info.Combo)
		end
	end
end)

remotes.Defeat.OnClientEvent:Connect(function(key, position, radius, isGolden)
	Effects.OnDefeat(key, position, radius, isGolden)
end)

remotes.Knockback.OnClientEvent:Connect(function(velocity, attackerName)
	Effects.OnKnockback(velocity, attackerName)
end)

remotes.Hatch.OnClientEvent:Connect(function(result)
	Hatch.Play(result)
end)

remotes.Duel.OnClientEvent:Connect(function(info)
	DuelUI.OnEvent(info)
end)

remotes.Trade.OnClientEvent:Connect(function(info)
	TradeUI.OnEvent(info)
end)

remotes.Request:FireServer("RequestState")
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX00000020"><Properties><string name="Name">DuelUI</string><ProtectedString name="Source"><![CDATA[--[[
	DuelUI: Anzeige waehrend eines Duells.
	  Lebensbalken beider Spieler, Timer, grosser Countdown,
	  Dash-Knopf (Taste Q) und Ergebnis.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local DuelUI = {}
local ctx, UI, Config, Create

local player = Players.LocalPlayer
local frame, myBar, theirBar, myLabel, theirLabel, timerLabel, bigLabel, bigScale, dashButton, comboLabel, comboScale
local active = false
local duelScale
local dashReadyAt = 0
local maxHealth = 100

local function build()
	frame = Create("Frame", {
		Name = "DuelHud",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.new(0, 520, 0, 74),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		Visible = false,
		ZIndex = 10,
		Parent = ctx.Screen,
	}, {
		UI.Corner(16),
		UI.Stroke(3, Color3.fromRGB(255, 80, 140)),
		UI.Gradient(Color3.fromRGB(70, 20, 50), Color3.fromRGB(30, 10, 30)),
		Create("UISizeConstraint", { MaxSize = Vector2.new(520, 74) }),
	})
	duelScale = Create("UIScale", { Scale = 1, Parent = frame })
	myLabel = UI.Label({ Position = UDim2.new(0, 10, 0, 4), Size = UDim2.new(0.4, -10, 0, 22), TextXAlignment = Enum.TextXAlignment.Left, Text = "You", ZIndex = 11, Parent = frame })
	theirLabel = UI.Label({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 4), Size = UDim2.new(0.4, -10, 0, 22), TextXAlignment = Enum.TextXAlignment.Right, Text = "", ZIndex = 11, Parent = frame })
	timerLabel = UI.Label({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 2), Size = UDim2.new(0.2, 0, 0, 28), Text = "60", TextColor3 = UI.Colors.Gold, ZIndex = 11, Parent = frame })
	UI.TextStroke(2).Parent = timerLabel
	local _, a = UI.ProgressBar({ Position = UDim2.new(0, 10, 0, 34), Size = UDim2.new(0.5, -20, 0, 22), Color = Color3.fromRGB(80, 220, 120), Parent = frame })
	local _, b = UI.ProgressBar({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 34), Size = UDim2.new(0.5, -20, 0, 22), Color = Color3.fromRGB(255, 70, 90), Parent = frame })
	myBar, theirBar = a, b
	comboLabel = UI.Label({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 1, 4), Size = UDim2.new(0.5, 0, 0, 26), Text = "",
		TextColor3 = Color3.fromRGB(255, 170, 60), ZIndex = 11, Parent = frame })
	UI.TextStroke(2).Parent = comboLabel
	comboScale = Create("UIScale", { Scale = 1, Parent = comboLabel })

	bigLabel = UI.Label({
		Name = "DuelBig",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.4),
		Size = UDim2.new(0.6, 0, 0.18, 0),
		Text = "",
		Visible = false,
		ZIndex = 30,
		Parent = ctx.Screen,
	})
	UI.TextStroke(4).Parent = bigLabel
	bigScale = Create("UIScale", { Scale = 1, Parent = bigLabel })

	dashButton = UI.Button({
		Name = "Dash",
		-- rechts in der Mitte, damit er nicht den Springen-Knopf am Handy verdeckt
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.45, 0),
		Size = UDim2.new(0, 110, 0, 60),
		Color = Color3.fromRGB(80, 160, 255),
		Text = "💨 DASH (Q)",
		Parent = ctx.Screen,
	}, function()
		DuelUI.Dash()
	end)
	dashButton.Visible = false
end

local function showBig(text, color, duration)
	bigLabel.Text = text
	bigLabel.TextColor3 = color or UI.Colors.White
	bigLabel.Visible = true
	bigScale.Scale = 0.3
	TweenService:Create(bigScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	local myText = text
	task.delay(duration or 0.9, function()
		if bigLabel.Text == myText then
			bigLabel.Visible = false
		end
	end)
end

function DuelUI.Dash()
	if not active then
		return
	end
	local now = os.clock()
	if now < dashReadyAt then
		return
	end
	dashReadyAt = now + Config.Duel.DashCooldown
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root then
		local look = root.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude > 0.01 then
			root.AssemblyLinearVelocity = flat.Unit * Config.Duel.DashSpeed + Vector3.new(0, 8, 0)
		end
	end
	ctx.PlaySound("Whoosh", 1.3)
	ctx.Request("DuelDash")
end

function DuelUI.OnEvent(info)
	if type(info) ~= "table" then
		return
	end
	if info.Kind == "Start" then
		active = true
		ctx.Hud.SetDuelMode(true)
		duelScale.Scale = ctx.Hud.GetScale()
		maxHealth = tonumber(info.MaxHealth) or 100
		frame.Visible = true
		dashButton.Visible = true
		theirLabel.Text = tostring(info.Opponent)
		myLabel.Text = player.DisplayName
		comboLabel.Text = "💨 Dash + slap = DASH STRIKE!"
		UI.SetProgress(myBar, 1)
		UI.SetProgress(theirBar, 1)
		timerLabel.Text = tostring(info.Duration or 60)
		ctx.UI.Close(ctx.UI.OpenWindow or "")
		task.spawn(function()
			local count = tonumber(info.Countdown) or 3
			for i = count, 1, -1 do
				showBig(tostring(i), UI.Colors.Gold, 0.8)
				ctx.PlaySound("Click", 1 + (count - i) * 0.2)
				task.wait(1)
			end
			showBig("⚔️ FIGHT! ⚔️", Color3.fromRGB(255, 90, 120), 1)
			ctx.PlaySound("Popup", 1.3)
		end)
	elseif info.Kind == "Update" then
		local myHealth = tonumber(info.MyHealth) or 0
		local theirHealth = tonumber(info.TheirHealth) or 0
		UI.SetProgress(myBar, myHealth / maxHealth)
		UI.SetProgress(theirBar, theirHealth / maxHealth)
		myLabel.Text = player.DisplayName .. "  " .. math.ceil(myHealth)
		theirLabel.Text = math.ceil(theirHealth) .. "  " .. tostring(info.Opponent or "")
		timerLabel.Text = tostring(math.ceil(tonumber(info.TimeLeft) or 0))
		local combo = tonumber(info.MyCombo) or 0
		if combo >= 1 then
			comboLabel.Text = "🔥 " .. (combo + 1) .. " HIT COMBO!"
			comboScale.Scale = 1.3
			TweenService:Create(comboScale, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		else
			comboLabel.Text = ""
		end
	elseif info.Kind == "DashOk" then
		dashReadyAt = math.max(dashReadyAt, os.clock() + (tonumber(info.Cooldown) or 2.5) - 0.2)
	elseif info.Kind == "End" then
		active = false
		dashButton.Visible = false
		local result = info.Result
		if result == "Win" then
			showBig("🏆 VICTORY!", UI.Colors.Gold, 2.5)
		elseif result == "Lose" then
			showBig("💀 DEFEAT", Color3.fromRGB(255, 90, 90), 2.5)
		else
			showBig("🤝 DRAW", UI.Colors.White, 2.5)
		end
		ctx.Hud.Notify("⚔️ Duel over (" .. tostring(info.Reason) .. ")  +" .. tostring(info.Gems) .. " 💎", { 255, 220, 120 })
		task.delay(2.5, function()
			if not active then
				frame.Visible = false
				ctx.Hud.SetDuelMode(false)
			end
		end)
	end
end

-- Dash-Schlag anzeigen (vom Effekt-System aufgerufen)
function DuelUI.OnDashStrike(mine)
	if active then
		showBig(mine and "⚡ DASH STRIKE!" or "⚡ OUCH!", mine and Color3.fromRGB(120, 220, 255) or Color3.fromRGB(255, 120, 120), 0.7)
	end
end

function DuelUI.IsActive()
	return active
end

function DuelUI.Init(context)
	ctx = context
	UI = ctx.UI
	Config = ctx.Config
	Create = UI.Create
	build()
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.Q then
			DuelUI.Dash()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.1)
			if active then
				local left = dashReadyAt - os.clock()
				if left > 0 then
					dashButton.Text = string.format("💨 %.1f", left)
					UI.SetButtonColor(dashButton, UI.Colors.Gray)
				else
					dashButton.Text = "💨 DASH (Q)"
					UI.SetButtonColor(dashButton, Color3.fromRGB(80, 160, 255))
				end
			end
		end
	end)
end

return DuelUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000021"><Properties><string name="Name">Effects</string><ProtectedString name="Source"><![CDATA[--[[
	Effects: Schadenszahlen, Partikel, Kamera-Wackeln, Konfetti, Rueckstoss.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

local Effects = {}
local ctx, UI, Calc

local player = Players.LocalPlayer
local shakeUntil = 0
local shakeStrength = 0

local function makeAttachment(position)
	local attachment = Instance.new("Attachment")
	attachment.Parent = workspace.Terrain
	attachment.WorldPosition = position
	return attachment
end

local function burst(position, colors, count, speed, size)
	local attachment = makeAttachment(position)
	local keypoints = {}
	for i, color in ipairs(colors) do
		table.insert(keypoints, ColorSequenceKeypoint.new((i - 1) / math.max(1, #colors - 1), color))
	end
	if #keypoints == 1 then
		table.insert(keypoints, ColorSequenceKeypoint.new(1, colors[1]))
	end
	local emitter = Instance.new("ParticleEmitter")
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(0.4, 0.9)
	emitter.Speed = NumberRange.new(speed * 0.6, speed)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Acceleration = Vector3.new(0, -30, 0)
	emitter.Drag = 2
	emitter.LightEmission = 0.6
	emitter.Color = ColorSequence.new(keypoints)
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 0.6) })
	emitter.Parent = attachment
	emitter:Emit(count)
	Debris:AddItem(attachment, 1.5)
end

local function floatingText(position, text, color, size, transparency)
	local attachment = makeAttachment(position)
	local billboard = UI.Create("BillboardGui", {
		Adornee = attachment,
		Size = UDim2.new(size * 1.8, 0, size, 0),
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = 200,
		Parent = attachment,
	})
	local label = UI.Create("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = UI.Font,
		TextScaled = true,
		TextColor3 = color,
		TextStrokeTransparency = 0,
		TextTransparency = transparency or 0,
		Text = text,
		Parent = billboard,
	})
	local scale = UI.Create("UIScale", { Scale = 0.4, Parent = label })
	TweenService:Create(scale, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	TweenService:Create(billboard, TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { StudsOffset = Vector3.new(0, 3.5, 0) }):Play()
	TweenService:Create(label, TweenInfo.new(0.45, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, 0.55), {
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	}):Play()
	Debris:AddItem(attachment, 1.1)
end

local function shake(strength, duration)
	if not ctx.Setting("Shake") then
		return
	end
	shakeStrength = math.max(shakeStrength, strength)
	shakeUntil = math.max(shakeUntil, os.clock() + duration)
end

local function fovPunch(amount)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local base = 70
	camera.FieldOfView = base + amount
	TweenService:Create(camera, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { FieldOfView = base }):Play()
end

local function screenFlash(color, strength)
	local flash = UI.Create("Frame", {
		Name = "Flash",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = color,
		BackgroundTransparency = 1 - strength,
		BorderSizePixel = 0,
		ZIndex = 40,
		Parent = ctx.Screen,
	})
	TweenService:Create(flash, TweenInfo.new(0.5), { BackgroundTransparency = 1 }):Play()
	Debris:AddItem(flash, 0.6)
end

local function lightning(position)
	for i = 1, 3 do
		local bolt = Instance.new("Part")
		bolt.Name = "Lightning"
		bolt.Anchored = true
		bolt.CanCollide = false
		bolt.CanQuery = false
		bolt.CanTouch = false
		bolt.CastShadow = false
		bolt.Material = Enum.Material.Neon
		bolt.Color = (i == 1) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(255, 240, 140)
		local width = (i == 1) and 1.6 or 0.7
		bolt.Size = Vector3.new(width, 140, width)
		local offset = Vector3.new((math.random() - 0.5) * 4, 70, (math.random() - 0.5) * 4)
		bolt.CFrame = CFrame.new(position + offset) * CFrame.Angles(0, 0, (math.random() - 0.5) * 0.12)
		bolt.Parent = workspace
		TweenService:Create(bolt, TweenInfo.new(0.45), { Transparency = 1 }):Play()
		Debris:AddItem(bolt, 0.5)
	end
end

function Effects.OnSlap(info)
	local position = info.Position
	if typeof(position) ~= "Vector3" then
		return
	end
	local isMine = info.UserId == player.UserId

	if info.Kind == "DuelDodge" then
		floatingText(position + Vector3.new(0, 3, 0), "💨 DODGE!", Color3.fromRGB(140, 200, 255), 4, 0)
		return
	end
	if info.Kind == "Duel" then
		local crit = tonumber(info.Crit) or 0
		if info.Special == "DashStrike" then
			burst(position, { Color3.fromRGB(120, 220, 255), Color3.fromRGB(255, 255, 255), Color3.fromRGB(80, 120, 255) }, 40, 40, 1.2)
			floatingText(position + Vector3.new(0, 5, 0), "⚡ DASH STRIKE!", Color3.fromRGB(130, 220, 255), 5, 0)
			if isMine or info.TargetId == player.UserId then
				shake(0.6, 0.25)
				fovPunch(7)
				screenFlash(Color3.fromRGB(150, 220, 255), 0.25)
			end
			if ctx.DuelUI and ctx.DuelUI.OnDashStrike and (isMine or info.TargetId == player.UserId) then
				ctx.DuelUI.OnDashStrike(isMine)
			end
		end
		local combo = tonumber(info.Combo) or 0
		if combo >= 2 then
			floatingText(position + Vector3.new(0, 6.5, 0), "x" .. (combo + 1) .. " COMBO", Color3.fromRGB(255, 170, 60), 3.5, 0)
		end
		burst(position, { Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 80, 120) }, crit > 0 and 30 or 16, 28, 0.9)
		floatingText(position + Vector3.new((math.random() - 0.5) * 2, 3, 0), (crit > 0 and "💥 " or "") .. "-" .. tostring(info.Damage), crit > 0 and Color3.fromRGB(255, 220, 60) or Color3.fromRGB(255, 120, 120), crit > 0 and 5 or 3.5, 0)
		if isMine then
			shake(0.3, 0.15)
			fovPunch(3)
		end
		return
	end
	if info.Kind == "Pvp" then
		burst(position, { Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 80, 160) }, 18, 25, 0.8)
		if isMine then
			shake(0.25, 0.15)
			fovPunch(3)
		end
		return
	end

	local radius = tonumber(info.Radius) or 3
	local damage = tonumber(info.Damage) or 0
	local crit = tonumber(info.Crit) or 0

	-- Trefferpunkt: Seite des Gyatts, die zum Schlaeger zeigt
	local hitPoint = position
	if typeof(info.From) == "Vector3" then
		local dir = info.From - position
		if dir.Magnitude > 0.01 then
			hitPoint = position + dir.Unit * radius * 0.95
		end
	end

	local colors = { Color3.fromRGB(255, 200, 230), Color3.fromRGB(255, 90, 170) }
	if crit == 1 then
		colors = { Color3.fromRGB(255, 240, 120), Color3.fromRGB(255, 140, 30) }
	elseif crit == 2 then
		colors = { Color3.fromRGB(255, 80, 80), Color3.fromRGB(255, 230, 80), Color3.fromRGB(80, 255, 120), Color3.fromRGB(80, 160, 255), Color3.fromRGB(200, 90, 255) }
	end
	burst(hitPoint, colors, isMine and (crit > 0 and 30 or 14) or 6, 22 + crit * 10, 0.7 + crit * 0.3)

	if ctx.Setting("DamageNumbers") and (isMine or math.random() < 0.5) then
		local text = "-" .. Calc.FormatNumber(damage)
		local color = Color3.fromRGB(255, 255, 255)
		local size = isMine and 4.5 or 2.8
		if crit == 1 then
			text = "💥 CRIT! " .. text
			color = Color3.fromRGB(255, 220, 60)
			size = size * 1.3
		elseif crit == 2 then
			text = "🌈 MEGA CRIT!! " .. text
			color = Color3.fromRGB(255, 90, 200)
			size = size * 1.7
		end
		if isMine and info.Reward then
			text = text .. "\n+" .. Calc.FormatNumber(info.Reward) .. " 👋"
		end
		local offset = Vector3.new((math.random() - 0.5) * radius * 1.4, radius * 0.5 + math.random() * radius * 0.6, 0)
		floatingText(position + offset, text, color, size, isMine and 0 or 0.35)
	end

	-- Legendaere Kraefte
	if info.Special == "Snap" then
		burst(position, { Color3.fromRGB(120, 100, 90), Color3.fromRGB(200, 180, 160) }, 80, 30, 1.6)
		floatingText(position + Vector3.new(0, radius + 3, 0), "🫰 SNAP!", Color3.fromRGB(190, 110, 255), 9, 0)
		if isMine then
			screenFlash(Color3.fromRGB(150, 60, 255), 0.45)
			shake(0.8, 0.4)
		end
	elseif info.Special == "Smite" then
		lightning(position)
		burst(position + Vector3.new(0, radius, 0), { Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 230, 100) }, 50, 45, 1.5)
		if isMine then
			floatingText(position + Vector3.new(0, radius + 3, 0), "⚡ DIVINE SMITE!", Color3.fromRGB(255, 240, 120), 8, 0)
			screenFlash(Color3.fromRGB(255, 255, 220), 0.35)
			shake(0.9, 0.35)
			ctx.PlaySound("Crit", 0.6)
		end
	end

	if isMine then
		fovPunch(crit > 0 and 4 or 1.5)
		if crit > 0 then
			shake(crit == 2 and 0.9 or 0.4, crit == 2 and 0.45 or 0.2)
			ctx.PlaySound("Crit", crit == 2 and 0.8 or 1.1)
		end
	end
end

function Effects.OnDefeat(key, position, radius, isGolden)
	if typeof(position) ~= "Vector3" then
		return
	end
	radius = tonumber(radius) or 4
	local confetti = {
		Color3.fromRGB(255, 80, 160), Color3.fromRGB(255, 220, 60), Color3.fromRGB(90, 220, 255),
		Color3.fromRGB(120, 255, 120), Color3.fromRGB(200, 120, 255),
	}
	burst(position, confetti, isGolden and 120 or 60, 40, 1.4)
	burst(position + Vector3.new(0, radius, 0), { Color3.fromRGB(255, 255, 255) }, 30, 25, 2)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if root and (root.Position - position).Magnitude < 80 then
		shake(0.6, 0.35)
		floatingText(position + Vector3.new(0, radius + 2, 0), isGolden and "⭐ GOLDEN DEFEATED! ⭐" or "💥 DEFEATED!", Color3.fromRGB(255, 230, 90), 7, 0)
	end
end

function Effects.OnKnockback(velocity, attackerName)
	if typeof(velocity) ~= "Vector3" then
		return
	end
	-- Schutz: unrealistisch starke Werte begrenzen
	if velocity.Magnitude > 250 then
		velocity = velocity.Unit * 250
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return
	end
	humanoid:ChangeState(Enum.HumanoidStateType.FallingDown)
	root.AssemblyLinearVelocity = velocity
	shake(0.7, 0.3)
	ctx.PlaySound("Whoosh")
	ctx.Hud.Notify("💥 " .. tostring(attackerName) .. " slapped you away!", { 255, 150, 150 })
	task.delay(0.8, function()
		if humanoid.Parent and humanoid.Health > 0 then
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end)
end

function Effects.Init(context)
	ctx = context
	UI = ctx.UI
	Calc = ctx.Calc

	-- Kamera-Wackeln ueber CameraOffset des Humanoids
	RunService.RenderStepped:Connect(function()
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not humanoid then
			return
		end
		local now = os.clock()
		if now < shakeUntil then
			local s = shakeStrength
			humanoid.CameraOffset = Vector3.new((math.random() - 0.5) * s, (math.random() - 0.5) * s, (math.random() - 0.5) * s)
		elseif shakeStrength > 0 then
			shakeStrength = 0
			humanoid.CameraOffset = Vector3.new(0, 0, 0)
		end
	end)
end

return Effects
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000022"><Properties><string name="Name">Hatch</string><ProtectedString name="Source"><![CDATA[--[[
	Hatch: Ei- und Kisten-Animation.
	  Ei wackelt immer schneller, leuchtet auf und platzt.
	  Dahinter drehen sich Lichtstrahlen in der Farbe der besten Seltenheit,
	  die Karten drehen sich um (Flip), springen und es regnet Konfetti.
]]

local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local Hatch = {}
local ctx, UI, Config, Calc, Create

local overlay, stage, eggLabel, eggScale, eggGlow, rays, raysScale, resultHolder, hintLabel, flash, confettiHolder, bestLabel
local playing = false
local queue = {}

local CATEGORY_ICON = { Hat = "🎩", Back = "🪽", Aura = "✨" }

local function build()
	overlay = Create("TextButton", {
		Name = "HatchOverlay",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(10, 0, 20),
		BackgroundTransparency = 0.3,
		AutoButtonColor = false,
		Text = "",
		Visible = false,
		ZIndex = 50,
		Parent = ctx.Screen,
	})
	stage = Create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 50, Parent = overlay })
	-- Lichtstrahlen (12 schmale Balken, die sich drehen)
	rays = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.new(0, 520, 0, 520),
		Rotation = 0,
		BackgroundTransparency = 1,
		ZIndex = 50,
		Parent = stage,
	})
	raysScale = Create("UIScale", { Scale = 1, Parent = rays })
	for i = 0, 11 do
		Create("Frame", {
			Name = "Ray",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(0, 34, 1, 0),
			Rotation = i * 15,
			BackgroundColor3 = Color3.fromRGB(255, 255, 255),
			BackgroundTransparency = 0.82,
			BorderSizePixel = 0,
			ZIndex = 50,
			Parent = rays,
		}, {
			Create("UIGradient", {
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 1),
					NumberSequenceKeypoint.new(0.5, 0),
					NumberSequenceKeypoint.new(1, 1),
				}),
				Rotation = 90,
			}),
		})
	end
	eggGlow = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.new(0, 200, 0, 200),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BackgroundTransparency = 0.6,
		ZIndex = 51,
		Parent = stage,
	}, { Create("UICorner", { CornerRadius = UDim.new(1, 0) }) })
	eggLabel = UI.Label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.new(0, 200, 0, 200),
		Text = "🥚",
		ZIndex = 52,
		Parent = stage,
	})
	eggScale = Create("UIScale", { Scale = 1, Parent = eggLabel })
	resultHolder = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.new(0.94, 0, 0, 230),
		BackgroundTransparency = 1,
		ZIndex = 52,
		Parent = stage,
	}, {
		Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 14),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	bestLabel = UI.Label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0.45, -125),
		Size = UDim2.new(0.8, 0, 0, 48),
		Text = "",
		ZIndex = 55,
		Parent = stage,
	})
	UI.TextStroke(3).Parent = bestLabel
	hintLabel = UI.Label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.45, 130),
		Size = UDim2.new(0.6, 0, 0, 26),
		Font = UI.BodyFont,
		TextColor3 = UI.Colors.SubText,
		Text = "Tap to close",
		ZIndex = 55,
		Parent = stage,
	})
	confettiHolder = Create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = 56, Parent = overlay })
	flash = Create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(255, 255, 255), BackgroundTransparency = 1, ZIndex = 57, Parent = overlay })
	-- auf kleinen Bildschirmen alles kleiner
	local stageScale = Create("UIScale", { Scale = 1, Parent = resultHolder })
	local function fit()
		local camera = workspace.CurrentCamera
		local h = camera and camera.ViewportSize.Y or 720
		local s = math.clamp(h / 700, 0.55, 1)
		stageScale.Scale = s
		raysScale.Scale = s
	end
	fit()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
	end
end

local function confetti(color, amount)
	local colors = { color, Color3.fromRGB(255, 220, 80), Color3.fromRGB(255, 110, 180), Color3.fromRGB(90, 200, 255), Color3.fromRGB(120, 255, 140) }
	for i = 1, amount do
		local startX = math.random()
		local startRotation = math.random(0, 360)
		local piece = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(startX, 0, -0.05, 0),
			Size = UDim2.new(0, math.random(6, 12), 0, math.random(10, 18)),
			Rotation = startRotation,
			BackgroundColor3 = colors[(i % #colors) + 1],
			BorderSizePixel = 0,
			ZIndex = 56,
			Parent = confettiHolder,
		})
		local duration = 1.6 + math.random() * 1.4
		TweenService:Create(piece, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.new(startX + (math.random() - 0.5) * 0.3, 0, 1.08, 0),
			Rotation = startRotation + math.random(-540, 540),
		}):Play()
		task.delay(duration + 0.05, function()
			piece:Destroy()
		end)
	end
end

-- Karte fuer ein Pet oder Item. Startet "umgedreht" (schmal) und dreht sich auf.
local function makeCard(order, info)
	local color = info.RarityColor
	local frame = Create("Frame", {
		LayoutOrder = order,
		Size = UDim2.new(0, 160, 0, 214),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		ZIndex = 53,
		Parent = resultHolder,
	}, {
		UI.Corner(18),
		UI.Stroke(4, color),
		UI.Gradient(UI.Colors.Panel, UI.Colors.Darker),
	})
	local inner = Create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 53, Parent = frame })
	local scale = Create("UIScale", { Scale = 0.2, Parent = frame })
	-- Rueckseite (Fragezeichen) waehrend des Flips
	local back = Create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = color, ZIndex = 58, Parent = frame }, { UI.Corner(18) })
	UI.Label({ Size = UDim2.fromScale(1, 1), Text = "?", ZIndex = 59, Parent = back })

	local face = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 14),
		Size = UDim2.new(0, 86, 0, 86),
		BackgroundColor3 = info.Color,
		ZIndex = 54,
		Parent = inner,
	}, { Create("UICorner", { CornerRadius = UDim.new(1, 0) }), UI.Stroke(3) })
	UI.Label({ Size = UDim2.fromScale(1, 1), Text = info.Icon, ZIndex = 55, Parent = face })
	local name = UI.Label({ Position = UDim2.new(0, 6, 0, 106), Size = UDim2.new(1, -12, 0, 30), TextWrapped = true, Text = info.Name, ZIndex = 54, Parent = inner })
	UI.TextStroke(1.5).Parent = name
	local rarityLabel = UI.Label({ Position = UDim2.new(0, 6, 0, 138), Size = UDim2.new(1, -12, 0, 24), Text = info.RarityName, TextColor3 = color, ZIndex = 54, Parent = inner })
	UI.TextStroke(1.5).Parent = rarityLabel
	UI.Label({ Position = UDim2.new(0, 6, 0, 166), Size = UDim2.new(1, -12, 0, 22), Font = UI.BodyFont, TextScaled = true, Text = info.Stat, TextColor3 = UI.Colors.Gold, ZIndex = 54, Parent = inner })
	if info.Order >= 5 then
		-- Glanz fuer sehr seltene Karten
		local shine = Create("UIGradient", {
			Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)), ColorSequenceKeypoint.new(0.5, color), ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 255, 255)) }),
			Rotation = 45,
			Parent = back,
		})
		shine.Offset = Vector2.new(-1, 0)
		TweenService:Create(shine, TweenInfo.new(0.5), { Offset = Vector2.new(1, 0) }):Play()
	end

	-- Auftauchen, dann Flip (Breite 0 -> voll), dann kleiner Huepfer
	local delayTime = 0.12 * (order - 1)
	task.delay(delayTime, function()
		TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		task.wait(0.35 + (info.Order >= 4 and 0.35 or 0))
		local half = TweenService:Create(frame, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Size = UDim2.new(0, 0, 0, 214) })
		half:Play()
		task.wait(0.12)
		back.Visible = false
		TweenService:Create(frame, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.new(0, 160, 0, 214) }):Play()
		task.wait(0.18)
		scale.Scale = 1.15
		TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Bounce, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end)
	return frame
end

local function petInfo(petId)
	local cfg = Config.Pets[petId]
	local rarity = Config.Rarities[cfg.Rarity]
	return {
		Name = cfg.DisplayName,
		Icon = "😊",
		Color = UI.rgb(cfg.Color),
		RarityName = rarity.DisplayName,
		RarityColor = UI.rgb(rarity.Color),
		Order = rarity.Order,
		Rarity = cfg.Rarity,
		Stat = "+" .. Calc.FormatNumber(math.floor(cfg.Boost * 100)) .. "% Slaps",
	}
end

local function itemInfo(itemId, level)
	local cfg = Config.Items[itemId]
	local rarity = Config.Rarities[cfg.Rarity]
	return {
		Name = cfg.DisplayName,
		Icon = CATEGORY_ICON[cfg.Category] or "🎁",
		Color = UI.rgb(cfg.Color),
		RarityName = rarity.DisplayName,
		RarityColor = UI.rgb(rarity.Color),
		Order = rarity.Order,
		Rarity = cfg.Rarity,
		Stat = Calc.DescribeItem(itemId, level or 1),
	}
end

local function playOne(result)
	playing = true
	for _, child in ipairs(resultHolder:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	local infos = {}
	for _, pet in ipairs(result.Pets or {}) do
		if Config.Pets[pet.Id] then
			table.insert(infos, petInfo(pet.Id))
		end
	end
	for _, item in ipairs(result.Items or {}) do
		if Config.Items[item.Id] then
			table.insert(infos, itemInfo(item.Id, item.Level))
		end
	end
	local best = infos[1]
	for _, info in ipairs(infos) do
		if info.Order > best.Order then
			best = info
		end
	end
	if not best then
		playing = false
		return
	end

	local isCrate = result.Crate ~= nil
	local eggCfg = result.EggId and Config.Eggs[result.EggId]
	local eggColor = eggCfg and UI.rgb(eggCfg.Color) or Color3.fromRGB(200, 150, 255)

	overlay.Visible = true
	hintLabel.Visible = false
	bestLabel.Text = ""
	eggLabel.Visible = true
	eggGlow.Visible = true
	eggLabel.Text = isCrate and "🎁" or "🥚"
	eggLabel.Rotation = 0
	eggGlow.BackgroundColor3 = eggColor
	eggGlow.BackgroundTransparency = 0.7
	eggScale.Scale = 0.4
	rays.Visible = true
	rays.Rotation = 0
	for _, ray in ipairs(rays:GetChildren()) do
		if ray:IsA("Frame") then
			ray.BackgroundColor3 = eggColor
			ray.BackgroundTransparency = 0.88
		end
	end
	TweenService:Create(eggScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()

	-- Strahlen drehen sich die ganze Zeit
	local spin = RunService.RenderStepped:Connect(function(dt)
		rays.Rotation = (rays.Rotation + dt * 25) % 360
	end)

	-- Wackeln, immer schneller; das Leuchten wird staerker (seltener = laenger)
	local shakes = { 0.16, 0.14, 0.12, 0.1, 0.08, 0.07, 0.06, 0.05 }
	if best.Order >= 5 then
		table.insert(shakes, 0.05)
		table.insert(shakes, 0.04)
		table.insert(shakes, 0.04)
	end
	for i, duration in ipairs(shakes) do
		local angle = (i % 2 == 0) and 16 or -16
		TweenService:Create(eggLabel, TweenInfo.new(duration), { Rotation = angle }):Play()
		eggGlow.BackgroundTransparency = 0.7 - (i / #shakes) * 0.45
		task.wait(duration)
	end
	-- Aufblitzen in der Farbe der besten Seltenheit
	ctx.PlaySound("Hatch")
	flash.BackgroundColor3 = best.RarityColor
	flash.BackgroundTransparency = best.Order >= 4 and 0.1 or 0.5
	TweenService:Create(flash, TweenInfo.new(0.5), { BackgroundTransparency = 1 }):Play()
	TweenService:Create(eggScale, TweenInfo.new(0.15), { Scale = 1.7 }):Play()
	task.wait(0.15)
	eggLabel.Visible = false
	eggGlow.Visible = false
	for _, ray in ipairs(rays:GetChildren()) do
		if ray:IsA("Frame") then
			ray.BackgroundColor3 = best.RarityColor
			ray.BackgroundTransparency = best.Order >= 4 and 0.55 or 0.78
		end
	end
	raysScale.Scale = raysScale.Scale * 0.6
	TweenService:Create(raysScale, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = raysScale.Scale / 0.6 }):Play()

	for i, info in ipairs(infos) do
		makeCard(i, info)
	end
	if best.Order >= 3 then
		bestLabel.Text = string.upper(best.RarityName) .. "!" .. (best.Order >= 5 and "!!" or "")
		bestLabel.TextColor3 = best.RarityColor
		local s = Create("UIScale", { Scale = 0.3, Parent = bestLabel })
		TweenService:Create(s, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		task.delay(3, function()
			s:Destroy()
		end)
	end
	confetti(best.RarityColor, best.Order >= 5 and 70 or (best.Order >= 3 and 40 or 18))
	ctx.PlaySound("Popup", best.Order >= 4 and 1.4 or 1)
	if best.Order >= 5 then
		ctx.Hud.Popup(string.upper(best.RarityName) .. "!!!", "Incredible luck!", Config.Rarities[best.Rarity].Color)
	end
	task.wait(0.6)
	hintLabel.Visible = true

	-- automatisch schliessen
	local closeAt = os.clock() + (best.Order >= 4 and 4 or 3)
	while overlay.Visible and os.clock() < closeAt do
		task.wait(0.1)
	end
	spin:Disconnect()
	overlay.Visible = false
	playing = false
	if #queue > 0 then
		local nextResult = table.remove(queue, 1)
		task.spawn(playOne, nextResult)
	end
end

function Hatch.Play(result)
	if type(result) ~= "table" or (type(result.Pets) ~= "table" and type(result.Items) ~= "table") then
		return
	end
	if playing then
		if #queue < 3 then
			table.insert(queue, result)
		end
		return
	end
	task.spawn(playOne, result)
end

function Hatch.Init(context)
	ctx = context
	UI = ctx.UI
	Config = ctx.Config
	Calc = ctx.Calc
	Create = UI.Create
	build()
	overlay.Activated:Connect(function()
		if hintLabel.Visible then
			overlay.Visible = false
		end
	end)
end

return Hatch
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000023"><Properties><string name="Name">Hud</string><ProtectedString name="Source"><![CDATA[--[[
	Hud: alles, was immer auf dem Bildschirm ist.
	  Geld-Anzeige, Combo, Boosts, Event-Banner, Menue-Knoepfe,
	  Auto-Slap-Schalter, Zonen-Anzeige, Nachrichten, Popups.
]]

local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local Hud = {}
local ctx, UI, Config, Calc, Create

local slapsLabel, gemsLabel, multiLabel, hintLabel
local comboFrame, comboLabel, comboFill
local boostRow
local eventBanner, eventLabel
local notifyHolder
local popupFrame, popupTitle, popupSub, popupScale
local zoneLabel
local autoButton
local topPanel, menuHolder
local hudScale = 1
local duelMode = false
local badges = {}

local comboValue = 0
local comboExpires = 0
local golden = { ZoneIndex = nil, EndsAt = 0 }
local notifyCounter = 0
local popupId = 0

--------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------
local function buildTop(screen)
	local top
	top = Create("Frame", {
		Name = "TopPanel",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 6),
		Size = UDim2.new(0, 330, 0, 44),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		Parent = screen,
	}, {
		UI.Corner(18),
		UI.Stroke(3, UI.Colors.Pink),
		UI.Gradient(UI.Colors.Dark, UI.Colors.Darker),
	})

	topPanel = top
	-- schmale Leiste: Slaps links, Gems rechts (verdeckt kaum etwas)
	slapsLabel = UI.Label({
		Name = "Slaps",
		Position = UDim2.new(0, 10, 0, 4),
		Size = UDim2.new(0.6, -14, 0, 36),
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "👋 Loading...",
		Parent = top,
	})
	UI.TextStroke(2).Parent = slapsLabel

	gemsLabel = UI.Label({
		Name = "Gems",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 7),
		Size = UDim2.new(0.4, -6, 0, 30),
		TextColor3 = Color3.fromRGB(140, 220, 255),
		TextXAlignment = Enum.TextXAlignment.Right,
		Text = "💎 0",
		Parent = top,
	})
	UI.TextStroke(1.5).Parent = gemsLabel

	multiLabel = UI.Label({
		Name = "Multi",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 44),
		Size = UDim2.new(0.55, -10, 0, 22),
		Font = UI.BodyFont,
		TextColor3 = UI.Colors.SubText,
		TextXAlignment = Enum.TextXAlignment.Right,
		Text = "",
		Visible = false,
		Parent = top,
	})

	hintLabel = UI.Label({
		Name = "Hint",
		Position = UDim2.new(0, 10, 0, 66),
		Size = UDim2.new(1, -20, 0, 16),
		Font = UI.BodyFont,
		TextColor3 = Color3.fromRGB(170, 140, 190),
		Text = "",
		Visible = false,
		Parent = top,
	})

	-- Combo
	comboFrame = Create("Frame", {
		Name = "Combo",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 98),
		Size = UDim2.new(0, 220, 0, 46),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = screen,
	})
	comboLabel = UI.Label({
		Size = UDim2.new(1, 0, 0, 32),
		TextColor3 = Color3.fromRGB(255, 160, 60),
		Text = "",
		Parent = comboFrame,
	})
	UI.TextStroke(2.5).Parent = comboLabel
	local _, fill = UI.ProgressBar({ Position = UDim2.new(0.1, 0, 0, 34), Size = UDim2.new(0.8, 0, 0, 8), Color = Color3.fromRGB(255, 140, 40), Parent = comboFrame })
	comboFill = fill

	-- Boosts
	boostRow = Create("Frame", {
		Name = "Boosts",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 148),
		Size = UDim2.new(0, 420, 0, 28),
		BackgroundTransparency = 1,
		Parent = screen,
	}, { UI.List(6, true, Enum.HorizontalAlignment.Center) })

	-- Event-Banner
	eventBanner = Create("Frame", {
		Name = "EventBanner",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 182),
		Size = UDim2.new(0, 420, 0, 40),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		Visible = false,
		Parent = screen,
	}, {
		UI.Corner(12),
		UI.Stroke(3, Color3.fromRGB(255, 240, 150)),
		UI.Gradient(Color3.fromRGB(255, 210, 60), Color3.fromRGB(230, 150, 20)),
		Create("UISizeConstraint", { MaxSize = Vector2.new(420, 40) }),
	})
	eventLabel = UI.Label({ Size = UDim2.fromScale(1, 1), Text = "", Parent = eventBanner }, nil)
	UI.Padding(6, 4).Parent = eventLabel
	UI.TextStroke(2).Parent = eventLabel
end

local MENU_BUTTONS = {
	{ "ShopHub", "🛒", "Shop", { 255, 105, 180 } },
	{ "Pets", "🐾", "Pets", { 90, 200, 120 } },
	{ "Items", "🎩", "Items", { 170, 110, 255 } },
	{ "Zones", "🗺️", "Zones", { 70, 170, 255 } },
	{ "Rebirth", "♻️", "Rebirth", { 160, 100, 255 } },
	{ "Quests", "📜", "Quests", { 255, 200, 60 } },
	{ "Daily", "🎁", "Daily", { 255, 90, 120 } },
	{ "Trade", "🤝", "Trade", { 60, 190, 170 } },
	{ "Settings", "⚙️", "Settings", { 130, 130, 150 } },
}
local BUTTON_SIZE = 50
local menuOpen = true
local menuList, menuToggle

local function setMenuOpen(open)
	menuOpen = open
	if menuList then
		menuList.Visible = open
	end
	if menuToggle then
		menuToggle.Text = open and "◀" or "☰"
	end
end
Hud.SetMenuOpen = setMenuOpen

-- Schmale Leiste links: eine Spalte, kann eingeklappt werden
local function buildMenuButtons(screen)
	local count = #MENU_BUTTONS
	local listHeight = count * (BUTTON_SIZE + 5)
	local holder = Create("Frame", {
		Name = "MenuButtons",
		ZIndex = 1,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 6, 0.5, 0),
		Size = UDim2.new(0, BUTTON_SIZE, 0, listHeight + 40),
		BackgroundTransparency = 1,
		Parent = screen,
	})
	menuToggle = UI.Button({
		Name = "MenuToggle",
		Size = UDim2.new(0, BUTTON_SIZE, 0, 34),
		Color = UI.Colors.Darker,
		Text = "◀",
		Parent = holder,
	}, function()
		setMenuOpen(not menuOpen)
	end)
	menuList = Create("Frame", {
		Name = "List",
		Position = UDim2.new(0, 0, 0, 40),
		Size = UDim2.new(1, 0, 0, listHeight),
		BackgroundTransparency = 1,
		Parent = holder,
	}, { UI.List(5, false) })
	-- auf kleinen Bildschirmen (Handy quer) verkleinern, damit alles passt
	local holderScale = Create("UIScale", { Scale = 1, Parent = holder })
	local function fit()
		local camera = workspace.CurrentCamera
		if camera then
			holderScale.Scale = math.clamp((camera.ViewportSize.Y - 60) / (listHeight + 40), 0.5, 1)
		end
	end
	fit()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
	end
	menuHolder = holder
	for order, info in ipairs(MENU_BUTTONS) do
		local name, icon, label, color = info[1], info[2], info[3], info[4]
		local button = UI.Button({
			Name = name,
			LayoutOrder = order,
			Size = UDim2.new(0, BUTTON_SIZE, 0, BUTTON_SIZE),
			Color = UI.rgb(color),
			Text = "",
			Padding = 2,
			PaddingY = 2,
			Parent = menuList,
		}, function()
			UI.Toggle(name)
		end)
		UI.Label({ Size = UDim2.new(1, 0, 0.64, 0), Text = icon, Parent = button })
		local text = UI.Label({ Position = UDim2.new(0, 0, 0.64, 0), Size = UDim2.new(1, 0, 0.36, 0), Text = label, Parent = button })
		UI.TextStroke(1.5).Parent = text

		local badge = Create("TextLabel", {
			Name = "Badge",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, -4, 0, 4),
			Size = UDim2.new(0, 18, 0, 18),
			BackgroundColor3 = UI.Colors.Red,
			Font = UI.Font,
			TextScaled = true,
			TextColor3 = UI.Colors.White,
			Text = "!",
			Visible = false,
			ZIndex = 3,
			Parent = button,
		}, { Create("UICorner", { CornerRadius = UDim.new(1, 0) }), UI.Stroke(2, UI.Colors.White) })
		badges[name] = badge
	end
	-- auf dem Handy startet das Menue eingeklappt
	local camera = workspace.CurrentCamera
	if camera and camera.ViewportSize.Y > 1 and camera.ViewportSize.Y < 500 then
		setMenuOpen(false)
	end
end

local function buildRightSide(screen)
	autoButton = UI.Button({
		Name = "AutoSlap",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, -40),
		Size = UDim2.new(0, 120, 0, 50),
		Color = UI.Colors.Gray,
		Text = "🤖 Auto: OFF",
		Parent = screen,
	}, function()
		ctx.Request("ToggleAutoSlap")
	end)
	autoButton.Visible = false
end

local function buildBottom(screen)
	zoneLabel = UI.Label({
		Name = "Zone",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -8),
		Size = UDim2.new(0, 360, 0, 26),
		TextColor3 = UI.Colors.White,
		Text = "📍 Hub",
		Parent = screen,
	})
	UI.TextStroke(2).Parent = zoneLabel

	notifyHolder = Create("Frame", {
		Name = "Notifications",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -40),
		Size = UDim2.new(0.8, 0, 0, 170),
		BackgroundTransparency = 1,
		Parent = screen,
	}, {
		Create("UIListLayout", {
			Padding = UDim.new(0, 4),
			SortOrder = Enum.SortOrder.LayoutOrder,
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
		}),
		Create("UISizeConstraint", { MaxSize = Vector2.new(620, 170) }),
	})

	popupFrame = Create("Frame", {
		Name = "Popup",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.36),
		Size = UDim2.new(0.8, 0, 0, 110),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 20,
		Parent = screen,
	}, { Create("UISizeConstraint", { MaxSize = Vector2.new(640, 110) }) })
	popupScale = Create("UIScale", { Scale = 1, Parent = popupFrame })
	popupTitle = UI.Label({ Size = UDim2.new(1, 0, 0, 64), Text = "", ZIndex = 20, Parent = popupFrame })
	UI.TextStroke(3.5).Parent = popupTitle
	popupSub = UI.Label({ Position = UDim2.new(0, 0, 0, 66), Size = UDim2.new(1, 0, 0, 34), TextColor3 = UI.Colors.White, Text = "", ZIndex = 20, Parent = popupFrame })
	UI.TextStroke(2.5).Parent = popupSub
end

--------------------------------------------------------------------------
-- Oeffentliche Funktionen
--------------------------------------------------------------------------
function Hud.Notify(text, color)
	if type(text) ~= "string" then
		return
	end
	local textColor = UI.Colors.White
	if type(color) == "table" and #color == 3 then
		textColor = UI.rgb(color)
	end
	notifyCounter = notifyCounter + 1

	local existing = {}
	for _, child in ipairs(notifyHolder:GetChildren()) do
		if child:IsA("TextLabel") then
			table.insert(existing, child)
		end
	end
	table.sort(existing, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	while #existing >= 5 do
		table.remove(existing, 1):Destroy()
	end

	local label = Create("TextLabel", {
		LayoutOrder = notifyCounter,
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundColor3 = UI.Colors.Darker,
		BackgroundTransparency = 0.2,
		Font = UI.BodyFont,
		TextScaled = true,
		TextColor3 = textColor,
		Text = text,
		Parent = notifyHolder,
	}, { UI.Corner(10), UI.Padding(10, 4), UI.TextStroke(1.5) })
	local scale = Create("UIScale", { Scale = 0.6, Parent = label })
	TweenService:Create(scale, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()

	task.delay(4, function()
		if label.Parent then
			TweenService:Create(label, TweenInfo.new(0.5), { TextTransparency = 1, BackgroundTransparency = 1 }):Play()
			task.delay(0.55, function()
				label:Destroy()
			end)
		end
	end)
end

function Hud.Popup(title, subtitle, color)
	popupId = popupId + 1
	local myId = popupId
	popupTitle.Text = tostring(title)
	popupSub.Text = tostring(subtitle or "")
	popupTitle.TextColor3 = (type(color) == "table" and #color == 3) and UI.rgb(color) or UI.Colors.White
	popupTitle.TextTransparency = 0
	popupSub.TextTransparency = 0
	popupFrame.Visible = true
	popupScale.Scale = 0.3
	TweenService:Create(popupScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	task.delay(2.6, function()
		if popupId ~= myId then
			return
		end
		TweenService:Create(popupTitle, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
		TweenService:Create(popupSub, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
		task.delay(0.45, function()
			if popupId == myId then
				popupFrame.Visible = false
			end
		end)
	end)
end

function Hud.SetCombo(combo)
	combo = tonumber(combo) or 0
	comboValue = combo
	comboExpires = os.clock() + Config.ComboWindow
	if combo >= 2 and not duelMode then
		comboFrame.Visible = true
		comboLabel.Text = "🔥 " .. combo .. "x COMBO  +" .. math.floor(combo * Config.ComboBonusPerStack * 100 + 0.5) .. "%"
		local hue = math.clamp(0.12 - combo / 1000, 0, 0.12)
		comboLabel.TextColor3 = Color3.fromHSV(hue, 0.85, 1)
	end
end

function Hud.SetGoldenEvent(zoneIndex, endsAt)
	if zoneIndex then
		golden.ZoneIndex = zoneIndex
		golden.EndsAt = tonumber(endsAt) or 0
		eventBanner.Visible = not duelMode
	else
		golden.ZoneIndex = nil
		eventBanner.Visible = false
	end
end

function Hud.SetZone(index)
	if index == -1 then
		zoneLabel.Text = "⚔️ Duel Arena"
	elseif index == 0 then
		zoneLabel.Text = "📍 Hub - Spawn Area"
	else
		local zone = Config.Zones[index]
		zoneLabel.Text = "📍 Zone " .. index .. ": " .. (zone and zone.Name or "?")
	end
end

local function refreshBoosts(state)
	for _, child in ipairs(boostRow:GetChildren()) do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	if not state or type(state.Boosts) ~= "table" then
		return
	end
	local now = ctx.Now()
	for order, id in ipairs(Config.BoostOrder) do
		local expires = tonumber(state.Boosts[id]) or 0
		if expires > now then
			local boost = Config.Boosts[id]
			Create("TextLabel", {
				Name = id,
				LayoutOrder = order,
				Size = UDim2.new(0, 130, 1, 0),
				BackgroundColor3 = UI.Colors.Darker,
				BackgroundTransparency = 0.15,
				Font = UI.Font,
				TextScaled = true,
				TextColor3 = UI.rgb(boost.Color),
				Text = boost.Icon .. " " .. boost.DisplayName .. " " .. Calc.FormatTime(expires - now),
				Parent = boostRow,
			}, { UI.Corner(8), UI.Padding(6, 3), UI.Stroke(2, UI.rgb(boost.Color)) })
		end
	end
end

local function refreshBadges(state)
	if not state then
		return
	end
	local questReady = false
	if state.Quests and state.Quests.Day then
		local quests = Calc.GetQuests(state.Quests.Day, ctx.Player.UserId)
		for i, quest in ipairs(quests) do
			local progress = state.Quests.Progress and state.Quests.Progress[i] or 0
			local claimed = state.Quests.Claimed and state.Quests.Claimed[i]
			if not claimed and progress >= quest.Amount then
				questReady = true
			end
		end
	end
	badges.Quests.Visible = questReady
	local dailyReady = Calc.GetDailyStatus(state, ctx.Now())
	badges.Daily.Visible = dailyReady == true
	badges.Rebirth.Visible = (state.Slaps or 0) >= Calc.GetRebirthCost(state.Rebirths)
end

function Hud.Refresh(state)
	if not state then
		return
	end
	slapsLabel.Text = "👋 " .. Calc.FormatNumber(state.Slaps) .. " Slaps"
	gemsLabel.Text = "💎 " .. Calc.FormatNumber(state.Gems)
	if state.Upgrades then
		local now = ctx.Now()
		multiLabel.Text = "💪 " .. Calc.FormatNumber(Calc.GetDamage(state, now)) .. "   💰 " .. Calc.FormatMultiplier(Calc.GetSlapMultiplier(state, now))
	end
	local owned = state.GemShop and (state.GemShop.AutoSlap or 0) >= 1
	autoButton.Visible = owned == true and not duelMode
	if owned then
		autoButton.Text = state.AutoSlapOn and "🤖 Auto: ON" or "🤖 Auto: OFF"
		UI.SetButtonColor(autoButton, state.AutoSlapOn and UI.Colors.Green or UI.Colors.Gray)
	end
	refreshBadges(state)
	refreshBoosts(state)

	-- naechstes Ziel
	local zones = state.Zones or 1
	local nextZone = Config.Zones[zones + 1]
	if nextZone then
		hintLabel.Text = "🎯 Next goal: Zone " .. (zones + 1) .. " for " .. Calc.FormatNumber(nextZone.Price) .. " Slaps"
	else
		hintLabel.Text = "🎯 Next goal: Rebirth for " .. Calc.FormatNumber(Calc.GetRebirthCost(state.Rebirths)) .. " Slaps"
	end
end

--------------------------------------------------------------------------
-- Handy: alles kleiner machen. Duell: unnoetiges ausblenden.
--------------------------------------------------------------------------
local scaleObjects = {}

local function addScale(guiObject)
	local scale = Create("UIScale", { Name = "HudScale", Scale = 1, Parent = guiObject })
	table.insert(scaleObjects, scale)
end

local function applyScale()
	local camera = workspace.CurrentCamera
	local height = camera and camera.ViewportSize.Y or 720
	hudScale = math.clamp(height / 680, 0.55, 1)
	for _, scale in ipairs(scaleObjects) do
		scale.Scale = hudScale
	end
	-- Abstaende an die Groesse anpassen
	local y = 6 + 44 * hudScale + 6
	comboFrame.Position = UDim2.new(0.5, 0, 0, y)
	y = y + 46 * hudScale + 4
	boostRow.Position = UDim2.new(0.5, 0, 0, y)
	y = y + 28 * hudScale + 6
	eventBanner.Position = UDim2.new(0.5, 0, 0, y)
	notifyHolder.Position = UDim2.new(0.5, 0, 1, -40 * hudScale)
end

function Hud.GetScale()
	return hudScale
end

-- Waehrend eines Duells nur das Noetigste zeigen (wichtig auf dem Handy)
function Hud.SetDuelMode(on)
	duelMode = on == true
	topPanel.Visible = not duelMode
	menuHolder.Visible = not duelMode
	boostRow.Visible = not duelMode
	zoneLabel.Visible = not duelMode
	if duelMode then
		comboFrame.Visible = false
		eventBanner.Visible = false
		autoButton.Visible = false
	else
		eventBanner.Visible = golden.ZoneIndex ~= nil
		if ctx.State then
			Hud.Refresh(ctx.State)
		end
	end
end

local lastSlaps = nil
function Hud.Init(context)
	ctx = context
	UI = ctx.UI
	Config = ctx.Config
	Calc = ctx.Calc
	Create = UI.Create

	buildTop(ctx.Screen)
	buildMenuButtons(ctx.Screen)
	buildRightSide(ctx.Screen)
	buildBottom(ctx.Screen)
	for _, guiObject in ipairs({ topPanel, comboFrame, boostRow, eventBanner, notifyHolder, zoneLabel }) do
		addScale(guiObject)
	end
	applyScale()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(applyScale)
	end

	ctx.OnState(function(state)
		Hud.Refresh(state)
		if lastSlaps and state.Slaps > lastSlaps then
			slapsLabel.TextColor3 = Color3.fromRGB(150, 255, 160)
			TweenService:Create(slapsLabel, TweenInfo.new(0.35), { TextColor3 = UI.Colors.White }):Play()
		end
		lastSlaps = state.Slaps
	end)

	-- Combo-Balken laufend leeren
	RunService.RenderStepped:Connect(function()
		if comboFrame.Visible then
			local remaining = comboExpires - os.clock()
			if remaining <= 0 then
				comboFrame.Visible = false
				comboValue = 0
			else
				UI.SetProgress(comboFill, remaining / Config.ComboWindow)
			end
		end
	end)

	-- Timer jede halbe Sekunde
	task.spawn(function()
		while true do
			task.wait(0.5)
			if golden.ZoneIndex then
				local remaining = golden.EndsAt - ctx.Now()
				if remaining < 0 then
					remaining = 0
				end
				eventLabel.Text = "⭐ GOLDEN BLOB in Zone " .. golden.ZoneIndex .. "!  " .. Calc.FormatTime(remaining)
			end
			if ctx.State then
				refreshBoosts(ctx.State)
				refreshBadges(ctx.State)
			end
		end
	end)
end

return Hud
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000024"><Properties><string name="Name">Menus</string><ProtectedString name="Source"><![CDATA[--[[
	Menus: alle Fenster.
	  Shop (Upgrades), Haende, Pets, Zonen, Gem-Shop, Rebirth,
	  Quests, Taegliche Belohnung, Codes, Optionen
]]

local Menus = {}
local ctx, UI, Config, Calc, Create, C

local function state()
	return ctx.State
end

local function smallLabel(props)
	props.Font = props.Font or UI.BodyFont
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	props.ZIndex = props.ZIndex or 6
	return UI.Label(props)
end

local function title(props)
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	props.ZIndex = props.ZIndex or 6
	local label = UI.Label(props)
	UI.TextStroke(1.5).Parent = label
	return label
end

local function money(amount, currency)
	return (currency == "Gems" and "💎 " or "👋 ") .. Calc.FormatNumber(amount)
end

--------------------------------------------------------------------------
-- Shop (Upgrades)
--------------------------------------------------------------------------
local function buildShop()
	local win = UI.CreateWindow(ctx.Screen, "Shop", "Hand Upgrades", "🛒", Vector2.new(600, 480))
	local list = UI.ScrollList(win.Content, {})
	UI.Label({ Size = UDim2.new(1, -10, 0, 34), LayoutOrder = 0, Font = UI.BodyFont, TextWrapped = true, TextColor3 = UI.Colors.SubText,
		Text = "Every 10 levels you need a ⚡ TIER UP (Slaps + Gems). Each new tier gives a much bigger bonus!", ZIndex = 6, Parent = list })
	local rows = {}
	for order, id in ipairs(Config.UpgradeOrder) do
		local upgrade = Config.Upgrades[id]
		local row = UI.Row(list, 104, order)
		title({ Position = UDim2.new(0, 12, 0, 6), Size = UDim2.new(0.42, -12, 0, 26), Text = upgrade.Icon .. " " .. upgrade.DisplayName, Parent = row })
		local tierBadge = UI.Label({ Position = UDim2.new(0.42, 0, 0, 9), Size = UDim2.new(0.18, -6, 0, 20), BackgroundTransparency = 0, Font = UI.Font,
			TextColor3 = Color3.fromRGB(30, 15, 35), Text = "", ZIndex = 7, Parent = row })
		UI.Corner(6).Parent = tierBadge
		local level = smallLabel({ Position = UDim2.new(0, 12, 0, 35), Size = UDim2.new(0.6, -12, 0, 16), TextColor3 = UI.Colors.SubText, Parent = row })
		local stat = smallLabel({ Position = UDim2.new(0, 12, 0, 53), Size = UDim2.new(0.6, -12, 0, 16), TextColor3 = UI.Colors.Text, Parent = row })
		local _, fill = UI.ProgressBar({ Position = UDim2.new(0, 12, 0, 76), Size = UDim2.new(0.6, -12, 0, 12), Parent = row })
		local buy = UI.Button({
			Name = "Buy",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -10, 0, 8),
			Size = UDim2.new(0.38, -14, 0, 52),
			Color = UI.Colors.Green,
			ZIndex = 6,
			Parent = row,
		}, function()
			ctx.Request("BuyUpgrade", id)
		end)
		local max = UI.Button({
			Name = "Max",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -10, 0, 66),
			Size = UDim2.new(0.38, -14, 0, 30),
			Color = UI.Colors.Purple,
			Text = "Buy MAX",
			ZIndex = 6,
			Parent = row,
		}, function()
			ctx.Request("BuyUpgradeMax", id)
		end)
		rows[id] = { Level = level, Stat = stat, Fill = fill, Buy = buy, Max = max, Tier = tierBadge }
	end

	win.Refresh = function()
		local s = state()
		if not s or not s.Upgrades then
			return
		end
		for _, id in ipairs(Config.UpgradeOrder) do
			local row = rows[id]
			local upgrade = Config.Upgrades[id]
			local level = Calc.ClampLevel(id, s.Upgrades[id])
			local cost, gems = Calc.GetUpgradeCost(id, level)
			local tierInfo = Calc.GetTierInfo(Calc.GetTier(level))
			row.Tier.Text = string.upper(tierInfo.Name)
			row.Tier.BackgroundColor3 = UI.rgb(tierInfo.Color)
			row.Level.Text = "Level " .. level .. " / " .. upgrade.MaxLevel .. "  -  " .. upgrade.Description
			-- Fortschritt innerhalb der aktuellen Tier
			UI.SetProgress(row.Fill, (level % Config.TierSize) / Config.TierSize)
			if level >= upgrade.MaxLevel then
				UI.SetProgress(row.Fill, 1)
			end
			if cost then
				row.Stat.Text = Calc.DescribeUpgrade(id, level) .. "  ➜  " .. Calc.DescribeUpgrade(id, level + 1)
				if gems > 0 then
					local nextTier = Calc.GetTierInfo(Calc.GetTier(level + 1))
					row.Buy.Text = "⚡ TIER UP → " .. nextTier.Name .. "\n" .. money(cost, "Slaps") .. " + " .. money(gems, "Gems")
					UI.SetButtonColor(row.Buy, (s.Slaps >= cost and s.Gems >= gems) and UI.Colors.Gold or UI.Colors.Gray)
				else
					row.Buy.Text = money(cost, "Slaps")
					UI.SetButtonColor(row.Buy, s.Slaps >= cost and UI.Colors.Green or UI.Colors.Gray)
				end
				row.Max.Visible = gems == 0
			else
				row.Stat.Text = Calc.DescribeUpgrade(id, level)
				row.Buy.Text = "MAX"
				UI.SetButtonColor(row.Buy, UI.Colors.Gold)
				row.Max.Visible = false
			end
		end
	end
	return win
end

--------------------------------------------------------------------------
-- Haende
--------------------------------------------------------------------------
local function buildHands()
	local win = UI.CreateWindow(ctx.Screen, "Hands", "Gloves", "✋", Vector2.new(620, 500))
	local tabBar = Create("Frame", { Size = UDim2.new(1, 0, 0, 38), BackgroundTransparency = 1, ZIndex = 5, Parent = win.Content }, { UI.List(8, true) })
	local list = UI.ScrollList(win.Content, { Position = UDim2.new(0, 0, 0, 44), Size = UDim2.new(1, 0, 1, -44) })
	local rows = {}
	local currentTab = "Slaps"
	local tabButtons = {}
	local function applyFilter()
		for _, hand in ipairs(Config.Hands) do
			local r = rows[hand.Id]
			if r then
				r.Row.Visible = hand.Currency == currentTab
			end
		end
		for name, button in pairs(tabButtons) do
			UI.SetButtonColor(button, name == currentTab and UI.Colors.Pink or UI.Colors.Gray)
		end
	end
	for order, info in ipairs({ { "Slaps", "👋 Slaps (60)" }, { "Gems", "💎 Gems" }, { "Robux", "👑 Robux" } }) do
		tabButtons[info[1]] = UI.Button({ Size = UDim2.new(0, 150, 1, 0), LayoutOrder = order, Text = info[2], ZIndex = 6, Parent = tabBar }, function()
			currentTab = info[1]
			applyFilter()
			list.CanvasPosition = Vector2.new(0, 0)
		end)
	end
	local effectNames = { sparkles = "Sparkles", fire = "Fire", smoke = "Frost Mist", rainbow = "Rainbow", dragon = "Dragon Fire", thanos = "Cosmic Stones",
		ultragod = "Divine Aura", aura = "Glow Aura", electric = "Lightning", shadow = "Shadow Smoke", orbit = "Orbiting Orbs", omni = "OMNI Aura" }
	for order, hand in ipairs(Config.Hands) do
		local rarity = Config.Rarities[hand.Rarity] or Config.Rarities.Common
		local rarityColor = UI.rgb(rarity.Color)
		local isUltra = hand.Currency == "Robux"
		local height = (hand.Perk and 104) or 84
		local row = UI.Row(list, height, order)
		if isUltra then
			row.BackgroundColor3 = Color3.fromRGB(70, 40, 20)
			UI.Create("UIGradient", {
				Color = ColorSequence.new(Color3.fromRGB(255, 230, 150), Color3.fromRGB(200, 120, 255)),
				Rotation = 0,
				Transparency = NumberSequence.new(0.6),
				Parent = row,
			})
		end
		local swatch = Create("Frame", {
			Position = UDim2.new(0, 10, 0, 12),
			Size = UDim2.new(0, 56, 0, 56),
			BackgroundColor3 = UI.rgb(hand.Color),
			ZIndex = 6,
			Parent = row,
		}, { UI.Corner(12), UI.Stroke(isUltra and 3.5 or 2, isUltra and UI.Colors.Gold or nil) })
		UI.Label({ Size = UDim2.fromScale(1, 1), Text = isUltra and (hand.Effect == "thanos" and "🫰" or "👑") or "✋", ZIndex = 7, Parent = swatch })

		title({ Position = UDim2.new(0, 76, 0, 6), Size = UDim2.new(0.58, -76, 0, 26), Text = (hand.Number and ("#" .. hand.Number .. "  ") or "") .. hand.DisplayName, Parent = row })
		local badge = UI.Label({
			Position = UDim2.new(0, 76, 0, 34),
			Size = UDim2.new(0, 96, 0, 18),
			BackgroundTransparency = 0,
			BackgroundColor3 = rarityColor,
			Font = UI.Font,
			TextColor3 = Color3.fromRGB(30, 15, 35),
			Text = string.upper(rarity.DisplayName),
			ZIndex = 7,
			Parent = row,
		})
		UI.Corner(6).Parent = badge
		local effect = effectNames[hand.Effect] and ("  ✨ " .. effectNames[hand.Effect]) or ""
		smallLabel({ Position = UDim2.new(0, 178, 0, 34), Size = UDim2.new(0.58, -178, 0, 18), TextColor3 = UI.Colors.SubText, Text = effect, Parent = row })
		smallLabel({ Position = UDim2.new(0, 76, 0, 56), Size = UDim2.new(0.58, -76, 0, 18), TextColor3 = UI.Colors.Gold, Text = Calc.DescribeHandPerks(hand), Parent = row })
		if hand.Perk then
			smallLabel({ Position = UDim2.new(0, 10, 0, 78), Size = UDim2.new(1, -20, 0, 20), TextColor3 = Color3.fromRGB(255, 240, 160), Text = hand.Perk, Parent = row })
		end
		local button = UI.Button({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -10, 0, 14),
			Size = UDim2.new(0.36, -10, 0, 50),
			ZIndex = 6,
			Parent = row,
		}, function()
			local s = state()
			if s and Calc.OwnsHand(s, hand.Id) then
				ctx.Request("EquipHand", hand.Id)
			else
				ctx.Request("BuyHand", hand.Id)
			end
		end)
		rows[hand.Id] = { Row = row, Button = button }
	end
	applyFilter()

	win.Refresh = function()
		local s = state()
		if not s or not s.OwnedHands then
			return
		end
		for _, hand in ipairs(Config.Hands) do
			local r = rows[hand.Id]
			local stroke = r.Row:FindFirstChildOfClass("UIStroke")
			local isUltra = hand.Currency == "Robux"
			if stroke then
				stroke.Color = isUltra and UI.Colors.Gold or UI.Colors.PanelLight
			end
			if s.Hand == hand.Id then
				r.Button.Text = "✅ Equipped"
				UI.SetButtonColor(r.Button, UI.Colors.GreenDark)
				if stroke then
					stroke.Color = UI.Colors.White
				end
			elseif Calc.OwnsHand(s, hand.Id) then
				r.Button.Text = "Equip"
				UI.SetButtonColor(r.Button, UI.Colors.Blue)
			elseif isUltra then
				r.Button.Text = "R$ " .. hand.Price
				UI.SetButtonColor(r.Button, UI.Colors.Gold)
			else
				local balance = hand.Currency == "Gems" and s.Gems or s.Slaps
				r.Button.Text = money(hand.Price, hand.Currency)
				UI.SetButtonColor(r.Button, balance >= hand.Price and UI.Colors.Green or UI.Colors.Gray)
			end
		end
	end
	return win
end

--------------------------------------------------------------------------
-- Pets
--------------------------------------------------------------------------
local function buildPets()
	local win = UI.CreateWindow(ctx.Screen, "Pets", "Pets", "🐾", Vector2.new(620, 500))
	local header = smallLabel({ Size = UDim2.new(1, 0, 0, 22), TextColor3 = UI.Colors.Gold, Parent = win.Content })
	local buttons = Create("Frame", {
		Position = UDim2.new(0, 0, 0, 26),
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = win.Content,
	}, { UI.List(8, true) })
	UI.Button({ Size = UDim2.new(0, 170, 1, 0), Color = UI.Colors.Green, Text = "⭐ Equip Best", LayoutOrder = 1, ZIndex = 6, Parent = buttons }, function()
		ctx.Request("EquipBestPets")
	end)
	UI.Button({ Size = UDim2.new(0, 200, 1, 0), Color = UI.Colors.Red, Text = "🗑️ Delete Commons", LayoutOrder = 2, ZIndex = 6, Parent = buttons }, function()
		ctx.Request("DeleteRarity", "Common")
	end)

	local grid = UI.ScrollList(win.Content, {
		Position = UDim2.new(0, 0, 0, 68),
		Size = UDim2.new(1, 0, 1, -128),
		Grid = UDim2.new(0, 108, 0, 112),
	})

	-- Auswahl unten
	local detail = Create("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 54),
		BackgroundColor3 = UI.Colors.Panel,
		ZIndex = 5,
		Parent = win.Content,
	}, { UI.Corner(12) })
	local detailText = smallLabel({ Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(0.45, -10, 1, 0), Text = "Click a pet", Parent = detail })
	local selectedUid = nil
	local equipButton = UI.Button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -118, 0.5, 0), Size = UDim2.new(0, 140, 0, 40), Color = UI.Colors.Blue, Text = "Equip", ZIndex = 6, Parent = detail }, function()
		local s = state()
		if not selectedUid or not s then
			return
		end
		for _, pet in ipairs(s.Pets or {}) do
			if pet.Uid == selectedUid then
				ctx.Request(pet.Equipped and "UnequipPet" or "EquipPet", selectedUid)
				return
			end
		end
	end)
	local deleteButton = UI.Button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.new(0, 104, 0, 40), Color = UI.Colors.Red, Text = "🗑️ Delete", ZIndex = 6, Parent = detail }, function()
		if selectedUid then
			ctx.Request("DeletePet", selectedUid)
			selectedUid = nil
		end
	end)

	local function refreshDetail(s)
		local selected = nil
		for _, pet in ipairs(s.Pets or {}) do
			if pet.Uid == selectedUid then
				selected = pet
			end
		end
		if not selected then
			selectedUid = nil
			detailText.Text = "Click a pet"
			equipButton.Visible = false
			deleteButton.Visible = false
			return
		end
		local cfg = Config.Pets[selected.Id]
		local rarity = Config.Rarities[cfg.Rarity]
		detailText.Text = cfg.DisplayName .. " (" .. rarity.DisplayName .. ")  +" .. Calc.FormatNumber(math.floor(cfg.Boost * 100)) .. "% Slaps"
		detailText.TextColor3 = UI.rgb(rarity.Color)
		equipButton.Visible = true
		deleteButton.Visible = not selected.Equipped
		equipButton.Text = selected.Equipped and "Unequip" or "Equip"
		UI.SetButtonColor(equipButton, selected.Equipped and UI.Colors.Gray or UI.Colors.Blue)
	end

	local lastSignature = nil
	win.Refresh = function()
		local s = state()
		if not s or not s.Pets then
			return
		end
		local equipped = Calc.GetEquippedPetIds(s)
		header.Text = "🐾 Equipped: " .. #equipped .. "/" .. Calc.GetPetSlots(s)
			.. "    🎒 " .. #s.Pets .. "/" .. Calc.GetInventorySize(s)
			.. "    💰 Pet Bonus: " .. Calc.FormatMultiplier(Calc.GetPetBoost(equipped))

		-- Karten nur neu bauen, wenn sich die Pets geaendert haben
		local parts = {}
		for _, pet in ipairs(s.Pets) do
			table.insert(parts, pet.Uid .. (pet.Equipped and "E" or "") .. ((pet.Uid == selectedUid) and "S" or ""))
		end
		local signature = table.concat(parts, ",")
		if signature ~= lastSignature then
			lastSignature = signature
			for _, child in ipairs(grid:GetChildren()) do
				if child:IsA("TextButton") then
					child:Destroy()
				end
			end
			local sorted = {}
			for _, pet in ipairs(s.Pets) do
				table.insert(sorted, pet)
			end
			table.sort(sorted, function(a, b)
				if a.Equipped ~= b.Equipped then
					return a.Equipped
				end
				local ba, bb = Config.Pets[a.Id].Boost, Config.Pets[b.Id].Boost
				if ba ~= bb then
					return ba > bb
				end
				return a.Uid < b.Uid
			end)
			for order, pet in ipairs(sorted) do
				local cfg = Config.Pets[pet.Id]
				local rarity = Config.Rarities[cfg.Rarity]
				local card = Create("TextButton", {
					Name = "Pet_" .. pet.Uid,
					LayoutOrder = order,
					BackgroundColor3 = UI.Colors.Panel,
					AutoButtonColor = true,
					Text = "",
					ZIndex = 6,
					Parent = grid,
				}, {
					UI.Corner(12),
					UI.Stroke(pet.Uid == selectedUid and 4 or 2.5, pet.Uid == selectedUid and UI.Colors.White or UI.rgb(rarity.Color)),
				})
				local face = Create("Frame", {
					AnchorPoint = Vector2.new(0.5, 0),
					Position = UDim2.new(0.5, 0, 0, 8),
					Size = UDim2.new(0, 44, 0, 44),
					BackgroundColor3 = UI.rgb(cfg.Color),
					ZIndex = 7,
					Parent = card,
				}, { Create("UICorner", { CornerRadius = UDim.new(1, 0) }), UI.Stroke(2) })
				UI.Label({ Size = UDim2.fromScale(1, 1), Text = "👀", ZIndex = 8, Parent = face })
				local nameLabel = UI.Label({ Position = UDim2.new(0, 4, 0, 54), Size = UDim2.new(1, -8, 0, 20), Text = cfg.DisplayName, ZIndex = 7, Parent = card })
				UI.TextStroke(1).Parent = nameLabel
				UI.Label({ Position = UDim2.new(0, 4, 0, 74), Size = UDim2.new(1, -8, 0, 16), Font = UI.BodyFont, TextColor3 = UI.rgb(rarity.Color), Text = rarity.DisplayName, ZIndex = 7, Parent = card })
				UI.Label({ Position = UDim2.new(0, 4, 0, 90), Size = UDim2.new(1, -8, 0, 16), Font = UI.BodyFont, TextColor3 = UI.Colors.Gold, Text = "+" .. Calc.FormatNumber(math.floor(cfg.Boost * 100)) .. "%", ZIndex = 7, Parent = card })
				if pet.Equipped then
					UI.Label({ Position = UDim2.new(0, 4, 0, 4), Size = UDim2.new(0, 22, 0, 22), Text = "✅", ZIndex = 8, Parent = card })
				end
				card.Activated:Connect(function()
					selectedUid = pet.Uid
					ctx.PlaySound("Click")
					lastSignature = nil
					win.Refresh()
				end)
			end
		end
		refreshDetail(s)
	end
	return win
end

--------------------------------------------------------------------------
-- Zonen
--------------------------------------------------------------------------
local function buildZones()
	local win = UI.CreateWindow(ctx.Screen, "Zones", "Zones & Teleport", "🗺️", Vector2.new(580, 480))
	local list = UI.ScrollList(win.Content, {})
	local hubRow = UI.Row(list, 56, 0)
	title({ Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(0.6, -12, 1, 0), Text = "🏠 Hub (Spawn, Arena, Leaderboards)", Parent = hubRow })
	UI.Button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.new(0.35, 0, 0, 40), Color = UI.Colors.Blue, Text = "Teleport", ZIndex = 6, Parent = hubRow }, function()
		ctx.Request("Teleport", 0)
		UI.Close("Zones")
	end)
	local rows = {}
	for index, zone in ipairs(Config.Zones) do
		local row = UI.Row(list, 76, index)
		Create("Frame", { Position = UDim2.new(0, 0, 0, 0), Size = UDim2.new(0, 10, 1, 0), BackgroundColor3 = UI.rgb(zone.Accent), ZIndex = 6, Parent = row }, { UI.Corner(8) })
		local dimName = Calc.GetDimension(index).Name
		title({ Position = UDim2.new(0, 18, 0, 6), Size = UDim2.new(0.6, -18, 0, 28), Text = (index > 6 and "🌀 " or "") .. "Zone " .. index .. ": " .. zone.Name, Parent = row })
		if index > 6 then
			smallLabel({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(0.62, 0, 0, 2), Size = UDim2.new(0.25, 0, 0, 12), TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = Color3.fromRGB(200, 150, 255), Text = dimName, Parent = row })
		end
		local names = {}
		for _, g in ipairs(zone.Gyatts) do
			table.insert(names, g.DisplayName)
		end
		local egg = Config.Eggs[zone.Egg]
		local mech = Config.MechanicInfo[zone.Mechanic or "none"]
		local mechText = (mech and zone.Mechanic ~= "none") and (mech.Icon .. " " .. mech.Name .. "  •  ") or ""
		smallLabel({ Position = UDim2.new(0, 18, 0, 36), Size = UDim2.new(0.6, -18, 0, 16), TextScaled = true, TextColor3 = UI.Colors.SubText, Text = mechText .. table.concat(names, ", ") .. "  •  " .. (egg and egg.DisplayName or ""), Parent = row })
		local status = smallLabel({ Position = UDim2.new(0, 18, 0, 54), Size = UDim2.new(0.6, -18, 0, 16), Parent = row })
		local button = UI.Button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.new(0.35, 0, 0, 46), ZIndex = 6, Parent = row }, function()
			local s = state()
			if s and index <= (s.Zones or 1) then
				ctx.Request("Teleport", index)
				UI.Close("Zones")
			else
				ctx.Request("UnlockZone", index)
			end
		end)
		rows[index] = { Status = status, Button = button }
	end
	win.Refresh = function()
		local s = state()
		if not s then
			return
		end
		local unlocked = s.Zones or 1
		for index, zone in ipairs(Config.Zones) do
			local r = rows[index]
			if index <= unlocked then
				r.Status.Text = "✅ Unlocked"
				r.Status.TextColor3 = UI.Colors.Green
				r.Button.Text = "Teleport"
				UI.SetButtonColor(r.Button, UI.Colors.Blue)
			elseif index == unlocked + 1 then
				r.Status.Text = "🔒 Unlock for " .. money(zone.Price, "Slaps")
				r.Status.TextColor3 = UI.Colors.Gold
				r.Button.Text = money(zone.Price, "Slaps")
				UI.SetButtonColor(r.Button, s.Slaps >= zone.Price and UI.Colors.Green or UI.Colors.Gray)
			else
				r.Status.Text = "🔒 Unlock Zone " .. (index - 1) .. " first"
				r.Status.TextColor3 = UI.Colors.SubText
				r.Button.Text = "🔒"
				UI.SetButtonColor(r.Button, UI.Colors.Gray)
			end
		end
	end
	return win
end

--------------------------------------------------------------------------
-- Gem-Shop
--------------------------------------------------------------------------
local function buildGems()
	local win = UI.CreateWindow(ctx.Screen, "Gems", "Gem Shop", "💎", Vector2.new(580, 470))
	local balance = smallLabel({ Size = UDim2.new(1, 0, 0, 24), TextColor3 = Color3.fromRGB(140, 220, 255), Parent = win.Content })
	local list = UI.ScrollList(win.Content, { Position = UDim2.new(0, 0, 0, 30), Size = UDim2.new(1, 0, 1, -30) })
	local rows = {}
	-- Gems fuer Robux
	UI.Label({ Size = UDim2.new(1, -10, 0, 28), LayoutOrder = -100, TextXAlignment = Enum.TextXAlignment.Left, Text = "💎 BUY GEMS", TextColor3 = Color3.fromRGB(140, 220, 255), ZIndex = 6, Parent = list })
	local packGrid = Create("Frame", { Size = UDim2.new(1, -10, 0, 236), LayoutOrder = -99, BackgroundTransparency = 1, ZIndex = 5, Parent = list }, {
		Create("UIGridLayout", { CellSize = UDim2.new(0.32, 0, 0, 110), CellPadding = UDim2.new(0.02, 0, 0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	for order, pack in ipairs(Config.GemPacks) do
		local card = Create("Frame", { LayoutOrder = order, BackgroundColor3 = UI.Colors.Panel, ZIndex = 6, Parent = packGrid }, { UI.Corner(12), UI.Stroke(2.5, Color3.fromRGB(120, 210, 255)) })
		local amount = UI.Label({ Position = UDim2.new(0, 4, 0, 6), Size = UDim2.new(1, -8, 0, 30), Text = "💎 " .. Calc.FormatNumber(pack.Gems), TextColor3 = Color3.fromRGB(150, 225, 255), ZIndex = 7, Parent = card })
		UI.TextStroke(1.5).Parent = amount
		if pack.Tag then
			local tag = UI.Label({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 38), Size = UDim2.new(0.8, 0, 0, 16), BackgroundTransparency = 0,
				BackgroundColor3 = UI.Colors.Gold, Font = UI.Font, TextColor3 = Color3.fromRGB(40, 20, 10), Text = pack.Tag, ZIndex = 7, Parent = card })
			UI.Corner(6).Parent = tag
		end
		UI.Button({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -8), Size = UDim2.new(0.86, 0, 0, 38), Color = UI.Colors.Green,
			Text = "R$ " .. pack.Robux, ZIndex = 7, Parent = card }, function()
			ctx.Request("BuyGemPack", pack.Id)
		end)
	end
	UI.Label({ Size = UDim2.new(1, -10, 0, 28), LayoutOrder = -98, TextXAlignment = Enum.TextXAlignment.Left, Text = "🛒 SPEND GEMS", TextColor3 = UI.Colors.Gold, ZIndex = 6, Parent = list })
	for order, item in ipairs(Config.GemShop) do
		local row = UI.Row(list, 72, order)
		title({ Position = UDim2.new(0, 12, 0, 6), Size = UDim2.new(0.6, -12, 0, 28), Text = item.Icon .. " " .. item.DisplayName, Parent = row })
		local desc = smallLabel({ Position = UDim2.new(0, 12, 0, 38), Size = UDim2.new(0.6, -12, 0, 26), TextColor3 = UI.Colors.SubText, TextWrapped = true, Text = item.Description, Parent = row })
		local button = UI.Button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.new(0.35, 0, 0, 46), ZIndex = 6, Parent = row }, function()
			ctx.Request("BuyGemItem", item.Id)
		end)
		rows[item.Id] = { Button = button, Desc = desc }
	end
	smallLabel({ Size = UDim2.new(1, -10, 0, 40), LayoutOrder = 100, TextWrapped = true, TextColor3 = UI.Colors.SubText,
		Text = "💡 You get Gems from defeated Blobs, quests, daily rewards, codes, rebirths and the Golden Blob!", Parent = list })

	win.Refresh = function()
		local s = state()
		if not s or not s.GemShop then
			return
		end
		balance.Text = "Your Gems: 💎 " .. Calc.FormatNumber(s.Gems)
		local now = ctx.Now()
		for _, item in ipairs(Config.GemShop) do
			local r = rows[item.Id]
			local owned = s.GemShop[item.Id] or 0
			local price = Calc.GetGemItemPrice(item.Id, owned)
			local extra = ""
			if item.Boost and s.Boosts then
				local left = (tonumber(s.Boosts[item.Boost]) or 0) - now
				if left > 0 then
					extra = "  ⏱️ active: " .. Calc.FormatTime(left)
				end
			elseif not item.Repeatable then
				extra = "  (" .. owned .. "/" .. #item.Prices .. ")"
			end
			r.Desc.Text = item.Description .. extra
			if price then
				r.Button.Text = "💎 " .. Calc.FormatNumber(price)
				UI.SetButtonColor(r.Button, s.Gems >= price and UI.Colors.Green or UI.Colors.Gray)
			else
				r.Button.Text = "✅ Bought"
				UI.SetButtonColor(r.Button, UI.Colors.Gold)
			end
		end
	end
	return win
end

--------------------------------------------------------------------------
-- Rebirth
--------------------------------------------------------------------------
local function buildRebirth()
	local win = UI.CreateWindow(ctx.Screen, "Rebirth", "Rebirth", "♻️", Vector2.new(520, 400))
	local info = smallLabel({ Size = UDim2.new(1, 0, 0, 170), TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, TextScaled = true, Parent = win.Content })
	local _, fill = UI.ProgressBar({ Position = UDim2.new(0, 0, 0, 182), Size = UDim2.new(1, 0, 0, 22), Color = UI.Colors.Purple, Parent = win.Content })
	local progressText = UI.Label({ Position = UDim2.new(0, 0, 0, 182), Size = UDim2.new(1, 0, 0, 22), ZIndex = 8, Text = "", Parent = win.Content })
	UI.TextStroke(1.5).Parent = progressText
	local button = UI.Button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -6),
		Size = UDim2.new(0.8, 0, 0, 60),
		Color = UI.Colors.Purple,
		ZIndex = 6,
		Parent = win.Content,
	}, function()
		ctx.Request("Rebirth")
	end)
	win.Refresh = function()
		local s = state()
		if not s then
			return
		end
		local cost = Calc.GetRebirthCost(s.Rebirths)
		local nextCount = (s.Rebirths or 0) + 1
		info.Text = "You have " .. (s.Rebirths or 0) .. " rebirths.\n\n"
			.. "A rebirth resets your Slaps, upgrades and zones.\n"
			.. "Hands, pets and Gems are kept!\n\n"
			.. "After that, forever:\n"
			.. "💰 " .. Calc.FormatMultiplier(Calc.GetRebirthSlapMultiplier(nextCount)) .. " Slaps   "
			.. "💪 " .. Calc.FormatMultiplier(Calc.GetRebirthDamageMultiplier(nextCount)) .. " Damage   "
			.. "💎 +" .. Calc.GetRebirthGems(nextCount) .. " Gems"
		UI.SetProgress(fill, s.Slaps / cost)
		progressText.Text = Calc.FormatNumber(s.Slaps) .. " / " .. Calc.FormatNumber(cost)
		if s.Slaps >= cost then
			button.Text = "♻️ REBIRTH NOW!"
			UI.SetButtonColor(button, UI.Colors.Purple)
		else
			button.Text = "Need " .. money(cost - s.Slaps, "Slaps")
			UI.SetButtonColor(button, UI.Colors.Gray)
		end
	end
	return win
end

--------------------------------------------------------------------------
-- Quests
--------------------------------------------------------------------------
local function buildQuests()
	local win = UI.CreateWindow(ctx.Screen, "Quests", "Daily Quests", "📜", Vector2.new(560, 400))
	local timer = smallLabel({ Size = UDim2.new(1, 0, 0, 22), TextColor3 = UI.Colors.SubText, Parent = win.Content })
	local list = UI.ScrollList(win.Content, { Position = UDim2.new(0, 0, 0, 28), Size = UDim2.new(1, 0, 1, -28) })
	local rows = {}
	for i = 1, Config.QuestsPerDay do
		local row = UI.Row(list, 84, i)
		local text = title({ Position = UDim2.new(0, 12, 0, 8), Size = UDim2.new(0.6, -12, 0, 26), Parent = row })
		local reward = smallLabel({ Position = UDim2.new(0, 12, 0, 36), Size = UDim2.new(0.6, -12, 0, 16), TextColor3 = Color3.fromRGB(140, 220, 255), Parent = row })
		local _, fill = UI.ProgressBar({ Position = UDim2.new(0, 12, 0, 58), Size = UDim2.new(0.6, -12, 0, 16), Color = UI.Colors.Gold, Parent = row })
		local progress = UI.Label({ Position = UDim2.new(0, 12, 0, 58), Size = UDim2.new(0.6, -12, 0, 16), ZIndex = 8, Font = UI.BodyFont, Parent = row })
		local button = UI.Button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.new(0.34, 0, 0, 46), ZIndex = 6, Parent = row }, function()
			ctx.Request("ClaimQuest", i)
		end)
		rows[i] = { Text = text, Reward = reward, Fill = fill, Progress = progress, Button = button }
	end
	win.Refresh = function()
		local s = state()
		if not s or not s.Quests then
			return
		end
		local now = ctx.Now()
		local secondsLeft = 86400 - (now % 86400)
		timer.Text = "⏱️ New quests in " .. Calc.FormatTime(secondsLeft)
		local quests = Calc.GetQuests(s.Quests.Day, ctx.Player.UserId)
		for i, quest in ipairs(quests) do
			local r = rows[i]
			if r then
				local value = (s.Quests.Progress and s.Quests.Progress[i]) or 0
				local claimed = s.Quests.Claimed and s.Quests.Claimed[i]
				r.Text.Text = quest.Text
				r.Reward.Text = "Reward: 💎 " .. quest.Gems
				UI.SetProgress(r.Fill, value / quest.Amount)
				r.Progress.Text = Calc.FormatNumber(value) .. " / " .. Calc.FormatNumber(quest.Amount)
				if claimed then
					r.Button.Text = "✅ Done"
					UI.SetButtonColor(r.Button, UI.Colors.GreenDark)
				elseif value >= quest.Amount then
					r.Button.Text = "🎁 Claim!"
					UI.SetButtonColor(r.Button, UI.Colors.Green)
				else
					r.Button.Text = "In progress..."
					UI.SetButtonColor(r.Button, UI.Colors.Gray)
				end
			end
		end
	end
	return win
end

--------------------------------------------------------------------------
-- Taegliche Belohnung
--------------------------------------------------------------------------
local function buildDaily()
	local win = UI.CreateWindow(ctx.Screen, "Daily", "Daily Reward", "🎁", Vector2.new(600, 380))
	local grid = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 200),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = win.Content,
	}, {
		Create("UIGridLayout", { CellSize = UDim2.new(0.23, 0, 0, 92), CellPadding = UDim2.new(0.02, 0, 0, 8), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center }),
	})
	local cards = {}
	for day, reward in ipairs(Config.DailyRewards) do
		local card = Create("Frame", { LayoutOrder = day, BackgroundColor3 = UI.Colors.Panel, ZIndex = 6, Parent = grid }, { UI.Corner(12), UI.Stroke(2.5, UI.Colors.PanelLight) })
		title({ Size = UDim2.new(1, 0, 0, 24), Position = UDim2.new(0, 0, 0, 4), TextXAlignment = Enum.TextXAlignment.Center, Text = "Day " .. day, Parent = card })
		local text = "💎 " .. reward.Gems
		if reward.Boost then
			text = text .. "\n" .. Config.Boosts[reward.Boost].Icon .. " " .. Calc.FormatTime(reward.Duration)
		end
		smallLabel({ Position = UDim2.new(0, 4, 0, 30), Size = UDim2.new(1, -8, 0, 54), TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = true, Text = text, Parent = card })
		cards[day] = card
	end
	local status = smallLabel({ Position = UDim2.new(0, 0, 0, 206), Size = UDim2.new(1, 0, 0, 24), TextXAlignment = Enum.TextXAlignment.Center, Parent = win.Content })
	local button = UI.Button({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -4), Size = UDim2.new(0.6, 0, 0, 54), Color = UI.Colors.Green, ZIndex = 6, Parent = win.Content }, function()
		ctx.Request("ClaimDaily")
	end)
	win.Refresh = function()
		local s = state()
		if not s then
			return
		end
		local canClaim, day, waitSeconds = Calc.GetDailyStatus(s, ctx.Now())
		local streak = (s.Daily and s.Daily.Streak) or 0
		for d, card in ipairs(cards) do
			local stroke = card:FindFirstChildOfClass("UIStroke")
			local claimedAlready = (not canClaim and d <= streak) or (canClaim and d < day)
			if (canClaim and d == day) then
				card.BackgroundColor3 = UI.Colors.GreenDark
				if stroke then
					stroke.Color = UI.Colors.Gold
				end
			elseif claimedAlready then
				card.BackgroundColor3 = UI.Colors.Darker
				if stroke then
					stroke.Color = UI.Colors.Green
				end
			else
				card.BackgroundColor3 = UI.Colors.Panel
				if stroke then
					stroke.Color = UI.Colors.PanelLight
				end
			end
		end
		if canClaim then
			status.Text = "Streak: Day " .. day .. " is ready!"
			button.Text = "🎁 Claim!"
			UI.SetButtonColor(button, UI.Colors.Green)
		else
			status.Text = "Streak: " .. streak .. " days  •  Next reward in " .. Calc.FormatTime(waitSeconds)
			button.Text = "⏱️ " .. Calc.FormatTime(waitSeconds)
			UI.SetButtonColor(button, UI.Colors.Gray)
		end
	end
	return win
end

