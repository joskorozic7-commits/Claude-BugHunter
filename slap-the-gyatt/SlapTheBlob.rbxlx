			b:add("Leg", Vector3.new(0.45, 0.35, 0.45), CFrame.new(side * 0.75, -0.8, 0.6), light, BALL)
		end
	elseif style == "golem" then
		for i = 1, 3 do
			b:add("Crystal", Vector3.new(0.3, 0.7, 0.3), CFrame.new((i - 2) * 0.45, 0.95, 0.2) * CFrame.Angles(0, 0, (i - 2) * 0.3), Color3.fromRGB(120, 230, 255), nil, Enum.Material.Neon)
		end
		for _, side in ipairs({ -1, 1 }) do
			b:add("Fist", Vector3.new(0.55, 0.55, 0.55), CFrame.new(side * 1.15, -0.2, 0), dark, BALL, Enum.Material.Slate, "ear", side)
		end
	elseif style == "whale" or style == "shark" then
		addTail(b, light, Vector3.new(1.4, 0.15, 0.6), CFrame.new(0, 0.2, 1.6))
		if style == "shark" then
			b:add("Fin", Vector3.new(0.2, 0.8, 0.6), CFrame.new(0, 0.95, 0.2) * CFrame.Angles(-0.3, 0, 0), dark)
			b:add("Teeth", Vector3.new(0.6, 0.12, 0.08), CFrame.new(0, -0.3, front + 0.05), WHITE)
		else
			b:add("Spout", Vector3.new(0.25, 0.25, 0.25), CFrame.new(0, 1.05, 0.2), Color3.fromRGB(150, 220, 255), BALL, Enum.Material.Neon, "spin")
		end
	elseif style == "octopus" then
		for i = 0, 5 do
			local angle = (i / 6) * math.pi * 2
			b:add("Tentacle", Vector3.new(0.25, 0.25, 1.1), CFrame.new(math.cos(angle) * 0.6, -0.9, math.sin(angle) * 0.6) * CFrame.Angles(math.rad(70), angle, 0), light, "Oval", nil, "tentacle", i)
		end
	elseif style == "jelly" then
		for i = 0, 4 do
			local angle = (i / 5) * math.pi * 2
			local t = b:add("Tentacle", Vector3.new(0.1, 1.2, 0.1), CFrame.new(math.cos(angle) * 0.5, -1.2, math.sin(angle) * 0.5), light, nil, Enum.Material.Neon, "tentacle", i)
			t.Transparency = 0.2
		end
	elseif style == "alien" or style == "robot" then
		for _, side in ipairs({ -1, 1 }) do
			b:add("Antenna", Vector3.new(0.1, 0.7, 0.1), CFrame.new(side * 0.35, 1.15, 0), Color3.fromRGB(80, 80, 90))
			b:add("AntennaTip", Vector3.new(0.3, 0.3, 0.3), CFrame.new(side * 0.35, 1.55, 0), Color3.fromRGB(120, 255, 120), BALL, Enum.Material.Neon, "ear", side)
		end
	elseif style == "ghost" then
		for i = -1, 1 do
			local tail = b:add("Wisp", Vector3.new(0.6, 0.6, 0.6), CFrame.new(i * 0.5, -0.95, 0), color, BALL, Enum.Material.Neon, "tentacle", i + 1)
			tail.Transparency = 0.35
		end
		b:add("Halo", Vector3.new(0.1, 1.1, 1.1), CFrame.new(0, 1.3, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(255, 230, 100), CYL, Enum.Material.Neon, "spin")
	elseif style == "slime" then
		b:add("Shine", Vector3.new(0.5, 0.3, 0.3), CFrame.new(-0.45, 0.4, -0.6), WHITE, "Oval", Enum.Material.Neon)
	end

	-- Seltenheit: Glanz, Licht, Regenbogen
	local order = rarity.Order
	if order >= 4 then
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = UI.rgb(rarity.Color)
		sparkles.Parent = body
	end
	if order >= 2 then
		local pointLight = Instance.new("PointLight")
		pointLight.Color = UI.rgb(rarity.Color)
		pointLight.Range = 4 + order * 1.5
		pointLight.Brightness = 0.6 + order * 0.15
		pointLight.Parent = body
	end
	if order >= 5 then
		b:add("Aura", Vector3.new(0.1, 3, 3), CFrame.new(0, -1.1, 0) * CFrame.Angles(0, 0, math.rad(90)), UI.rgb(rarity.Color), CYL, Enum.Material.Neon, "spin").Transparency = 0.6
	end

	local billboard = UI.Create("BillboardGui", {
		Adornee = body,
		Size = UDim2.new(4, 0, 0.8, 0),
		StudsOffsetWorldSpace = Vector3.new(0, 1.8, 0),
		MaxDistance = 45,
		LightInfluence = 0,
		Parent = body,
	})
	UI.Create("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = UI.Font,
		TextScaled = true,
		TextColor3 = UI.rgb(rarity.Color),
		TextStrokeTransparency = 0,
		Text = cfg.DisplayName,
		Parent = billboard,
	})

	model.Parent = folder
	return {
		Model = model,
		Parts = b.Parts,
		Motion = MOTION[style] or "float",
		Secret = cfg.Rarity == "Secret",
		Phase = math.random() * 6,
		Current = nil,
	}
end

local function clearOwner(owner)
	local entry = owners[owner]
	if entry then
		for _, pet in ipairs(entry.Pets) do
			pet.Model:Destroy()
		end
		owners[owner] = nil
	end
end

local function syncOwner(owner)
	local signature = owner:GetAttribute("EquippedPets") or ""
	if owner ~= Players.LocalPlayer and not ctx.Setting("OtherPets") then
		signature = ""
	end
	if owner:GetAttribute("InDuel") then
		signature = "" -- im Duell keine Pets: freie Sicht
	end
	local entry = owners[owner]
	if entry and entry.Signature == signature then
		return
	end
	clearOwner(owner)
	entry = { Signature = signature, Pets = {} }
	owners[owner] = entry
	for petId in string.gmatch(signature, "[^,]+") do
		if Config.Pets[petId] then
			table.insert(entry.Pets, buildPet(petId))
		end
	end
end

-- Animation eines Teils
local function partAnimation(role, extra, t, speedFactor)
	if role == "wingL" then
		-- Drehpunkt an der Schulter, Fluegel zeigt nach aussen
		return CFrame.Angles(0, 0, -math.sin(t * 14) * 0.6) * CFrame.new(-extra / 2, 0, 0)
	elseif role == "wingR" then
		return CFrame.Angles(0, 0, math.sin(t * 14) * 0.6) * CFrame.new(extra / 2, 0, 0)
	elseif role == "tail" then
		return CFrame.Angles(0, math.sin(t * (6 + speedFactor * 8)) * 0.5, 0)
	elseif role == "ear" then
		return CFrame.Angles(0, 0, math.sin(t * 3 + extra) * 0.12)
	elseif role == "tentacle" then
		return CFrame.Angles(math.sin(t * 4 + extra) * 0.35, 0, 0)
	elseif role == "spin" then
		return CFrame.Angles(t * 2, 0, 0)
	end
	return nil
end

local function animate(dt)
	local t = os.clock()
	local alpha = math.min(1, dt * 7)
	local rainbow = Color3.fromHSV((t * 0.3) % 1, 0.6, 1)
	for owner, entry in pairs(owners) do
		local character = owner.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and owner.Parent then
			local velocity = root.AssemblyLinearVelocity
			local moving = Vector3.new(velocity.X, 0, velocity.Z).Magnitude > 2
			local speedFactor = moving and 1 or 0
			local count = #entry.Pets
			for i, pet in ipairs(entry.Pets) do
				local spread = (i - (count + 1) / 2) * 3.2
				local row = math.floor((i - 1) / 4)
				local phaseT = t + pet.Phase
				local height, tilt, sway = 0.6, 0, 0
				if pet.Motion == "hop" then
					local hop = math.abs(math.sin(phaseT * (moving and 9 or 3)))
					height = 0.2 + hop * (moving and 1.1 or 0.25)
					tilt = moving and -0.15 or 0
				elseif pet.Motion == "fly" then
					height = 2 + math.sin(phaseT * 3) * 0.45
					tilt = math.sin(phaseT * 2) * 0.08
				elseif pet.Motion == "swim" then
					height = 1.6 + math.sin(phaseT * 2) * 0.3
					sway = math.sin(phaseT * 2.5) * 0.3
				else
					height = 1.2 + math.sin(phaseT * 2) * 0.3
					sway = math.sin(phaseT * 0.8) * 0.15
				end
				local offset = CFrame.new(spread, height, 4.5 + row * 3)
				local target = root.CFrame * offset
				local look = target.Position + root.CFrame.LookVector
				local targetCFrame = CFrame.lookAt(target.Position, look)
				if not pet.Current or (pet.Current.Position - targetCFrame.Position).Magnitude > 60 then
					pet.Current = targetCFrame
				else
					pet.Current = pet.Current:Lerp(targetCFrame, alpha)
				end
				local bodyCFrame = pet.Current * CFrame.Angles(tilt, sway, 0)
				for _, info in ipairs(pet.Parts) do
					local anim = info.Role and partAnimation(info.Role, info.Extra, phaseT, speedFactor)
					if anim then
						info.Part.CFrame = bodyCFrame * info.Offset * anim
					else
						info.Part.CFrame = bodyCFrame * info.Offset
					end
				end
				if pet.Secret and pet.Parts[1] then
					pet.Parts[1].Part.Color = rainbow
				end
			end
		end
	end
end

function PetsFx.Init(context)
	ctx = context
	Config = ctx.Config
	UI = ctx.UI

	folder = Instance.new("Folder")
	folder.Name = "SlapLocalPets"
	folder.Parent = workspace

	Players.PlayerRemoving:Connect(clearOwner)
	RunService.RenderStepped:Connect(animate)
	task.spawn(function()
		while true do
			for _, owner in ipairs(Players:GetPlayers()) do
				syncOwner(owner)
			end
			task.wait(0.5)
		end
	end)
end

return PetsFx
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000026"><Properties><string name="Name">TradeUI</string><ProtectedString name="Source"><![CDATA[--[[
	TradeUI: Pets handeln.
	  * "Trade"-Fenster: Spielerliste mit "Request"-Knopf
	  * Anfrage-Popup (Annehmen / Ablehnen)
	  * Handelsfenster: eigene Pets anklicken, beide Angebote, Bereit / Bestaetigen / Abbrechen
]]

local Players = game:GetService("Players")

local TradeUI = {}
local ctx, UI, Config, Calc, Create

local player = Players.LocalPlayer
local listWindow, playerList
local requestFrame, requestLabel, requestFrom
local tradeWindow, myGrid, myOfferGrid, theirOfferGrid, statusLabel, readyButton, confirmButton, partnerLabel
local current = nil -- letztes Update vom Server
local myOffer = {} -- Liste von Uids

local function petCard(parent, petId, order, onClick, highlight)
	local cfg = Config.Pets[petId]
	if not cfg then
		return
	end
	local rarity = Config.Rarities[cfg.Rarity]
	local card = Create("TextButton", {
		LayoutOrder = order,
		BackgroundColor3 = highlight and UI.Colors.GreenDark or UI.Colors.Panel,
		AutoButtonColor = onClick ~= nil,
		Text = "",
		ZIndex = 6,
		Parent = parent,
	}, { UI.Corner(10), UI.Stroke(2, UI.rgb(rarity.Color)) })
	local face = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 4),
		Size = UDim2.new(0, 30, 0, 30),
		BackgroundColor3 = UI.rgb(cfg.Color),
		ZIndex = 7,
		Parent = card,
	}, { Create("UICorner", { CornerRadius = UDim.new(1, 0) }), UI.Stroke(1.5) })
	UI.Label({ Size = UDim2.fromScale(1, 1), Text = "👀", ZIndex = 8, Parent = face })
	UI.Label({ Position = UDim2.new(0, 2, 0, 36), Size = UDim2.new(1, -4, 0, 16), Text = cfg.DisplayName, ZIndex = 7, Parent = card })
	UI.Label({ Position = UDim2.new(0, 2, 0, 52), Size = UDim2.new(1, -4, 0, 12), Font = UI.BodyFont, TextColor3 = UI.rgb(rarity.Color), Text = rarity.DisplayName, ZIndex = 7, Parent = card })
	if onClick then
		card.Activated:Connect(onClick)
	end
	return card
end

local function clear(container)
	for _, child in ipairs(container:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end
end

local function isOffered(uid)
	for _, u in ipairs(myOffer) do
		if u == uid then
			return true
		end
	end
	return false
end

local function sendOffer()
	ctx.Request("TradeSetOffer", myOffer)
end

local function refreshTrade()
	if not current then
		return
	end
	partnerLabel.Text = "🤝 Trading with " .. tostring(current.Partner)
	-- eigene Pets
	clear(myGrid)
	local state = ctx.State
	if state and state.Pets then
		local sorted = {}
		for _, pet in ipairs(state.Pets) do
			table.insert(sorted, pet)
		end
		table.sort(sorted, function(a, b)
			local ba, bb = Config.Pets[a.Id] and Config.Pets[a.Id].Boost or 0, Config.Pets[b.Id] and Config.Pets[b.Id].Boost or 0
			if ba ~= bb then
				return ba > bb
			end
			return a.Uid < b.Uid
		end)
		for order, pet in ipairs(sorted) do
			local uid = pet.Uid
			petCard(myGrid, pet.Id, order, function()
				if isOffered(uid) then
					for i, u in ipairs(myOffer) do
						if u == uid then
							table.remove(myOffer, i)
							break
						end
					end
				elseif #myOffer < Config.Trade.MaxPets then
					table.insert(myOffer, uid)
				end
				ctx.PlaySound("Click")
				sendOffer()
			end, isOffered(uid))
		end
	end
	clear(myOfferGrid)
	for order, pet in ipairs(current.MyOffer or {}) do
		petCard(myOfferGrid, pet.Id, order, nil, false)
	end
	clear(theirOfferGrid)
	for order, pet in ipairs(current.TheirOffer or {}) do
		petCard(theirOfferGrid, pet.Id, order, nil, false)
	end

	local status
	if current.MyConfirmed and not current.TheirConfirmed then
		status = "✅ Confirmed - waiting for " .. tostring(current.Partner) .. "..."
	elseif current.CountdownLeft and current.CountdownLeft > 0 then
		status = "⏱️ Check the offers! Confirm in " .. math.ceil(current.CountdownLeft) .. "..."
	elseif current.CountdownLeft then
		status = "👉 Both ready - press CONFIRM to trade!"
	else
		status = (current.MyReady and "✅ You are ready" or "⏳ You are not ready") .. "   |   " .. (current.TheirReady and "✅ They are ready" or "⏳ They are not ready")
	end
	statusLabel.Text = status
	readyButton.Text = current.MyReady and "❌ Not Ready" or "✅ Ready"
	UI.SetButtonColor(readyButton, current.MyReady and UI.Colors.Gray or UI.Colors.Green)
	local canConfirm = current.CountdownLeft ~= nil and current.CountdownLeft <= 0 and not current.MyConfirmed
	confirmButton.Visible = current.CountdownLeft ~= nil
	UI.SetButtonColor(confirmButton, canConfirm and UI.Colors.Gold or UI.Colors.Gray)
end

local function buildListWindow()
	listWindow = UI.CreateWindow(ctx.Screen, "Trade", "Trade Pets", "🤝", Vector2.new(480, 420))
	UI.Label({ Size = UDim2.new(1, 0, 0, 24), Font = UI.BodyFont, TextColor3 = UI.Colors.SubText, Text = "Pick a player to send a trade request:", ZIndex = 6, Parent = listWindow.Content })
	playerList = UI.ScrollList(listWindow.Content, { Position = UDim2.new(0, 0, 0, 30), Size = UDim2.new(1, 0, 1, -30) })
	listWindow.Refresh = function()
		for _, child in ipairs(playerList:GetChildren()) do
			if child:IsA("Frame") or child:IsA("TextLabel") then
				child:Destroy()
			end
		end
		local count = 0
		for _, other in ipairs(Players:GetPlayers()) do
			if other ~= player then
				count = count + 1
				local row = UI.Row(playerList, 56, count)
				UI.Label({ Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(0.6, -12, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, Text = "👤 " .. other.DisplayName, ZIndex = 6, Parent = row })
				local userId = other.UserId
				UI.Button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.new(0.35, 0, 0, 40), Color = UI.Colors.Blue, Text = "Request", ZIndex = 6, Parent = row }, function()
					ctx.Request("TradeRequest", userId)
				end)
			end
		end
		if count == 0 then
			UI.Label({ Size = UDim2.new(1, -10, 0, 40), Font = UI.BodyFont, TextColor3 = UI.Colors.SubText, Text = "Nobody else is on this server yet.", ZIndex = 6, Parent = playerList })
		end
	end
end

local function buildRequestPopup()
	requestFrame = Create("Frame", {
		Name = "TradeRequest",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 110),
		Size = UDim2.new(0, 280, 0, 110),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		Visible = false,
		ZIndex = 15,
		Parent = ctx.Screen,
	}, { UI.Corner(14), UI.Stroke(3, UI.Colors.Blue), UI.Gradient(UI.Colors.Dark, UI.Colors.Darker) })
	requestLabel = UI.Label({ Position = UDim2.new(0, 10, 0, 8), Size = UDim2.new(1, -20, 0, 40), TextWrapped = true, Text = "", ZIndex = 16, Parent = requestFrame })
	UI.Button({ Position = UDim2.new(0, 10, 1, -50), Size = UDim2.new(0.5, -15, 0, 40), Color = UI.Colors.Green, Text = "Accept", ZIndex = 16, Parent = requestFrame }, function()
		requestFrame.Visible = false
		if requestFrom then
			ctx.Request("TradeRespond", requestFrom, true)
		end
	end)
	UI.Button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 1, -50), Size = UDim2.new(0.5, -15, 0, 40), Color = UI.Colors.Red, Text = "Decline", ZIndex = 16, Parent = requestFrame }, function()
		requestFrame.Visible = false
		if requestFrom then
			ctx.Request("TradeRespond", requestFrom, false)
		end
	end)
end

local function buildTradeWindow()
	tradeWindow = UI.CreateWindow(ctx.Screen, "TradeSession", "Trade", "🤝", Vector2.new(700, 520))
	local content = tradeWindow.Content
	partnerLabel = UI.Label({ Size = UDim2.new(1, 0, 0, 24), TextXAlignment = Enum.TextXAlignment.Left, Text = "", ZIndex = 6, Parent = content })
	UI.Label({ Position = UDim2.new(0, 0, 0, 28), Size = UDim2.new(0.5, -6, 0, 18), Font = UI.BodyFont, TextColor3 = UI.Colors.SubText, Text = "Your offer (max " .. Config.Trade.MaxPets .. ")", ZIndex = 6, Parent = content })
	UI.Label({ Position = UDim2.new(0.5, 6, 0, 28), Size = UDim2.new(0.5, -6, 0, 18), Font = UI.BodyFont, TextColor3 = UI.Colors.SubText, Text = "Their offer", ZIndex = 6, Parent = content })
	local offerBoxProps = { Size = UDim2.new(0.5, -6, 0, 150), Grid = UDim2.new(0, 70, 0, 68) }
	offerBoxProps.Position = UDim2.new(0, 0, 0, 48)
	myOfferGrid = UI.ScrollList(content, offerBoxProps)
	theirOfferGrid = UI.ScrollList(content, { Position = UDim2.new(0.5, 6, 0, 48), Size = UDim2.new(0.5, -6, 0, 150), Grid = UDim2.new(0, 70, 0, 68) })
	for _, grid in ipairs({ myOfferGrid, theirOfferGrid }) do
		grid.BackgroundTransparency = 0.4
		grid.BackgroundColor3 = UI.Colors.Darker
	end
	UI.Label({ Position = UDim2.new(0, 0, 0, 204), Size = UDim2.new(1, 0, 0, 18), Font = UI.BodyFont, TextColor3 = UI.Colors.SubText, Text = "Your pets - click to add or remove:", ZIndex = 6, Parent = content })
	myGrid = UI.ScrollList(content, { Position = UDim2.new(0, 0, 0, 224), Size = UDim2.new(1, 0, 1, -300), Grid = UDim2.new(0, 70, 0, 68) })
	statusLabel = UI.Label({ AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -50), Size = UDim2.new(1, 0, 0, 22), Font = UI.BodyFont, TextColor3 = UI.Colors.Gold, Text = "", ZIndex = 6, Parent = content })
	readyButton = UI.Button({ AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -4), Size = UDim2.new(0.32, -6, 0, 42), Color = UI.Colors.Green, Text = "✅ Ready", ZIndex = 6, Parent = content }, function()
		ctx.Request("TradeReady", not (current and current.MyReady))
	end)
	confirmButton = UI.Button({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -4), Size = UDim2.new(0.32, -6, 0, 42), Color = UI.Colors.Gold, Text = "🤝 CONFIRM", ZIndex = 6, Parent = content }, function()
		ctx.Request("TradeConfirm")
	end)
	UI.Button({ AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, 0, 1, -4), Size = UDim2.new(0.32, -6, 0, 42), Color = UI.Colors.Red, Text = "Cancel", ZIndex = 6, Parent = content }, function()
		ctx.Request("TradeCancel")
	end)
	tradeWindow.Refresh = refreshTrade
	-- Schliessen ueber das X bricht den Handel ab
	local close = tradeWindow.Frame:FindFirstChild("Close")
	if close then
		close.Activated:Connect(function()
			if current then
				ctx.Request("TradeCancel")
			end
		end)
	end
end

function TradeUI.OnEvent(info)
	if type(info) ~= "table" then
		return
	end
	if info.Kind == "Request" then
		requestFrom = info.FromUserId
		requestLabel.Text = "🤝 " .. tostring(info.FromName) .. " wants to trade!"
		requestFrame.Visible = true
		ctx.PlaySound("Popup", 1.2)
		local myFrom = requestFrom
		task.delay(tonumber(info.Timeout) or 30, function()
			if requestFrom == myFrom then
				requestFrame.Visible = false
			end
		end)
	elseif info.Kind == "Update" then
		local firstUpdate = current == nil
		current = info
		myOffer = {}
		for _, pet in ipairs(info.MyOffer or {}) do
			table.insert(myOffer, pet.Uid)
		end
		if firstUpdate or UI.OpenWindow ~= "TradeSession" then
			UI.Open("TradeSession")
		else
			refreshTrade()
		end
		-- Countdown im Text weiterzaehlen
		if info.CountdownLeft and info.CountdownLeft > 0 then
			local mine = info
			task.spawn(function()
				local endsAt = os.clock() + info.CountdownLeft
				while current == mine and os.clock() < endsAt do
					current.CountdownLeft = endsAt - os.clock()
					refreshTrade()
					task.wait(0.25)
				end
				if current == mine then
					current.CountdownLeft = 0
					refreshTrade()
				end
			end)
		end
	elseif info.Kind == "Closed" then
		current = nil
		myOffer = {}
		UI.Close("TradeSession")
		if info.Reason ~= "Done" then
			ctx.Hud.Notify("🤝 Trade closed: " .. tostring(info.Reason), { 255, 180, 120 })
		end
	end
end

function TradeUI.Init(context)
	ctx = context
	UI = ctx.UI
	Config = ctx.Config
	Calc = ctx.Calc
	Create = UI.Create
	buildListWindow()
	buildRequestPopup()
	buildTradeWindow()
	ctx.OnState(function(_, full)
		if full and current and UI.OpenWindow == "TradeSession" then
			refreshTrade()
		end
	end)
end

return TradeUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000027"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[--[[
	UI: kleine UI-Bibliothek (Farben, Bausteine, animierte Buttons, Fenster).
]]

local TweenService = game:GetService("TweenService")

local UI = {}

UI.Colors = {
	Pink = Color3.fromRGB(255, 105, 180),
	PinkDark = Color3.fromRGB(200, 60, 140),
	Purple = Color3.fromRGB(150, 90, 255),
	Dark = Color3.fromRGB(38, 22, 50),
	Darker = Color3.fromRGB(26, 14, 36),
	Panel = Color3.fromRGB(62, 36, 82),
	PanelLight = Color3.fromRGB(85, 52, 110),
	Green = Color3.fromRGB(60, 200, 100),
	GreenDark = Color3.fromRGB(30, 140, 70),
	Gray = Color3.fromRGB(115, 110, 125),
	Gold = Color3.fromRGB(255, 200, 50),
	Blue = Color3.fromRGB(70, 170, 255),
	Red = Color3.fromRGB(230, 70, 90),
	White = Color3.fromRGB(255, 255, 255),
	Text = Color3.fromRGB(245, 235, 255),
	SubText = Color3.fromRGB(205, 180, 225),
}

UI.Font = Enum.Font.FredokaOne
UI.BodyFont = Enum.Font.GothamBold

function UI.rgb(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

function UI.Create(className, props, children)
	local instance = Instance.new(className)
	local parent = nil
	if props then
		for key, value in pairs(props) do
			if key == "Parent" then
				parent = value
			else
				instance[key] = value
			end
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end
local Create = UI.Create

function UI.Corner(radius)
	return Create("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
end

function UI.Stroke(thickness, color, transparency)
	return Create("UIStroke", {
		Thickness = thickness or 2,
		Color = color or Color3.fromRGB(20, 8, 28),
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UI.TextStroke(thickness)
	return Create("UIStroke", {
		Thickness = thickness or 2,
		Color = Color3.fromRGB(20, 8, 28),
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
	})
end

function UI.Padding(all, top)
	return Create("UIPadding", {
		PaddingLeft = UDim.new(0, all),
		PaddingRight = UDim.new(0, all),
		PaddingTop = UDim.new(0, top or all),
		PaddingBottom = UDim.new(0, top or all),
	})
end

function UI.Gradient(top, bottom)
	return Create("UIGradient", {
		Color = ColorSequence.new(top, bottom),
		Rotation = 90,
	})
end

function UI.List(padding, horizontal, align)
	return Create("UIListLayout", {
		Padding = UDim.new(0, padding or 6),
		FillDirection = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
		VerticalAlignment = Enum.VerticalAlignment.Center,
	})
end

function UI.Label(props)
	local defaults = {
		BackgroundTransparency = 1,
		Font = UI.Font,
		TextScaled = true,
		TextColor3 = UI.Colors.Text,
		Text = "",
	}
	for k, v in pairs(props) do
		defaults[k] = v
	end
	return Create("TextLabel", defaults)
end

local function lighten(color, amount)
	return Color3.new(
		math.clamp(color.R + amount, 0, 1),
		math.clamp(color.G + amount, 0, 1),
		math.clamp(color.B + amount, 0, 1)
	)
end
UI.Lighten = lighten

-- Setzt die Farbe eines mit UI.Button gebauten Knopfes
function UI.SetButtonColor(button, color)
	button.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	local gradient = button:FindFirstChild("ButtonGradient")
	if gradient then
		gradient.Color = ColorSequence.new(lighten(color, 0.12), color)
	end
end

-- Animierter Knopf. onClick wird bei Klick/Tap aufgerufen.
function UI.Button(props, onClick)
	local color = props.Color or UI.Colors.Pink
	local button = Create("TextButton", {
		Name = props.Name or "Button",
		Size = props.Size or UDim2.new(0, 120, 0, 44),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(),
		LayoutOrder = props.LayoutOrder or 0,
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		AutoButtonColor = false,
		Font = UI.Font,
		TextScaled = true,
		TextColor3 = UI.Colors.White,
		Text = props.Text or "",
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	}, {
		UI.Corner(props.Radius or 12),
		UI.Stroke(props.StrokeThickness or 2.5),
		Create("UIGradient", { Name = "ButtonGradient", Color = ColorSequence.new(lighten(color, 0.12), color), Rotation = 90 }),
		UI.Padding(props.Padding or 6, props.PaddingY or 4),
		UI.TextStroke(1.5),
	})
	local scale = Create("UIScale", { Scale = 1, Parent = button })

	local hoverInfo = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	button.MouseEnter:Connect(function()
		TweenService:Create(scale, hoverInfo, { Scale = 1.06 }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(scale, hoverInfo, { Scale = 1 }):Play()
	end)
	button.MouseButton1Down:Connect(function()
		TweenService:Create(scale, hoverInfo, { Scale = 0.93 }):Play()
	end)
	button.MouseButton1Up:Connect(function()
		TweenService:Create(scale, hoverInfo, { Scale = 1.03 }):Play()
	end)
	if onClick then
		button.Activated:Connect(function()
			onClick(button)
		end)
	end
	return button
end

-- Fortschrittsbalken. Gibt Hintergrund und Fuellung zurueck.
function UI.ProgressBar(props)
	local back = Create("Frame", {
		Name = props.Name or "Progress",
		Size = props.Size or UDim2.new(1, 0, 0, 12),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(),
		LayoutOrder = props.LayoutOrder or 0,
		BackgroundColor3 = UI.Colors.Darker,
		BorderSizePixel = 0,
		Parent = props.Parent,
	}, { UI.Corner(props.Radius or 6), UI.Stroke(1.5) })
	local fill = Create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
		Parent = back,
	}, {
		UI.Corner(props.Radius or 6),
		UI.Gradient(lighten(props.Color or UI.Colors.Pink, 0.15), props.Color or UI.Colors.Pink),
	})
	return back, fill
end

function UI.SetProgress(fill, ratio)
	if ratio ~= ratio then
		ratio = 0
	end
	fill.Size = UDim2.fromScale(math.clamp(ratio, 0, 1), 1)
end

--------------------------------------------------------------------------
-- Fenster
--------------------------------------------------------------------------
UI.Windows = {}
UI.OpenWindow = nil
UI.OnWindowOpened = nil -- function(name)

function UI.CreateWindow(screen, name, title, icon, size)
	local width = size and size.X or 560
	local height = size and size.Y or 440
	local window = Create("Frame", {
		Name = name .. "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.53),
		Size = UDim2.new(0.94, 0, 0.8, 0),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		Visible = false,
		ZIndex = 5,
		Parent = screen,
	}, {
		UI.Corner(20),
		UI.Stroke(4, UI.Colors.Pink),
		UI.Gradient(UI.Colors.Dark, UI.Colors.Darker),
		Create("UISizeConstraint", { MaxSize = Vector2.new(width, height) }),
	})
	local scale = Create("UIScale", { Scale = 1, Parent = window })

	local titleBar = Create("Frame", {
		Name = "TitleBar",
		Size = UDim2.new(1, 0, 0, 54),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		ZIndex = 5,
		Parent = window,
	}, {
		UI.Corner(20),
		UI.Gradient(UI.Colors.Pink, UI.Colors.PinkDark),
	})
	-- untere Ecken der Titelleiste eckig machen
	Create("Frame", {
		Name = "Filler",
		Position = UDim2.new(0, 0, 1, -18),
		Size = UDim2.new(1, 0, 0, 18),
		BorderSizePixel = 0,
		BackgroundColor3 = UI.Colors.PinkDark,
		ZIndex = 5,
		Parent = titleBar,
	})
	local titleLabel = UI.Label({
		Name = "Title",
		Position = UDim2.new(0, 16, 0, 7),
		Size = UDim2.new(1, -80, 0, 40),
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = icon .. "  " .. title,
		ZIndex = 6,
		Parent = titleBar,
	})
	UI.TextStroke(2).Parent = titleLabel

	local content = Create("Frame", {
		Name = "Content",
		Position = UDim2.new(0, 12, 0, 62),
		Size = UDim2.new(1, -24, 1, -72),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = window,
	})

	local entry = { Name = name, Frame = window, Content = content, Scale = scale, Refresh = nil }

	UI.Button({
		Name = "Close",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 8),
		Size = UDim2.new(0, 40, 0, 38),
		Color = UI.Colors.Red,
		Text = "X",
		ZIndex = 7,
		Parent = window,
	}, function()
		UI.Close(name)
	end)

	UI.Windows[name] = entry
	return entry
end

function UI.Close(name)
	local entry = UI.Windows[name]
	if entry and entry.Frame.Visible then
		entry.Frame.Visible = false
		if UI.OpenWindow == name then
			UI.OpenWindow = nil
		end
	end
end

function UI.Open(name)
	local entry = UI.Windows[name]
	if not entry then
		return
	end
	if UI.OpenWindow and UI.OpenWindow ~= name then
		UI.Close(UI.OpenWindow)
	end
	UI.OpenWindow = name
	entry.Frame.Visible = true
	entry.Scale.Scale = 0.85
	TweenService:Create(entry.Scale, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	if entry.Refresh then
		entry.Refresh()
	end
	if UI.OnWindowOpened then
		UI.OnWindowOpened(name)
	end
end

function UI.Toggle(name)
	if UI.OpenWindow == name then
		UI.Close(name)
	else
		UI.Open(name)
	end
end

-- Scroll-Liste fuer Fenster-Inhalte
function UI.ScrollList(parent, props)
	props = props or {}
	local scroll = Create("ScrollingFrame", {
		Name = props.Name or "List",
		Position = props.Position or UDim2.new(),
		Size = props.Size or UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = UI.Colors.Pink,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ZIndex = 5,
		Parent = parent,
	}, {
		UI.Padding(4, 4),
	})
	if props.Grid then
		Create("UIGridLayout", {
			CellSize = props.Grid,
			CellPadding = UDim2.new(0, 8, 0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = scroll,
		})
	else
		Create("UIListLayout", {
			Padding = UDim.new(0, props.Padding or 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = scroll,
		})
	end
	return scroll
end

-- Zeile in einer Liste
function UI.Row(parent, height, order)
	return Create("Frame", {
		Name = "Row",
		Size = UDim2.new(1, -10, 0, height),
		LayoutOrder = order or 0,
		BackgroundColor3 = UI.Colors.Panel,
		ZIndex = 5,
		Parent = parent,
	}, { UI.Corner(14), UI.Stroke(2, UI.Colors.PanelLight) })
end

return UI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000028"><Properties><string name="Name">WorldFx</string><ProtectedString name="Source"><![CDATA[--[[
	WorldFx: alles, was der Client in der Welt animiert.
	  * Gyatts huepfen, schauen dich an, wackeln und erschrecken bei Treffern
	  * Eier drehen sich, Regenbogen-Haende leuchten
	  * Tore freigeschalteter Zonen werden durchlaessig
	  * Licht & Stimmung je nach Zone
	  * Tutorial-Pfeil zum ersten Gyatt
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")

local WorldFx = {}
local ctx, Config, Calc

local player = Players.LocalPlayer
local gyattCache = {} -- [Model] = Animationsdaten
local hitsByKey = {} -- [Key] = { Time, From }
local currentZone = -1

--------------------------------------------------------------------------
-- Gyatts
--------------------------------------------------------------------------
local function getCache(model)
	local cache = gyattCache[model]
	if cache then
		return cache
	end
	local smiles = {}
	for _, child in ipairs(model:GetChildren()) do
		if child.Name == "MouthSmile" then
			table.insert(smiles, child)
		end
	end
	cache = {
		Phase = math.random() * 10,
		Yaw = 0,
		MouthO = model:FindFirstChild("MouthO"),
		Smiles = smiles,
		Highlight = model:FindFirstChild("Outline"),
		Shocked = false,
	}
	gyattCache[model] = cache
	return cache
end

local function setShocked(cache, shocked)
	if cache.Shocked == shocked then
		return
	end
	cache.Shocked = shocked
	if cache.MouthO then
		cache.MouthO.Transparency = shocked and 0 or 1
	end
	for _, part in ipairs(cache.Smiles) do
		part.Transparency = shocked and 1 or 0
	end
end

local function angleLerp(a, b, t)
	local diff = (b - a + math.pi) % (math.pi * 2) - math.pi
	return a + diff * t
end

local function animateGyatts(dt)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local camera = workspace.CurrentCamera
	local cameraPos = camera and camera.CFrame.Position or Vector3.new()
	local now = os.clock()

	for _, model in ipairs(CollectionService:GetTagged("SlapGyatt")) do
		local base = model:GetAttribute("BaseCFrame")
		local size = model:GetAttribute("Size") or 6
		if model.Parent and typeof(base) == "CFrame" and model.PrimaryPart then
			local position = base.Position
			local distance = (position - cameraPos).Magnitude
			local cache = getCache(model)
			if cache.Highlight then
				cache.Highlight.Enabled = distance < 170
			end
			if distance < 260 then

				-- zum Spieler drehen (Schatzkisten nicht)
				local targetYaw = cache.Yaw
				if root and not model:GetAttribute("NoTurn") then
					local d = root.Position - position
					if d.X * d.X + d.Z * d.Z > 1 then
						targetYaw = math.atan2(-d.X, -d.Z)
					end
				end
				cache.Yaw = angleLerp(cache.Yaw, targetYaw, math.min(1, dt * 4))

				-- Treffer-Reaktion
				local hit = hitsByKey[model:GetAttribute("Key")]
				local k = 0
				if hit then
					local age = now - hit.Time
					if age < 0.35 then
						k = 1 - age / 0.35
					end
				end
				setShocked(cache, k > 0.15)
				if cache.Highlight then
					cache.Highlight.FillTransparency = 1 - 0.55 * k
				end

				local bounce = math.abs(math.sin(now * 2.2 + cache.Phase)) * size * 0.05
				if model:GetAttribute("Float") then
					bounce = math.sin(now * 1.6 + cache.Phase) * size * 0.12
				elseif model:GetAttribute("NoTurn") then
					bounce = 0
				end
				local wobble = math.sin(now * 40) * k * 0.12
				local pivot = CFrame.new(position + Vector3.new(0, bounce - k * size * 0.04, 0))
					* CFrame.Angles(0, cache.Yaw, 0)
					* CFrame.Angles(k * 0.32, 0, wobble)
				model:PivotTo(pivot)
			end
		end
	end

	-- alte Eintraege aufraeumen
	for model in pairs(gyattCache) do
		if not model.Parent then
			gyattCache[model] = nil
		end
	end
end

function WorldFx.OnSlap(info)
	if info.Kind == "Gyatt" and type(info.Key) == "string" then
		hitsByKey[info.Key] = { Time = os.clock() }
	end
end

--------------------------------------------------------------------------
-- Eier & Regenbogen
--------------------------------------------------------------------------
local function animateEggs()
	local t = os.clock()
	for _, egg in ipairs(CollectionService:GetTagged("SlapEgg")) do
		local baseY = egg:GetAttribute("BaseY")
		if type(baseY) == "number" then
			local p = egg.Position
			egg.CFrame = CFrame.new(p.X, baseY + math.sin(t * 2 + p.Z) * 0.4, p.Z) * CFrame.Angles(0, t * 0.8, math.sin(t * 3) * 0.08)
		end
	end
	for _, swirl in ipairs(CollectionService:GetTagged("SlapPortal")) do
		local p = swirl.Position
		swirl.CFrame = CFrame.new(p) * CFrame.Angles(0, math.rad(90), 0) * CFrame.Angles(t * 2, 0, 0)
	end
	local rainbow = Color3.fromHSV((t * 0.25) % 1, 0.75, 1)
	for _, part in ipairs(CollectionService:GetTagged("RainbowHand")) do
		part.Color = rainbow
	end
end

--------------------------------------------------------------------------
-- Tore
--------------------------------------------------------------------------
local function refreshGates()
	local unlocked = (ctx.State and ctx.State.Zones) or 1
	for _, gate in ipairs(CollectionService:GetTagged("SlapGate")) do
		local index = gate:GetAttribute("ZoneIndex") or 99
		local open = index <= unlocked
		gate.CanCollide = not open
		gate.Transparency = open and 0.9 or 0.3
		for _, gui in ipairs(gate:GetChildren()) do
			if gui:IsA("SurfaceGui") then
				gui.Enabled = not open
			end
		end
	end
	-- Prompts zum Freischalten bereits offener Zonen verstecken
	local world = workspace:FindFirstChild("SlapWorld")
	if world then
		for index = 2, #Config.Zones do
			local zoneFolder = world:FindFirstChild("Zone" .. index)
			local promptPart = zoneFolder and zoneFolder:FindFirstChild("GatePrompt")
			local prompt = promptPart and promptPart:FindFirstChild("UnlockPrompt")
			if prompt then
				prompt.Enabled = index > unlocked
			end
		end
	end
end

--------------------------------------------------------------------------
-- Stimmung pro Zone
--------------------------------------------------------------------------
local MOODS = {
	[0] = { Clock = 14.5, Color = { 255, 220, 235 }, Decay = { 150, 110, 160 }, Density = 0.28, Tint = { 255, 255, 255 }, Cloud = 0.55, CloudColor = { 255, 245, 250 } },
	[1] = { Clock = 14.5, Color = { 255, 225, 235 }, Decay = { 140, 160, 120 }, Density = 0.28, Tint = { 255, 255, 255 }, Cloud = 0.55, CloudColor = { 255, 255, 255 } },
	[2] = { Clock = 15.8, Color = { 255, 225, 180 }, Decay = { 200, 140, 90 }, Density = 0.33, Tint = { 255, 242, 220 }, Cloud = 0.3, CloudColor = { 255, 235, 210 } },
	[3] = { Clock = 13, Color = { 220, 240, 255 }, Decay = { 140, 180, 220 }, Density = 0.36, Tint = { 232, 242, 255 }, Cloud = 0.75, CloudColor = { 240, 245, 255 } },
	[4] = { Clock = 18.1, Color = { 255, 150, 110 }, Decay = { 140, 40, 30 }, Density = 0.42, Tint = { 255, 222, 210 }, Cloud = 0.8, CloudColor = { 90, 70, 70 } },
	[5] = { Clock = 12, Color = { 255, 255, 255 }, Decay = { 255, 230, 200 }, Density = 0.3, Tint = { 255, 250, 240 }, Cloud = 0.7, CloudColor = { 255, 250, 235 } },
	[6] = { Clock = 0.5, Color = { 120, 90, 200 }, Decay = { 40, 20, 90 }, Density = 0.22, Tint = { 222, 212, 255 }, Cloud = 0, CloudColor = { 255, 255, 255 } },
	[7] = { Clock = 13, Color = { 255, 200, 230 }, Decay = { 255, 140, 200 }, Density = 0.3, Tint = { 255, 235, 245 }, Cloud = 0.6, CloudColor = { 255, 210, 240 } },
	[8] = { Clock = 21, Color = { 60, 200, 255 }, Decay = { 10, 30, 70 }, Density = 0.32, Tint = { 210, 240, 255 }, Cloud = 0.2, CloudColor = { 60, 80, 120 } },
	[9] = { Clock = 22.5, Color = { 120, 60, 170 }, Decay = { 40, 10, 60 }, Density = 0.45, Tint = { 225, 205, 245 }, Cloud = 0.7, CloudColor = { 60, 40, 80 } },
	[10] = { Clock = 0, Color = { 40, 20, 70 }, Decay = { 10, 0, 25 }, Density = 0.35, Tint = { 210, 200, 240 }, Cloud = 0, CloudColor = { 255, 255, 255 } },
	[-1] = { Clock = 18.5, Color = { 255, 150, 170 }, Decay = { 120, 40, 90 }, Density = 0.25, Tint = { 255, 230, 235 }, Cloud = 0.4, CloudColor = { 255, 200, 220 } },
}

-- Welten ab Zone 11 nehmen die Stimmung ihres Themas
local DECOR_MOOD = { meadow = 1, desert = 2, ice = 3, lava = 4, cloud = 5, space = 6, candy = 7, cyber = 8, shadow = 9, void = 10 }

local DARK_MOOD = { Clock = 0, Color = { 40, 30, 70 }, Decay = { 5, 0, 15 }, Density = 0.55, Tint = { 170, 160, 210 }, Cloud = 0, CloudColor = { 255, 255, 255 } }

local function applyMood(zoneIndex)
	local mood = MOODS[zoneIndex]
	if not mood then
		local zone = Config.Zones[zoneIndex]
		mood = (zone and MOODS[DECOR_MOOD[zone.Decor]]) or MOODS[0]
		if zone and zone.Mechanic == "dark" then
			mood = DARK_MOOD
		end
	end
	local info = TweenInfo.new(2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	TweenService:Create(Lighting, info, { ClockTime = mood.Clock }):Play()
	local atmosphere = Lighting:FindFirstChild("SlapAtmosphere")
	if atmosphere then
		TweenService:Create(atmosphere, info, {
			Color = ctx.UI.rgb(mood.Color),
			Decay = ctx.UI.rgb(mood.Decay),
			Density = mood.Density,
		}):Play()
	end
	local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds")
	if clouds then
		TweenService:Create(clouds, info, { Cover = mood.Cloud, Color = ctx.UI.rgb(mood.CloudColor) }):Play()
	end
	local color = Lighting:FindFirstChild("SlapColor")
	if color then
		TweenService:Create(color, info, { TintColor = ctx.UI.rgb(mood.Tint) }):Play()
	end
end

local function checkZone()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local zone = Calc.GetZoneAtZ(root.Position.Z)
	if root.Position.Y > Config.Duel.ArenaHeight * 0.6 then
		zone = -1 -- Duell-Arena
	end
	if zone ~= currentZone then
		currentZone = zone
		ctx.Hud.SetZone(zone)
		applyMood(zone)
		WorldFx.ApplyMechanic(zone)
	end
end

--------------------------------------------------------------------------
-- Zonen-Mechaniken (Schwerkraft, Wind, Spring- und Turbo-Felder)
--------------------------------------------------------------------------
local GRAVITY = { lowgrav = 70, floaty = 120, heavy = 300 }
local MECHANIC_HINT = {
	lowgrav = "Low gravity! Jump really high!",
	floaty = "Floaty air! You fall slowly.",
	heavy = "Heavy gravity! Jumping is hard here.",
	ice = "Slippery ice! Careful, you slide!",
	bounce = "Step on the pink pads to bounce up high!",
	boost = "Run over the blue pads for a speed boost!",
	dark = "It's dark here... the targets glow!",
	storm = "Strong wind gusts push you around!",
}
local currentMechanic = "none"

function WorldFx.ApplyMechanic(zoneIndex)
	local zone = Config.Zones[zoneIndex]
	local mechanic = (zone and zone.Mechanic) or "none"
	currentMechanic = mechanic
	workspace.Gravity = GRAVITY[mechanic] or 196.2
	local info = Config.MechanicInfo[mechanic]
	if info and MECHANIC_HINT[mechanic] then
		ctx.Hud.Notify(info.Icon .. " " .. info.Name .. ": " .. MECHANIC_HINT[mechanic], { 200, 230, 255 })
	end
end

local padCooldown = 0
local function onPadTouched(pad, hit, kind)
	local character = player.Character
	if not character or not hit:IsDescendantOf(character) then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	local now = os.clock()
	if not root or now < padCooldown then
		return
	end
	padCooldown = now + 0.6
	local v = root.AssemblyLinearVelocity
	if kind == "bounce" then
		root.AssemblyLinearVelocity = Vector3.new(v.X, 110, v.Z)
	else
		local dir = pad.CFrame.LookVector
		dir = Vector3.new(dir.X, 0, dir.Z)
		if dir.Magnitude < 0.01 then
			dir = Vector3.new(0, 0, 1)
		end
		root.AssemblyLinearVelocity = dir.Unit * 110 + Vector3.new(0, 18, 0)
	end
	ctx.PlaySound("Popup", kind == "bounce" and 1.6 or 1.2)
end

local function hookPad(pad, kind)
	if pad:IsA("BasePart") and not pad:GetAttribute("PadHooked") then
		pad:SetAttribute("PadHooked", true)
		pad.Touched:Connect(function(hit)
			onPadTouched(pad, hit, kind)
		end)
	end
end

local function setupPads()
	for tag, kind in pairs({ SlapBouncePad = "bounce", SlapBoostPad = "boost" }) do
		for _, pad in ipairs(CollectionService:GetTagged(tag)) do
			hookPad(pad, kind)
		end
		CollectionService:GetInstanceAddedSignal(tag):Connect(function(pad)
			hookPad(pad, kind)
		end)
	end
end

-- Windboeen in Sturm-Zonen
local nextGust = 0
local function updateStorm()
	if currentMechanic ~= "storm" then
		return
	end
	local now = os.clock()
	if now < nextGust then
		return
	end
	nextGust = now + 3 + math.random() * 3
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root then
		local angle = math.random() * math.pi * 2
		root.AssemblyLinearVelocity = root.AssemblyLinearVelocity + Vector3.new(math.cos(angle) * 45, 8, math.sin(angle) * 45)
		ctx.Hud.Notify("💨 Whoosh! A gust of wind!", { 200, 230, 255 })
	end
end

--------------------------------------------------------------------------
-- Tutorial-Pfeil
--------------------------------------------------------------------------
local tutorial = { Beam = nil, A0 = nil, A1 = nil }

local function clearTutorial()
	for _, key in ipairs({ "Beam", "A0", "A1" }) do
		if tutorial[key] then
			tutorial[key]:Destroy()
			tutorial[key] = nil
		end
	end
end

local function updateTutorial()
	local state = ctx.State
	if not state or state.TutorialDone then
		clearTutorial()
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local target = nil
	for _, model in ipairs(CollectionService:GetTagged("SlapGyatt")) do
		if model:GetAttribute("Key") == "Z1_1" and model.Parent then
			target = model.PrimaryPart
		end
	end
	if not root or not target then
		clearTutorial()
		return
	end
	if tutorial.A0 and tutorial.A0.Parent == root and tutorial.A1 and tutorial.A1.Parent == target then
		return
	end
	clearTutorial()
	tutorial.A0 = Instance.new("Attachment")
	tutorial.A0.Parent = root
	tutorial.A1 = Instance.new("Attachment")
	tutorial.A1.Parent = target
	local beam = Instance.new("Beam")
	beam.Attachment0 = tutorial.A0
	beam.Attachment1 = tutorial.A1
	beam.Color = ColorSequence.new(Color3.fromRGB(255, 120, 200), Color3.fromRGB(255, 230, 120))
	beam.Width0 = 0.6
	beam.Width1 = 0.6
	beam.FaceCamera = true
	beam.LightEmission = 1
	beam.Transparency = NumberSequence.new(0.2)
	beam.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	beam.TextureMode = Enum.TextureMode.Wrap
	beam.TextureLength = 2
	beam.TextureSpeed = 2
	beam.Parent = tutorial.A0
	tutorial.Beam = beam
end

--------------------------------------------------------------------------
function WorldFx.Init(context)
	ctx = context
	Config = ctx.Config
	Calc = ctx.Calc

	RunService.RenderStepped:Connect(function(dt)
		animateGyatts(dt)
		animateEggs()
	end)

	ctx.OnState(function(_, full)
		if full then
			refreshGates()
			updateTutorial()
		end
	end)

	setupPads()
	task.spawn(function()
		while true do
			task.wait(0.5)
			pcall(updateStorm)
			checkZone()
			refreshGates()
			updateTutorial()
		end
	end)
end

return WorldFx
]]></ProtectedString></Properties></Item></Item></Item></Item></roblox>
