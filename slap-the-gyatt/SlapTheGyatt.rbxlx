<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="ReplicatedStorage" referent="RBX00000004"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000003"><Properties><string name="Name">SlapShared</string></Properties><Item class="ModuleScript" referent="RBX00000001"><Properties><string name="Name">Calc</string><ProtectedString name="Source"><![CDATA[--[[
	SlapShared/Calc  (ModuleScript)

	Alle Formeln. Wird von Server UND Client benutzt, damit die Anzeige
	immer genau zu dem passt, was der Server rechnet.
	Benutzt keine Roblox-APIs.
]]

local Config = require(script.Parent:WaitForChild("Config"))

local Calc = {}

--------------------------------------------------------------------------
-- Zahlen & Zeit
--------------------------------------------------------------------------
local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc", "Ud", "Dd", "Td" }

function Calc.FormatNumber(n)
	n = tonumber(n) or 0
	if n ~= n then
		return "0"
	end
	if n == math.huge then
		return "∞"
	end
	local negative = n < 0
	if negative then
		n = -n
	end
	local index = 1
	while n >= 1000 and index < #SUFFIXES do
		n = n / 1000
		index = index + 1
	end
	local text
	if index == 1 then
		text = tostring(math.floor(n))
	elseif n >= 100 then
		text = tostring(math.floor(n)) .. SUFFIXES[index]
	elseif n >= 10 then
		text = string.format("%.1f", math.floor(n * 10) / 10) .. SUFFIXES[index]
	else
		text = string.format("%.2f", math.floor(n * 100) / 100) .. SUFFIXES[index]
	end
	if negative then
		text = "-" .. text
	end
	return text
end

function Calc.FormatTime(seconds)
	seconds = math.max(0, math.floor(tonumber(seconds) or 0))
	local hours = math.floor(seconds / 3600)
	local minutes = math.floor((seconds % 3600) / 60)
	local secs = seconds % 60
	if hours > 0 then
		return string.format("%dh %02dm", hours, minutes)
	end
	return string.format("%02d:%02d", minutes, secs)
end

function Calc.FormatMultiplier(m)
	if m >= 1000 then
		return "x" .. Calc.FormatNumber(m)
	elseif m >= 100 then
		return string.format("x%d", math.floor(m))
	end
	return string.format("x%.2f", m)
end

--------------------------------------------------------------------------
-- Upgrades
--------------------------------------------------------------------------
function Calc.ClampLevel(id, level)
	local upgrade = Config.Upgrades[id]
	level = math.floor(tonumber(level) or 0)
	if level ~= level or level < 0 then
		level = 0
	end
	if upgrade and level > upgrade.MaxLevel then
		level = upgrade.MaxLevel
	end
	return level
end

function Calc.GetUpgradeCost(id, currentLevel)
	local upgrade = Config.Upgrades[id]
	if not upgrade then
		return nil
	end
	currentLevel = Calc.ClampLevel(id, currentLevel)
	if currentLevel >= upgrade.MaxLevel then
		return nil
	end
	return math.floor(upgrade.BaseCost * (upgrade.CostGrowth ^ currentLevel))
end

function Calc.GetBaseDamage(powerLevel)
	powerLevel = Calc.ClampLevel("Power", powerLevel)
	return math.floor((1 + powerLevel) * (1.15 ^ powerLevel))
end

function Calc.GetCooldown(speedLevel)
	speedLevel = Calc.ClampLevel("Speed", speedLevel)
	return math.max(0.12, 0.8 * (0.935 ^ speedLevel))
end

function Calc.GetReach(reachLevel)
	reachLevel = Calc.ClampLevel("Reach", reachLevel)
	return 6 + reachLevel * 1.5
end

function Calc.GetCritChance(luckLevel)
	luckLevel = Calc.ClampLevel("Luck", luckLevel)
	return 0.03 + luckLevel * 0.015
end

function Calc.GetGreedMultiplier(greedLevel)
	greedLevel = Calc.ClampLevel("Greed", greedLevel)
	return 1 + greedLevel * 0.25
end

function Calc.GetMaxCombo(comboLevel)
	comboLevel = Calc.ClampLevel("Combo", comboLevel)
	return 25 + comboLevel * 10
end

function Calc.GetComboMultiplier(combo)
	combo = math.max(0, math.floor(tonumber(combo) or 0))
	return 1 + combo * Config.ComboBonusPerStack
end

function Calc.GetHandScale(powerLevel)
	powerLevel = Calc.ClampLevel("Power", powerLevel)
	return 1 + powerLevel * 0.025
end

function Calc.DescribeUpgrade(id, level)
	if id == "Power" then
		return Calc.FormatNumber(Calc.GetBaseDamage(level)) .. " base damage"
	elseif id == "Speed" then
		return string.format("%.2f s", Calc.GetCooldown(level))
	elseif id == "Reach" then
		return string.format("%.1f Studs", Calc.GetReach(level))
	elseif id == "Luck" then
		return string.format("%.1f%% crit", Calc.GetCritChance(level) * 100)
	elseif id == "Greed" then
		return string.format("x%.2f Slaps", Calc.GetGreedMultiplier(level))
	elseif id == "Combo" then
		return "Max Combo " .. Calc.GetMaxCombo(level)
	end
	return ""
end

--------------------------------------------------------------------------
-- Rebirth
--------------------------------------------------------------------------
local function cleanCount(n)
	n = math.floor(tonumber(n) or 0)
	if n ~= n or n < 0 then
		return 0
	end
	return n
end

function Calc.GetRebirthCost(rebirths)
	return math.floor(Config.RebirthBaseCost * (Config.RebirthCostGrowth ^ cleanCount(rebirths)))
end

function Calc.GetRebirthSlapMultiplier(rebirths)
	return 1 + cleanCount(rebirths) * Config.RebirthSlapBonus
end

function Calc.GetRebirthDamageMultiplier(rebirths)
	return 1 + cleanCount(rebirths) * Config.RebirthDamageBonus
end

function Calc.GetRebirthGems(newRebirthCount)
	return Config.RebirthGems * cleanCount(newRebirthCount)
end

--------------------------------------------------------------------------
-- Haende
--------------------------------------------------------------------------
local handIndex = {}
for i, hand in ipairs(Config.Hands) do
	handIndex[hand.Id] = i
end

function Calc.GetHand(handId)
	local index = handIndex[handId]
	if index then
		return Config.Hands[index], index
	end
	return Config.Hands[1], 1
end

function Calc.IsHand(handId)
	return handIndex[handId] ~= nil
end

function Calc.IsRobuxHand(handId)
	local index = handIndex[handId]
	return index ~= nil and Config.Hands[index].Currency == "Robux"
end

-- Besitzt der Spieler die Hand? (Robux-Haende stehen in RobuxHands)
function Calc.OwnsHand(data, handId)
	if type(data) ~= "table" then
		return false
	end
	if type(data.OwnedHands) == "table" and data.OwnedHands[handId] then
		return true
	end
	return type(data.RobuxHands) == "table" and data.RobuxHands[handId] == true
end

-- Kurzbeschreibung der Bonus-Werte einer Hand
function Calc.DescribeHandPerks(hand)
	local parts = { "x" .. Calc.FormatNumber(hand.Damage) .. " Damage" }
	if hand.SlapMultiplier then
		table.insert(parts, "x" .. hand.SlapMultiplier .. " Slaps")
	end
	if hand.CritBonus then
		table.insert(parts, "+" .. math.floor(hand.CritBonus * 100 + 0.5) .. "% Crit")
	end
	if hand.ReachBonus then
		table.insert(parts, "+" .. hand.ReachBonus .. " Reach")
	end
	if hand.SpeedMultiplier then
		table.insert(parts, "+" .. math.floor((1 / hand.SpeedMultiplier - 1) * 100 + 0.5) .. "% Speed")
	end
	return table.concat(parts, " • ")
end

--------------------------------------------------------------------------
-- Pets
--------------------------------------------------------------------------
function Calc.GetPetBoost(petIds)
	local total = 1
	for _, petId in ipairs(petIds or {}) do
		local pet = Config.Pets[petId]
		if pet then
			total = total + pet.Boost
		end
	end
	return total
end

-- Liste der Pet-IDs, die ein Spieler ausgeruestet hat
function Calc.GetEquippedPetIds(data)
	local result = {}
	if type(data) ~= "table" or type(data.Pets) ~= "table" then
		return result
	end
	for _, pet in ipairs(data.Pets) do
		if pet.Equipped and Config.Pets[pet.Id] then
			table.insert(result, pet.Id)
		end
	end
	return result
end

function Calc.GetPetSlots(data)
	local bought = (data and data.GemShop and tonumber(data.GemShop.PetSlot)) or 0
	return Config.BasePetSlots + cleanCount(bought)
end

function Calc.GetInventorySize(data)
	local bought = (data and data.GemShop and tonumber(data.GemShop.Inventory)) or 0
	return Config.BaseInventory + cleanCount(bought) * 20
end

-- Wahrscheinlichkeiten eines Eis (fuer Anzeige und Wuerfeln)
function Calc.GetEggChances(eggId, lucky)
	local egg = Config.Eggs[eggId]
	local result = {}
	if not egg then
		return result
	end
	local total = 0
	for _, entry in ipairs(egg.Pets) do
		local pet = Config.Pets[entry[1]]
		local weight = entry[2]
		if lucky and pet and pet.Rarity ~= "Common" then
			weight = weight * Config.LuckyBoostFactor
		end
		total = total + weight
		table.insert(result, { PetId = entry[1], Weight = weight })
	end
	for _, entry in ipairs(result) do
		entry.Chance = entry.Weight / total
	end
	return result
end

-- randomFn() muss eine Zahl in [0, 1) liefern
function Calc.RollEgg(eggId, lucky, randomFn)
	local chances = Calc.GetEggChances(eggId, lucky)
	local roll = randomFn()
	local sum = 0
	for _, entry in ipairs(chances) do
		sum = sum + entry.Chance
		if roll < sum then
			return entry.PetId
		end
	end
	local last = chances[#chances]
	return last and last.PetId or nil
end

function Calc.FormatChance(chance)
	local percent = chance * 100
	if percent >= 10 then
		return string.format("%d%%", math.floor(percent + 0.5))
	elseif percent >= 1 then
		return string.format("%.1f%%", percent)
	end
	return string.format("%.2f%%", percent)
end

--------------------------------------------------------------------------
-- Boosts
--------------------------------------------------------------------------
function Calc.IsBoostActive(data, boostId, now)
	if type(data) ~= "table" or type(data.Boosts) ~= "table" then
		return false
	end
	local expires = tonumber(data.Boosts[boostId])
	return expires ~= nil and expires > now
end

--------------------------------------------------------------------------
-- Gesamtwerte eines Spielers
--------------------------------------------------------------------------
function Calc.GetDamage(data, now)
	local upgrades = data.Upgrades or {}
	local hand = Calc.GetHand(data.Hand)
	local damage = Calc.GetBaseDamage(upgrades.Power) * hand.Damage * Calc.GetRebirthDamageMultiplier(data.Rebirths)
	if Calc.IsBoostActive(data, "DoubleDamage", now) then
		damage = damage * 2
	end
	return math.max(1, math.floor(damage))
end

-- Multiplikator fuer verdiente Slaps (ohne Combo und ohne Gyatt-Multiplikator)
function Calc.GetSlapMultiplier(data, now)
	local upgrades = data.Upgrades or {}
	local hand = Calc.GetHand(data.Hand)
	local multiplier = Calc.GetGreedMultiplier(upgrades.Greed)
		* Calc.GetRebirthSlapMultiplier(data.Rebirths)
		* Calc.GetPetBoost(Calc.GetEquippedPetIds(data))
		* (hand.SlapMultiplier or 1)
	if Calc.IsBoostActive(data, "DoubleSlaps", now) then
		multiplier = multiplier * 2
	end
	return multiplier
end

-- Krit-Chance inklusive Hand-Bonus
function Calc.GetTotalCritChance(data)
	local hand = Calc.GetHand(data.Hand)
	return math.min(0.95, Calc.GetCritChance((data.Upgrades or {}).Luck) + (hand.CritBonus or 0))
end

-- Reichweite inklusive Hand-Bonus
function Calc.GetTotalReach(data)
	local hand = Calc.GetHand(data.Hand)
	return Calc.GetReach((data.Upgrades or {}).Reach) + (hand.ReachBonus or 0)
end

-- Wartezeit inklusive Hand-Bonus
function Calc.GetTotalCooldown(data)
	local hand = Calc.GetHand(data.Hand)
	return math.max(0.08, Calc.GetCooldown((data.Upgrades or {}).Speed) * (hand.SpeedMultiplier or 1))
end

--------------------------------------------------------------------------
-- Gem-Shop
--------------------------------------------------------------------------
local gemItems = {}
for _, item in ipairs(Config.GemShop) do
	gemItems[item.Id] = item
end

function Calc.GetGemItem(itemId)
	return gemItems[itemId]
end

-- Preis fuer den naechsten Kauf, nil wenn ausverkauft
function Calc.GetGemItemPrice(itemId, ownedCount)
	local item = gemItems[itemId]
	if not item then
		return nil
	end
	if item.Repeatable then
		return item.Prices[1]
	end
	return item.Prices[cleanCount(ownedCount) + 1]
end

--------------------------------------------------------------------------
-- Zonen
--------------------------------------------------------------------------
function Calc.GetZoneStartZ(zoneIndex)
	return (zoneIndex - 1) * Config.ZoneLength
end

function Calc.GetZoneAtZ(z)
	if z < 0 then
		return 0 -- Hub
	end
	local index = math.floor(z / Config.ZoneLength) + 1
	if index > #Config.Zones then
		index = #Config.Zones
	end
	return index
end

function Calc.GetGyattKey(zoneIndex, gyattIndex)
	return "Z" .. zoneIndex .. "_" .. gyattIndex
end

--------------------------------------------------------------------------
-- Taegliche Belohnung
-- Gibt zurueck: kannAbholen, Serien-Tag, Sekunden bis zur naechsten
--------------------------------------------------------------------------
function Calc.GetDailyStatus(data, now)
	local daily = (type(data) == "table" and type(data.Daily) == "table") and data.Daily or { Last = 0, Streak = 0 }
	local last = tonumber(daily.Last) or 0
	local streak = tonumber(daily.Streak) or 0
	if last > 0 and now - last < Config.DailyCooldown then
		return false, streak, last + Config.DailyCooldown - now
	end
	if last == 0 or now - last > Config.DailyStreakReset or streak >= #Config.DailyRewards then
		return true, 1, 0
	end
	return true, streak + 1, 0
end

--------------------------------------------------------------------------
-- Quests
--------------------------------------------------------------------------
function Calc.GetDayNumber(unixTime)
	return math.floor((tonumber(unixTime) or 0) / 86400)
end

-- Gibt die Quests eines Tages fuer einen Spieler zurueck (immer gleich fuer
-- denselben Tag und Spieler, egal auf welchem Server).
function Calc.GetQuests(day, userId)
	local seed = (cleanCount(day) * 7919 + cleanCount(userId) * 104729) % 2147483647
	local function nextRandom()
		seed = (seed * 16807) % 2147483647
		return seed / 2147483647
	end
	nextRandom()
	local pool = {}
	for i = 1, #Config.QuestPool do
		pool[i] = i
	end
	local quests = {}
	for slot = 1, math.min(Config.QuestsPerDay, #pool) do
		local pick = math.floor(nextRandom() * #pool) + 1
		if pick > #pool then
			pick = #pool
		end
		local template = Config.QuestPool[pool[pick]]
		table.remove(pool, pick)
		local tier = slot -- Quest 1 leicht, 2 mittel, 3 schwer
		local amount = template.Amounts[tier] or template.Amounts[#template.Amounts]
		table.insert(quests, {
			Id = template.Id,
			Stat = template.Stat,
			Text = string.format(template.Text, Calc.FormatNumber(amount)),
			Amount = amount,
			Gems = template.Gems[tier] or template.Gems[#template.Gems],
		})
	end
	return quests
end

return Calc
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[--[[
	SlapShared/Config  (ModuleScript)

	ALLE Spielwerte von "Slap the Gyatt" an einem Ort.
	Keine Roblox-APIs hier drin -> funktioniert auf Server und Client gleich.
	Farben sind { R, G, B } Tabellen (0-255).
]]

local Config = {}

Config.GameName = "Slap the Gyatt"
Config.Version = "2.2"

--------------------------------------------------------------------------
-- Speichern
--------------------------------------------------------------------------
Config.DataStoreName = "SlapTheGyatt_Data_v2"
Config.LeaderboardSlapsStore = "SlapTheGyatt_TopEarned_v2"
Config.LeaderboardRebirthStore = "SlapTheGyatt_TopRebirths_v2"
Config.AutosaveInterval = 120 -- Sekunden
Config.LeaderboardRefresh = 90 -- Sekunden

--------------------------------------------------------------------------
-- Kampf
--------------------------------------------------------------------------
Config.CritMultiplier = 3
Config.MegaCritChance = 0.02 -- Chance, dass ein Krit ein MEGA-Krit wird
Config.MegaCritMultiplier = 10
Config.ComboWindow = 1.6 -- Sekunden, bis die Combo abbricht
Config.ComboBonusPerStack = 0.01 -- +1% Slaps pro Combo-Stufe
Config.GyattRespawnTime = 4
Config.AutoSlapSlowdown = 1.35 -- Auto-Slap ist etwas langsamer als Klicken

--------------------------------------------------------------------------
-- Rebirth
--------------------------------------------------------------------------
Config.RebirthBaseCost = 250000
Config.RebirthCostGrowth = 3.5
Config.RebirthSlapBonus = 0.5 -- +50% Slaps pro Rebirth
Config.RebirthDamageBonus = 0.25 -- +25% Schaden pro Rebirth
Config.RebirthGems = 25 -- Gems pro Rebirth (mal Rebirth-Nummer)

--------------------------------------------------------------------------
-- Upgrades (mit Slaps kaufen, werden bei Rebirth zurueckgesetzt)
--------------------------------------------------------------------------
Config.UpgradeOrder = { "Power", "Speed", "Reach", "Luck", "Greed", "Combo" }

Config.Upgrades = {
	Power = {
		DisplayName = "Hand Power",
		Icon = "💪",
		Description = "More damage per slap - and your hand grows!",
		MaxLevel = 60,
		BaseCost = 15,
		CostGrowth = 1.33,
	},
	Speed = {
		DisplayName = "Slap Speed",
		Icon = "⚡",
		Description = "Shorter wait between slaps.",
		MaxLevel = 30,
		BaseCost = 40,
		CostGrowth = 1.55,
	},
	Reach = {
		DisplayName = "Reach",
		Icon = "📏",
		Description = "Hit the Gyatt from farther away.",
		MaxLevel = 20,
		BaseCost = 60,
		CostGrowth = 1.6,
	},
	Luck = {
		DisplayName = "Crit Luck",
		Icon = "🍀",
		Description = "Higher chance for critical slaps (x3 damage).",
		MaxLevel = 30,
		BaseCost = 100,
		CostGrowth = 1.5,
	},
	Greed = {
		DisplayName = "Slap Greed",
		Icon = "💰",
		Description = "More Slaps for every hit.",
		MaxLevel = 50,
		BaseCost = 150,
		CostGrowth = 1.42,
	},
	Combo = {
		DisplayName = "Combo Master",
		Icon = "🔥",
		Description = "Higher max combo = more bonus Slaps.",
		MaxLevel = 20,
		BaseCost = 500,
		CostGrowth = 1.7,
	},
}

--------------------------------------------------------------------------
-- Haende (permanent, bleiben nach Rebirth)
--   Effect: "none" | "sparkles" | "fire" | "smoke" | "rainbow"
--------------------------------------------------------------------------
Config.Hands = {
	{ Id = "Wood", DisplayName = "Wood Hand", Rarity = "Common", Damage = 1, Price = 0, Currency = "Slaps", Color = { 165, 115, 70 }, Material = "Wood", Effect = "none" },
	{ Id = "Stone", DisplayName = "Stone Hand", Rarity = "Common", Damage = 1.5, Price = 500, Currency = "Slaps", Color = { 125, 125, 130 }, Material = "Slate", Effect = "none" },
	{ Id = "Iron", DisplayName = "Iron Hand", Rarity = "Common", Damage = 2.2, Price = 7500, Currency = "Slaps", Color = { 195, 200, 210 }, Material = "DiamondPlate", Effect = "none" },
	{ Id = "Gold", DisplayName = "Gold Hand", Rarity = "Rare", Damage = 3.5, Price = 60000, Currency = "Slaps", Color = { 255, 200, 40 }, Material = "Foil", Effect = "sparkles" },
	{ Id = "Emerald", DisplayName = "Emerald Hand", Rarity = "Rare", Damage = 5, Price = 600000, Currency = "Slaps", Color = { 40, 220, 110 }, Material = "Glass", Effect = "sparkles" },
	{ Id = "Diamond", DisplayName = "Diamond Hand", Rarity = "Epic", Damage = 8, Price = 8000000, Currency = "Slaps", Color = { 120, 230, 255 }, Material = "Glass", Effect = "sparkles" },
	{ Id = "Ice", DisplayName = "Frost Hand", Rarity = "Epic", Damage = 12, Price = 90000000, Currency = "Slaps", Color = { 190, 235, 255 }, Material = "Ice", Effect = "smoke" },
	{ Id = "Lava", DisplayName = "Lava Hand", Rarity = "Epic", Damage = 18, Price = 1200000000, Currency = "Slaps", Color = { 255, 110, 20 }, Material = "Neon", Effect = "fire" },
	{ Id = "Cloud", DisplayName = "Cloud Hand", Rarity = "Legendary", Damage = 27, Price = 20000000000, Currency = "Slaps", Color = { 250, 250, 255 }, Material = "SmoothPlastic", Effect = "sparkles" },
	{ Id = "Galaxy", DisplayName = "Galaxy Hand", Rarity = "Legendary", Damage = 40, Price = 400000000000, Currency = "Slaps", Color = { 120, 50, 220 }, Material = "Neon", Effect = "sparkles" },
	{ Id = "Rainbow", DisplayName = "Rainbow Hand", Rarity = "Legendary", Damage = 60, Price = 8000000000000, Currency = "Slaps", Color = { 255, 80, 200 }, Material = "Neon", Effect = "rainbow" },
	{ Id = "GyattGod", DisplayName = "Gyatt God Hand", Rarity = "Legendary", Damage = 100, Price = 2500, Currency = "Gems", Color = { 255, 235, 120 }, Material = "Neon", Effect = "fire",
		SlapMultiplier = 1.25 },
	{ Id = "DragonClaw", DisplayName = "Dragon Claw", Rarity = "Mythic", Damage = 180, Price = 6000, Currency = "Gems", Color = { 200, 30, 40 }, Material = "Neon", Effect = "dragon",
		SlapMultiplier = 1.5, CritBonus = 0.05 },

	-- ROBUX-HAENDE (Game Passes). So richtest du sie ein:
	--   1. create.roblox.com -> dein Spiel -> Monetization -> Passes -> "Create a Pass"
	--   2. Preis einstellen (Thanos 299, Ultra God 1999) und "Item for Sale" anschalten
	--   3. Die Pass-ID (Zahl in der Adresse) hier bei GamePassId eintragen
	-- Solange GamePassId = 0 ist, kann man die Hand nur in Studio zum Testen kostenlos benutzen.
	{ Id = "Thanos", DisplayName = "Thanos Gauntlet", Rarity = "Ultra", Damage = 500, Price = 299, Currency = "Robux", GamePassId = 0,
		Color = { 220, 170, 40 }, Material = "Foil", Effect = "thanos",
		SlapMultiplier = 3, CritBonus = 0.1, ReachBonus = 5, SpeedMultiplier = 0.8, Snap = 0.05,
		Perk = "🫰 SNAP: 5% chance to erase a Gyatt instantly" },
	{ Id = "UltraGod", DisplayName = "ULTRA GOD HAND", Rarity = "Ultra", Damage = 2500, Price = 1999, Currency = "Robux", GamePassId = 0,
		Color = { 255, 250, 220 }, Material = "Neon", Effect = "ultragod",
		SlapMultiplier = 10, CritBonus = 0.25, ReachBonus = 15, SpeedMultiplier = 0.5, Snap = 0.1,
		Smite = { Every = 5, Multiplier = 25, Radius = 45 },
		Perk = "⚡ DIVINE SMITE: every 5th slap strikes lightning (x25, area) + 10% SNAP" },
}

--------------------------------------------------------------------------
-- Seltenheiten
--------------------------------------------------------------------------
Config.RarityOrder = { "Common", "Rare", "Epic", "Legendary", "Mythic" }
Config.Rarities = {
	Common = { DisplayName = "Common", Color = { 200, 200, 200 }, Order = 1 },
	Rare = { DisplayName = "Rare", Color = { 80, 170, 255 }, Order = 2 },
	Epic = { DisplayName = "Epic", Color = { 190, 90, 255 }, Order = 3 },
	Legendary = { DisplayName = "Legendary", Color = { 255, 190, 40 }, Order = 4 },
	Mythic = { DisplayName = "Mythic", Color = { 255, 60, 120 }, Order = 5 },
	Ultra = { DisplayName = "ULTRA", Color = { 255, 240, 120 }, Order = 6 },
}

--------------------------------------------------------------------------
-- Pets. Boost = Bonus auf Slaps (+Boost, also 0.5 = +50%)
--   Style: Aussehen ("dog","cat","bunny","bear","slime","bird","dragon","ghost","robot","alien","whale","unicorn")
--------------------------------------------------------------------------
Config.Pets = {
	-- Wiese
	Dog = { DisplayName = "Dog", Rarity = "Common", Boost = 0.1, Color = { 200, 150, 100 }, Style = "dog" },
	Cat = { DisplayName = "Cat", Rarity = "Common", Boost = 0.15, Color = { 255, 170, 80 }, Style = "cat" },
	Bunny = { DisplayName = "Bunny", Rarity = "Rare", Boost = 0.3, Color = { 255, 255, 255 }, Style = "bunny" },
