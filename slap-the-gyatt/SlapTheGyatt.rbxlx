local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local Shared = ReplicatedStorage:WaitForChild("SlapShared")
local Config = require(Shared:WaitForChild("Config"))
local Calc = require(Shared:WaitForChild("Calc"))
local remotes = ReplicatedStorage:WaitForChild("SlapRemotes")

local UI = require(script:WaitForChild("UI"))
local Hud = require(script:WaitForChild("Hud"))
local Menus = require(script:WaitForChild("Menus"))
local Effects = require(script:WaitForChild("Effects"))
local WorldFx = require(script:WaitForChild("WorldFx"))
local PetsFx = require(script:WaitForChild("PetsFx"))
local Hatch = require(script:WaitForChild("Hatch"))

local old = playerGui:FindFirstChild("SlapUI")
if old then
	old:Destroy()
end
local screen = UI.Create("ScreenGui", {
	Name = "SlapUI",
	ResetOnSpawn = false,
	IgnoreGuiInset = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = playerGui,
})

--------------------------------------------------------------------------
-- Kontext
--------------------------------------------------------------------------
local ctx = {
	Player = player,
	Config = Config,
	Calc = Calc,
	UI = UI,
	Screen = screen,
	Remotes = remotes,
	State = nil,
	TimeOffset = 0,
}

local listeners = {}
function ctx.OnState(fn)
	table.insert(listeners, fn)
end

function ctx.Request(action, a, b)
	remotes.Request:FireServer(action, a, b)
end

function ctx.Now()
	return os.time() + ctx.TimeOffset
end

function ctx.Setting(name)
	local state = ctx.State
	if state and state.Settings and state.Settings[name] ~= nil then
		return state.Settings[name]
	end
	return true
end

-- Sounds (nur eingebaute Roblox-Sounds, damit garantiert nichts fehlt)
local SOUNDS = {
	Click = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.35, Speed = 1.6 },
	Buy = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.6, Speed = 1.2 },
	Denied = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.5, Speed = 0.6 },
	Crit = { Id = "rbxasset://sounds/swordlunge.wav", Volume = 0.7, Speed = 1 },
	Popup = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.7, Speed = 0.9 },
	Hatch = { Id = "rbxasset://sounds/unsheath.wav", Volume = 0.7, Speed = 1 },
	Whoosh = { Id = "rbxasset://sounds/swordslash.wav", Volume = 0.5, Speed = 0.7 },
}
local soundTemplates = {}
for name, info in pairs(SOUNDS) do
	local sound = Instance.new("Sound")
	sound.Name = "Slap_" .. name
	sound.SoundId = info.Id
	sound.Volume = info.Volume
	sound.PlaybackSpeed = info.Speed
	sound.Parent = SoundService
	soundTemplates[name] = sound
end

function ctx.PlaySound(name, speedFactor)
	if not ctx.Setting("Sounds") then
		return
	end
	local template = soundTemplates[name]
	if not template then
		return
	end
	local sound = template:Clone()
	sound.PlaybackSpeed = template.PlaybackSpeed * (speedFactor or 1)
	sound.Parent = SoundService
	sound:Play()
	Debris:AddItem(sound, 3)
end

--------------------------------------------------------------------------
-- Module starten
--------------------------------------------------------------------------
ctx.Hud = Hud
ctx.Menus = Menus
ctx.Effects = Effects
ctx.WorldFx = WorldFx
ctx.PetsFx = PetsFx
ctx.Hatch = Hatch

Hud.Init(ctx)
Menus.Init(ctx)
Effects.Init(ctx)
WorldFx.Init(ctx)
PetsFx.Init(ctx)
Hatch.Init(ctx)

UI.OnWindowOpened = function()
	ctx.PlaySound("Click")
end

--------------------------------------------------------------------------
-- Spielstand vom Server
--------------------------------------------------------------------------
remotes.State.OnClientEvent:Connect(function(payload)
	if type(payload) ~= "table" then
		return
	end
	if type(payload.ServerTime) == "number" then
		ctx.TimeOffset = payload.ServerTime - os.time()
	end
	if payload.Full or not ctx.State then
		ctx.State = payload
	else
		for key, value in pairs(payload) do
			ctx.State[key] = value
		end
	end
	for _, fn in ipairs(listeners) do
		local ok, err = pcall(fn, ctx.State, payload.Full == true)
		if not ok then
			warn("[SlapTheGyatt] UI error: " .. tostring(err))
		end
	end
end)

remotes.Notify.OnClientEvent:Connect(function(text, color)
	Hud.Notify(text, color)
end)

remotes.Popup.OnClientEvent:Connect(function(title, subtitle, color)
	Hud.Popup(title, subtitle, color)
	ctx.PlaySound("Popup")
end)

remotes.Event.OnClientEvent:Connect(function(kind, a, b)
	if kind == "Purchased" then
		ctx.PlaySound("Buy")
	elseif kind == "Denied" then
		ctx.PlaySound("Denied")
	elseif kind == "GoldenStart" then
		Hud.SetGoldenEvent(a, b)
		ctx.PlaySound("Popup", 1.3)
	elseif kind == "GoldenEnd" then
		Hud.SetGoldenEvent(nil, nil)
	end
end)

remotes.SlapFx.OnClientEvent:Connect(function(info)
	if type(info) == "table" then
		Effects.OnSlap(info)
		WorldFx.OnSlap(info)
		if info.UserId == player.UserId and info.Kind == "Gyatt" then
			Hud.SetCombo(info.Combo)
		end
	end
end)

remotes.Defeat.OnClientEvent:Connect(function(key, position, radius, isGolden)
	Effects.OnDefeat(key, position, radius, isGolden)
end)

remotes.Knockback.OnClientEvent:Connect(function(velocity, attackerName)
	Effects.OnKnockback(velocity, attackerName)
end)

remotes.Hatch.OnClientEvent:Connect(function(result)
	Hatch.Play(result)
end)

remotes.Request:FireServer("RequestState")
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">Effects</string><ProtectedString name="Source"><![CDATA[--[[
	Effects: Schadenszahlen, Partikel, Kamera-Wackeln, Konfetti, Rueckstoss.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

local Effects = {}
local ctx, UI, Calc

local player = Players.LocalPlayer
local shakeUntil = 0
local shakeStrength = 0

local function makeAttachment(position)
	local attachment = Instance.new("Attachment")
	attachment.Parent = workspace.Terrain
	attachment.WorldPosition = position
	return attachment
end

local function burst(position, colors, count, speed, size)
	local attachment = makeAttachment(position)
	local keypoints = {}
	for i, color in ipairs(colors) do
		table.insert(keypoints, ColorSequenceKeypoint.new((i - 1) / math.max(1, #colors - 1), color))
	end
	if #keypoints == 1 then
		table.insert(keypoints, ColorSequenceKeypoint.new(1, colors[1]))
	end
	local emitter = Instance.new("ParticleEmitter")
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(0.4, 0.9)
	emitter.Speed = NumberRange.new(speed * 0.6, speed)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Acceleration = Vector3.new(0, -30, 0)
	emitter.Drag = 2
	emitter.LightEmission = 0.6
	emitter.Color = ColorSequence.new(keypoints)
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 0.6) })
	emitter.Parent = attachment
	emitter:Emit(count)
	Debris:AddItem(attachment, 1.5)
end

local function floatingText(position, text, color, size, transparency)
	local attachment = makeAttachment(position)
	local billboard = UI.Create("BillboardGui", {
		Adornee = attachment,
		Size = UDim2.new(size * 1.8, 0, size, 0),
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = 200,
		Parent = attachment,
	})
	local label = UI.Create("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = UI.Font,
		TextScaled = true,
		TextColor3 = color,
		TextStrokeTransparency = 0,
		TextTransparency = transparency or 0,
		Text = text,
		Parent = billboard,
	})
	local scale = UI.Create("UIScale", { Scale = 0.4, Parent = label })
	TweenService:Create(scale, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	TweenService:Create(billboard, TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { StudsOffset = Vector3.new(0, 3.5, 0) }):Play()
	TweenService:Create(label, TweenInfo.new(0.45, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, 0.55), {
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	}):Play()
	Debris:AddItem(attachment, 1.1)
end

local function shake(strength, duration)
	if not ctx.Setting("Shake") then
		return
	end
	shakeStrength = math.max(shakeStrength, strength)
	shakeUntil = math.max(shakeUntil, os.clock() + duration)
end

local function fovPunch(amount)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local base = 70
	camera.FieldOfView = base + amount
	TweenService:Create(camera, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { FieldOfView = base }):Play()
end

local function screenFlash(color, strength)
	local flash = UI.Create("Frame", {
		Name = "Flash",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = color,
		BackgroundTransparency = 1 - strength,
		BorderSizePixel = 0,
		ZIndex = 40,
		Parent = ctx.Screen,
	})
	TweenService:Create(flash, TweenInfo.new(0.5), { BackgroundTransparency = 1 }):Play()
	Debris:AddItem(flash, 0.6)
end

local function lightning(position)
	for i = 1, 3 do
		local bolt = Instance.new("Part")
		bolt.Name = "Lightning"
		bolt.Anchored = true
		bolt.CanCollide = false
		bolt.CanQuery = false
		bolt.CanTouch = false
		bolt.CastShadow = false
		bolt.Material = Enum.Material.Neon
		bolt.Color = (i == 1) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(255, 240, 140)
		local width = (i == 1) and 1.6 or 0.7
		bolt.Size = Vector3.new(width, 140, width)
		local offset = Vector3.new((math.random() - 0.5) * 4, 70, (math.random() - 0.5) * 4)
		bolt.CFrame = CFrame.new(position + offset) * CFrame.Angles(0, 0, (math.random() - 0.5) * 0.12)
		bolt.Parent = workspace
		TweenService:Create(bolt, TweenInfo.new(0.45), { Transparency = 1 }):Play()
		Debris:AddItem(bolt, 0.5)
	end
end

function Effects.OnSlap(info)
	local position = info.Position
	if typeof(position) ~= "Vector3" then
		return
	end
	local isMine = info.UserId == player.UserId

	if info.Kind == "Pvp" then
		burst(position, { Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 80, 160) }, 18, 25, 0.8)
		if isMine then
			shake(0.25, 0.15)
			fovPunch(3)
		end
		return
	end

	local radius = tonumber(info.Radius) or 3
	local damage = tonumber(info.Damage) or 0
	local crit = tonumber(info.Crit) or 0

	-- Trefferpunkt: Seite des Gyatts, die zum Schlaeger zeigt
	local hitPoint = position
	if typeof(info.From) == "Vector3" then
		local dir = info.From - position
		if dir.Magnitude > 0.01 then
			hitPoint = position + dir.Unit * radius * 0.95
		end
	end

	local colors = { Color3.fromRGB(255, 200, 230), Color3.fromRGB(255, 90, 170) }
	if crit == 1 then
		colors = { Color3.fromRGB(255, 240, 120), Color3.fromRGB(255, 140, 30) }
	elseif crit == 2 then
		colors = { Color3.fromRGB(255, 80, 80), Color3.fromRGB(255, 230, 80), Color3.fromRGB(80, 255, 120), Color3.fromRGB(80, 160, 255), Color3.fromRGB(200, 90, 255) }
	end
	burst(hitPoint, colors, isMine and (crit > 0 and 30 or 14) or 6, 22 + crit * 10, 0.7 + crit * 0.3)

	if ctx.Setting("DamageNumbers") and (isMine or math.random() < 0.5) then
		local text = "-" .. Calc.FormatNumber(damage)
		local color = Color3.fromRGB(255, 255, 255)
		local size = isMine and 4.5 or 2.8
		if crit == 1 then
			text = "💥 CRIT! " .. text
			color = Color3.fromRGB(255, 220, 60)
			size = size * 1.3
		elseif crit == 2 then
			text = "🌈 MEGA CRIT!! " .. text
			color = Color3.fromRGB(255, 90, 200)
			size = size * 1.7
		end
		if isMine and info.Reward then
			text = text .. "\n+" .. Calc.FormatNumber(info.Reward) .. " 👋"
		end
		local offset = Vector3.new((math.random() - 0.5) * radius * 1.4, radius * 0.5 + math.random() * radius * 0.6, 0)
		floatingText(position + offset, text, color, size, isMine and 0 or 0.35)
	end

	-- Legendaere Kraefte
	if info.Special == "Snap" then
		burst(position, { Color3.fromRGB(120, 100, 90), Color3.fromRGB(200, 180, 160) }, 80, 30, 1.6)
		floatingText(position + Vector3.new(0, radius + 3, 0), "🫰 SNAP!", Color3.fromRGB(190, 110, 255), 9, 0)
		if isMine then
			screenFlash(Color3.fromRGB(150, 60, 255), 0.45)
			shake(0.8, 0.4)
		end
	elseif info.Special == "Smite" then
		lightning(position)
		burst(position + Vector3.new(0, radius, 0), { Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 230, 100) }, 50, 45, 1.5)
		if isMine then
			floatingText(position + Vector3.new(0, radius + 3, 0), "⚡ DIVINE SMITE!", Color3.fromRGB(255, 240, 120), 8, 0)
			screenFlash(Color3.fromRGB(255, 255, 220), 0.35)
			shake(0.9, 0.35)
			ctx.PlaySound("Crit", 0.6)
		end
	end

	if isMine then
		fovPunch(crit > 0 and 4 or 1.5)
		if crit > 0 then
			shake(crit == 2 and 0.9 or 0.4, crit == 2 and 0.45 or 0.2)
			ctx.PlaySound("Crit", crit == 2 and 0.8 or 1.1)
		end
	end
end

function Effects.OnDefeat(key, position, radius, isGolden)
	if typeof(position) ~= "Vector3" then
		return
	end
	radius = tonumber(radius) or 4
	local confetti = {
		Color3.fromRGB(255, 80, 160), Color3.fromRGB(255, 220, 60), Color3.fromRGB(90, 220, 255),
		Color3.fromRGB(120, 255, 120), Color3.fromRGB(200, 120, 255),
	}
	burst(position, confetti, isGolden and 120 or 60, 40, 1.4)
	burst(position + Vector3.new(0, radius, 0), { Color3.fromRGB(255, 255, 255) }, 30, 25, 2)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if root and (root.Position - position).Magnitude < 80 then
		shake(0.6, 0.35)
		floatingText(position + Vector3.new(0, radius + 2, 0), isGolden and "⭐ GOLDEN DEFEATED! ⭐" or "💥 DEFEATED!", Color3.fromRGB(255, 230, 90), 7, 0)
	end
end

function Effects.OnKnockback(velocity, attackerName)
	if typeof(velocity) ~= "Vector3" then
		return
	end
	-- Schutz: unrealistisch starke Werte begrenzen
	if velocity.Magnitude > 250 then
		velocity = velocity.Unit * 250
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return
	end
	humanoid:ChangeState(Enum.HumanoidStateType.FallingDown)
	root.AssemblyLinearVelocity = velocity
	shake(0.7, 0.3)
	ctx.PlaySound("Whoosh")
	ctx.Hud.Notify("💥 " .. tostring(attackerName) .. " slapped you away!", { 255, 150, 150 })
	task.delay(0.8, function()
		if humanoid.Parent and humanoid.Health > 0 then
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end)
end

function Effects.Init(context)
	ctx = context
	UI = ctx.UI
	Calc = ctx.Calc

	-- Kamera-Wackeln ueber CameraOffset des Humanoids
	RunService.RenderStepped:Connect(function()
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not humanoid then
			return
		end
		local now = os.clock()
		if now < shakeUntil then
			local s = shakeStrength
			humanoid.CameraOffset = Vector3.new((math.random() - 0.5) * s, (math.random() - 0.5) * s, (math.random() - 0.5) * s)
		elseif shakeStrength > 0 then
			shakeStrength = 0
			humanoid.CameraOffset = Vector3.new(0, 0, 0)
		end
	end)
end

return Effects
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000018"><Properties><string name="Name">Hatch</string><ProtectedString name="Source"><![CDATA[--[[
	Hatch: Ei-Oeffnen-Animation (Ei wackelt, knackt, Pets erscheinen).
]]

local TweenService = game:GetService("TweenService")

local Hatch = {}
local ctx, UI, Config, Calc, Create

local overlay, eggLabel, eggScale, resultHolder, hintLabel
local playing = false
local queue = {}

local function build()
	overlay = Create("TextButton", {
		Name = "HatchOverlay",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(10, 0, 20),
		BackgroundTransparency = 0.35,
		AutoButtonColor = false,
		Text = "",
		Visible = false,
		ZIndex = 50,
		Parent = ctx.Screen,
	})
	eggLabel = UI.Label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.new(0, 220, 0, 220),
		Text = "🥚",
		ZIndex = 51,
		Parent = overlay,
	})
	eggScale = Create("UIScale", { Scale = 1, Parent = eggLabel })
	resultHolder = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.new(0.9, 0, 0, 230),
		BackgroundTransparency = 1,
		ZIndex = 51,
		Parent = overlay,
	}, {
		Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 14),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	hintLabel = UI.Label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.72, 0),
		Size = UDim2.new(0.6, 0, 0, 28),
		Font = UI.BodyFont,
		TextColor3 = UI.Colors.SubText,
		Text = "Click to close",
		ZIndex = 51,
		Parent = overlay,
	})
end

local function card(petId, order)
	local cfg = Config.Pets[petId]
	local rarity = Config.Rarities[cfg.Rarity]
	local color = UI.rgb(rarity.Color)
	local frame = Create("Frame", {
		LayoutOrder = order,
		Size = UDim2.new(0, 160, 0, 210),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		ZIndex = 52,
		Parent = resultHolder,
	}, {
		UI.Corner(18),
		UI.Stroke(4, color),
		UI.Gradient(UI.Colors.Panel, UI.Colors.Darker),
	})
	local scale = Create("UIScale", { Scale = 0.2, Parent = frame })
	local face = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 14),
		Size = UDim2.new(0, 86, 0, 86),
		BackgroundColor3 = UI.rgb(cfg.Color),
		ZIndex = 53,
		Parent = frame,
	}, { Create("UICorner", { CornerRadius = UDim.new(1, 0) }), UI.Stroke(3) })
	UI.Label({ Size = UDim2.fromScale(1, 1), Text = "😊", ZIndex = 54, Parent = face })
	local name = UI.Label({ Position = UDim2.new(0, 6, 0, 108), Size = UDim2.new(1, -12, 0, 30), Text = cfg.DisplayName, ZIndex = 53, Parent = frame })
	UI.TextStroke(1.5).Parent = name
	local rarityLabel = UI.Label({ Position = UDim2.new(0, 6, 0, 140), Size = UDim2.new(1, -12, 0, 24), Text = rarity.DisplayName, TextColor3 = color, ZIndex = 53, Parent = frame })
	UI.TextStroke(1.5).Parent = rarityLabel
	UI.Label({ Position = UDim2.new(0, 6, 0, 168), Size = UDim2.new(1, -12, 0, 22), Font = UI.BodyFont, Text = "+" .. Calc.FormatNumber(math.floor(cfg.Boost * 100)) .. "% Slaps", TextColor3 = UI.Colors.Gold, ZIndex = 53, Parent = frame })
	TweenService:Create(scale, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	return frame
end

local function playOne(result)
	playing = true
	for _, child in ipairs(resultHolder:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	overlay.Visible = true
	hintLabel.Visible = false
	eggLabel.Visible = true
	eggLabel.Rotation = 0
	eggScale.Scale = 0.5
	TweenService:Create(eggScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()

	-- Wackeln, immer schneller
	local shakes = { 0.16, 0.14, 0.12, 0.1, 0.08, 0.07, 0.06, 0.05 }
	for i, duration in ipairs(shakes) do
		local angle = (i % 2 == 0) and 18 or -18
		TweenService:Create(eggLabel, TweenInfo.new(duration), { Rotation = angle }):Play()
		task.wait(duration)
	end
	ctx.PlaySound("Hatch")
	TweenService:Create(eggScale, TweenInfo.new(0.15), { Scale = 1.6 }):Play()
	task.wait(0.15)
	eggLabel.Visible = false

	local best = "Common"
	for i, pet in ipairs(result.Pets or {}) do
		if Config.Pets[pet.Id] then
			card(pet.Id, i)
			local rarity = Config.Pets[pet.Id].Rarity
			if Config.Rarities[rarity].Order > Config.Rarities[best].Order then
				best = rarity
			end
		end
	end
	ctx.PlaySound("Popup", (best == "Legendary" or best == "Mythic") and 1.4 or 1)
	if best == "Legendary" or best == "Mythic" then
		ctx.Hud.Popup(string.upper(Config.Rarities[best].DisplayName) .. "!!!", "What luck!", Config.Rarities[best].Color)
	end
	hintLabel.Visible = true

	-- automatisch schliessen
	local closeAt = os.clock() + 3
	while overlay.Visible and os.clock() < closeAt do
		task.wait(0.1)
	end
	overlay.Visible = false
	playing = false
	if #queue > 0 then
		local nextResult = table.remove(queue, 1)
		task.spawn(playOne, nextResult)
	end
end

function Hatch.Play(result)
	if type(result) ~= "table" or type(result.Pets) ~= "table" then
		return
	end
	if playing then
		if #queue < 3 then
			table.insert(queue, result)
		end
		return
	end
	task.spawn(playOne, result)
end

function Hatch.Init(context)
	ctx = context
	UI = ctx.UI
	Config = ctx.Config
	Calc = ctx.Calc
	Create = UI.Create
	build()
	overlay.Activated:Connect(function()
		if hintLabel.Visible then
			overlay.Visible = false
		end
	end)
end

return Hatch
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000019"><Properties><string name="Name">Hud</string><ProtectedString name="Source"><![CDATA[--[[
	Hud: alles, was immer auf dem Bildschirm ist.
	  Geld-Anzeige, Combo, Boosts, Event-Banner, Menue-Knoepfe,
	  Auto-Slap-Schalter, Zonen-Anzeige, Nachrichten, Popups.
]]

local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local Hud = {}
local ctx, UI, Config, Calc, Create

local slapsLabel, gemsLabel, multiLabel, hintLabel
local comboFrame, comboLabel, comboFill
local boostRow
local eventBanner, eventLabel
local notifyHolder
local popupFrame, popupTitle, popupSub, popupScale
local zoneLabel
local autoButton
local badges = {}

local comboValue = 0
local comboExpires = 0
local golden = { ZoneIndex = nil, EndsAt = 0 }
local notifyCounter = 0
local popupId = 0

--------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------
local function buildTop(screen)
	local top = Create("Frame", {
		Name = "TopPanel",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 6),
		Size = UDim2.new(0, 360, 0, 86),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		Parent = screen,
	}, {
		UI.Corner(18),
		UI.Stroke(3, UI.Colors.Pink),
		UI.Gradient(UI.Colors.Dark, UI.Colors.Darker),
	})

	slapsLabel = UI.Label({
		Name = "Slaps",
		Position = UDim2.new(0, 10, 0, 4),
		Size = UDim2.new(1, -20, 0, 40),
		Text = "👋 Loading...",
		Parent = top,
	})
	UI.TextStroke(2).Parent = slapsLabel

	gemsLabel = UI.Label({
		Name = "Gems",
		Position = UDim2.new(0, 10, 0, 44),
		Size = UDim2.new(0.45, -10, 0, 22),
		TextColor3 = Color3.fromRGB(140, 220, 255),
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "💎 0",
		Parent = top,
	})
	UI.TextStroke(1.5).Parent = gemsLabel

	multiLabel = UI.Label({
		Name = "Multi",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 44),
		Size = UDim2.new(0.55, -10, 0, 22),
		Font = UI.BodyFont,
		TextColor3 = UI.Colors.SubText,
		TextXAlignment = Enum.TextXAlignment.Right,
		Text = "",
		Parent = top,
	})

	hintLabel = UI.Label({
		Name = "Hint",
		Position = UDim2.new(0, 10, 0, 66),
		Size = UDim2.new(1, -20, 0, 16),
		Font = UI.BodyFont,
		TextColor3 = Color3.fromRGB(170, 140, 190),
		Text = "",
		Parent = top,
	})

	-- Combo
	comboFrame = Create("Frame", {
		Name = "Combo",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 98),
		Size = UDim2.new(0, 220, 0, 46),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = screen,
	})
	comboLabel = UI.Label({
		Size = UDim2.new(1, 0, 0, 32),
		TextColor3 = Color3.fromRGB(255, 160, 60),
		Text = "",
		Parent = comboFrame,
	})
	UI.TextStroke(2.5).Parent = comboLabel
	local _, fill = UI.ProgressBar({ Position = UDim2.new(0.1, 0, 0, 34), Size = UDim2.new(0.8, 0, 0, 8), Color = Color3.fromRGB(255, 140, 40), Parent = comboFrame })
	comboFill = fill

	-- Boosts
	boostRow = Create("Frame", {
		Name = "Boosts",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 148),
		Size = UDim2.new(0, 420, 0, 28),
		BackgroundTransparency = 1,
		Parent = screen,
	}, { UI.List(6, true, Enum.HorizontalAlignment.Center) })

	-- Event-Banner
	eventBanner = Create("Frame", {
		Name = "EventBanner",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 182),
		Size = UDim2.new(0, 420, 0, 40),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		Visible = false,
		Parent = screen,
	}, {
		UI.Corner(12),
		UI.Stroke(3, Color3.fromRGB(255, 240, 150)),
		UI.Gradient(Color3.fromRGB(255, 210, 60), Color3.fromRGB(230, 150, 20)),
		Create("UISizeConstraint", { MaxSize = Vector2.new(420, 40) }),
	})
	eventLabel = UI.Label({ Size = UDim2.fromScale(1, 1), Text = "", Parent = eventBanner }, nil)
	UI.Padding(6, 4).Parent = eventLabel
	UI.TextStroke(2).Parent = eventLabel
end

local MENU_BUTTONS = {
	{ "Shop", "🛒", "Shop", { 255, 105, 180 } },
	{ "Hands", "✋", "Hands", { 255, 160, 60 } },
	{ "Pets", "🐾", "Pets", { 90, 200, 120 } },
	{ "Zones", "🗺️", "Zones", { 70, 170, 255 } },
	{ "Gems", "💎", "Gems", { 90, 210, 255 } },
	{ "Rebirth", "♻️", "Rebirth", { 160, 100, 255 } },
	{ "Quests", "📜", "Quests", { 255, 200, 60 } },
	{ "Daily", "🎁", "Daily", { 255, 90, 120 } },
	{ "Codes", "🎟️", "Codes", { 120, 120, 255 } },
	{ "Settings", "⚙️", "Settings", { 130, 130, 150 } },
}

local function buildMenuButtons(screen)
	local holder = Create("Frame", {
		Name = "MenuButtons",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 8, 0.5, 0),
		Size = UDim2.new(0, 132, 0, 330),
		BackgroundTransparency = 1,
		Parent = screen,
	}, {
		Create("UIGridLayout", {
			CellSize = UDim2.new(0, 62, 0, 60),
			CellPadding = UDim2.new(0, 6, 0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	for order, info in ipairs(MENU_BUTTONS) do
		local name, icon, label, color = info[1], info[2], info[3], info[4]
		local button = UI.Button({
			Name = name,
			LayoutOrder = order,
			Color = UI.rgb(color),
			Text = "",
			Padding = 2,
			PaddingY = 2,
			Parent = holder,
		}, function()
			UI.Toggle(name)
		end)
		UI.Label({ Size = UDim2.new(1, 0, 0.62, 0), Text = icon, Parent = button })
		local text = UI.Label({ Position = UDim2.new(0, 0, 0.62, 0), Size = UDim2.new(1, 0, 0.38, 0), Text = label, Parent = button })
		UI.TextStroke(1.5).Parent = text

		local badge = Create("TextLabel", {
			Name = "Badge",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, -4, 0, 4),
			Size = UDim2.new(0, 22, 0, 22),
			BackgroundColor3 = UI.Colors.Red,
			Font = UI.Font,
			TextScaled = true,
			TextColor3 = UI.Colors.White,
			Text = "!",
			Visible = false,
			ZIndex = 3,
			Parent = button,
		}, { Create("UICorner", { CornerRadius = UDim.new(1, 0) }), UI.Stroke(2, UI.Colors.White) })
		badges[name] = badge
	end
end

local function buildRightSide(screen)
	autoButton = UI.Button({
		Name = "AutoSlap",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, -40),
		Size = UDim2.new(0, 120, 0, 50),
		Color = UI.Colors.Gray,
		Text = "🤖 Auto: OFF",
		Parent = screen,
	}, function()
		ctx.Request("ToggleAutoSlap")
	end)
	autoButton.Visible = false
end

local function buildBottom(screen)
	zoneLabel = UI.Label({
		Name = "Zone",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -8),
		Size = UDim2.new(0, 360, 0, 26),
		TextColor3 = UI.Colors.White,
		Text = "📍 Hub",
		Parent = screen,
	})
	UI.TextStroke(2).Parent = zoneLabel

	notifyHolder = Create("Frame", {
		Name = "Notifications",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -40),
		Size = UDim2.new(0.8, 0, 0, 170),
		BackgroundTransparency = 1,
		Parent = screen,
	}, {
		Create("UIListLayout", {
			Padding = UDim.new(0, 4),
			SortOrder = Enum.SortOrder.LayoutOrder,
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
		}),
		Create("UISizeConstraint", { MaxSize = Vector2.new(620, 170) }),
	})

	popupFrame = Create("Frame", {
		Name = "Popup",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.36),
		Size = UDim2.new(0.8, 0, 0, 110),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 20,
		Parent = screen,
	}, { Create("UISizeConstraint", { MaxSize = Vector2.new(640, 110) }) })
	popupScale = Create("UIScale", { Scale = 1, Parent = popupFrame })
	popupTitle = UI.Label({ Size = UDim2.new(1, 0, 0, 64), Text = "", ZIndex = 20, Parent = popupFrame })
	UI.TextStroke(3.5).Parent = popupTitle
	popupSub = UI.Label({ Position = UDim2.new(0, 0, 0, 66), Size = UDim2.new(1, 0, 0, 34), TextColor3 = UI.Colors.White, Text = "", ZIndex = 20, Parent = popupFrame })
	UI.TextStroke(2.5).Parent = popupSub
end

--------------------------------------------------------------------------
-- Oeffentliche Funktionen
--------------------------------------------------------------------------
function Hud.Notify(text, color)
	if type(text) ~= "string" then
		return
	end
	local textColor = UI.Colors.White
	if type(color) == "table" and #color == 3 then
		textColor = UI.rgb(color)
	end
	notifyCounter = notifyCounter + 1

	local existing = {}
	for _, child in ipairs(notifyHolder:GetChildren()) do
		if child:IsA("TextLabel") then
			table.insert(existing, child)
		end
	end
	table.sort(existing, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	while #existing >= 5 do
		table.remove(existing, 1):Destroy()
	end

	local label = Create("TextLabel", {
		LayoutOrder = notifyCounter,
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundColor3 = UI.Colors.Darker,
		BackgroundTransparency = 0.2,
		Font = UI.BodyFont,
		TextScaled = true,
		TextColor3 = textColor,
		Text = text,
		Parent = notifyHolder,
	}, { UI.Corner(10), UI.Padding(10, 4), UI.TextStroke(1.5) })
	local scale = Create("UIScale", { Scale = 0.6, Parent = label })
	TweenService:Create(scale, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()

	task.delay(4, function()
		if label.Parent then
			TweenService:Create(label, TweenInfo.new(0.5), { TextTransparency = 1, BackgroundTransparency = 1 }):Play()
			task.delay(0.55, function()
				label:Destroy()
			end)
		end
	end)
end

function Hud.Popup(title, subtitle, color)
	popupId = popupId + 1
	local myId = popupId
	popupTitle.Text = tostring(title)
	popupSub.Text = tostring(subtitle or "")
	popupTitle.TextColor3 = (type(color) == "table" and #color == 3) and UI.rgb(color) or UI.Colors.White
	popupTitle.TextTransparency = 0
	popupSub.TextTransparency = 0
	popupFrame.Visible = true
	popupScale.Scale = 0.3
	TweenService:Create(popupScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	task.delay(2.6, function()
		if popupId ~= myId then
			return
		end
		TweenService:Create(popupTitle, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
		TweenService:Create(popupSub, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
		task.delay(0.45, function()
			if popupId == myId then
				popupFrame.Visible = false
			end
		end)
	end)
end

function Hud.SetCombo(combo)
	combo = tonumber(combo) or 0
	comboValue = combo
	comboExpires = os.clock() + Config.ComboWindow
	if combo >= 2 then
		comboFrame.Visible = true
		comboLabel.Text = "🔥 " .. combo .. "x COMBO  +" .. math.floor(combo * Config.ComboBonusPerStack * 100 + 0.5) .. "%"
		local hue = math.clamp(0.12 - combo / 1000, 0, 0.12)
		comboLabel.TextColor3 = Color3.fromHSV(hue, 0.85, 1)
	end
end

function Hud.SetGoldenEvent(zoneIndex, endsAt)
	if zoneIndex then
		golden.ZoneIndex = zoneIndex
		golden.EndsAt = tonumber(endsAt) or 0
		eventBanner.Visible = true
	else
		golden.ZoneIndex = nil
		eventBanner.Visible = false
	end
end

function Hud.SetZone(index)
	if index == 0 then
		zoneLabel.Text = "📍 Hub - Spawn Area"
	else
		local zone = Config.Zones[index]
		zoneLabel.Text = "📍 Zone " .. index .. ": " .. (zone and zone.Name or "?")
	end
end

local function refreshBoosts(state)
	for _, child in ipairs(boostRow:GetChildren()) do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	if not state or type(state.Boosts) ~= "table" then
		return
	end
	local now = ctx.Now()
	for order, id in ipairs(Config.BoostOrder) do
		local expires = tonumber(state.Boosts[id]) or 0
		if expires > now then
			local boost = Config.Boosts[id]
			Create("TextLabel", {
				Name = id,
				LayoutOrder = order,
				Size = UDim2.new(0, 130, 1, 0),
				BackgroundColor3 = UI.Colors.Darker,
				BackgroundTransparency = 0.15,
				Font = UI.Font,
				TextScaled = true,
				TextColor3 = UI.rgb(boost.Color),
				Text = boost.Icon .. " " .. boost.DisplayName .. " " .. Calc.FormatTime(expires - now),
				Parent = boostRow,
			}, { UI.Corner(8), UI.Padding(6, 3), UI.Stroke(2, UI.rgb(boost.Color)) })
		end
	end
end

local function refreshBadges(state)
	if not state then
		return
	end
	local questReady = false
	if state.Quests and state.Quests.Day then
		local quests = Calc.GetQuests(state.Quests.Day, ctx.Player.UserId)
		for i, quest in ipairs(quests) do
			local progress = state.Quests.Progress and state.Quests.Progress[i] or 0
			local claimed = state.Quests.Claimed and state.Quests.Claimed[i]
			if not claimed and progress >= quest.Amount then
				questReady = true
			end
		end
	end
	badges.Quests.Visible = questReady
	local dailyReady = Calc.GetDailyStatus(state, ctx.Now())
	badges.Daily.Visible = dailyReady == true
	badges.Rebirth.Visible = (state.Slaps or 0) >= Calc.GetRebirthCost(state.Rebirths)
end

function Hud.Refresh(state)
	if not state then
		return
	end
	slapsLabel.Text = "👋 " .. Calc.FormatNumber(state.Slaps) .. " Slaps"
	gemsLabel.Text = "💎 " .. Calc.FormatNumber(state.Gems)
	if state.Upgrades then
		local now = ctx.Now()
		multiLabel.Text = "💪 " .. Calc.FormatNumber(Calc.GetDamage(state, now)) .. "   💰 " .. Calc.FormatMultiplier(Calc.GetSlapMultiplier(state, now))
	end
	local owned = state.GemShop and (state.GemShop.AutoSlap or 0) >= 1
	autoButton.Visible = owned == true
	if owned then
		autoButton.Text = state.AutoSlapOn and "🤖 Auto: ON" or "🤖 Auto: OFF"
		UI.SetButtonColor(autoButton, state.AutoSlapOn and UI.Colors.Green or UI.Colors.Gray)
	end
	refreshBadges(state)
	refreshBoosts(state)

	-- naechstes Ziel
	local zones = state.Zones or 1
	local nextZone = Config.Zones[zones + 1]
	if nextZone then
		hintLabel.Text = "🎯 Next goal: Zone " .. (zones + 1) .. " for " .. Calc.FormatNumber(nextZone.Price) .. " Slaps"
	else
		hintLabel.Text = "🎯 Next goal: Rebirth for " .. Calc.FormatNumber(Calc.GetRebirthCost(state.Rebirths)) .. " Slaps"
	end
end

local lastSlaps = nil
function Hud.Init(context)
	ctx = context
	UI = ctx.UI
	Config = ctx.Config
	Calc = ctx.Calc
	Create = UI.Create

	buildTop(ctx.Screen)
	buildMenuButtons(ctx.Screen)
	buildRightSide(ctx.Screen)
	buildBottom(ctx.Screen)

	ctx.OnState(function(state)
		Hud.Refresh(state)
		if lastSlaps and state.Slaps > lastSlaps then
			slapsLabel.TextColor3 = Color3.fromRGB(150, 255, 160)
			TweenService:Create(slapsLabel, TweenInfo.new(0.35), { TextColor3 = UI.Colors.White }):Play()
		end
		lastSlaps = state.Slaps
	end)

	-- Combo-Balken laufend leeren
	RunService.RenderStepped:Connect(function()
		if comboFrame.Visible then
			local remaining = comboExpires - os.clock()
			if remaining <= 0 then
				comboFrame.Visible = false
				comboValue = 0
			else
				UI.SetProgress(comboFill, remaining / Config.ComboWindow)
			end
		end
	end)

	-- Timer jede halbe Sekunde
	task.spawn(function()
		while true do
			task.wait(0.5)
			if golden.ZoneIndex then
				local remaining = golden.EndsAt - ctx.Now()
				if remaining < 0 then
					remaining = 0
				end
				eventLabel.Text = "⭐ GOLDEN GYATT in Zone " .. golden.ZoneIndex .. "!  " .. Calc.FormatTime(remaining)
			end
			if ctx.State then
				refreshBoosts(ctx.State)
				refreshBadges(ctx.State)
			end
		end
	end)
end

return Hud
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000020"><Properties><string name="Name">Menus</string><ProtectedString name="Source"><![CDATA[--[[
	Menus: alle Fenster.
	  Shop (Upgrades), Haende, Pets, Zonen, Gem-Shop, Rebirth,
	  Quests, Taegliche Belohnung, Codes, Optionen
]]

local Menus = {}
local ctx, UI, Config, Calc, Create, C

local function state()
	return ctx.State
end

local function smallLabel(props)
	props.Font = props.Font or UI.BodyFont
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	props.ZIndex = props.ZIndex or 6
	return UI.Label(props)
end

local function title(props)
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	props.ZIndex = props.ZIndex or 6
	local label = UI.Label(props)
	UI.TextStroke(1.5).Parent = label
	return label
end

local function money(amount, currency)
	return (currency == "Gems" and "💎 " or "👋 ") .. Calc.FormatNumber(amount)
end

--------------------------------------------------------------------------
-- Shop (Upgrades)
--------------------------------------------------------------------------
local function buildShop()
	local win = UI.CreateWindow(ctx.Screen, "Shop", "Hand Upgrades", "🛒", Vector2.new(580, 470))
	local list = UI.ScrollList(win.Content, {})
	local rows = {}
	for order, id in ipairs(Config.UpgradeOrder) do
		local upgrade = Config.Upgrades[id]
		local row = UI.Row(list, 92, order)
		title({ Position = UDim2.new(0, 12, 0, 6), Size = UDim2.new(0.58, -12, 0, 26), Text = upgrade.Icon .. " " .. upgrade.DisplayName, Parent = row })
		local level = smallLabel({ Position = UDim2.new(0, 12, 0, 33), Size = UDim2.new(0.58, -12, 0, 16), TextColor3 = UI.Colors.SubText, Parent = row })
		local stat = smallLabel({ Position = UDim2.new(0, 12, 0, 51), Size = UDim2.new(0.58, -12, 0, 16), TextColor3 = UI.Colors.Text, Parent = row })
		local _, fill = UI.ProgressBar({ Position = UDim2.new(0, 12, 0, 72), Size = UDim2.new(0.58, -12, 0, 10), Parent = row })
		local buy = UI.Button({
			Name = "Buy",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -10, 0, 8),
			Size = UDim2.new(0.4, -14, 0, 44),
			Color = UI.Colors.Green,
			ZIndex = 6,
			Parent = row,
		}, function()
			ctx.Request("BuyUpgrade", id)
		end)
		local max = UI.Button({
			Name = "Max",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -10, 0, 56),
			Size = UDim2.new(0.4, -14, 0, 28),
			Color = UI.Colors.Purple,
			Text = "Buy MAX",
			ZIndex = 6,
			Parent = row,
		}, function()
			ctx.Request("BuyUpgradeMax", id)
		end)
		rows[id] = { Level = level, Stat = stat, Fill = fill, Buy = buy, Max = max }
	end

	win.Refresh = function()
		local s = state()
		if not s or not s.Upgrades then
			return
		end
		for _, id in ipairs(Config.UpgradeOrder) do
			local row = rows[id]
			local upgrade = Config.Upgrades[id]
			local level = Calc.ClampLevel(id, s.Upgrades[id])
			local cost = Calc.GetUpgradeCost(id, level)
			row.Level.Text = "Level " .. level .. " / " .. upgrade.MaxLevel .. "  -  " .. upgrade.Description
			UI.SetProgress(row.Fill, level / upgrade.MaxLevel)
			if cost then
				row.Stat.Text = Calc.DescribeUpgrade(id, level) .. "  ➜  " .. Calc.DescribeUpgrade(id, level + 1)
				row.Buy.Text = money(cost, "Slaps")
				UI.SetButtonColor(row.Buy, s.Slaps >= cost and UI.Colors.Green or UI.Colors.Gray)
				row.Max.Visible = true
			else
				row.Stat.Text = Calc.DescribeUpgrade(id, level)
				row.Buy.Text = "MAX"
				UI.SetButtonColor(row.Buy, UI.Colors.Gold)
				row.Max.Visible = false
			end
		end
	end
	return win
end

--------------------------------------------------------------------------
-- Haende
--------------------------------------------------------------------------
local function buildHands()
	local win = UI.CreateWindow(ctx.Screen, "Hands", "Hands", "✋", Vector2.new(600, 490))
	local list = UI.ScrollList(win.Content, {})
	local rows = {}
	local effectNames = { sparkles = "Sparkles", fire = "Fire", smoke = "Frost Mist", rainbow = "Rainbow", dragon = "Dragon Fire", thanos = "Infinity Stones", ultragod = "Divine Aura" }
	for order, hand in ipairs(Config.Hands) do
		local rarity = Config.Rarities[hand.Rarity] or Config.Rarities.Common
		local rarityColor = UI.rgb(rarity.Color)
		local isUltra = hand.Currency == "Robux"
		local height = (hand.Perk and 104) or 84
		local row = UI.Row(list, height, order)
		if isUltra then
			row.BackgroundColor3 = Color3.fromRGB(70, 40, 20)
			UI.Create("UIGradient", {
				Color = ColorSequence.new(Color3.fromRGB(255, 230, 150), Color3.fromRGB(200, 120, 255)),
				Rotation = 0,
				Transparency = NumberSequence.new(0.6),
				Parent = row,
			})
		end
		local swatch = Create("Frame", {
			Position = UDim2.new(0, 10, 0, 12),
			Size = UDim2.new(0, 56, 0, 56),
			BackgroundColor3 = UI.rgb(hand.Color),
			ZIndex = 6,
			Parent = row,
		}, { UI.Corner(12), UI.Stroke(isUltra and 3.5 or 2, isUltra and UI.Colors.Gold or nil) })
		UI.Label({ Size = UDim2.fromScale(1, 1), Text = isUltra and (hand.Effect == "thanos" and "🫰" or "👑") or "✋", ZIndex = 7, Parent = swatch })

		title({ Position = UDim2.new(0, 76, 0, 6), Size = UDim2.new(0.58, -76, 0, 26), Text = hand.DisplayName, Parent = row })
		local badge = UI.Label({
			Position = UDim2.new(0, 76, 0, 34),
			Size = UDim2.new(0, 96, 0, 18),
			BackgroundTransparency = 0,
			BackgroundColor3 = rarityColor,
			Font = UI.Font,
			TextColor3 = Color3.fromRGB(30, 15, 35),
			Text = string.upper(rarity.DisplayName),
			ZIndex = 7,
			Parent = row,
		})
		UI.Corner(6).Parent = badge
		local effect = effectNames[hand.Effect] and ("  ✨ " .. effectNames[hand.Effect]) or ""
		smallLabel({ Position = UDim2.new(0, 178, 0, 34), Size = UDim2.new(0.58, -178, 0, 18), TextColor3 = UI.Colors.SubText, Text = effect, Parent = row })
		smallLabel({ Position = UDim2.new(0, 76, 0, 56), Size = UDim2.new(0.58, -76, 0, 18), TextColor3 = UI.Colors.Gold, Text = Calc.DescribeHandPerks(hand), Parent = row })
		if hand.Perk then
			smallLabel({ Position = UDim2.new(0, 10, 0, 78), Size = UDim2.new(1, -20, 0, 20), TextColor3 = Color3.fromRGB(255, 240, 160), Text = hand.Perk, Parent = row })
		end
		local button = UI.Button({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -10, 0, 14),
			Size = UDim2.new(0.36, -10, 0, 50),
			ZIndex = 6,
			Parent = row,
		}, function()
			local s = state()
			if s and Calc.OwnsHand(s, hand.Id) then
				ctx.Request("EquipHand", hand.Id)
			else
				ctx.Request("BuyHand", hand.Id)
			end
		end)
		rows[hand.Id] = { Row = row, Button = button }
	end

	win.Refresh = function()
		local s = state()
		if not s or not s.OwnedHands then
			return
		end
		for _, hand in ipairs(Config.Hands) do
			local r = rows[hand.Id]
			local stroke = r.Row:FindFirstChildOfClass("UIStroke")
			local isUltra = hand.Currency == "Robux"
			if stroke then
				stroke.Color = isUltra and UI.Colors.Gold or UI.Colors.PanelLight
			end
			if s.Hand == hand.Id then
				r.Button.Text = "✅ Equipped"
				UI.SetButtonColor(r.Button, UI.Colors.GreenDark)
				if stroke then
					stroke.Color = UI.Colors.White
				end
			elseif Calc.OwnsHand(s, hand.Id) then
				r.Button.Text = "Equip"
				UI.SetButtonColor(r.Button, UI.Colors.Blue)
			elseif isUltra then
				r.Button.Text = "R$ " .. hand.Price
				UI.SetButtonColor(r.Button, UI.Colors.Gold)
			else
				local balance = hand.Currency == "Gems" and s.Gems or s.Slaps
				r.Button.Text = money(hand.Price, hand.Currency)
				UI.SetButtonColor(r.Button, balance >= hand.Price and UI.Colors.Green or UI.Colors.Gray)
			end
		end
	end
	return win
end

--------------------------------------------------------------------------
-- Pets
--------------------------------------------------------------------------
local function buildPets()
	local win = UI.CreateWindow(ctx.Screen, "Pets", "Pets", "🐾", Vector2.new(620, 500))
	local header = smallLabel({ Size = UDim2.new(1, 0, 0, 22), TextColor3 = UI.Colors.Gold, Parent = win.Content })
	local buttons = Create("Frame", {
		Position = UDim2.new(0, 0, 0, 26),
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = win.Content,
	}, { UI.List(8, true) })
	UI.Button({ Size = UDim2.new(0, 170, 1, 0), Color = UI.Colors.Green, Text = "⭐ Equip Best", LayoutOrder = 1, ZIndex = 6, Parent = buttons }, function()
		ctx.Request("EquipBestPets")
	end)
	UI.Button({ Size = UDim2.new(0, 200, 1, 0), Color = UI.Colors.Red, Text = "🗑️ Delete Commons", LayoutOrder = 2, ZIndex = 6, Parent = buttons }, function()
		ctx.Request("DeleteRarity", "Common")
	end)

	local grid = UI.ScrollList(win.Content, {
		Position = UDim2.new(0, 0, 0, 68),
		Size = UDim2.new(1, 0, 1, -128),
		Grid = UDim2.new(0, 108, 0, 112),
	})

	-- Auswahl unten
	local detail = Create("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 54),
		BackgroundColor3 = UI.Colors.Panel,
		ZIndex = 5,
		Parent = win.Content,
	}, { UI.Corner(12) })
	local detailText = smallLabel({ Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(0.45, -10, 1, 0), Text = "Click a pet", Parent = detail })
	local selectedUid = nil
	local equipButton = UI.Button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -118, 0.5, 0), Size = UDim2.new(0, 140, 0, 40), Color = UI.Colors.Blue, Text = "Equip", ZIndex = 6, Parent = detail }, function()
		local s = state()
		if not selectedUid or not s then
			return
		end
		for _, pet in ipairs(s.Pets or {}) do
			if pet.Uid == selectedUid then
				ctx.Request(pet.Equipped and "UnequipPet" or "EquipPet", selectedUid)
				return
			end
		end
	end)
	local deleteButton = UI.Button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.new(0, 104, 0, 40), Color = UI.Colors.Red, Text = "🗑️ Delete", ZIndex = 6, Parent = detail }, function()
		if selectedUid then
			ctx.Request("DeletePet", selectedUid)
			selectedUid = nil
		end
	end)

	local function refreshDetail(s)
		local selected = nil
		for _, pet in ipairs(s.Pets or {}) do
			if pet.Uid == selectedUid then
				selected = pet
			end
		end
		if not selected then
			selectedUid = nil
			detailText.Text = "Click a pet"
			equipButton.Visible = false
			deleteButton.Visible = false
			return
		end
		local cfg = Config.Pets[selected.Id]
		local rarity = Config.Rarities[cfg.Rarity]
		detailText.Text = cfg.DisplayName .. " (" .. rarity.DisplayName .. ")  +" .. Calc.FormatNumber(math.floor(cfg.Boost * 100)) .. "% Slaps"
		detailText.TextColor3 = UI.rgb(rarity.Color)
		equipButton.Visible = true
		deleteButton.Visible = not selected.Equipped
		equipButton.Text = selected.Equipped and "Unequip" or "Equip"
		UI.SetButtonColor(equipButton, selected.Equipped and UI.Colors.Gray or UI.Colors.Blue)
	end

	local lastSignature = nil
	win.Refresh = function()
		local s = state()
		if not s or not s.Pets then
			return
		end
		local equipped = Calc.GetEquippedPetIds(s)
		header.Text = "🐾 Equipped: " .. #equipped .. "/" .. Calc.GetPetSlots(s)
			.. "    🎒 " .. #s.Pets .. "/" .. Calc.GetInventorySize(s)
			.. "    💰 Pet Bonus: " .. Calc.FormatMultiplier(Calc.GetPetBoost(equipped))

		-- Karten nur neu bauen, wenn sich die Pets geaendert haben
		local parts = {}
		for _, pet in ipairs(s.Pets) do
			table.insert(parts, pet.Uid .. (pet.Equipped and "E" or "") .. ((pet.Uid == selectedUid) and "S" or ""))
		end
		local signature = table.concat(parts, ",")
		if signature ~= lastSignature then
			lastSignature = signature
			for _, child in ipairs(grid:GetChildren()) do
				if child:IsA("TextButton") then
					child:Destroy()
				end
			end
			local sorted = {}
			for _, pet in ipairs(s.Pets) do
				table.insert(sorted, pet)
			end
			table.sort(sorted, function(a, b)
				if a.Equipped ~= b.Equipped then
					return a.Equipped
				end
				local ba, bb = Config.Pets[a.Id].Boost, Config.Pets[b.Id].Boost
				if ba ~= bb then
					return ba > bb
				end
				return a.Uid < b.Uid
			end)
			for order, pet in ipairs(sorted) do
				local cfg = Config.Pets[pet.Id]
				local rarity = Config.Rarities[cfg.Rarity]
				local card = Create("TextButton", {
					Name = "Pet_" .. pet.Uid,
					LayoutOrder = order,
					BackgroundColor3 = UI.Colors.Panel,
					AutoButtonColor = true,
					Text = "",
					ZIndex = 6,
					Parent = grid,
				}, {
					UI.Corner(12),
					UI.Stroke(pet.Uid == selectedUid and 4 or 2.5, pet.Uid == selectedUid and UI.Colors.White or UI.rgb(rarity.Color)),
				})
				local face = Create("Frame", {
					AnchorPoint = Vector2.new(0.5, 0),
					Position = UDim2.new(0.5, 0, 0, 8),
					Size = UDim2.new(0, 44, 0, 44),
					BackgroundColor3 = UI.rgb(cfg.Color),
					ZIndex = 7,
					Parent = card,
				}, { Create("UICorner", { CornerRadius = UDim.new(1, 0) }), UI.Stroke(2) })
				UI.Label({ Size = UDim2.fromScale(1, 1), Text = "👀", ZIndex = 8, Parent = face })
				local nameLabel = UI.Label({ Position = UDim2.new(0, 4, 0, 54), Size = UDim2.new(1, -8, 0, 20), Text = cfg.DisplayName, ZIndex = 7, Parent = card })
				UI.TextStroke(1).Parent = nameLabel
				UI.Label({ Position = UDim2.new(0, 4, 0, 74), Size = UDim2.new(1, -8, 0, 16), Font = UI.BodyFont, TextColor3 = UI.rgb(rarity.Color), Text = rarity.DisplayName, ZIndex = 7, Parent = card })
				UI.Label({ Position = UDim2.new(0, 4, 0, 90), Size = UDim2.new(1, -8, 0, 16), Font = UI.BodyFont, TextColor3 = UI.Colors.Gold, Text = "+" .. Calc.FormatNumber(math.floor(cfg.Boost * 100)) .. "%", ZIndex = 7, Parent = card })
				if pet.Equipped then
					UI.Label({ Position = UDim2.new(0, 4, 0, 4), Size = UDim2.new(0, 22, 0, 22), Text = "✅", ZIndex = 8, Parent = card })
				end
				card.Activated:Connect(function()
					selectedUid = pet.Uid
					ctx.PlaySound("Click")
					lastSignature = nil
					win.Refresh()
				end)
			end
		end
		refreshDetail(s)
	end
	return win
end

--------------------------------------------------------------------------
-- Zonen
--------------------------------------------------------------------------
local function buildZones()
	local win = UI.CreateWindow(ctx.Screen, "Zones", "Zones & Teleport", "🗺️", Vector2.new(580, 480))
	local list = UI.ScrollList(win.Content, {})
	local hubRow = UI.Row(list, 56, 0)
	title({ Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(0.6, -12, 1, 0), Text = "🏠 Hub (Spawn, Arena, Leaderboards)", Parent = hubRow })
	UI.Button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.new(0.35, 0, 0, 40), Color = UI.Colors.Blue, Text = "Teleport", ZIndex = 6, Parent = hubRow }, function()
		ctx.Request("Teleport", 0)
		UI.Close("Zones")
	end)
	local rows = {}
	for index, zone in ipairs(Config.Zones) do
		local row = UI.Row(list, 76, index)
		Create("Frame", { Position = UDim2.new(0, 0, 0, 0), Size = UDim2.new(0, 10, 1, 0), BackgroundColor3 = UI.rgb(zone.Accent), ZIndex = 6, Parent = row }, { UI.Corner(8) })
		title({ Position = UDim2.new(0, 18, 0, 6), Size = UDim2.new(0.6, -18, 0, 28), Text = "Zone " .. index .. ": " .. zone.Name, Parent = row })
		local names = {}
		for _, g in ipairs(zone.Gyatts) do
			table.insert(names, g.DisplayName)
		end
		local egg = Config.Eggs[zone.Egg]
		smallLabel({ Position = UDim2.new(0, 18, 0, 36), Size = UDim2.new(0.6, -18, 0, 16), TextColor3 = UI.Colors.SubText, Text = table.concat(names, " & ") .. "  •  " .. (egg and egg.DisplayName or ""), Parent = row })
		local status = smallLabel({ Position = UDim2.new(0, 18, 0, 54), Size = UDim2.new(0.6, -18, 0, 16), Parent = row })
		local button = UI.Button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.new(0.35, 0, 0, 46), ZIndex = 6, Parent = row }, function()
			local s = state()
			if s and index <= (s.Zones or 1) then
				ctx.Request("Teleport", index)
				UI.Close("Zones")
			else
				ctx.Request("UnlockZone", index)
			end
		end)
		rows[index] = { Status = status, Button = button }
	end
	win.Refresh = function()
		local s = state()
		if not s then
			return
		end
		local unlocked = s.Zones or 1
		for index, zone in ipairs(Config.Zones) do
			local r = rows[index]
			if index <= unlocked then
				r.Status.Text = "✅ Unlocked"
				r.Status.TextColor3 = UI.Colors.Green
				r.Button.Text = "Teleport"
				UI.SetButtonColor(r.Button, UI.Colors.Blue)
			elseif index == unlocked + 1 then
				r.Status.Text = "🔒 Unlock for " .. money(zone.Price, "Slaps")
				r.Status.TextColor3 = UI.Colors.Gold
				r.Button.Text = money(zone.Price, "Slaps")
				UI.SetButtonColor(r.Button, s.Slaps >= zone.Price and UI.Colors.Green or UI.Colors.Gray)
			else
				r.Status.Text = "🔒 Unlock Zone " .. (index - 1) .. " first"
				r.Status.TextColor3 = UI.Colors.SubText
				r.Button.Text = "🔒"
				UI.SetButtonColor(r.Button, UI.Colors.Gray)
			end
		end
	end
	return win
end

--------------------------------------------------------------------------
-- Gem-Shop
--------------------------------------------------------------------------
local function buildGems()
	local win = UI.CreateWindow(ctx.Screen, "Gems", "Gem Shop", "💎", Vector2.new(580, 470))
	local balance = smallLabel({ Size = UDim2.new(1, 0, 0, 24), TextColor3 = Color3.fromRGB(140, 220, 255), Parent = win.Content })
	local list = UI.ScrollList(win.Content, { Position = UDim2.new(0, 0, 0, 30), Size = UDim2.new(1, 0, 1, -30) })
	local rows = {}
	for order, item in ipairs(Config.GemShop) do
		local row = UI.Row(list, 72, order)
		title({ Position = UDim2.new(0, 12, 0, 6), Size = UDim2.new(0.6, -12, 0, 28), Text = item.Icon .. " " .. item.DisplayName, Parent = row })
		local desc = smallLabel({ Position = UDim2.new(0, 12, 0, 38), Size = UDim2.new(0.6, -12, 0, 26), TextColor3 = UI.Colors.SubText, TextWrapped = true, Text = item.Description, Parent = row })
		local button = UI.Button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.new(0.35, 0, 0, 46), ZIndex = 6, Parent = row }, function()
			ctx.Request("BuyGemItem", item.Id)
		end)
		rows[item.Id] = { Button = button, Desc = desc }
	end
	smallLabel({ Size = UDim2.new(1, -10, 0, 40), LayoutOrder = 100, TextWrapped = true, TextColor3 = UI.Colors.SubText,
		Text = "💡 You get Gems from defeated Gyatts, quests, daily rewards, codes, rebirths and the Golden Gyatt!", Parent = list })

	win.Refresh = function()
		local s = state()
		if not s or not s.GemShop then
			return
		end
		balance.Text = "Your Gems: 💎 " .. Calc.FormatNumber(s.Gems)
		local now = ctx.Now()
		for _, item in ipairs(Config.GemShop) do
			local r = rows[item.Id]
			local owned = s.GemShop[item.Id] or 0
			local price = Calc.GetGemItemPrice(item.Id, owned)
			local extra = ""
			if item.Boost and s.Boosts then
				local left = (tonumber(s.Boosts[item.Boost]) or 0) - now
				if left > 0 then
					extra = "  ⏱️ active: " .. Calc.FormatTime(left)
				end
			elseif not item.Repeatable then
				extra = "  (" .. owned .. "/" .. #item.Prices .. ")"
			end
			r.Desc.Text = item.Description .. extra
			if price then
				r.Button.Text = "💎 " .. Calc.FormatNumber(price)
				UI.SetButtonColor(r.Button, s.Gems >= price and UI.Colors.Green or UI.Colors.Gray)
			else
				r.Button.Text = "✅ Bought"
				UI.SetButtonColor(r.Button, UI.Colors.Gold)
			end
		end
	end
	return win
end

--------------------------------------------------------------------------
-- Rebirth
--------------------------------------------------------------------------
local function buildRebirth()
	local win = UI.CreateWindow(ctx.Screen, "Rebirth", "Rebirth", "♻️", Vector2.new(520, 400))
	local info = smallLabel({ Size = UDim2.new(1, 0, 0, 170), TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, TextScaled = true, Parent = win.Content })
	local _, fill = UI.ProgressBar({ Position = UDim2.new(0, 0, 0, 182), Size = UDim2.new(1, 0, 0, 22), Color = UI.Colors.Purple, Parent = win.Content })
	local progressText = UI.Label({ Position = UDim2.new(0, 0, 0, 182), Size = UDim2.new(1, 0, 0, 22), ZIndex = 8, Text = "", Parent = win.Content })
	UI.TextStroke(1.5).Parent = progressText
	local button = UI.Button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -6),
		Size = UDim2.new(0.8, 0, 0, 60),
		Color = UI.Colors.Purple,
		ZIndex = 6,
		Parent = win.Content,
	}, function()
		ctx.Request("Rebirth")
	end)
	win.Refresh = function()
		local s = state()
		if not s then
			return
		end
		local cost = Calc.GetRebirthCost(s.Rebirths)
		local nextCount = (s.Rebirths or 0) + 1
		info.Text = "You have " .. (s.Rebirths or 0) .. " rebirths.\n\n"
			.. "A rebirth resets your Slaps, upgrades and zones.\n"
			.. "Hands, pets and Gems are kept!\n\n"
			.. "After that, forever:\n"
			.. "💰 " .. Calc.FormatMultiplier(Calc.GetRebirthSlapMultiplier(nextCount)) .. " Slaps   "
			.. "💪 " .. Calc.FormatMultiplier(Calc.GetRebirthDamageMultiplier(nextCount)) .. " Damage   "
			.. "💎 +" .. Calc.GetRebirthGems(nextCount) .. " Gems"
		UI.SetProgress(fill, s.Slaps / cost)
		progressText.Text = Calc.FormatNumber(s.Slaps) .. " / " .. Calc.FormatNumber(cost)
		if s.Slaps >= cost then
			button.Text = "♻️ REBIRTH NOW!"
			UI.SetButtonColor(button, UI.Colors.Purple)
		else
			button.Text = "Need " .. money(cost - s.Slaps, "Slaps")
			UI.SetButtonColor(button, UI.Colors.Gray)
		end
	end
	return win
end

--------------------------------------------------------------------------
-- Quests
--------------------------------------------------------------------------
local function buildQuests()
	local win = UI.CreateWindow(ctx.Screen, "Quests", "Daily Quests", "📜", Vector2.new(560, 400))
	local timer = smallLabel({ Size = UDim2.new(1, 0, 0, 22), TextColor3 = UI.Colors.SubText, Parent = win.Content })
	local list = UI.ScrollList(win.Content, { Position = UDim2.new(0, 0, 0, 28), Size = UDim2.new(1, 0, 1, -28) })
	local rows = {}
	for i = 1, Config.QuestsPerDay do
		local row = UI.Row(list, 84, i)
		local text = title({ Position = UDim2.new(0, 12, 0, 8), Size = UDim2.new(0.6, -12, 0, 26), Parent = row })
		local reward = smallLabel({ Position = UDim2.new(0, 12, 0, 36), Size = UDim2.new(0.6, -12, 0, 16), TextColor3 = Color3.fromRGB(140, 220, 255), Parent = row })
		local _, fill = UI.ProgressBar({ Position = UDim2.new(0, 12, 0, 58), Size = UDim2.new(0.6, -12, 0, 16), Color = UI.Colors.Gold, Parent = row })
		local progress = UI.Label({ Position = UDim2.new(0, 12, 0, 58), Size = UDim2.new(0.6, -12, 0, 16), ZIndex = 8, Font = UI.BodyFont, Parent = row })
		local button = UI.Button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.new(0.34, 0, 0, 46), ZIndex = 6, Parent = row }, function()
			ctx.Request("ClaimQuest", i)
		end)
		rows[i] = { Text = text, Reward = reward, Fill = fill, Progress = progress, Button = button }
	end
	win.Refresh = function()
		local s = state()
		if not s or not s.Quests then
			return
		end
		local now = ctx.Now()
		local secondsLeft = 86400 - (now % 86400)
		timer.Text = "⏱️ New quests in " .. Calc.FormatTime(secondsLeft)
		local quests = Calc.GetQuests(s.Quests.Day, ctx.Player.UserId)
		for i, quest in ipairs(quests) do
			local r = rows[i]
			if r then
				local value = (s.Quests.Progress and s.Quests.Progress[i]) or 0
				local claimed = s.Quests.Claimed and s.Quests.Claimed[i]
				r.Text.Text = quest.Text
				r.Reward.Text = "Reward: 💎 " .. quest.Gems
				UI.SetProgress(r.Fill, value / quest.Amount)
				r.Progress.Text = Calc.FormatNumber(value) .. " / " .. Calc.FormatNumber(quest.Amount)
				if claimed then
					r.Button.Text = "✅ Done"
					UI.SetButtonColor(r.Button, UI.Colors.GreenDark)
				elseif value >= quest.Amount then
					r.Button.Text = "🎁 Claim!"
					UI.SetButtonColor(r.Button, UI.Colors.Green)
				else
					r.Button.Text = "In progress..."
					UI.SetButtonColor(r.Button, UI.Colors.Gray)
				end
			end
		end
	end
	return win
end

--------------------------------------------------------------------------
-- Taegliche Belohnung
--------------------------------------------------------------------------
local function buildDaily()
	local win = UI.CreateWindow(ctx.Screen, "Daily", "Daily Reward", "🎁", Vector2.new(600, 380))
	local grid = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 200),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = win.Content,
	}, {
		Create("UIGridLayout", { CellSize = UDim2.new(0.23, 0, 0, 92), CellPadding = UDim2.new(0.02, 0, 0, 8), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center }),
	})
	local cards = {}
	for day, reward in ipairs(Config.DailyRewards) do
		local card = Create("Frame", { LayoutOrder = day, BackgroundColor3 = UI.Colors.Panel, ZIndex = 6, Parent = grid }, { UI.Corner(12), UI.Stroke(2.5, UI.Colors.PanelLight) })
		title({ Size = UDim2.new(1, 0, 0, 24), Position = UDim2.new(0, 0, 0, 4), TextXAlignment = Enum.TextXAlignment.Center, Text = "Day " .. day, Parent = card })
		local text = "💎 " .. reward.Gems
		if reward.Boost then
			text = text .. "\n" .. Config.Boosts[reward.Boost].Icon .. " " .. Calc.FormatTime(reward.Duration)
		end
		smallLabel({ Position = UDim2.new(0, 4, 0, 30), Size = UDim2.new(1, -8, 0, 54), TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = true, Text = text, Parent = card })
		cards[day] = card
	end
	local status = smallLabel({ Position = UDim2.new(0, 0, 0, 206), Size = UDim2.new(1, 0, 0, 24), TextXAlignment = Enum.TextXAlignment.Center, Parent = win.Content })
	local button = UI.Button({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -4), Size = UDim2.new(0.6, 0, 0, 54), Color = UI.Colors.Green, ZIndex = 6, Parent = win.Content }, function()
		ctx.Request("ClaimDaily")
	end)
	win.Refresh = function()
		local s = state()
		if not s then
			return
		end
		local canClaim, day, waitSeconds = Calc.GetDailyStatus(s, ctx.Now())
		local streak = (s.Daily and s.Daily.Streak) or 0
		for d, card in ipairs(cards) do
			local stroke = card:FindFirstChildOfClass("UIStroke")
			local claimedAlready = (not canClaim and d <= streak) or (canClaim and d < day)
			if (canClaim and d == day) then
				card.BackgroundColor3 = UI.Colors.GreenDark
				if stroke then
					stroke.Color = UI.Colors.Gold
				end
			elseif claimedAlready then
				card.BackgroundColor3 = UI.Colors.Darker
				if stroke then
					stroke.Color = UI.Colors.Green
				end
			else
				card.BackgroundColor3 = UI.Colors.Panel
				if stroke then
					stroke.Color = UI.Colors.PanelLight
				end
			end
		end
		if canClaim then
			status.Text = "Streak: Day " .. day .. " is ready!"
			button.Text = "🎁 Claim!"
			UI.SetButtonColor(button, UI.Colors.Green)
		else
			status.Text = "Streak: " .. streak .. " days  •  Next reward in " .. Calc.FormatTime(waitSeconds)
			button.Text = "⏱️ " .. Calc.FormatTime(waitSeconds)
			UI.SetButtonColor(button, UI.Colors.Gray)
		end
	end
	return win
end

--------------------------------------------------------------------------
-- Codes
--------------------------------------------------------------------------
local function buildCodes()
	local win = UI.CreateWindow(ctx.Screen, "Codes", "Codes", "🎟️", Vector2.new(480, 300))
	smallLabel({ Size = UDim2.new(1, 0, 0, 26), TextXAlignment = Enum.TextXAlignment.Center, Text = "Enter a code and get rewards!", Parent = win.Content })
	local box = Create("TextBox", {
		Position = UDim2.new(0.1, 0, 0, 40),
		Size = UDim2.new(0.8, 0, 0, 54),
		BackgroundColor3 = UI.Colors.Darker,
		Font = UI.Font,
		TextScaled = true,
		TextColor3 = UI.Colors.White,
		PlaceholderText = "Enter code here...",
		PlaceholderColor3 = UI.Colors.SubText,
		Text = "",
		ClearTextOnFocus = false,
		ZIndex = 6,
		Parent = win.Content,
	}, { UI.Corner(12), UI.Stroke(3, UI.Colors.Pink), UI.Padding(10, 8) })
	UI.Button({ Position = UDim2.new(0.25, 0, 0, 108), Size = UDim2.new(0.5, 0, 0, 52), Color = UI.Colors.Green, Text = "✅ Redeem", ZIndex = 6, Parent = win.Content }, function()
		if #box.Text > 0 then
			ctx.Request("RedeemCode", box.Text)
			box.Text = ""
		end
	end)
	smallLabel({ Position = UDim2.new(0, 0, 0, 172), Size = UDim2.new(1, 0, 0, 40), TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = true, TextColor3 = UI.Colors.Gold,
		Text = "💡 Tip: Try GYATT, SLAP or RELEASE!", Parent = win.Content })
	return win
end

--------------------------------------------------------------------------
-- Optionen & Statistik
--------------------------------------------------------------------------
local SETTING_TEXT = {
	{ "Sounds", "🔊 Sounds" },
	{ "DamageNumbers", "🔢 Damage Numbers" },
	{ "Shake", "📳 Camera Shake" },
	{ "OtherPets", "🐾 Other Players' Pets" },
}

local function buildSettings()
	local win = UI.CreateWindow(ctx.Screen, "Settings", "Settings & Stats", "⚙️", Vector2.new(540, 470))
	local list = UI.ScrollList(win.Content, {})
	local toggles = {}
	for order, info in ipairs(SETTING_TEXT) do
		local name, text = info[1], info[2]
		local row = UI.Row(list, 56, order)
		title({ Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(0.6, -12, 1, 0), Text = text, Parent = row })
		toggles[name] = UI.Button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.new(0, 110, 0, 40), ZIndex = 6, Parent = row }, function()
			ctx.Request("SetSetting", name, not ctx.Setting(name))
		end)
	end
	local statsRow = UI.Row(list, 190, 10)
	local stats = smallLabel({ Position = UDim2.new(0, 12, 0, 8), Size = UDim2.new(1, -24, 1, -16), TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Parent = statsRow })
	win.Refresh = function()
		local s = state()
		if not s then
			return
		end
		for name, button in pairs(toggles) do
			local on = ctx.Setting(name)
			button.Text = on and "AN" or "AUS"
			UI.SetButtonColor(button, on and UI.Colors.Green or UI.Colors.Gray)
		end
		local hand = Calc.GetHand(s.Hand)
		stats.Text = "📊 YOUR STATS\n"
			.. "👋 Total slaps: " .. Calc.FormatNumber(s.TotalSlaps) .. "\n"
			.. "💰 Total earned: " .. Calc.FormatNumber(s.TotalEarned) .. "\n"
			.. "💥 Gyatts defeated: " .. Calc.FormatNumber(s.TotalDefeats) .. "\n"
			.. "🔥 Best combo: " .. Calc.FormatNumber(s.BestCombo) .. "\n"
			.. "♻️ Rebirths: " .. tostring(s.Rebirths) .. "\n"
			.. "✋ Hand: " .. hand.DisplayName .. "   🐾 Pets: " .. #(s.Pets or {}) .. "\n"
			.. "⏱️ Playtime: " .. Calc.FormatTime(s.PlayTime or 0)
	end
	return win
end

--------------------------------------------------------------------------
function Menus.Init(context)
	ctx = context
	UI = ctx.UI
	Config = ctx.Config
	Calc = ctx.Calc
	Create = UI.Create
	C = UI.Colors

	buildShop()
	buildHands()
	buildPets()
	buildZones()
	buildGems()
	buildRebirth()
	buildQuests()
	buildDaily()
	buildCodes()
	buildSettings()

	-- offenes Fenster bei jeder Aenderung aktualisieren
	ctx.OnState(function()
		local open = UI.OpenWindow
		if open and UI.Windows[open] and UI.Windows[open].Refresh then
			UI.Windows[open].Refresh()
		end
	end)
	-- Timer in offenen Fenstern weiterlaufen lassen
	task.spawn(function()
		while true do
			task.wait(1)
			local open = UI.OpenWindow
			if (open == "Daily" or open == "Quests" or open == "Gems") and UI.Windows[open].Refresh and ctx.State then
				UI.Windows[open].Refresh()
			end
		end
	end)
end

return Menus
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000021"><Properties><string name="Name">PetsFx</string><ProtectedString name="Source"><![CDATA[--[[
	PetsFx: baut kleine Pet-Modelle und laesst sie hinter ihren Besitzern
	herschweben. Laeuft nur lokal (fluessig und ohne Server-Last).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local PetsFx = {}
local ctx, Config, UI

local folder
local owners = {} -- [Player] = { Signature, Pets = { {Model, Current} } }

local function newPart(model, name, size, color, shape, mat)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.Color = color
	p.Material = mat or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		p.Shape = shape
	end
	p.Parent = model
	return p
end

-- Pet-Modell bauen. Alles relativ zum Koerper (Vorderseite = -Z).
local function buildPet(petId)
	local cfg = Config.Pets[petId]
	local rarity = Config.Rarities[cfg.Rarity]
	local color = UI.rgb(cfg.Color)
	local style = cfg.Style
	local model = Instance.new("Model")
	model.Name = "Pet_" .. petId

	local bodySize = 1.9
	local body
	if style == "robot" then
		body = newPart(model, "Body", Vector3.new(1.8, 1.6, 1.8), color, nil, Enum.Material.DiamondPlate)
	elseif style == "whale" then
		body = newPart(model, "Body", Vector3.new(1.8, 1.6, 2.8), color, nil)
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = body
	elseif style == "slime" then
		body = newPart(model, "Body", Vector3.new(2, 1.4, 2), color, nil, Enum.Material.Glass)
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = body
		body.Transparency = 0.15
	else
		body = newPart(model, "Body", Vector3.new(bodySize, bodySize, bodySize), color, Enum.PartType.Ball)
	end
	if style == "ghost" then
		body.Transparency = 0.25
		body.Material = Enum.Material.Neon
	end
	model.PrimaryPart = body
	local base = body.CFrame

	local white = Color3.fromRGB(255, 255, 255)
	local black = Color3.fromRGB(20, 15, 25)
	local front = -body.Size.Z / 2

	-- Augen
	for _, side in ipairs({ -1, 1 }) do
		newPart(model, "Eye", Vector3.new(0.45, 0.45, 0.45), white, Enum.PartType.Ball).CFrame = base * CFrame.new(side * 0.38, 0.25, front + 0.12)
		newPart(model, "Pupil", Vector3.new(0.24, 0.24, 0.24), black, Enum.PartType.Ball).CFrame = base * CFrame.new(side * 0.38, 0.25, front - 0.04)
	end
	newPart(model, "Mouth", Vector3.new(0.35, 0.08, 0.08), black).CFrame = base * CFrame.new(0, -0.15, front + 0.02)

	local accent = UI.Lighten(color, 0.15)
	if style == "cat" or style == "dog" or style == "bear" or style == "bunny" then
		for _, side in ipairs({ -1, 1 }) do
			local ear
			if style == "bunny" then
				ear = newPart(model, "Ear", Vector3.new(0.3, 1.2, 0.2), accent)
				ear.CFrame = base * CFrame.new(side * 0.35, 1.3, 0) * CFrame.Angles(0, 0, side * -0.15)
			elseif style == "cat" then
				ear = newPart(model, "Ear", Vector3.new(0.45, 0.6, 0.2), accent)
				ear.CFrame = base * CFrame.new(side * 0.5, 0.9, 0) * CFrame.Angles(0, 0, side * -0.4)
			elseif style == "dog" then
				ear = newPart(model, "Ear", Vector3.new(0.35, 0.8, 0.2), UI.Lighten(color, -0.15))
				ear.CFrame = base * CFrame.new(side * 0.85, 0.25, 0) * CFrame.Angles(0, 0, side * 0.3)
			else
				ear = newPart(model, "Ear", Vector3.new(0.5, 0.5, 0.5), accent, Enum.PartType.Ball)
				ear.CFrame = base * CFrame.new(side * 0.65, 0.75, 0)
			end
		end
		if style == "dog" or style == "bear" then
			newPart(model, "Nose", Vector3.new(0.25, 0.2, 0.2), black, Enum.PartType.Ball).CFrame = base * CFrame.new(0, 0.02, front - 0.05)
		end
	elseif style == "dragon" or style == "bird" then
		for _, side in ipairs({ -1, 1 }) do
			local wing = newPart(model, "Wing", Vector3.new(1.4, 0.15, 0.9), accent, nil, Enum.Material.Neon)
			wing.CFrame = base * CFrame.new(side * 1.2, 0.3, 0.3) * CFrame.Angles(0, 0, side * 0.4)
			wing.Transparency = 0.2
		end
		if style == "dragon" then
			for _, side in ipairs({ -1, 1 }) do
				newPart(model, "Horn", Vector3.new(0.2, 0.6, 0.2), Color3.fromRGB(255, 240, 200)).CFrame = base * CFrame.new(side * 0.4, 1, 0.1) * CFrame.Angles(-0.3, 0, side * -0.2)
			end
		else
			newPart(model, "Beak", Vector3.new(0.3, 0.2, 0.4), Color3.fromRGB(255, 180, 40)).CFrame = base * CFrame.new(0, 0, front - 0.15)
		end
	elseif style == "unicorn" then
		newPart(model, "Horn", Vector3.new(0.22, 0.9, 0.22), Color3.fromRGB(255, 230, 120), nil, Enum.Material.Neon).CFrame = base * CFrame.new(0, 1.15, -0.35) * CFrame.Angles(-0.4, 0, 0)
		newPart(model, "Mane", Vector3.new(0.3, 0.9, 1.2), Color3.fromRGB(170, 120, 255)).CFrame = base * CFrame.new(0, 0.8, 0.4)
	elseif style == "alien" or style == "robot" then
		for _, side in ipairs({ -1, 1 }) do
			newPart(model, "Antenna", Vector3.new(0.1, 0.7, 0.1), Color3.fromRGB(80, 80, 90)).CFrame = base * CFrame.new(side * 0.35, 1.15, 0)
			newPart(model, "AntennaTip", Vector3.new(0.3, 0.3, 0.3), Color3.fromRGB(120, 255, 120), Enum.PartType.Ball, Enum.Material.Neon).CFrame = base * CFrame.new(side * 0.35, 1.55, 0)
		end
	elseif style == "whale" then
		newPart(model, "Tail", Vector3.new(1.4, 0.15, 0.6), accent).CFrame = base * CFrame.new(0, 0.3, 1.6)
		local spout = newPart(model, "Spout", Vector3.new(0.25, 0.25, 0.25), Color3.fromRGB(150, 220, 255), Enum.PartType.Ball, Enum.Material.Neon)
		spout.CFrame = base * CFrame.new(0, 1.05, 0.2)
	elseif style == "ghost" then
		local crown = newPart(model, "Halo", Vector3.new(0.1, 1.1, 1.1), Color3.fromRGB(255, 230, 100), Enum.PartType.Cylinder, Enum.Material.Neon)
		crown.CFrame = base * CFrame.new(0, 1.3, 0) * CFrame.Angles(0, 0, math.rad(90))
	end

	-- Glanz fuer seltene Pets
	if cfg.Rarity == "Legendary" or cfg.Rarity == "Mythic" then
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = UI.rgb(rarity.Color)
		sparkles.Parent = body
	end
	if cfg.Rarity ~= "Common" then
		local light = Instance.new("PointLight")
		light.Color = UI.rgb(rarity.Color)
		light.Range = 6
		light.Brightness = 0.8
		light.Parent = body
	end

	local billboard = UI.Create("BillboardGui", {
		Adornee = body,
		Size = UDim2.new(4, 0, 0.8, 0),
		StudsOffsetWorldSpace = Vector3.new(0, 1.7, 0),
		MaxDistance = 45,
		LightInfluence = 0,
		Parent = body,
	})
	UI.Create("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = UI.Font,
		TextScaled = true,
		TextColor3 = UI.rgb(rarity.Color),
		TextStrokeTransparency = 0,
		Text = cfg.DisplayName,
		Parent = billboard,
	})

	model.Parent = folder
	return model
end

local function clearOwner(owner)
	local entry = owners[owner]
	if entry then
		for _, pet in ipairs(entry.Pets) do
			pet.Model:Destroy()
		end
		owners[owner] = nil
	end
end

local function syncOwner(owner)
	local signature = owner:GetAttribute("EquippedPets") or ""
	if owner ~= Players.LocalPlayer and not ctx.Setting("OtherPets") then
		signature = ""
	end
	local entry = owners[owner]
	if entry and entry.Signature == signature then
		return
	end
	clearOwner(owner)
	entry = { Signature = signature, Pets = {} }
	owners[owner] = entry
	for petId in string.gmatch(signature, "[^,]+") do
		if Config.Pets[petId] then
			table.insert(entry.Pets, { Model = buildPet(petId), Current = nil, Phase = math.random() * 6 })
		end
	end
end

local function animate(dt)
	local t = os.clock()
	local alpha = math.min(1, dt * 7)
	for owner, entry in pairs(owners) do
		local character = owner.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and owner.Parent then
			local count = #entry.Pets
			for i, pet in ipairs(entry.Pets) do
				local spread = (i - (count + 1) / 2) * 3.2
				local row = math.floor((i - 1) / 4)
				local offset = CFrame.new(spread, 0.6 + math.sin(t * 3 + pet.Phase) * 0.35, 4.5 + row * 3)
				local target = root.CFrame * offset
				local look = target.Position + root.CFrame.LookVector
				local targetCFrame = CFrame.lookAt(target.Position, look)
				if not pet.Current or (pet.Current.Position - targetCFrame.Position).Magnitude > 60 then
					pet.Current = targetCFrame
				else
					pet.Current = pet.Current:Lerp(targetCFrame, alpha)
				end
				if pet.Model.PrimaryPart then
					pet.Model:PivotTo(pet.Current)
				end
			end
		end
	end
end

function PetsFx.Init(context)
	ctx = context
	Config = ctx.Config
	UI = ctx.UI

	folder = Instance.new("Folder")
	folder.Name = "SlapLocalPets"
	folder.Parent = workspace

	Players.PlayerRemoving:Connect(clearOwner)
	RunService.RenderStepped:Connect(animate)
	task.spawn(function()
		while true do
			for _, owner in ipairs(Players:GetPlayers()) do
				syncOwner(owner)
			end
			task.wait(0.5)
		end
	end)
end

return PetsFx
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000022"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[--[[
	UI: kleine UI-Bibliothek (Farben, Bausteine, animierte Buttons, Fenster).
]]

local TweenService = game:GetService("TweenService")

local UI = {}

UI.Colors = {
	Pink = Color3.fromRGB(255, 105, 180),
	PinkDark = Color3.fromRGB(200, 60, 140),
	Purple = Color3.fromRGB(150, 90, 255),
	Dark = Color3.fromRGB(38, 22, 50),
	Darker = Color3.fromRGB(26, 14, 36),
	Panel = Color3.fromRGB(62, 36, 82),
	PanelLight = Color3.fromRGB(85, 52, 110),
	Green = Color3.fromRGB(60, 200, 100),
	GreenDark = Color3.fromRGB(30, 140, 70),
	Gray = Color3.fromRGB(115, 110, 125),
	Gold = Color3.fromRGB(255, 200, 50),
	Blue = Color3.fromRGB(70, 170, 255),
	Red = Color3.fromRGB(230, 70, 90),
	White = Color3.fromRGB(255, 255, 255),
	Text = Color3.fromRGB(245, 235, 255),
	SubText = Color3.fromRGB(205, 180, 225),
}

UI.Font = Enum.Font.FredokaOne
UI.BodyFont = Enum.Font.GothamBold

function UI.rgb(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

function UI.Create(className, props, children)
	local instance = Instance.new(className)
	local parent = nil
	if props then
		for key, value in pairs(props) do
			if key == "Parent" then
				parent = value
			else
				instance[key] = value
			end
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end
local Create = UI.Create

function UI.Corner(radius)
	return Create("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
end

function UI.Stroke(thickness, color, transparency)
	return Create("UIStroke", {
		Thickness = thickness or 2,
		Color = color or Color3.fromRGB(20, 8, 28),
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UI.TextStroke(thickness)
	return Create("UIStroke", {
		Thickness = thickness or 2,
		Color = Color3.fromRGB(20, 8, 28),
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
	})
end

function UI.Padding(all, top)
	return Create("UIPadding", {
		PaddingLeft = UDim.new(0, all),
		PaddingRight = UDim.new(0, all),
		PaddingTop = UDim.new(0, top or all),
		PaddingBottom = UDim.new(0, top or all),
	})
end

function UI.Gradient(top, bottom)
	return Create("UIGradient", {
		Color = ColorSequence.new(top, bottom),
		Rotation = 90,
	})
end

function UI.List(padding, horizontal, align)
	return Create("UIListLayout", {
		Padding = UDim.new(0, padding or 6),
		FillDirection = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
		VerticalAlignment = Enum.VerticalAlignment.Center,
	})
end

function UI.Label(props)
	local defaults = {
		BackgroundTransparency = 1,
		Font = UI.Font,
		TextScaled = true,
		TextColor3 = UI.Colors.Text,
		Text = "",
	}
	for k, v in pairs(props) do
		defaults[k] = v
	end
	return Create("TextLabel", defaults)
end

local function lighten(color, amount)
	return Color3.new(
		math.clamp(color.R + amount, 0, 1),
		math.clamp(color.G + amount, 0, 1),
		math.clamp(color.B + amount, 0, 1)
	)
end
UI.Lighten = lighten

-- Setzt die Farbe eines mit UI.Button gebauten Knopfes
function UI.SetButtonColor(button, color)
	button.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	local gradient = button:FindFirstChild("ButtonGradient")
	if gradient then
		gradient.Color = ColorSequence.new(lighten(color, 0.12), color)
	end
end

-- Animierter Knopf. onClick wird bei Klick/Tap aufgerufen.
function UI.Button(props, onClick)
	local color = props.Color or UI.Colors.Pink
	local button = Create("TextButton", {
		Name = props.Name or "Button",
		Size = props.Size or UDim2.new(0, 120, 0, 44),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(),
		LayoutOrder = props.LayoutOrder or 0,
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		AutoButtonColor = false,
		Font = UI.Font,
		TextScaled = true,
		TextColor3 = UI.Colors.White,
		Text = props.Text or "",
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	}, {
		UI.Corner(props.Radius or 12),
		UI.Stroke(props.StrokeThickness or 2.5),
		Create("UIGradient", { Name = "ButtonGradient", Color = ColorSequence.new(lighten(color, 0.12), color), Rotation = 90 }),
		UI.Padding(props.Padding or 6, props.PaddingY or 4),
		UI.TextStroke(1.5),
	})
	local scale = Create("UIScale", { Scale = 1, Parent = button })

	local hoverInfo = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	button.MouseEnter:Connect(function()
		TweenService:Create(scale, hoverInfo, { Scale = 1.06 }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(scale, hoverInfo, { Scale = 1 }):Play()
	end)
	button.MouseButton1Down:Connect(function()
		TweenService:Create(scale, hoverInfo, { Scale = 0.93 }):Play()
	end)
	button.MouseButton1Up:Connect(function()
		TweenService:Create(scale, hoverInfo, { Scale = 1.03 }):Play()
	end)
	if onClick then
		button.Activated:Connect(function()
			onClick(button)
		end)
	end
	return button
end

-- Fortschrittsbalken. Gibt Hintergrund und Fuellung zurueck.
function UI.ProgressBar(props)
	local back = Create("Frame", {
		Name = props.Name or "Progress",
		Size = props.Size or UDim2.new(1, 0, 0, 12),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(),
		LayoutOrder = props.LayoutOrder or 0,
		BackgroundColor3 = UI.Colors.Darker,
		BorderSizePixel = 0,
		Parent = props.Parent,
	}, { UI.Corner(props.Radius or 6), UI.Stroke(1.5) })
	local fill = Create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
		Parent = back,
	}, {
		UI.Corner(props.Radius or 6),
		UI.Gradient(lighten(props.Color or UI.Colors.Pink, 0.15), props.Color or UI.Colors.Pink),
	})
	return back, fill
end

function UI.SetProgress(fill, ratio)
	if ratio ~= ratio then
		ratio = 0
	end
	fill.Size = UDim2.fromScale(math.clamp(ratio, 0, 1), 1)
end

--------------------------------------------------------------------------
-- Fenster
--------------------------------------------------------------------------
UI.Windows = {}
UI.OpenWindow = nil
UI.OnWindowOpened = nil -- function(name)

function UI.CreateWindow(screen, name, title, icon, size)
	local width = size and size.X or 560
	local height = size and size.Y or 440
	local window = Create("Frame", {
		Name = name .. "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.53),
		Size = UDim2.new(0.94, 0, 0.8, 0),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		Visible = false,
		ZIndex = 5,
		Parent = screen,
	}, {
		UI.Corner(20),
		UI.Stroke(4, UI.Colors.Pink),
		UI.Gradient(UI.Colors.Dark, UI.Colors.Darker),
		Create("UISizeConstraint", { MaxSize = Vector2.new(width, height) }),
	})
	local scale = Create("UIScale", { Scale = 1, Parent = window })

	local titleBar = Create("Frame", {
		Name = "TitleBar",
		Size = UDim2.new(1, 0, 0, 54),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		ZIndex = 5,
		Parent = window,
	}, {
		UI.Corner(20),
		UI.Gradient(UI.Colors.Pink, UI.Colors.PinkDark),
	})
	-- untere Ecken der Titelleiste eckig machen
	Create("Frame", {
		Name = "Filler",
		Position = UDim2.new(0, 0, 1, -18),
		Size = UDim2.new(1, 0, 0, 18),
		BorderSizePixel = 0,
		BackgroundColor3 = UI.Colors.PinkDark,
		ZIndex = 5,
		Parent = titleBar,
	})
	local titleLabel = UI.Label({
		Name = "Title",
		Position = UDim2.new(0, 16, 0, 7),
		Size = UDim2.new(1, -80, 0, 40),
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = icon .. "  " .. title,
		ZIndex = 6,
		Parent = titleBar,
	})
	UI.TextStroke(2).Parent = titleLabel

	local content = Create("Frame", {
		Name = "Content",
		Position = UDim2.new(0, 12, 0, 62),
		Size = UDim2.new(1, -24, 1, -72),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = window,
	})

	local entry = { Name = name, Frame = window, Content = content, Scale = scale, Refresh = nil }

	UI.Button({
		Name = "Close",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 8),
		Size = UDim2.new(0, 40, 0, 38),
		Color = UI.Colors.Red,
		Text = "X",
		ZIndex = 7,
		Parent = window,
	}, function()
		UI.Close(name)
	end)

	UI.Windows[name] = entry
	return entry
end

function UI.Close(name)
	local entry = UI.Windows[name]
	if entry and entry.Frame.Visible then
		entry.Frame.Visible = false
		if UI.OpenWindow == name then
			UI.OpenWindow = nil
		end
	end
end

function UI.Open(name)
	local entry = UI.Windows[name]
	if not entry then
		return
	end
	if UI.OpenWindow and UI.OpenWindow ~= name then
		UI.Close(UI.OpenWindow)
	end
	UI.OpenWindow = name
	entry.Frame.Visible = true
	entry.Scale.Scale = 0.85
	TweenService:Create(entry.Scale, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	if entry.Refresh then
		entry.Refresh()
	end
	if UI.OnWindowOpened then
		UI.OnWindowOpened(name)
	end
end

function UI.Toggle(name)
	if UI.OpenWindow == name then
		UI.Close(name)
	else
		UI.Open(name)
	end
end

-- Scroll-Liste fuer Fenster-Inhalte
function UI.ScrollList(parent, props)
	props = props or {}
	local scroll = Create("ScrollingFrame", {
		Name = props.Name or "List",
		Position = props.Position or UDim2.new(),
		Size = props.Size or UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = UI.Colors.Pink,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ZIndex = 5,
		Parent = parent,
	}, {
		UI.Padding(4, 4),
	})
	if props.Grid then
		Create("UIGridLayout", {
			CellSize = props.Grid,
			CellPadding = UDim2.new(0, 8, 0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = scroll,
		})
	else
		Create("UIListLayout", {
			Padding = UDim.new(0, props.Padding or 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = scroll,
		})
	end
	return scroll
end

-- Zeile in einer Liste
function UI.Row(parent, height, order)
	return Create("Frame", {
		Name = "Row",
		Size = UDim2.new(1, -10, 0, height),
		LayoutOrder = order or 0,
		BackgroundColor3 = UI.Colors.Panel,
		ZIndex = 5,
		Parent = parent,
	}, { UI.Corner(14), UI.Stroke(2, UI.Colors.PanelLight) })
end

return UI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000023"><Properties><string name="Name">WorldFx</string><ProtectedString name="Source"><![CDATA[--[[
	WorldFx: alles, was der Client in der Welt animiert.
	  * Gyatts huepfen, schauen dich an, wackeln und erschrecken bei Treffern
	  * Eier drehen sich, Regenbogen-Haende leuchten
	  * Tore freigeschalteter Zonen werden durchlaessig
	  * Licht & Stimmung je nach Zone
	  * Tutorial-Pfeil zum ersten Gyatt
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")

local WorldFx = {}
local ctx, Config, Calc

local player = Players.LocalPlayer
local gyattCache = {} -- [Model] = Animationsdaten
local hitsByKey = {} -- [Key] = { Time, From }
local currentZone = -1

--------------------------------------------------------------------------
-- Gyatts
--------------------------------------------------------------------------
local function getCache(model)
	local cache = gyattCache[model]
	if cache then
		return cache
	end
	local smiles = {}
	for _, child in ipairs(model:GetChildren()) do
		if child.Name == "MouthSmile" then
			table.insert(smiles, child)
		end
	end
	cache = {
		Phase = math.random() * 10,
		Yaw = 0,
		MouthO = model:FindFirstChild("MouthO"),
		Smiles = smiles,
		Highlight = model:FindFirstChild("Outline"),
		Shocked = false,
	}
	gyattCache[model] = cache
	return cache
end

local function setShocked(cache, shocked)
	if cache.Shocked == shocked then
		return
	end
	cache.Shocked = shocked
	if cache.MouthO then
		cache.MouthO.Transparency = shocked and 0 or 1
	end
	for _, part in ipairs(cache.Smiles) do
		part.Transparency = shocked and 1 or 0
	end
end

local function angleLerp(a, b, t)
	local diff = (b - a + math.pi) % (math.pi * 2) - math.pi
	return a + diff * t
end

local function animateGyatts(dt)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local camera = workspace.CurrentCamera
	local cameraPos = camera and camera.CFrame.Position or Vector3.new()
	local now = os.clock()

	for _, model in ipairs(CollectionService:GetTagged("SlapGyatt")) do
		local base = model:GetAttribute("BaseCFrame")
		local size = model:GetAttribute("Size") or 6
		if model.Parent and typeof(base) == "CFrame" and model.PrimaryPart then
			local position = base.Position
			if (position - cameraPos).Magnitude < 260 then
				local cache = getCache(model)

				-- zum Spieler drehen
				local targetYaw = cache.Yaw
				if root then
					local d = root.Position - position
					if d.X * d.X + d.Z * d.Z > 1 then
						targetYaw = math.atan2(-d.X, -d.Z)
					end
				end
				cache.Yaw = angleLerp(cache.Yaw, targetYaw, math.min(1, dt * 4))

				-- Treffer-Reaktion
				local hit = hitsByKey[model:GetAttribute("Key")]
				local k = 0
				if hit then
					local age = now - hit.Time
					if age < 0.35 then
						k = 1 - age / 0.35
					end
				end
				setShocked(cache, k > 0.15)
				if cache.Highlight then
					cache.Highlight.FillTransparency = 1 - 0.55 * k
				end

				local bounce = math.abs(math.sin(now * 2.2 + cache.Phase)) * size * 0.05
				local wobble = math.sin(now * 40) * k * 0.12
				local pivot = CFrame.new(position + Vector3.new(0, bounce - k * size * 0.04, 0))
					* CFrame.Angles(0, cache.Yaw, 0)
					* CFrame.Angles(k * 0.32, 0, wobble)
				model:PivotTo(pivot)
			end
		end
	end

	-- alte Eintraege aufraeumen
	for model in pairs(gyattCache) do
		if not model.Parent then
			gyattCache[model] = nil
		end
	end
end

function WorldFx.OnSlap(info)
	if info.Kind == "Gyatt" and type(info.Key) == "string" then
		hitsByKey[info.Key] = { Time = os.clock() }
	end
end

--------------------------------------------------------------------------
-- Eier & Regenbogen
--------------------------------------------------------------------------
local function animateEggs()
	local t = os.clock()
	for _, egg in ipairs(CollectionService:GetTagged("SlapEgg")) do
		local baseY = egg:GetAttribute("BaseY")
		if type(baseY) == "number" then
			local p = egg.Position
			egg.CFrame = CFrame.new(p.X, baseY + math.sin(t * 2 + p.Z) * 0.4, p.Z) * CFrame.Angles(0, t * 0.8, math.sin(t * 3) * 0.08)
		end
	end
	local rainbow = Color3.fromHSV((t * 0.25) % 1, 0.75, 1)
	for _, part in ipairs(CollectionService:GetTagged("RainbowHand")) do
		part.Color = rainbow
	end
end

--------------------------------------------------------------------------
-- Tore
--------------------------------------------------------------------------
local function refreshGates()
	local unlocked = (ctx.State and ctx.State.Zones) or 1
	for _, gate in ipairs(CollectionService:GetTagged("SlapGate")) do
		local index = gate:GetAttribute("ZoneIndex") or 99
		local open = index <= unlocked
		gate.CanCollide = not open
		gate.Transparency = open and 0.9 or 0.3
		for _, gui in ipairs(gate:GetChildren()) do
			if gui:IsA("SurfaceGui") then
				gui.Enabled = not open
			end
		end
	end
	-- Prompts zum Freischalten bereits offener Zonen verstecken
	local world = workspace:FindFirstChild("SlapWorld")
	if world then
		for index = 2, #Config.Zones do
			local zoneFolder = world:FindFirstChild("Zone" .. index)
			local promptPart = zoneFolder and zoneFolder:FindFirstChild("GatePrompt")
			local prompt = promptPart and promptPart:FindFirstChild("UnlockPrompt")
			if prompt then
				prompt.Enabled = index > unlocked
			end
		end
	end
end

--------------------------------------------------------------------------
-- Stimmung pro Zone
--------------------------------------------------------------------------
local MOODS = {
	[0] = { Clock = 14.5, Color = { 255, 220, 235 }, Decay = { 150, 110, 160 }, Density = 0.28, Tint = { 255, 255, 255 }, Cloud = 0.55, CloudColor = { 255, 245, 250 } },
	[1] = { Clock = 14.5, Color = { 255, 225, 235 }, Decay = { 140, 160, 120 }, Density = 0.28, Tint = { 255, 255, 255 }, Cloud = 0.55, CloudColor = { 255, 255, 255 } },
	[2] = { Clock = 15.8, Color = { 255, 225, 180 }, Decay = { 200, 140, 90 }, Density = 0.33, Tint = { 255, 242, 220 }, Cloud = 0.3, CloudColor = { 255, 235, 210 } },
	[3] = { Clock = 13, Color = { 220, 240, 255 }, Decay = { 140, 180, 220 }, Density = 0.36, Tint = { 232, 242, 255 }, Cloud = 0.75, CloudColor = { 240, 245, 255 } },
	[4] = { Clock = 18.1, Color = { 255, 150, 110 }, Decay = { 140, 40, 30 }, Density = 0.42, Tint = { 255, 222, 210 }, Cloud = 0.8, CloudColor = { 90, 70, 70 } },
	[5] = { Clock = 12, Color = { 255, 255, 255 }, Decay = { 255, 230, 200 }, Density = 0.3, Tint = { 255, 250, 240 }, Cloud = 0.7, CloudColor = { 255, 250, 235 } },
	[6] = { Clock = 0.5, Color = { 120, 90, 200 }, Decay = { 40, 20, 90 }, Density = 0.22, Tint = { 222, 212, 255 }, Cloud = 0, CloudColor = { 255, 255, 255 } },
}

local function applyMood(zoneIndex)
	local mood = MOODS[zoneIndex] or MOODS[0]
	local info = TweenInfo.new(2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	TweenService:Create(Lighting, info, { ClockTime = mood.Clock }):Play()
	local atmosphere = Lighting:FindFirstChild("SlapAtmosphere")
	if atmosphere then
		TweenService:Create(atmosphere, info, {
			Color = ctx.UI.rgb(mood.Color),
			Decay = ctx.UI.rgb(mood.Decay),
			Density = mood.Density,
		}):Play()
	end
	local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds")
	if clouds then
		TweenService:Create(clouds, info, { Cover = mood.Cloud, Color = ctx.UI.rgb(mood.CloudColor) }):Play()
	end
	local color = Lighting:FindFirstChild("SlapColor")
	if color then
		TweenService:Create(color, info, { TintColor = ctx.UI.rgb(mood.Tint) }):Play()
	end
end

local function checkZone()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local zone = Calc.GetZoneAtZ(root.Position.Z)
	if zone ~= currentZone then
		currentZone = zone
		ctx.Hud.SetZone(zone)
		applyMood(zone)
	end
end

--------------------------------------------------------------------------
-- Tutorial-Pfeil
--------------------------------------------------------------------------
local tutorial = { Beam = nil, A0 = nil, A1 = nil }

local function clearTutorial()
	for _, key in ipairs({ "Beam", "A0", "A1" }) do
		if tutorial[key] then
			tutorial[key]:Destroy()
			tutorial[key] = nil
		end
	end
end

local function updateTutorial()
	local state = ctx.State
	if not state or state.TutorialDone then
		clearTutorial()
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local target = nil
	for _, model in ipairs(CollectionService:GetTagged("SlapGyatt")) do
		if model:GetAttribute("Key") == "Z1_1" and model.Parent then
			target = model.PrimaryPart
		end
	end
	if not root or not target then
		clearTutorial()
		return
	end
	if tutorial.A0 and tutorial.A0.Parent == root and tutorial.A1 and tutorial.A1.Parent == target then
		return
	end
	clearTutorial()
	tutorial.A0 = Instance.new("Attachment")
	tutorial.A0.Parent = root
	tutorial.A1 = Instance.new("Attachment")
	tutorial.A1.Parent = target
	local beam = Instance.new("Beam")
	beam.Attachment0 = tutorial.A0
	beam.Attachment1 = tutorial.A1
	beam.Color = ColorSequence.new(Color3.fromRGB(255, 120, 200), Color3.fromRGB(255, 230, 120))
	beam.Width0 = 0.6
	beam.Width1 = 0.6
	beam.FaceCamera = true
	beam.LightEmission = 1
	beam.Transparency = NumberSequence.new(0.2)
	beam.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	beam.TextureMode = Enum.TextureMode.Wrap
	beam.TextureLength = 2
	beam.TextureSpeed = 2
	beam.Parent = tutorial.A0
	tutorial.Beam = beam
end

--------------------------------------------------------------------------
function WorldFx.Init(context)
	ctx = context
	Config = ctx.Config
	Calc = ctx.Calc

	RunService.RenderStepped:Connect(function(dt)
		animateGyatts(dt)
		animateEggs()
	end)

	ctx.OnState(function(_, full)
		if full then
			refreshGates()
			updateTutorial()
		end
	end)

	task.spawn(function()
		while true do
			task.wait(0.5)
			checkZone()
			refreshGates()
			updateTutorial()
		end
	end)
end

return WorldFx
]]></ProtectedString></Properties></Item></Item></Item></Item></roblox>
